<?xml version="1.0" encoding="UTF-8"?>
<!-- Everything one screen needs, for its configured rows only (see generator/screen.xmltemplate).
     Conditions use Skin Variables' own comparisons (a==b, a!=b) so the build does not depend on Kodi state
     and tools/build_home_defaults.py can reproduce it. Row ids are {base} + 1 + {item_x}.
     A hub slot (node set) also reads its hub from the hubs menu: the entry at position {node}, if any. Its label, open
     target and "disabled" field become the slot's menu entry (Bald_HubLabel_<screen>, Bald_HubShown_<screen>,
     Bald_HubOpen_<screen>); a slot past the end of the list has no hub and no rows, so it builds only empty names. -->
<contents>
    <items>
        <item>
            <template>generator/screen.xmltemplate</template>
            <!-- The hub in this slot, when there is one (home and livetv have no node, so nothing matches). -->
            <value name="hub_label">
                <items menu="hubs" mode="submenu">
                    <item>
                        <condition>{item_x}=={node}</condition>
                        <template>{item_label}</template>
                    </item>
                </items>
            </value>
            <!-- Shown in the main menu unless its "disabled" field is True (Home Screens, Show in the main menu). -->
            <value name="hub_shown">
                <items menu="hubs" mode="submenu">
                    <item>
                        <condition>{item_x}=={node}</condition>
                        <condition>{item_disabled}!=True</condition>
                        <template>| [true]</template>
                    </item>
                </items>
            </value>
            <!-- The optional open target (path and target, as Skin Variables' do_action stores them). -->
            <value name="hub_has_open">
                <items menu="hubs" mode="submenu">
                    <item>
                        <condition>{item_x}=={node}</condition>
                        <condition>{item_path}!=</condition>
                        <template>| [true]</template>
                    </item>
                </items>
            </value>
            <!-- What the bridge runs (first rule that holds; a<<b is "a contains b", a!<b "a does not contain b", Skin
                 Variables' check_condition):
                   a builtin runs as it is: a path with no "://" (Browse's Favourites, Weather, Pictures, Programs,
                     Add-ons and Radio entries, or Edit's ActivateWindow(Weather)), or one that names a common builtin;
                   music, picture and program paths open their own window whatever the stored target says (Edit keeps
                     the old target, so a hub first set to a video node and then edited to musicdb:// still has "videos");
                     Bald's album and artist playlists are music too;
                   any other path opens in its target window (Browse stores the grouping entry's node: videos, music,
                     tvchannels, radiochannels, favouritesbrowser), or in videos when the target is empty. -->
            <value name="hub_open">
                <items menu="hubs" mode="submenu">
                    <item>
                        <condition>{item_x}=={node}</condition>
                        <condition>{item_path}!=</condition>
                        <template>&lt;onfocus&gt;{hub_action}&lt;/onfocus&gt;</template>
                        <rules name="hub_action">
                            <rule>
                                <condition>{item_path}!&lt;://</condition>
                                <value>{item_path}</value>
                            </rule>
                            <rule>
                                <condition>{item_path}&lt;&lt;ActivateWindow(</condition>
                                <value>{item_path}</value>
                            </rule>
                            <rule>
                                <condition>{item_path}&lt;&lt;activatewindow(</condition>
                                <value>{item_path}</value>
                            </rule>
                            <rule>
                                <condition>{item_path}&lt;&lt;PlayMedia(</condition>
                                <value>{item_path}</value>
                            </rule>
                            <rule>
                                <condition>{item_path}&lt;&lt;RunScript(</condition>
                                <value>{item_path}</value>
                            </rule>
                            <rule>
                                <condition>{item_path}&lt;&lt;RunAddon(</condition>
                                <value>{item_path}</value>
                            </rule>
                            <rule>
                                <condition>{item_path}&lt;&lt;RunPlugin(</condition>
                                <value>{item_path}</value>
                            </rule>
                            <rule>
                                <condition>{item_path}&lt;&lt;musicdb://</condition>
                                <value>ActivateWindow(music,{item_path},return)</value>
                            </rule>
                            <rule>
                                <condition>{item_path}&lt;&lt;library://music/</condition>
                                <value>ActivateWindow(music,{item_path},return)</value>
                            </rule>
                            <rule>
                                <condition>{item_path}&lt;&lt;addons://sources/audio</condition>
                                <value>ActivateWindow(music,{item_path},return)</value>
                            </rule>
                            <rule>
                                <condition>{item_path}&lt;&lt;special://skin/playlists/</condition>
                                <condition>{item_path}&lt;&lt;_albums.xsp</condition>
                                <value>ActivateWindow(music,{item_path},return)</value>
                            </rule>
                            <rule>
                                <condition>{item_path}&lt;&lt;special://skin/playlists/random_artists.xsp</condition>
                                <value>ActivateWindow(music,{item_path},return)</value>
                            </rule>
                            <rule>
                                <condition>{item_path}&lt;&lt;addons://sources/image</condition>
                                <value>ActivateWindow(pictures,{item_path},return)</value>
                            </rule>
                            <rule>
                                <condition>{item_path}&lt;&lt;addons://sources/executable</condition>
                                <value>ActivateWindow(programs,{item_path},return)</value>
                            </rule>
                            <rule>
                                <condition>{item_target}!=</condition>
                                <value>ActivateWindow({item_target},{item_path},return)</value>
                            </rule>
                            <rule>
                                <value>ActivateWindow(videos,{item_path},return)</value>
                            </rule>
                        </rules>
                    </item>
                </items>
            </value>
            <value name="rows">
                <items menu="{menu}" item="{node}" mode="{mode}">
                    <item>
                        <template>generator/row.xmltemplate</template>
                        <value name="row_id">$MATH[{base} + 1 + {item_x}]</value>
                        <value name="row_index">$MATH[1 + {item_x}]</value>
                        <value name="dots_width">$MATH[12 * {item_length_x} - 6]</value>
                        <!-- The row's style (widget editor, row field "style"); anything else, or none, is fanart. Text is a landscape
                             row whose tiles show the name (Bald_RowTiles_text); the frame treats it as fanart. -->
                        <rules name="row_style">
                            <rule>
                                <condition>{item_style}==thumbnail</condition>
                                <value>thumbnail</value>
                            </rule>
                            <rule>
                                <condition>{item_style}==logo</condition>
                                <value>logo</value>
                            </rule>
                            <rule>
                                <condition>{item_style}==poster</condition>
                                <value>poster</value>
                            </rule>
                            <rule>
                                <condition>{item_style}==square</condition>
                                <value>square</value>
                            </rule>
                            <rule>
                                <condition>{item_style}==text</condition>
                                <value>text</value>
                            </rule>
                            <rule>
                                <value>fanart</value>
                            </rule>
                        </rules>
                        <!-- Focus slot and the item a fresh fixedlist selects there (focusposition + 1): poster rows let focus
                             travel to slot 5 (docs/SPEC.md 5.1), landscape rows to slot 2. -->
                        <rules name="row_slot">
                            <rule>
                                <condition>{item_style}==poster</condition>
                                <value>5</value>
                            </rule>
                            <rule>
                                <value>2</value>
                            </rule>
                        </rules>
                        <rules name="row_start">
                            <rule>
                                <condition>{item_style}==poster</condition>
                                <value>6</value>
                            </rule>
                            <rule>
                                <value>3</value>
                            </rule>
                        </rules>
                        <rules name="row_up">
                            <rule>
                                <condition>{item_x}==0</condition>
                                <value>SetFocus(9000,0,absolute)</value>
                            </rule>
                            <rule>
                                <value>$MATH[{base} + {item_x}]</value>
                            </rule>
                        </rules>
                        <rules name="row_down">
                            <rule>
                                <condition>{item_x}==$MATH[{item_length_x} - 1]</condition>
                                <value></value>
                            </rule>
                            <rule>
                                <value>$MATH[{base} + 2 + {item_x}]</value>
                            </rule>
                        </rules>
                        <!-- Optional row fields sortby / sortorder: set in the widget editor's Sort by and Order (Kodi sort
                             method names: title, year, rating, dateadded, lastplayed, playcount, time, random), and by the
                             Live TV defaults as Estuary's PVR widgets do. No sortby keeps the path's own order; no
                             sortorder is Kodi's default, ascending. -->
                        <rules name="content_sort">
                            <rule>
                                <condition>{item_sortby}!=</condition>
                                <condition>{item_sortorder}!=</condition>
                                <value> sortby="{item_sortby}" sortorder="{item_sortorder}"</value>
                            </rule>
                            <rule>
                                <condition>{item_sortby}!=</condition>
                                <value> sortby="{item_sortby}"</value>
                            </rule>
                            <rule>
                                <value></value>
                            </rule>
                        </rules>
                        <rules name="secondary_content">
                            <rule>
                                <condition>{item_secondary}==1</condition>
                                <value>&lt;content target="{item_target_escaped}" limit="{item_limit_escaped}" browse="never"{content_sort}&gt;{item_path2_escaped}&lt;/content&gt;</value>
                            </rule>
                            <rule>
                                <value></value>
                            </rule>
                        </rules>
                        <!-- The next row is hidden (and already loaded) while this one has focus: move it back to its first
                             item now, so it never shows the fixedlist's pristine item at its focus slot (docs/NOTES.md,
                             Fixedlist focus). Bald_RowStart_<next row> is written with that row's own slot (row_parts). -->
                        <rules name="next_start">
                            <rule>
                                <condition>{item_x}==$MATH[{item_length_x} - 1]</condition>
                                <value></value>
                            </rule>
                            <rule>
                                <value>&lt;include&gt;Bald_RowStart_$MATH[{base} + 2 + {item_x}]&lt;/include&gt;</value>
                            </rule>
                        </rules>
                    </item>
                </items>
            </value>
            <value name="row_parts">
                <items menu="{menu}" item="{node}" mode="{mode}">
                    <item>
                        <template>generator/row-parts.xmltemplate</template>
                        <value name="row_id">$MATH[{base} + 1 + {item_x}]</value>
                        <value name="row_index">$MATH[1 + {item_x}]</value>
                        <!-- As in rows above. -->
                        <rules name="row_slot">
                            <rule>
                                <condition>{item_style}==poster</condition>
                                <value>5</value>
                            </rule>
                            <rule>
                                <value>2</value>
                            </rule>
                        </rules>
                        <rules name="row_start">
                            <rule>
                                <condition>{item_style}==poster</condition>
                                <value>6</value>
                            </rule>
                            <rule>
                                <value>3</value>
                            </rule>
                        </rules>
                        <value name="dots">
                            <items menu="{menu}" item="{node}" mode="{mode}">
                                <item>
                                    <template>generator/row-dot.xmltemplate</template>
                                    <value name="dot_x">$MATH[12 * {item_x}]</value>
                                    <rules name="dot_color">
                                        <rule>
                                            <condition>{item_x}=={parent_item_x}</condition>
                                            <value>bald_ink95</value>
                                        </rule>
                                        <rule>
                                            <value>bald_ink28</value>
                                        </rule>
                                    </rules>
                                </item>
                            </items>
                        </value>
                        <rules name="note_rest">
                            <rule>
                                <condition>{item_x}==$MATH[{item_length_x} - 1]</condition>
                                <value></value>
                            </rule>
                            <rule>
                                <value>, $VAR[Bald_RowsNote_{screen}_$MATH[2 + {item_x}]]</value>
                            </rule>
                        </rules>
                    </item>
                </items>
            </value>
            <value name="row_styles">
                <items menu="{menu}" item="{node}" mode="{mode}">
                    <item>
                        <template>&lt;value condition="String.IsEqual(Window(home).Property(Bald.Row.{screen}),{row_id})"&gt;{row_style}&lt;/value&gt;</template>
                        <value name="row_id">$MATH[{base} + 1 + {item_x}]</value>
                        <rules name="row_style">
                            <rule>
                                <condition>{item_style}==thumbnail</condition>
                                <value>thumbnail</value>
                            </rule>
                            <rule>
                                <condition>{item_style}==logo</condition>
                                <value>logo</value>
                            </rule>
                            <rule>
                                <condition>{item_style}==poster</condition>
                                <value>poster</value>
                            </rule>
                            <rule>
                                <condition>{item_style}==square</condition>
                                <value>square</value>
                            </rule>
                            <rule>
                                <condition>{item_style}==text</condition>
                                <value>text</value>
                            </rule>
                            <rule>
                                <value>fanart</value>
                            </rule>
                        </rules>
                    </item>
                </items>
            </value>
            <value name="has_rows">
                <items menu="{menu}" item="{node}" mode="{mode}">
                    <item>
                        <template>| [true]</template>
                    </item>
                </items>
            </value>
            <!-- Startup splash: a row is still loading until its list provider has fetched (Container.IsUpdating is true
                 from window load until then, and while a refresh is pending), so a row that loaded empty counts as done. -->
            <value name="rows_loading">
                <items menu="{menu}" item="{node}" mode="{mode}">
                    <item>
                        <template>| [Container({row_id}).IsUpdating]</template>
                        <value name="row_id">$MATH[{base} + 1 + {item_x}]</value>
                    </item>
                </items>
            </value>
            <value name="note_head">
                <items menu="{menu}" item="{node}" mode="{mode}">
                    <item>
                        <condition>{item_x}==0</condition>
                        <template>&lt;value&gt;$VAR[Bald_RowsNote_{screen}_1]&lt;/value&gt;</template>
                    </item>
                </items>
            </value>
            <value name="start_reset">
                <items menu="{menu}" item="{node}" mode="{mode}">
                    <item>
                        <template>&lt;onload&gt;ClearProperty(Bald.Start$MATH[{base} + 1 + {item_x}],home)&lt;/onload&gt;</template>
                    </item>
                </items>
            </value>
            <value name="art_logos">
                <!-- Rows with the art-frame clearlogo off (row field "logo" = off; empty or on shows it) get no
                     clearlogo instances, and no branch in the logo expressions below, so the frame shows no logo or scrim. -->
                <items menu="{menu}" item="{node}" mode="{mode}">
                    <item>
                        <condition>{item_logo}!=off</condition>
                        <template>generator/row-binding.xmltemplate</template>
                        <value name="content">Bald_ArtLogo</value>
                        <value name="row_id">$MATH[{base} + 1 + {item_x}]</value>
                    </item>
                </items>
            </value>
            <value name="captions">
                <items menu="{menu}" item="{node}" mode="{mode}">
                    <item>
                        <template>generator/row-binding.xmltemplate</template>
                        <value name="content">Bald_Caption</value>
                        <value name="row_id">$MATH[{base} + 1 + {item_x}]</value>
                    </item>
                </items>
            </value>
            <value name="item_odd">
                <items menu="{menu}" item="{node}" mode="{mode}">
                    <item>
                        <template>| [String.IsEqual(Window(home).Property(Bald.Row),{row_id}) + Integer.IsOdd(Container({row_id}).CurrentItem)]</template>
                        <value name="row_id">$MATH[{base} + 1 + {item_x}]</value>
                    </item>
                </items>
            </value>
            <value name="has_logo">
                <items menu="{menu}" item="{node}" mode="{mode}">
                    <item>
                        <condition>{item_logo}!=off</condition>
                        <template>| [String.IsEqual(Window(home).Property(Bald.Row),{row_id}) + [!String.IsEmpty(Container({row_id}).ListItem.Art(clearlogo)) | !String.IsEmpty(Container({row_id}).ListItem.Art(tvshow.clearlogo))]]</template>
                        <value name="row_id">$MATH[{base} + 1 + {item_x}]</value>
                    </item>
                </items>
            </value>
            <value name="preview_item_odd">
                <items menu="{menu}" item="{node}" mode="{mode}">
                    <item>
                        <template>| [$EXP[Bald_Preview{title}] + String.IsEqual(Window(home).Property(Bald.Row.{screen}),{row_id}) + Integer.IsOdd(Container({row_id}).CurrentItem)]</template>
                        <value name="row_id">$MATH[{base} + 1 + {item_x}]</value>
                    </item>
                </items>
            </value>
            <value name="preview_has_logo">
                <items menu="{menu}" item="{node}" mode="{mode}">
                    <item>
                        <condition>{item_logo}!=off</condition>
                        <template>| [$EXP[Bald_Preview{title}] + String.IsEqual(Window(home).Property(Bald.Row.{screen}),{row_id}) + [!String.IsEmpty(Container({row_id}).ListItem.Art(clearlogo)) | !String.IsEmpty(Container({row_id}).ListItem.Art(tvshow.clearlogo))]]</template>
                        <value name="row_id">$MATH[{base} + 1 + {item_x}]</value>
                    </item>
                </items>
            </value>
        </item>
    </items>
</contents>
