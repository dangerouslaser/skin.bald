<value condition="{prefix} + !String.IsEmpty(Container({row_id}).ListItem.Art(fanart))">$INFO[Container({row_id}).ListItem.Art(fanart)]</value>
<value condition="{prefix} + !String.IsEmpty(Container({row_id}).ListItem.Art(tvshow.fanart))">$INFO[Container({row_id}).ListItem.Art(tvshow.fanart)]</value>
<value condition="{prefix} + !String.IsEmpty(Container({row_id}).ListItem.Art(artist.fanart))">$INFO[Container({row_id}).ListItem.Art(artist.fanart)]</value>
<value condition="{prefix} + $EXP[Bald_HasArt_{screen}]">$VAR[Bald_ScreenArt_{screen}]</value>
<value condition="{prefix}">$INFO[Container({row_id}).ListItem.Art(thumb)]</value>
