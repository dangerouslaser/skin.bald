<include content="Bald_Row">
    <param name="id">{row_id}</param>
    <param name="label">{item_label_escaped}</param>
    <param name="index">{row_index}</param>
    <param name="screen">{screen}</param>
    <param name="menu">{button}</param>
    <param name="enabled">{enabled}</param>
    <param name="up">{row_up}</param>
    <param name="down">{row_down}</param>
    <param name="dots">Bald_RowDots_{row_id}</param>
    <param name="dots_width">{dots_width}</param>
    <param name="style">{row_style}</param>
    <param name="slot">{row_slot}</param>
    <param name="start">{row_start}</param>
    {row_content}
    {next_start}
</include>
