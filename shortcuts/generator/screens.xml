<?xml version="1.0" encoding="UTF-8"?>
<!-- The Home screens with rows: Home, Live TV and eight fixed hub slots (docs/NOTES.md, Home hubs). Every datafile in
     skinvariables-generator.json loads this first, so each one loops over the screens in this order and then over
     that screen's rows (<items menu="{menu}" item="{node}" mode="{mode}">).
       screen   Bald.Screen / Bald.MenuPreview value and the Bald.Row.<screen> property suffix
       menu     the Skin Variables menu holding the rows (skinvariables-shortcut-<menu>.json)
       node     absent (empty) for a menu of rows; for a hub, its position in the hubs menu (slot n is hub n - 1), whose
                "widgets" list holds its rows. A slot past the end of the hubs menu has no rows and builds nothing.
       mode     submenu (the menu's own items) or widgets (the node's widgets)
       title    include and expression name part (Bald_Generated_<title>Widgets, Bald_Preview<title>)
       base     row ids are base + 1 onward (1080i/IDs)
       button   the screen's main-menu entry (Home.xml grouplist 9000), where Up from its first row and Back go
       enabled  a Kodi condition the screen's rows also need (Live TV rows need a PVR add-on; Home's rows are off
                while Home is hidden, Bald_HomeHidden)
     Never write an empty <value>: Skin Variables reads it as None and formats the text "None". -->
<contents>
    <lists>
        <list name="home">
            <value name="screen">home</value>
            <value name="menu">homewidgets</value>
            <value name="mode">submenu</value>
            <value name="title">Home</value>
            <value name="base">9100</value>
            <value name="button">9001</value>
            <value name="enabled">!$EXP[Bald_HomeHidden]</value>
        </list>
        <list name="livetv">
            <value name="screen">livetv</value>
            <value name="menu">livetvwidgets</value>
            <value name="mode">submenu</value>
            <value name="title">LiveTV</value>
            <value name="base">9050</value>
            <value name="button">9004</value>
            <value name="enabled">System.HasPVRAddon</value>
        </list>
        <list name="hub1">
            <value name="screen">hub1</value>
            <value name="menu">hubs</value>
            <value name="node">0</value>
            <value name="mode">widgets</value>
            <value name="title">Hub1</value>
            <value name="base">9200</value>
            <value name="button">9011</value>
            <value name="enabled">true</value>
        </list>
        <list name="hub2">
            <value name="screen">hub2</value>
            <value name="menu">hubs</value>
            <value name="node">1</value>
            <value name="mode">widgets</value>
            <value name="title">Hub2</value>
