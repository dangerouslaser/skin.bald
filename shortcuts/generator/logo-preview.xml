<?xml version="1.0" encoding="UTF-8"?>
<!-- Values of Bald_Logo for each configured row, while the menu previews its screen (Bald.Row.<screen>). -->
<contents>
    <items>
        <item>
            <items menu="{menu}" mode="submenu">
                <item>
                    <template>generator/logo.xmltemplate</template>
                    <value name="row_id">$MATH[{base} + 1 + {item_x}]</value>
                    <value name="prefix">$EXP[Bald_Preview{title}] + String.IsEqual(Window(home).Property(Bald.Row.{screen}),$MATH[{base} + 1 + {item_x}])</value>
                </item>
            </items>
        </item>
    </items>
</contents>
