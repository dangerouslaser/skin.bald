<?xml version="1.0" encoding="UTF-8"?>
<colors>
	<color name="background">FF000000</color>
	<color name="black">FF000000</color>
	<color name="grey">FFA0A0A0</color>
	<color name="button_focus">FF12A0C7</color>
	<color name="text_shadow">22000000</color>
	<color name="border_alpha">60FFFFFF</color>
	<color name="disabled">40FFFFFF</color>
	<color name="selected">FFFFB70F</color>
	<color name="invalid">FFFF0000</color>
	<!-- DialogNumeric (Estuary layout): the input well behind the digits, and the unfocused action buttons. -->
	<color name="input_field">32FFFFFF</color>
	<color name="button_alt_nofocus">71FFFFFF</color>
	<!-- Bald tokens (docs/SPEC.md section 3). Ink opacity uses one fixed scale:
	     100 / 95 / 80 / 70 / 60 / 45 / 34 / 28 / 10. Pick the nearest step; do not add in-between values.
	     Image treatments (dimming, placeholders, backdrop brightness, scrims) have role names instead. -->
	<color name="bald_field">FF0B0C10</color>
	<!-- Accent: white (it was a light blue): focus discs and dots, progress, the genre line, ratings glyphs. -->
	<color name="bald_accent">FFFFFFFF</color>
	<!-- Recording and timer marks (the channel status icon, the guide's timer dots, timer rows): a clear red, the one
	     colour the white accent cannot stand in for. -->
	<color name="bald_record">FFE5484D</color>
	<!-- The TV guide's "now" line: the accent at half strength. -->
	<color name="bald_accent50">80FFFFFF</color>
	<color name="bald_ink">FFECEEF2</color>
	<color name="bald_ink95">F2ECEEF2</color>
	<color name="bald_ink80">CCECEEF2</color>
	<color name="bald_ink70">B3ECEEF2</color>
	<color name="bald_ink60">99ECEEF2</color>
	<color name="bald_ink45">73ECEEF2</color>
	<color name="bald_ink34">57ECEEF2</color>
	<color name="bald_ink28">47ECEEF2</color>
	<color name="bald_ink10">1AECEEF2</color>
	<!-- Blurred fanart background brightness (multiplies the image): 30%. -->
	<color name="bald_backdrop">FF4D4D4D</color>
	<!-- The weather page's unblurred photo, without a blur helper (Bald_WeatherBackdrop): 12%. -->
	<color name="bald_backdrop12">FF1F1F1F</color>
	<!-- Appearance › Background brightness for the blurred background (Bald_BlurDiffuse): 20, 40 or 50 %; unset is 30. -->
	<color name="bald_backdrop20">FF333333</color>
	<color name="bald_backdrop40">FF666666</color>
	<color name="bald_backdrop50">FF808080</color>
	<!-- Info dialog scrim layer. -->
	<color name="bald_field60">990B0C10</color>
	<!-- The context menu's scrim when it opens away from Home. -->
	<color name="bald_field85">D90B0C10</color>
	<!-- Playback scrims (the OSD, seek layer and info overlay over video): pure black, so they never tint the picture;
	     Playback › Background shading scales them (Bald_OSDShade). -->
	<color name="bald_scrim">FF000000</color>
	<color name="bald_scrim60">99000000</color>
	<!-- Behind Estuary-layout dialogs that ask for a darkened background (DialogBackgroundCommons darken_bg). -->
	<color name="bald_scrim50">80000000</color>
	<!-- The in-player Live TV panel (guide and channels): an even black under the whole screen. -->
	<color name="bald_scrim85">D9000000</color>
	<!-- Background video (playing video behind Bald's windows): Playback › Background video dim darkens it by 60, 70,
	     80 (the default) or 90 %, so rows and text stay readable. -->
	<color name="bald_video_dim60">99000000</color>
	<color name="bald_video_dim70">B3000000</color>
	<color name="bald_video_dim">CC000000</color>
	<color name="bald_video_dim90">E6000000</color>
	<!-- Unfocused tiles and posters: 55% (SPEC 5.1 row behavior), as brightness at full opacity, so a tile stays solid
	     over background video (a 55% alpha tile let the video through). -->
	<color name="bald_tile_dim">FF8C8C8C</color>
	<color name="bald_poster_dim">FF818285</color>
	<!-- Artwork at an ink step's brightness, at full opacity (ink60/70/45 are translucent; over video they showed it
	     through): unfocused wall posters, music covers and icons. -->
	<color name="bald_art70">FFA5A7A9</color>
	<color name="bald_art45">FF6A6B6D</color>
	<!-- Placeholder boxes under artwork (and behind channel logos): the tint they had over the field, at full opacity,
	     so a tile stays solid over background video. -->
	<color name="bald_placeholder">FF141519</color>
	<color name="bald_tile_placeholder">FF1D1E22</color>
	<!-- The track under a progress mark on Home tiles (Bald_TileMarks): bald_ink28 over the field, at full opacity, so
	     the bar stays solid over background video; _dim is it at the unfocused tile's 55% brightness (bald_tile_dim). -->
	<color name="bald_mark_track">FF4A4B4F</color>
	<color name="bald_mark_track_dim">FF29292B</color>
</colors>
