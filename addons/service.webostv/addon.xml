<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.webostv" name="LG webOS TV Control" version="0.5.2" provider-name="dangerouslaser">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.python.pluginsource" library="plugin.py">
    <provides>executable</provides>
  </extension>
  <extension point="kodi.context.item">
    <menu id="kodi.core.main">
      <menu>
        <label>32300</label>
        <item library="context.py" args="filmmaker">
          <label>32301</label>
          <visible>String.IsEqual(Window(Home).Property(WebOS.Connected),true) + !ListItem.IsFolder + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.DBTYPE,musicvideo) | Window.IsActive(videos)]</visible>
        </item>
        <item library="context.py" args="bright">
          <label>32302</label>
          <visible>String.IsEqual(Window(Home).Property(WebOS.Connected),true) + !ListItem.IsFolder + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.DBTYPE,musicvideo) | Window.IsActive(videos)]</visible>
        </item>
        <item library="context.py" args="preset">
          <label>32303</label>
          <visible>String.IsEqual(Window(Home).Property(WebOS.Connected),true) + !ListItem.IsFolder + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.DBTYPE,musicvideo) | Window.IsActive(videos)]</visible>
        </item>
        <item library="context.py" args="screen_off">
          <label>32304</label>
          <visible>String.IsEqual(Window(Home).Property(WebOS.Connected),true) + !ListItem.IsFolder + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.DBTYPE,musicvideo) | Window.IsActive(videos)]</visible>
        </item>
        <item library="context.py" args="sleep">
          <label>32305</label>
          <visible>String.IsEqual(Window(Home).Property(WebOS.Connected),true) + !ListItem.IsFolder + [String.IsEqual(ListItem.DBTYPE,movie) | String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.DBTYPE,musicvideo) | Window.IsActive(videos)]</visible>
        </item>
      </menu>
    </menu>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Control the LG webOS TV that Kodi runs on</summary>
    <description lang="en_GB">Power, volume, mute, inputs, apps, sound output, remote buttons and toast notifications for LG webOS TVs over the local SSAP API. Publishes live TV state as skin properties (Window(Home).Property(WebOS.*)) and exposes every action through RunScript, keymaps and JSON-RPC. Works with Kodi running on the TV itself or on another box on the LAN.</description>
    <platform>all</platform>
    <license>Apache-2.0</license>
    <source>https://github.com/dangerouslaser/kodi-webos-control</source>
  </extension>
</addon>
