<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="movies">
    <name>Epics</name>
    <match>all</match>
    <rule field="time" operator="greaterthan">
        <value>02:29:59</value>
    </rule>
    <rule field="playcount" operator="is">
        <value>0</value>
    </rule>
    <order direction="ascending">random</order>
</smartplaylist>
