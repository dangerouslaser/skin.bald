<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald slider popup (docs/SPEC.md 5, "Playback (proposed)"), used by the OSD settings' sliders (audio delay,
     subtitle delay, zoom and so on): an opaque field panel at the top centre with the name, the value and the
     settings slider (4 px track, 16 px nib, accent on focus). Started from Kodi 22 Estuary's DialogSlider.xml
     (GPL-2.0-or-later, see LICENSE-Estuary.txt). Kodi (CGUIDialogSlider) binds 10 (heading), 11 (slider) and
     12 (value); 13 and 14 are the mouse step buttons, kept with Estuary's actions. -->
<window>
	<!-- Parks the video OSD's auto-close while this dialog is open over it (Includes_Bald_OSD.xml). -->
	<include>Bald_OSDSuspendAutoClose</include>
	<defaultcontrol>11</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<depth>DepthOSD+</depth>
	<controls>
		<control type="group">
			<top>96</top>
			<centerleft>50%</centerleft>
			<width>840</width>
			<include>Bald_PlaybackPanel</include>
			<control type="label" id="10">
				<description>Dialog header</description>
				<left>40</left>
				<top>24</top>
				<width>520</width>
				<height>32</height>
				<aligny>center</aligny>
				<font>Bald_Section</font>
				<textcolor>bald_ink60</textcolor>
			</control>
			<control type="label" id="12">
				<description>Slider Value</description>
				<left>520</left>
				<top>24</top>
				<width>280</width>
				<height>32</height>
				<align>right</align>
				<aligny>center</aligny>
				<font>Bald_InfoMeta</font>
				<textcolor>bald_ink</textcolor>
			</control>
			<control type="slider" id="11">
				<description>Slider</description>
				<left>80</left>
				<top>88</top>
				<width>680</width>
				<height>16</height>
				<onup>11</onup>
				<ondown>11</ondown>
				<onleft>11</onleft>
				<onright>11</onright>
				<texturesliderbar border="8,0,8,0" colordiffuse="bald_ink28">bald/slider_bar.png</texturesliderbar>
				<texturesliderbardisabled border="8,0,8,0" colordiffuse="bald_ink10">bald/slider_bar.png</texturesliderbardisabled>
				<textureslidernib colordiffuse="bald_ink60">bald/slider_nib.png</textureslidernib>
				<textureslidernibfocus colordiffuse="bald_accent">bald/slider_nib.png</textureslidernibfocus>
				<textureslidernibdisabled colordiffuse="bald_ink28">bald/slider_nib.png</textureslidernibdisabled>
			</control>
			<control type="group">
				<visible>!System.GetBool(input.enablemouse)</visible>
				<control type="image">
					<left>40</left>
					<top>84</top>
					<width>24</width>
					<height>24</height>
					<texture flipx="true" colordiffuse="bald_ink45">bald/chevron.png</texture>
				</control>
				<control type="image">
					<left>776</left>
					<top>84</top>
					<width>24</width>
					<height>24</height>
					<texture colordiffuse="bald_ink45">bald/chevron.png</texture>
				</control>
			</control>
			<control type="group">
				<visible>System.GetBool(input.enablemouse)</visible>
				<control type="button" id="13">
					<left>40</left>
					<top>84</top>
					<width>24</width>
					<height>24</height>
					<label />
					<font>Bald_Hint</font>
					<onclick>SetFocus(11)</onclick>
					<onclick>Left</onclick>
					<onclick>SetFocus(13)</onclick>
					<texturefocus flipx="true" colordiffuse="bald_ink">bald/chevron.png</texturefocus>
					<texturenofocus flipx="true" colordiffuse="bald_ink45">bald/chevron.png</texturenofocus>
				</control>
				<control type="button" id="14">
					<left>776</left>
					<top>84</top>
					<width>24</width>
					<height>24</height>
					<label />
					<font>Bald_Hint</font>
					<onclick>SetFocus(11)</onclick>
					<onclick>Right</onclick>
					<onclick>SetFocus(14)</onclick>
					<texturefocus colordiffuse="bald_ink">bald/chevron.png</texturefocus>
					<texturenofocus colordiffuse="bald_ink45">bald/chevron.png</texturenofocus>
				</control>
			</control>
		</control>
	</controls>
</window>
