<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald layout constants: 1080i coordinates with a 96 px safe margin (CLAUDE.md). Loaded for every screen height,
     since Bald lays out in 1080i only (as is Constants.xml). Kodi substitutes a constant only
     when it is the whole value of a position or size tag and cannot do arithmetic, so offsets from these (a 12 px
     focus-ring inset, a width that ends on the right safe edge at x 1824) stay literal, and $PARAM values that an
     include negates (Bald_BackdropWindow's x and y) must stay numbers. -->
<includes>
	<!-- Left safe margin: page titles, lists, footers and hints start here. -->
	<constant name="Bald_SafeLeft">96</constant>
	<!-- Footer line: counters, page trail and navigation hints. -->
	<constant name="Bald_HintTop">954</constant>
	<!-- The player's hints: under the OSD buttons (y 872), which sit 36 px lower than the page layout. -->
	<constant name="Bald_OSDHintTop">990</constant>
	<!-- Right column: the Home menu, the options menus and the right-hand hints. -->
	<constant name="Bald_RightColumn">1440</constant>
	<!-- Library and Search preview column (528 wide, ending on the right safe edge) and the header meta above it. -->
	<constant name="Bald_PreviewLeft">1296</constant>
	<!-- Library and Search page title. -->
	<constant name="Bald_PageTitleTop">108</constant>
	<!-- Library and Search content: lists and the preview column. -->
	<constant name="Bald_ContentTop">222</constant>
	<!-- Low poster rail under a 1248 x 576 art frame: library views 515 and 523, and Home's poster rows. -->
	<constant name="Bald_LowRailTop">738</constant>
	<!-- Rating pill glyphs (Bald_RatingFrame), by pill height: 26 (captions, player) and 30 (information screens).
	     Glyph: its square size; Top: centred in the pill; Lead: the pill's left end, 8 px plus the glyph; Back: the
	     glyph's left, pulled back over that end. -->
	<constant name="Bald_RatingGlyph26">16</constant>
	<constant name="Bald_RatingGlyphTop26">5</constant>
	<constant name="Bald_RatingLead26">24</constant>
	<constant name="Bald_RatingGlyphBack26">-16</constant>
	<constant name="Bald_RatingGlyph30">18</constant>
	<constant name="Bald_RatingGlyphTop30">6</constant>
	<constant name="Bald_RatingLead30">26</constant>
	<constant name="Bald_RatingGlyphBack30">-18</constant>
</includes>
