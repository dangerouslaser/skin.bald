<?xml version="1.0" encoding="UTF-8"?>
<timers>
    <!-- Only an initial load handoff: page motion and per-item previews never depend on this slow timer. -->
    <timer>
        <name>bald_info_recommendations_ready</name>
        <start>Window.IsActive(movieinformation) + String.IsEqual(Window(home).Property(Bald.InfoSec),2) + Control.HasFocus(5150) + !String.IsEmpty(Window(movieinformation).Property(Bald.MorePath)) + Integer.IsGreater(Container(5100).NumItems,0)</start>
        <onstart>SetFocus(5100)</onstart>
        <stop>!Control.HasFocus(5150) | !Window.IsActive(movieinformation)</stop>
    </timer>
    <!-- Video OSD auto-close (Includes_Bald_OSD.xml, Bald_OSDAutoCloseArm): the OSD buttons run the alarm
         bald_osd_close, which only sets Bald.OSD.Close on Home; this closes the companion panels and the OSD. Replaces
         Estuary's autoclosevideoosd timer and its OSDAutoClose settings (migrated in Startup.xml). -->
    <timer>
        <name>bald_osd_close</name>
        <start>!String.IsEmpty(Window(home).Property(Bald.OSD.Close))</start>
        <onstart>ClearProperty(Bald.OSD.Close,home)</onstart>
        <onstart condition="Window.IsVisible(videoosd)">Dialog.Close(1120,true)</onstart>
        <onstart condition="Window.IsVisible(videoosd)">Dialog.Close(1121,true)</onstart>
        <onstart condition="Window.IsVisible(videoosd)">Dialog.Close(1122,true)</onstart>
        <onstart condition="Window.IsVisible(videoosd)">Dialog.Close(1123,true)</onstart>
        <onstart condition="Window.IsVisible(videoosd)">Dialog.Close(1124,true)</onstart>
        <onstart condition="Window.IsVisible(videoosd)">Dialog.Close(videoosd)</onstart>
        <stop>String.IsEmpty(Window(home).Property(Bald.OSD.Close))</stop>
    </timer>
    <!-- Bald skin timers run in CApplication::ProcessSlow, every 500 ms: fine for row start and idle, too coarse
         for anything that must follow item changes. -->
    <!-- Bald Home. Row start: a fixedlist first selects the item at its focus position (slot 2, or slot 5 on a poster
         row: item 6 at position 5; a landscape row's cursor never reaches position 5, so the two cannot be confused);
         once a row's items have loaded, move it back to the first item. One shot per window load; Home clears the flags in onload.
         Timers only for rows that can show before they are focused (the first rows, and each screen's first row in the menu
         preview) and the next two Home rows; every other row is moved by the row above it or on its own focus (Bald_Row). -->
    <timer>
        <name>bald_rowstart_9101</name>
        <start>Window.IsActive(home) + !Container(9101).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9101)) + [[String.IsEqual(Container(9101).CurrentItem,3) + String.IsEqual(Container(9101).Position,2)] | [String.IsEqual(Container(9101).CurrentItem,6) + String.IsEqual(Container(9101).Position,5)]]</start>
        <onstart>SetProperty(Bald.Start9101,1,home)</onstart>
        <onstart condition="String.IsEqual(Container(9101).Position,2)">Control.Move(9101,-2)</onstart>
        <onstart condition="String.IsEqual(Container(9101).Position,5)">Control.Move(9101,-5)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9101))</stop>
    </timer>
    <timer>
        <name>bald_rowstart_9102</name>
        <start>Window.IsActive(home) + !Container(9102).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9102)) + [[String.IsEqual(Container(9102).CurrentItem,3) + String.IsEqual(Container(9102).Position,2)] | [String.IsEqual(Container(9102).CurrentItem,6) + String.IsEqual(Container(9102).Position,5)]]</start>
        <onstart>SetProperty(Bald.Start9102,1,home)</onstart>
        <onstart condition="String.IsEqual(Container(9102).Position,2)">Control.Move(9102,-2)</onstart>
        <onstart condition="String.IsEqual(Container(9102).Position,5)">Control.Move(9102,-5)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9102))</stop>
    </timer>
    <timer>
        <name>bald_rowstart_9103</name>
        <start>Window.IsActive(home) + !Container(9103).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9103)) + [[String.IsEqual(Container(9103).CurrentItem,3) + String.IsEqual(Container(9103).Position,2)] | [String.IsEqual(Container(9103).CurrentItem,6) + String.IsEqual(Container(9103).Position,5)]]</start>
        <onstart>SetProperty(Bald.Start9103,1,home)</onstart>
        <onstart condition="String.IsEqual(Container(9103).Position,2)">Control.Move(9103,-2)</onstart>
        <onstart condition="String.IsEqual(Container(9103).Position,5)">Control.Move(9103,-5)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9103))</stop>
    </timer>
    <!-- The first Movies and TV Shows rows preview in the menu before they are ever focused. -->
    <timer>
        <name>bald_rowstart_9201</name>
        <start>Window.IsActive(home) + !Container(9201).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9201)) + [[String.IsEqual(Container(9201).CurrentItem,3) + String.IsEqual(Container(9201).Position,2)] | [String.IsEqual(Container(9201).CurrentItem,6) + String.IsEqual(Container(9201).Position,5)]]</start>
        <onstart>SetProperty(Bald.Start9201,1,home)</onstart>
        <onstart condition="String.IsEqual(Container(9201).Position,2)">Control.Move(9201,-2)</onstart>
        <onstart condition="String.IsEqual(Container(9201).Position,5)">Control.Move(9201,-5)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9201))</stop>
    </timer>
    <timer>
        <name>bald_rowstart_9301</name>
        <start>Window.IsActive(home) + !Container(9301).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9301)) + [[String.IsEqual(Container(9301).CurrentItem,3) + String.IsEqual(Container(9301).Position,2)] | [String.IsEqual(Container(9301).CurrentItem,6) + String.IsEqual(Container(9301).Position,5)]]</start>
        <onstart>SetProperty(Bald.Start9301,1,home)</onstart>
        <onstart condition="String.IsEqual(Container(9301).Position,2)">Control.Move(9301,-2)</onstart>
        <onstart condition="String.IsEqual(Container(9301).Position,5)">Control.Move(9301,-5)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9301))</stop>
    </timer>
    <!-- Bald startup splash (Home.xml, Includes_Bald_Home.xml Bald_Splash): lift it once every row has loaded (the
         9194 marker shows the Bald_RowsLoaded expression, which a timer condition cannot use) or the 10 s alarm Startup.xml set
         has run out, and not under a modal dialog (focus would go to the dialog). 9195 moves focus on to Home's usual
         first control. The rows' start timers above run behind the splash; idle and ambient wait for it. -->
    <timer>
        <name>bald_preload</name>
        <start>Window.IsActive(home) + !String.IsEmpty(Window(home).Property(Bald.Preload)) + !System.HasActiveModalDialog + [Control.IsVisible(9194) | !System.HasAlarm(bald_preload)]</start>
        <onstart>ClearProperty(Bald.Preload,home)</onstart>
        <onstart>CancelAlarm(bald_preload,silent)</onstart>
        <onstart>SetFocus(9195)</onstart>
        <stop>String.IsEmpty(Window(home).Property(Bald.Preload))</stop>
    </timer>
    <!-- Bald Home idle (60 s): close the menu and park focus on the wake button so the first key only wakes. -->
    <timer>
        <name>bald_idle</name>
        <start reset="true">Window.IsActive(home) + System.IdleTime(60) + !Control.HasFocus(9199) + String.IsEmpty(Window(home).Property(Bald.Preload))</start>
        <onstart>ClearProperty(Bald.Menu,home)</onstart>
        <onstart>SetFocus(9199)</onstart>
        <stop>!System.IdleTime(60) | Control.HasFocus(9199)</stop>
    </timer>
    <!-- Bald Home ambient: while idle, advance the current row every 8 s (Skin setting Bald.AmbientOff turns it off). -->
    <timer>
        <name>bald_ambient</name>
        <start reset="true">Window.IsActive(home) + System.IdleTime(60) + !Skin.HasSetting(Bald.AmbientOff) + String.IsEmpty(Window(home).Property(Bald.Preload))</start>
        <stop>Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(bald_ambient),8) | !System.IdleTime(60)</stop>
        <onstop condition="System.IdleTime(60) + !String.IsEmpty(Window(home).Property(Bald.Row))">Control.Move($INFO[Window(home).Property(Bald.Row)],1)</onstop>
    </timer>
</timers>
