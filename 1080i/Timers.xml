<?xml version="1.0" encoding="UTF-8"?>
<timers>
    <!-- Only an initial load handoff: page motion and per-item previews never depend on this slow timer. -->
    <timer>
        <name>bald_info_recommendations_ready</name>
        <start>Window.IsActive(movieinformation) + String.IsEqual(Window(home).Property(Bald.InfoSec),2) + Control.HasFocus(5150) + !String.IsEmpty(Window(movieinformation).Property(Bald.MorePath)) + Integer.IsGreater(Container(5100).NumItems,0)</start>
        <onstart>SetFocus(5100)</onstart>
        <stop>!Control.HasFocus(5150) | !Window.IsActive(movieinformation)</stop>
    </timer>
    <timer>
        <name>autoclosevideoosd</name>
        <description>Timer to auto close the video OSD (if enabled in the skin settings)</description>
        <start reset="true">Window.IsActive(videoosd) + Skin.HasSetting(OSDAutoClose) + !String.IsEqual(window(home).Property(settingsdialog_content),osd) + !Window.IsActive(osdsubtitlesettings) + !Window.IsActive(osdaudiosettings) + !Window.IsActive(osdvideosettings) + !Window.IsActive(OSDCMSSettings)</start>
        <reset>Window.IsActive(videoosd) + !System.IdleTime(1) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(autoclosevideoosd), 1) | String.IsEqual(window(home).Property(settingsdialog_content),osd) | Window.IsActive(osdsubtitlesettings) | Window.IsActive(osdaudiosettings) | Window.IsActive(osdvideosettings) | Window.IsActive(OSDCMSSettings)</reset>
        <stop>!Window.IsActive(videoosd) | String.IsEmpty(Skin.String(OSDAutoCloseTime)) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(autoclosevideoosd), 4) | !String.IsEmpty(Skin.String(OSDAutoCloseTime)) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(autoclosevideoosd),Skin.Numeric(OSDAutoCloseTime))</stop>
        <onstop>Dialog.Close(videoosd)</onstop>
    </timer>
    <timer>
        <name>1109_topbaroverlay</name>
        <description>A timer that is activated when the topbaroverlay is loaded and stops automatically after 5 seconds (or playback is resumed)</description>
        <start reset="true">[Window.IsActive(videoosd) | Window.IsActive(musicosd) | Window.IsActive(playerprocessinfo)] | [Window.IsActive(1109) + [Player.Seeking | Player.Forwarding | Player.Rewinding | Player.HasPerformedSeek(1)]]</start>
        <reset>Player.Seeking | Player.Forwarding | Player.Rewinding | Player.HasPerformedSeek(1)</reset>
        <stop>Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(1109_topbaroverlay),5) | Player.Playing</stop>
    </timer>
    <!-- Bald skin timers run in CApplication::ProcessSlow, every 500 ms: fine for row start and idle, too coarse
         for anything that must follow item changes. -->
    <!-- Bald Home. Row start: a fixedlist first selects the item at its focus position (slot 2);
         once a row's items have loaded, move it back to the first item. One shot per window load; Home clears the flags in onload.
         Timers only for rows that can show before they are focused (the first rows, and each screen's first row in the menu
         preview) and the next two Home rows; every other row is moved by the row above it or on its own focus (Bald_Row). -->
    <timer>
        <name>bald_rowstart_9101</name>
        <start>Window.IsActive(home) + !Container(9101).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9101)) + String.IsEqual(Container(9101).CurrentItem,3) + String.IsEqual(Container(9101).Position,2)</start>
        <onstart>SetProperty(Bald.Start9101,1,home)</onstart>
        <onstart>Control.Move(9101,-2)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9101))</stop>
    </timer>
    <timer>
        <name>bald_rowstart_9102</name>
        <start>Window.IsActive(home) + !Container(9102).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9102)) + String.IsEqual(Container(9102).CurrentItem,3) + String.IsEqual(Container(9102).Position,2)</start>
        <onstart>SetProperty(Bald.Start9102,1,home)</onstart>
        <onstart>Control.Move(9102,-2)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9102))</stop>
    </timer>
    <timer>
        <name>bald_rowstart_9103</name>
        <start>Window.IsActive(home) + !Container(9103).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9103)) + String.IsEqual(Container(9103).CurrentItem,3) + String.IsEqual(Container(9103).Position,2)</start>
        <onstart>SetProperty(Bald.Start9103,1,home)</onstart>
        <onstart>Control.Move(9103,-2)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9103))</stop>
    </timer>
    <!-- The first Movies and TV Shows rows preview in the menu before they are ever focused. -->
    <timer>
        <name>bald_rowstart_9201</name>
        <start>Window.IsActive(home) + !Container(9201).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9201)) + String.IsEqual(Container(9201).CurrentItem,3) + String.IsEqual(Container(9201).Position,2)</start>
        <onstart>SetProperty(Bald.Start9201,1,home)</onstart>
        <onstart>Control.Move(9201,-2)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9201))</stop>
    </timer>
    <timer>
        <name>bald_rowstart_9301</name>
        <start>Window.IsActive(home) + !Container(9301).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9301)) + String.IsEqual(Container(9301).CurrentItem,3) + String.IsEqual(Container(9301).Position,2)</start>
        <onstart>SetProperty(Bald.Start9301,1,home)</onstart>
        <onstart>Control.Move(9301,-2)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9301))</stop>
    </timer>
    <!-- Bald Home idle (60 s): close the menu and park focus on the wake button so the first key only wakes. -->
    <timer>
        <name>bald_idle</name>
        <start reset="true">Window.IsActive(home) + System.IdleTime(60) + !Control.HasFocus(9199)</start>
        <onstart>ClearProperty(Bald.Menu,home)</onstart>
        <onstart>SetFocus(9199)</onstart>
        <stop>!System.IdleTime(60) | Control.HasFocus(9199)</stop>
    </timer>
    <!-- Bald Home ambient: while idle, advance the current row every 8 s (Skin setting Bald.AmbientOff turns it off). -->
    <timer>
        <name>bald_ambient</name>
        <start reset="true">Window.IsActive(home) + System.IdleTime(60) + !Skin.HasSetting(Bald.AmbientOff)</start>
        <stop>Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(bald_ambient),8) | !System.IdleTime(60)</stop>
        <onstop condition="System.IdleTime(60)">Control.Move($INFO[Window(home).Property(Bald.Row)],1)</onstop>
    </timer>
</timers>
