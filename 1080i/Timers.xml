         the start condition never holds. -->
    <timer>
        <name>bald_rowstart_9201</name>
        <start>Window.IsActive(home) + !Container(9201).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9201)) + [[String.IsEqual(Container(9201).CurrentItem,3) + String.IsEqual(Container(9201).Position,2)] | [String.IsEqual(Container(9201).CurrentItem,6) + String.IsEqual(Container(9201).Position,5)]]</start>
        <onstart>SetProperty(Bald.Start9201,1,home)</onstart>
        <onstart condition="String.IsEqual(Container(9201).Position,2)">Control.Move(9201,-2)</onstart>
        <onstart condition="String.IsEqual(Container(9201).Position,5)">Control.Move(9201,-5)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9201))</stop>
    </timer>
    <timer>
        <name>bald_rowstart_9301</name>
        <start>Window.IsActive(home) + !Container(9301).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9301)) + [[String.IsEqual(Container(9301).CurrentItem,3) + String.IsEqual(Container(9301).Position,2)] | [String.IsEqual(Container(9301).CurrentItem,6) + String.IsEqual(Container(9301).Position,5)]]</start>
        <onstart>SetProperty(Bald.Start9301,1,home)</onstart>
        <onstart condition="String.IsEqual(Container(9301).Position,2)">Control.Move(9301,-2)</onstart>
        <onstart condition="String.IsEqual(Container(9301).Position,5)">Control.Move(9301,-5)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9301))</stop>
    </timer>
    <timer>
        <name>bald_rowstart_9401</name>
        <start>Window.IsActive(home) + !Container(9401).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9401)) + [[String.IsEqual(Container(9401).CurrentItem,3) + String.IsEqual(Container(9401).Position,2)] | [String.IsEqual(Container(9401).CurrentItem,6) + String.IsEqual(Container(9401).Position,5)]]</start>
        <onstart>SetProperty(Bald.Start9401,1,home)</onstart>
        <onstart condition="String.IsEqual(Container(9401).Position,2)">Control.Move(9401,-2)</onstart>
        <onstart condition="String.IsEqual(Container(9401).Position,5)">Control.Move(9401,-5)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9401))</stop>
    </timer>
    <timer>
        <name>bald_rowstart_9501</name>
        <start>Window.IsActive(home) + !Container(9501).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9501)) + [[String.IsEqual(Container(9501).CurrentItem,3) + String.IsEqual(Container(9501).Position,2)] | [String.IsEqual(Container(9501).CurrentItem,6) + String.IsEqual(Container(9501).Position,5)]]</start>
        <onstart>SetProperty(Bald.Start9501,1,home)</onstart>
        <onstart condition="String.IsEqual(Container(9501).Position,2)">Control.Move(9501,-2)</onstart>
        <onstart condition="String.IsEqual(Container(9501).Position,5)">Control.Move(9501,-5)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9501))</stop>
    </timer>
    <timer>
        <name>bald_rowstart_9601</name>
        <start>Window.IsActive(home) + !Container(9601).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9601)) + [[String.IsEqual(Container(9601).CurrentItem,3) + String.IsEqual(Container(9601).Position,2)] | [String.IsEqual(Container(9601).CurrentItem,6) + String.IsEqual(Container(9601).Position,5)]]</start>
        <onstart>SetProperty(Bald.Start9601,1,home)</onstart>
        <onstart condition="String.IsEqual(Container(9601).Position,2)">Control.Move(9601,-2)</onstart>
        <onstart condition="String.IsEqual(Container(9601).Position,5)">Control.Move(9601,-5)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9601))</stop>
    </timer>
    <timer>
        <name>bald_rowstart_9701</name>
        <start>Window.IsActive(home) + !Container(9701).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9701)) + [[String.IsEqual(Container(9701).CurrentItem,3) + String.IsEqual(Container(9701).Position,2)] | [String.IsEqual(Container(9701).CurrentItem,6) + String.IsEqual(Container(9701).Position,5)]]</start>
        <onstart>SetProperty(Bald.Start9701,1,home)</onstart>
        <onstart condition="String.IsEqual(Container(9701).Position,2)">Control.Move(9701,-2)</onstart>
        <onstart condition="String.IsEqual(Container(9701).Position,5)">Control.Move(9701,-5)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9701))</stop>
    </timer>
    <timer>
        <name>bald_rowstart_9801</name>
        <start>Window.IsActive(home) + !Container(9801).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9801)) + [[String.IsEqual(Container(9801).CurrentItem,3) + String.IsEqual(Container(9801).Position,2)] | [String.IsEqual(Container(9801).CurrentItem,6) + String.IsEqual(Container(9801).Position,5)]]</start>
        <onstart>SetProperty(Bald.Start9801,1,home)</onstart>
        <onstart condition="String.IsEqual(Container(9801).Position,2)">Control.Move(9801,-2)</onstart>
        <onstart condition="String.IsEqual(Container(9801).Position,5)">Control.Move(9801,-5)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9801))</stop>
    </timer>
    <timer>
        <name>bald_rowstart_9901</name>
        <start>Window.IsActive(home) + !Container(9901).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9901)) + [[String.IsEqual(Container(9901).CurrentItem,3) + String.IsEqual(Container(9901).Position,2)] | [String.IsEqual(Container(9901).CurrentItem,6) + String.IsEqual(Container(9901).Position,5)]]</start>
        <onstart>SetProperty(Bald.Start9901,1,home)</onstart>
        <onstart condition="String.IsEqual(Container(9901).Position,2)">Control.Move(9901,-2)</onstart>
        <onstart condition="String.IsEqual(Container(9901).Position,5)">Control.Move(9901,-5)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9901))</stop>
    </timer>
    <timer>
        <name>bald_rowstart_9051</name>
        <start>Window.IsActive(home) + !Container(9051).IsUpdating + String.IsEmpty(Window(home).Property(Bald.Start9051)) + [[String.IsEqual(Container(9051).CurrentItem,3) + String.IsEqual(Container(9051).Position,2)] | [String.IsEqual(Container(9051).CurrentItem,6) + String.IsEqual(Container(9051).Position,5)]]</start>
        <onstart>SetProperty(Bald.Start9051,1,home)</onstart>
        <onstart condition="String.IsEqual(Container(9051).Position,2)">Control.Move(9051,-2)</onstart>
        <onstart condition="String.IsEqual(Container(9051).Position,5)">Control.Move(9051,-5)</onstart>
        <stop>!String.IsEmpty(Window(home).Property(Bald.Start9051))</stop>
    </timer>
    <!-- Bald startup splash (Home.xml, Includes_Bald_Home.xml Bald_Splash): lift it once every row has loaded (the
         9194 marker shows the Bald_RowsLoaded expression, which a timer condition cannot use) or the 10 s alarm Startup.xml set
         has run out, and not under a modal dialog (focus would go to the dialog). 9195 moves focus on to Home's usual
         first control. The rows' start timers above run behind the splash; idle and ambient wait for it. -->
    <timer>
        <name>bald_preload</name>
        <start>Window.IsActive(home) + !String.IsEmpty(Window(home).Property(Bald.Preload)) + !System.HasActiveModalDialog + [Control.IsVisible(9194) | !System.HasAlarm(bald_preload)]</start>
        <onstart>ClearProperty(Bald.Preload,home)</onstart>
        <onstart>CancelAlarm(bald_preload,silent)</onstart>
        <onstart>SetFocus(9195)</onstart>
        <stop>String.IsEmpty(Window(home).Property(Bald.Preload))</stop>
    </timer>
    <!-- Bald Home idle (60 s): close the menu and park focus on the wake button so the first key only wakes. -->
    <timer>
        <name>bald_idle</name>
        <start reset="true">Window.IsActive(home) + System.IdleTime(60) + !Control.HasFocus(9199) + String.IsEmpty(Window(home).Property(Bald.Preload))</start>
        <onstart>ClearProperty(Bald.Menu,home)</onstart>
        <onstart>SetFocus(9199)</onstart>
        <stop>!System.IdleTime(60) | Control.HasFocus(9199)</stop>
    </timer>
    <!-- Bald Home ambient: while idle, advance the current row every 8 s (Skin setting Bald.AmbientOff turns it off). -->
    <timer>
        <name>bald_ambient</name>
        <start reset="true">Window.IsActive(home) + System.IdleTime(60) + !Skin.HasSetting(Bald.AmbientOff) + String.IsEmpty(Window(home).Property(Bald.Preload))</start>
        <stop>Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(bald_ambient),8) | !System.IdleTime(60)</stop>
        <onstop condition="System.IdleTime(60) + !String.IsEmpty(Window(home).Property(Bald.Row))">Control.Move($INFO[Window(home).Property(Bald.Row)],1)</onstop>
    </timer>
    <!-- Bald Helper (addons/script.bald.helper): while Appearance, Behavior, "Open TV shows on their info page" is on, its
         keymap maps Select in the video library (the <videos> section) to Skin.TimerStart(bald_library_select). With a
         library view container focused on a library TV show, Select opens the show's information (DialogVideoInfo,
         Bald's series page) instead of its seasons; anything else gets Select as usual. A timer, not a hidden button:
         SendClick never runs a skin button's onclick, and a focus bridge would replay the focused poster's pop (docs/NOTES.md,
         "Select on a TV show opens its info page"). Conditions are evaluated when the keymap starts the timer, before
         the actions run; the view ids are MyVideoNav's <views>. No start condition: only the keymap starts it. -->
    <timer>
        <name>bald_library_select</name>
        <onstart condition="Skin.HasSetting(Bald.ShowsOpenInfo) + Window.IsActive(videos) + [Control.HasFocus(510) | Control.HasFocus(511) | Control.HasFocus(512) | Control.HasFocus(513) | Control.HasFocus(514) | Control.HasFocus(515) | Control.HasFocus(520) | Control.HasFocus(521) | Control.HasFocus(522) | Control.HasFocus(523) | Control.HasFocus(530) | Control.HasFocus(531) | Control.HasFocus(532) | Control.HasFocus(540) | Control.HasFocus(541) | Control.HasFocus(542) | Control.HasFocus(504) | Control.HasFocus(50) | Control.HasFocus(51) | Control.HasFocus(52) | Control.HasFocus(53) | Control.HasFocus(54) | Control.HasFocus(55) | Control.HasFocus(500) | Control.HasFocus(501) | Control.HasFocus(502)] + String.IsEqual(ListItem.DBType,tvshow) + Integer.IsGreater(ListItem.DBID,0) + !ListItem.IsParentFolder">Action(Info)</onstart>
        <onstart condition="![Skin.HasSetting(Bald.ShowsOpenInfo) + Window.IsActive(videos) + [Control.HasFocus(510) | Control.HasFocus(511) | Control.HasFocus(512) | Control.HasFocus(513) | Control.HasFocus(514) | Control.HasFocus(515) | Control.HasFocus(520) | Control.HasFocus(521) | Control.HasFocus(522) | Control.HasFocus(523) | Control.HasFocus(530) | Control.HasFocus(531) | Control.HasFocus(532) | Control.HasFocus(540) | Control.HasFocus(541) | Control.HasFocus(542) | Control.HasFocus(504) | Control.HasFocus(50) | Control.HasFocus(51) | Control.HasFocus(52) | Control.HasFocus(53) | Control.HasFocus(54) | Control.HasFocus(55) | Control.HasFocus(500) | Control.HasFocus(501) | Control.HasFocus(502)] + String.IsEqual(ListItem.DBType,tvshow) + Integer.IsGreater(ListItem.DBID,0) + !ListItem.IsParentFolder]">Action(Select)</onstart>
        <stop>true</stop>
    </timer>
</timers>
