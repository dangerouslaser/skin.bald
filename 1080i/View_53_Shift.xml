<?xml version="1.0" encoding="UTF-8"?>
<!-- Started from Kodi 22's bundled Estuary (skin.estuary, GPL-2.0-or-later; see LICENSE-Estuary.txt).
     Bald: a poster rail under a large caption, with the preview art at the right. Rail tiles are the Bald wall's
     (192 x 288 posters, or labelled covers and icons kept whole). Id, viewtype, visibility, page control 5199 and
     navigation are Estuary's. -->
<includes>
	<include name="View_53_Shift">
		<control type="group">
			<visible>Control.IsVisible(53)</visible>
			<include>Bald_BrowseViewIn</include>
			<control type="group">
				<visible>!ListItem.IsParentFolder + !$EXP[Bald_BrowseMenuOpen]</visible>
				<include>Bald_BrowseFade</include>
				<control type="label">
					<left>Bald_SafeLeft</left><top>Bald_ContentTop</top><width>1140</width><height>90</height>
					<font>Bald_InfoTitle</font><textcolor>bald_ink</textcolor><label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>Bald_SafeLeft</left><top>320</top><width>1140</width><height>32</height>
					<font>Bald_InfoMeta</font><textcolor>bald_ink70</textcolor><label>$VAR[Bald_BrowseMeta]</label>
				</control>
				<control type="label">
					<left>Bald_SafeLeft</left><top>362</top><width>1140</width><height>26</height>
					<font>Bald_InfoGenre</font><textcolor>bald_accent</textcolor><label>$INFO[ListItem.Genre]</label>
				</control>
				<control type="textbox">
					<left>Bald_SafeLeft</left><top>400</top><width>1140</width><height>100</height>
					<font>Bald_CaptionPlot</font><textcolor>bald_ink80</textcolor><label>$VAR[Bald_BrowsePlot]</label>
					<autoscroll delay="10000" time="3000" repeat="10000">Skin.HasSetting(autoscroll) + !System.HasActiveModalDialog</autoscroll>
				</control>
			</control>
			<control type="list" id="53">
				<onfocus condition="Container.Content(tvshows)">Container.SetViewMode(520)</onfocus><onfocus condition="Container.Content(seasons)">Container.SetViewMode(530)</onfocus><onfocus condition="Container.Content(episodes)">Container.SetViewMode(540)</onfocus>
				<left>Bald_BrowseWallLeft</left>
				<top>534</top>
				<width>1152</width>
				<height>336</height>
				<orientation>horizontal</orientation>
				<scrolltime tween="cubic" easing="out">440</scrolltime>
				<preloaditems>3</preloaditems>
				<pagecontrol>5199</pagecontrol>
				<onleft>53</onleft>
				<onright>53</onright>
				<onup>9000</onup>
				<ondown>5199</ondown>
				<visible>Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(musicvideos) | Container.Content(artists) | Container.Content(albums) | Container.Content(mixed) | Container.Content(images) | Container.Content(videos) | Container.Content(games) | Container.Content(favourites) | $EXP[videoasset_true]</visible>
				<viewtype label="31100">icon</viewtype>
				<include>Bald_BrowseDim</include>
				<itemlayout width="216" height="312" condition="Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(games)">
					<include content="Bald_BrowseTile" />
				</itemlayout>
				<focusedlayout width="216" height="312" condition="Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(games)">
					<include content="Bald_BrowseTile"><param name="diffuse">bald_ink</param><param name="focused">Control.HasFocus(53)</param></include>
				</focusedlayout>
				<itemlayout width="216" height="312">
					<include content="Bald_BrowseTile">
						<param name="art">$VAR[Bald_BrowseIconArt]</param><param name="aspect">keep</param>
						<param name="height">192</param><param name="ring_height">198</param><param name="center">108,108</param>
						<param name="label_visible">true</param><param name="label_top">214</param>
					</include>
				</itemlayout>
				<focusedlayout width="216" height="312">
					<include content="Bald_BrowseTile">
						<param name="art">$VAR[Bald_BrowseIconArt]</param><param name="aspect">keep</param>
						<param name="height">192</param><param name="ring_height">198</param><param name="center">108,108</param>
						<param name="label_visible">true</param><param name="label_top">214</param>
						<param name="diffuse">bald_ink</param><param name="ink">bald_ink</param><param name="focused">Control.HasFocus(53)</param>
					</include>
				</focusedlayout>
			</control>
			<include content="Bald_BrowsePreview"><param name="show_caption">false</param></include>
		</control>
	</include>
</includes>
