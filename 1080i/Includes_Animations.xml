<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="Animation_FocusTextureFade">
		<animation effect="fade" start="0" end="100" time="200" tween="sine" easing="inout">Focus</animation>
		<animation effect="fade" start="100" end="0" time="0">UnFocus</animation>
	</include>
	<!-- Popup dialogs (select, confirm, sliders, subtitle search, the player controls and more): open with the pop
	     (back out) and a fade in, close with a fade only (docs/SPEC.md 4: fade = sine in-out, pop = back out).
	     Estuary's linear fade and back-in zoom on close are gone. -->
	<include name="Animation_DialogPopupOpenClose">
		<animation type="WindowOpen" condition="$EXP[Bald_FullMotion]" reversible="false">
			<effect type="zoom" start="80" end="100" center="50%,50%" delay="160" time="240" tween="back" easing="out" />
			<effect type="fade" start="0" end="100" delay="160" time="240" tween="sine" easing="inout" />
		</animation>
		<animation type="WindowOpen" condition="$EXP[Bald_ReduceMotion]" reversible="false">
			<effect type="fade" start="0" end="100" delay="160" time="240" tween="sine" easing="inout" />
		</animation>
		<animation type="WindowClose" reversible="false">
			<effect type="fade" start="100" end="0" time="160" tween="sine" easing="inout" />
		</animation>
		<depth>DepthDialog</depth>
	</include>
	<include name="Animation_DialogPopupVisible">
		<animation type="Visible" condition="$EXP[Bald_FullMotion]" reversible="false">
			<effect type="zoom" start="80" end="100" center="50%,50%" delay="160" time="240" tween="back" easing="out" />
			<effect type="fade" start="0" end="100" delay="160" time="240" tween="sine" easing="inout" />
		</animation>
		<animation type="Visible" condition="$EXP[Bald_ReduceMotion]" reversible="false">
			<effect type="fade" start="0" end="100" delay="160" time="240" tween="sine" easing="inout" />
		</animation>
		<animation type="Hidden" condition="$EXP[Bald_FullMotion]" reversible="false">
			<effect type="zoom" start="100" end="80" center="50%,50%" time="240" tween="cubic" easing="out" />
			<effect type="fade" start="100" end="0" time="240" tween="sine" easing="inout" />
		</animation>
		<animation type="Hidden" condition="$EXP[Bald_ReduceMotion]" reversible="false">
			<effect type="fade" start="100" end="0" time="240" tween="sine" easing="inout" />
		</animation>
	</include>
	<include name="Visible_Left">
		<animation type="Visible" condition="$EXP[Bald_FullMotion]" reversible="false">
			<effect type="fade" start="0" end="100" time="300" tween="sine" easing="inout" />
			<effect type="slide" start="-320" end="0" time="400" tween="cubic" easing="out" />
		</animation>
		<animation type="Visible" condition="$EXP[Bald_ReduceMotion]" reversible="false">
			<effect type="fade" start="0" end="100" time="300" tween="sine" easing="inout" />
		</animation>
		<animation type="Hidden" condition="$EXP[Bald_FullMotion]" reversible="false">
			<effect type="fade" start="100" end="0" time="300" tween="sine" easing="inout" />
			<effect type="slide" start="0" end="-320" time="300" tween="cubic" easing="out" />
		</animation>
		<animation type="Hidden" condition="$EXP[Bald_ReduceMotion]" reversible="false">
			<effect type="fade" start="100" end="0" time="300" tween="sine" easing="inout" />
		</animation>
	</include>
	<include name="OpenClose_Left">
		<animation type="WindowOpen" condition="$EXP[Bald_FullMotion]">
			<effect type="fade" start="0" end="100" time="300" tween="sine" easing="inout" />
			<effect type="slide" start="-320" end="0" time="400" tween="cubic" easing="out" />
		</animation>
		<animation type="WindowOpen" condition="$EXP[Bald_ReduceMotion]">
			<effect type="fade" start="0" end="100" time="300" tween="sine" easing="inout" />
		</animation>
		<animation type="WindowClose" condition="$EXP[Bald_FullMotion]">
			<effect type="fade" start="100" end="0" time="300" tween="sine" easing="inout" />
			<effect type="slide" start="0" end="-320" time="300" tween="cubic" easing="out" />
		</animation>
		<animation type="WindowClose" condition="$EXP[Bald_ReduceMotion]">
			<effect type="fade" start="100" end="0" time="300" tween="sine" easing="inout" />
		</animation>
	</include>
	<include name="OpenClose_Right">
		<animation type="WindowOpen" condition="$EXP[Bald_FullMotion]">
			<effect type="fade" start="0" end="100" time="300" tween="sine" easing="inout" />
			<effect type="slide" start="320" end="0" time="400" tween="cubic" easing="out" />
		</animation>
		<animation type="WindowOpen" condition="$EXP[Bald_ReduceMotion]">
			<effect type="fade" start="0" end="100" time="300" tween="sine" easing="inout" />
		</animation>
		<animation type="WindowClose" condition="$EXP[Bald_FullMotion]">
			<effect type="fade" start="100" end="0" time="300" tween="sine" easing="inout" />
			<effect type="slide" start="0" end="320" time="300" tween="cubic" easing="out" />
		</animation>
		<animation type="WindowClose" condition="$EXP[Bald_ReduceMotion]">
			<effect type="fade" start="100" end="0" time="300" tween="sine" easing="inout" />
		</animation>
	</include>
	<include name="Keyboard_Slide_Up">
		<animation type="WindowOpen" condition="$EXP[Bald_FullMotion]">
			<effect type="fade" start="0" end="100" time="300" tween="sine" easing="inout" />
			<effect type="slide" start="0,1080" end="0,0" time="400" tween="cubic" easing="out" />
		</animation>
		<animation type="WindowOpen" condition="$EXP[Bald_ReduceMotion]">
			<effect type="fade" start="0" end="100" time="300" tween="sine" easing="inout" />
		</animation>
		<animation type="WindowClose" condition="$EXP[Bald_FullMotion]">
			<effect type="fade" start="100" end="0" time="300" tween="sine" easing="inout" />
			<effect type="slide" start="0,0" end="0,1080" time="400" tween="cubic" easing="out" />
		</animation>
		<animation type="WindowClose" condition="$EXP[Bald_ReduceMotion]">
			<effect type="fade" start="100" end="0" time="300" tween="sine" easing="inout" />
		</animation>
	</include>
</includes>
