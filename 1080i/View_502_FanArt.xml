<?xml version="1.0" encoding="UTF-8"?>
<!-- Started from Kodi 22's bundled Estuary (skin.estuary, GPL-2.0-or-later; see LICENSE-Estuary.txt).
     Bald: the compact list over the focused item's full-bleed fanart, darkened toward the list with Bald's info
     scrims (field-coloured) so the art stays clear on the right, where the plot sits. Id 502, its viewtype and page
     control 502600 are Estuary's. -->
<includes>
	<include name="View_502_FanArt">
		<control type="group">
			<visible>Control.IsVisible(502)</visible>
			<include>Bald_BrowseViewIn</include>
			<control type="image">
				<width>1920</width><height>1080</height><aspectratio>scale</aspectratio><fadetime>700</fadetime>
				<texture background="true">$VAR[Bald_BrowseWideArt]</texture>
				<include>Bald_BrowseDim</include>
			</control>
			<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field">bald/scrim_info_h.png</texture></control>
			<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field">bald/scrim_info_b.png</texture></control>
			<include content="ListContainer">
				<param name="list_id" value="502" />
				<param name="width" value="900" />
				<param name="label_width" value="560" />
				<param name="label2_left" value="620" />
				<param name="state_left" value="780" />
				<param name="viewtype_label" value="$LOCALIZE[20445]" />
			</include>
			<control type="scrollbar" id="502600">
				<left>1012</left>
				<top>Bald_ContentTop</top>
				<width>4</width>
				<height>624</height>
				<onleft>502</onleft>
				<onright>502</onright>
				<include content="Bald_BrowseScrollbarStyle" />
			</control>
			<control type="group">
				<visible>!ListItem.IsParentFolder + !$EXP[Bald_BrowseMenuOpen]</visible>
				<include>Bald_BrowseFade</include>
				<control type="label">
					<left>Bald_PreviewLeft</left><top>600</top><width>528</width><height>28</height>
					<font>Bald_CaptionMeta</font><textcolor>bald_ink80</textcolor><label>$VAR[Bald_BrowseMeta]</label>
				</control>
				<control type="textbox">
					<left>Bald_PreviewLeft</left><top>640</top><width>528</width><height>240</height>
					<font>Bald_CaptionPlot</font><textcolor>bald_ink80</textcolor><label>$VAR[Bald_BrowsePlot]</label>
					<autoscroll time="3000" delay="7000" repeat="5000">!System.HasActiveModalDialog + Skin.HasSetting(Bald.ScrollPlots)</autoscroll>
				</control>
			</control>
		</control>
	</include>
</includes>
