			<control type="grouplist" id="9000">
				<left>900</left>
				<top>132</top>
				<width>260</width>
				<orientation>vertical</orientation>
				<onleft>10</onleft>
				<onright>10</onright>
				<ondown>12</ondown>
				<itemgap>dialogbuttons_itemgap</itemgap>
				<include content="DefaultDialogButton">
					<param name="id" value="11" />
					<param name="width" value="260" />
