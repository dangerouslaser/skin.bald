			<include content="Bald_MediaCaption">
				<param name="label">$LOCALIZE[1022]</param>
				<param name="top">420</param>
				<param name="width">1120</param>
			</include>
			<control type="edit" id="12">
				<description>Name Button</description>
				<left>40</left>
				<top>458</top>
				<width>1120</width>
				<height>72</height>
				<label></label>
				<onup>10</onup>
				<ondown>9001</ondown>
