		<include content="Bald_ConfigureButton"><param name="width">440</param></include>
		<invalidcolor>bald_ink45</invalidcolor>
		<alttexturefocus border="12,0,0,0" colordiffuse="bald_accent">bald/menu_dot.png</alttexturefocus>
		<alttexturenofocus />
	</include>
	<include name="PVRQuickNavItemsCommon">
		<param name="height">110</param>
		<definition>
			<control type="radiobutton" id="$PARAM[control_id]">
				<width>92</width>
				<height>92</height>
				<align>center</align>
				<aligny>center</aligny>
				<font></font>
				<texturefocus colordiffuse="bald_ink">bald/circle_112.png</texturefocus>
				<texturenofocus />
				<radioposx>26</radioposx>
				<radioposy>0</radioposy>
				<radiowidth>40</radiowidth>
				<radioheight>40</radioheight>
				<textureradioonfocus colordiffuse="bald_field">$PARAM[icon]</textureradioonfocus>
				<textureradioonnofocus colordiffuse="bald_ink70">$PARAM[icon]</textureradioonnofocus>
				<textureradioofffocus colordiffuse="bald_field">$PARAM[icon]</textureradioofffocus>
				<textureradiooffnofocus colordiffuse="bald_ink70">$PARAM[icon]</textureradiooffnofocus>
				<textureradiooffdisabled colordiffuse="bald_accent">$PARAM[icon]</textureradiooffdisabled>
				<onclick condition="String.IsEmpty(Window.Property(IsRadio))">ActivateWindow(TV$PARAM[area])</onclick>
				<onclick condition="!String.IsEmpty(Window.Property(IsRadio))">ActivateWindow(Radio$PARAM[area])</onclick>
				<enable>!Window.IsActive(TV$PARAM[area]) + !Window.IsActive(Radio$PARAM[area])</enable>
			</control>
		</definition>
	</include>
