				<onup>9000</onup>
				<onright>9000</onright>
				<ondown>14100</ondown>
				<onback>50</onback>
				<control type="group" id="60520">
					<height>50</height>
					<control type="label">
						<include>MediaMenuLabelCommon</include>
						<label>$LOCALIZE[31148]</label>
					</control>
					<control type="label">
						<width>440</width>
						<textoffsetx>20</textoffsetx>
						<textoffsety>15</textoffsety>
						<height>50</height>
