<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald components shared by Home, the info dialog and the library views.

     Item prefix. Includes that read an item take `container`, the text placed before ListItem: empty for the
     window's or layout's own item (ListItem.*), or "Container(511)." for a list's focused item
     (Container(511).ListItem.*). -->
<includes>
	<!-- ============ Shared conditions ============ -->
	<!-- Expression bodies are wrapped in [...] so a name negates and combines safely wherever it is used. -->
	<expression name="Bald_HasTMDbHelper">[System.HasAddon(plugin.video.themoviedb.helper)]</expression>
	<!-- Background video (Playback › Background video, on unless Bald.OSD.NoBackgroundVideo): while video plays behind
	     Bald's windows, it shows full screen and dimmed in place of the field and the blurred backdrop. Bald_Field is
	     the field that gives way to it; Bald_VideoBackdrop draws it (a window's first layer, or the curtain). -->
	<expression name="Bald_VideoBackdropOn">[Player.HasVideo + !Skin.HasSetting(Bald.OSD.NoBackgroundVideo)]</expression>
	<include name="Bald_VideoBackdrop">
		<control type="group">
			<visible>$EXP[Bald_VideoBackdropOn]</visible>
			<control type="videowindow"><width>1920</width><height>1080</height></control>
			<!-- Dim level: Skin.String(Bald.OSD.BackgroundVideoDim) 60, 70 or 90; anything else (empty) is 80, so an
			     unexpected value never leaves the video undimmed. -->
			<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_video_dim">bald/white.png</texture><visible>!Skin.String(Bald.OSD.BackgroundVideoDim,60) + !Skin.String(Bald.OSD.BackgroundVideoDim,70) + !Skin.String(Bald.OSD.BackgroundVideoDim,90)</visible></control>
			<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_video_dim60">bald/white.png</texture><visible>Skin.String(Bald.OSD.BackgroundVideoDim,60)</visible></control>
			<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_video_dim70">bald/white.png</texture><visible>Skin.String(Bald.OSD.BackgroundVideoDim,70)</visible></control>
			<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_video_dim90">bald/white.png</texture><visible>Skin.String(Bald.OSD.BackgroundVideoDim,90)</visible></control>
		</control>
	</include>
	<!-- Reduce motion (Appearance › Behavior, Bald.ReduceMotion, off by default): zooms and slides become plain fades,
	     for slower boxes. Every timed slide or zoom is gated on Bald_FullMotion; its twin under Bald_ReduceMotion keeps
	     only the fades, with the same timings, or, where the move holds a layout (poster rows, the info handoff, the OSD
	     rising for its panels, the playback speed marker), makes the move instantly. Kodi has no per-effect
	     conditions, so the twins are whole animations. Instant layout steps (time 0) and list scrolling stay. -->
	<expression name="Bald_FullMotion">[!Skin.HasSetting(Bald.ReduceMotion)]</expression>
	<expression name="Bald_ReduceMotion">[Skin.HasSetting(Bald.ReduceMotion)]</expression>
	<!-- Window changes fade without their move: over background video (a slide flashed the video undimmed) and under
	     Reduce motion. -->
	<expression name="Bald_FadeOnly">[$EXP[Bald_VideoBackdropOn] | $EXP[Bald_ReduceMotion]]</expression>
	<include name="Bald_Field">
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="bald_field">bald/white.png</texture>
			<visible>!$EXP[Bald_VideoBackdropOn]</visible>
		</control>
	</include>
	<!-- Idle (Appearance › Behavior, Skin.String(Bald.IdleTime)): how long Home and Now Playing wait untouched before
	     the idle state (Home closes its menu, parks focus on the wake button, expands its art frame over the rows,
	     Bald_IdleExpand, and, with Ambient movement on, advances the row; Now Playing dims). Empty is 1 minute (docs/SPEC.md 5.1), then 2, 5 or 10; "off"
	     never goes idle. Any other value counts as 1 minute. Timers.xml repeats these bodies literally ($EXP does not
	     trigger there; tests/test_idle.py keeps them equal). -->
	<expression name="Bald_IdleReached">[[System.IdleTime(60) + !Skin.String(Bald.IdleTime,2) + !Skin.String(Bald.IdleTime,5) + !Skin.String(Bald.IdleTime,10) + !Skin.String(Bald.IdleTime,off)] | [System.IdleTime(120) + Skin.String(Bald.IdleTime,2)] | [System.IdleTime(300) + Skin.String(Bald.IdleTime,5)] | [System.IdleTime(600) + Skin.String(Bald.IdleTime,10)]]</expression>
	<!-- The burn-in drift keeps its guard with idle off: it then starts after the default minute. -->
	<expression name="Bald_DriftIdle">[[[System.IdleTime(60) + !Skin.String(Bald.IdleTime,2) + !Skin.String(Bald.IdleTime,5) + !Skin.String(Bald.IdleTime,10) + !Skin.String(Bald.IdleTime,off)] | [System.IdleTime(120) + Skin.String(Bald.IdleTime,2)] | [System.IdleTime(300) + Skin.String(Bald.IdleTime,5)] | [System.IdleTime(600) + Skin.String(Bald.IdleTime,10)]] | [System.IdleTime(60) + Skin.String(Bald.IdleTime,off)]]</expression>
	<variable name="Bald_IdleTimeLabel">
		<value condition="Skin.String(Bald.IdleTime,off)">$LOCALIZE[351]</value>
		<value condition="Skin.String(Bald.IdleTime,2)">2 $LOCALIZE[31710]</value>
		<value condition="Skin.String(Bald.IdleTime,5)">5 $LOCALIZE[31710]</value>
		<value condition="Skin.String(Bald.IdleTime,10)">10 $LOCALIZE[31710]</value>
		<value>1 $LOCALIZE[31710]</value>
	</variable>
	<!-- Idle burn-in guard: while Home or Now Playing sits idle, the content steps round a small square (x, y px), one
	     corner every 3 minutes (Timers.xml bald_drift loops every 12 minutes). Each step is instant and the screen is
	     still in between, so Kodi redraws the whole screen once per step instead of every frame, as a continuous
	     pulsing drift made it. -->
	<expression name="Bald_DriftStep1">[Skin.TimerIsRunning(bald_drift) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(bald_drift),180) + Integer.IsLess(Skin.TimerElapsedSecs(bald_drift),360)]</expression>
	<expression name="Bald_DriftStep2">[Skin.TimerIsRunning(bald_drift) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(bald_drift),360) + Integer.IsLess(Skin.TimerElapsedSecs(bald_drift),540)]</expression>
	<expression name="Bald_DriftStep3">[Skin.TimerIsRunning(bald_drift) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(bald_drift),540)]</expression>
	<include name="Bald_IdleDrift">
		<param name="x">2</param>
		<param name="y">2</param>
		<definition>
			<animation type="Conditional" condition="$EXP[Bald_DriftStep1]"><effect type="slide" start="0,0" end="$PARAM[x],0" time="0" tween="cubic" easing="out" /></animation>
			<animation type="Conditional" condition="$EXP[Bald_DriftStep2]"><effect type="slide" start="0,0" end="$PARAM[x],$PARAM[y]" time="0" tween="cubic" easing="out" /></animation>
			<animation type="Conditional" condition="$EXP[Bald_DriftStep3]"><effect type="slide" start="0,0" end="0,$PARAM[y]" time="0" tween="cubic" easing="out" /></animation>
		</definition>
	</include>
	<!-- A window's base: the field, or the dimmed video behind it. -->
	<include name="Bald_WindowBase">
		<include>Bald_Field</include>
		<include>Bald_VideoBackdrop</include>
	</include>
	<!-- Bald Helper (addons/script.bald.helper) is installed and enabled: it blurs the backgrounds (Bald.Blur) and owns
	     Bald's keymaps. TMDb Helper's blur is the fallback without it. -->
	<expression name="Bald_HasHelper">[System.HasAddon(script.bald.helper) + System.AddonIsEnabled(script.bald.helper)]</expression>
	<!-- Bald Helper is running and serves the skin's latency-sensitive actions (its service sets the property once it
	     has loaded scripts/info.py and clears it when it stops). Call sites send NotifyAll(skin.bald,bald.<action>|...)
	     while this holds and RunScript(skin.bald,...) otherwise; see addons/script.bald.helper/resources/lib/actions.py. -->
	<expression name="Bald_HelperActions">[$EXP[Bald_HasHelper] + String.IsEqual(Window(home).Property(Bald.Helper.Actions),1)]</expression>

	<!-- ============ Following an item ============ -->
	<!-- The background follows the focused item of the container a window names in its Bald.FocusContainer property
	     (Bald Helper's blur, resources/lib/blur.py); with none, Bald Helper follows a media window's view or the info
	     dialog's own item. TMDb Helper follows the same container in its TMDbHelper.WidgetContainer, for its blur
	     without Bald Helper and for its online ratings (Includes_Bald_Ratings.xml) with or without it:
	       - Bald Helper absent: TMDb Helper blurs, so it must follow;
	       - Bald Helper present and online ratings on: TMDb Helper's ListItem monitor still publishes the ratings of
	         the item it follows (TMDbHelper.ListItem.*), so it must follow too (its blur is off, Home.xml);
	       - Bald Helper present and online ratings off: TMDb Helper has nothing to do, so it is not told.
	     Clears are unconditional. One include per event, as an include cannot choose its tag. -->
	<expression name="Bald_TMDbHelperFollows">[!$EXP[Bald_HasHelper] | $EXP[Bald_RatingsOnline]]</expression>
	<include name="Bald_FollowContainer">
		<param name="condition">true</param>
		<definition>
			<onfocus condition="$PARAM[condition]">SetProperty(Bald.FocusContainer,$PARAM[id],$PARAM[window])</onfocus>
			<onfocus condition="[$PARAM[condition]] + $EXP[Bald_TMDbHelperFollows]">SetProperty(TMDbHelper.WidgetContainer,$PARAM[id],$PARAM[window])</onfocus>
		</definition>
	</include>
	<include name="Bald_FollowContainerOnUp">
		<param name="condition">true</param>
		<definition>
			<onup condition="$PARAM[condition]">SetProperty(Bald.FocusContainer,$PARAM[id],$PARAM[window])</onup>
			<onup condition="[$PARAM[condition]] + $EXP[Bald_TMDbHelperFollows]">SetProperty(TMDbHelper.WidgetContainer,$PARAM[id],$PARAM[window])</onup>
		</definition>
	</include>
	<include name="Bald_FollowContainerOnDown">
		<param name="condition">true</param>
		<definition>
			<ondown condition="$PARAM[condition]">SetProperty(Bald.FocusContainer,$PARAM[id],$PARAM[window])</ondown>
			<ondown condition="[$PARAM[condition]] + $EXP[Bald_TMDbHelperFollows]">SetProperty(TMDbHelper.WidgetContainer,$PARAM[id],$PARAM[window])</ondown>
		</definition>
	</include>
	<include name="Bald_FollowContainerOnBack">
		<param name="condition">true</param>
		<definition>
			<onback condition="$PARAM[condition]">SetProperty(Bald.FocusContainer,$PARAM[id],$PARAM[window])</onback>
			<onback condition="[$PARAM[condition]] + $EXP[Bald_TMDbHelperFollows]">SetProperty(TMDbHelper.WidgetContainer,$PARAM[id],$PARAM[window])</onback>
		</definition>
	</include>
	<include name="Bald_FollowContainerOnLoad">
		<param name="condition">true</param>
		<definition>
			<onload condition="$PARAM[condition]">SetProperty(Bald.FocusContainer,$PARAM[id],$PARAM[window])</onload>
			<onload condition="[$PARAM[condition]] + $EXP[Bald_TMDbHelperFollows]">SetProperty(TMDbHelper.WidgetContainer,$PARAM[id],$PARAM[window])</onload>
		</definition>
	</include>
	<include name="Bald_UnfollowContainer">
		<param name="condition">true</param>
		<definition>
			<onunfocus condition="$PARAM[condition]">ClearProperty(Bald.FocusContainer,$PARAM[window])</onunfocus>
			<onunfocus condition="$PARAM[condition]">ClearProperty(TMDbHelper.WidgetContainer,$PARAM[window])</onunfocus>
		</definition>
	</include>
	<include name="Bald_UnfollowContainerOnFocus">
		<param name="condition">true</param>
		<definition>
			<onfocus condition="$PARAM[condition]">ClearProperty(Bald.FocusContainer,$PARAM[window])</onfocus>
			<onfocus condition="$PARAM[condition]">ClearProperty(TMDbHelper.WidgetContainer,$PARAM[window])</onfocus>
		</definition>
	</include>
	<include name="Bald_UnfollowContainerOnUp">
		<param name="condition">true</param>
		<definition>
			<onup condition="$PARAM[condition]">ClearProperty(Bald.FocusContainer,$PARAM[window])</onup>
			<onup condition="$PARAM[condition]">ClearProperty(TMDbHelper.WidgetContainer,$PARAM[window])</onup>
		</definition>
	</include>
	<include name="Bald_UnfollowContainerOnDown">
		<param name="condition">true</param>
		<definition>
			<ondown condition="$PARAM[condition]">ClearProperty(Bald.FocusContainer,$PARAM[window])</ondown>
			<ondown condition="$PARAM[condition]">ClearProperty(TMDbHelper.WidgetContainer,$PARAM[window])</ondown>
		</definition>
	</include>
	<include name="Bald_UnfollowContainerOnLoad">
		<param name="condition">true</param>
		<definition>
			<onload condition="$PARAM[condition]">ClearProperty(Bald.FocusContainer,$PARAM[window])</onload>
			<onload condition="$PARAM[condition]">ClearProperty(TMDbHelper.WidgetContainer,$PARAM[window])</onload>
		</definition>
	</include>
	<include name="Bald_UnfollowContainerOnUnload">
		<param name="condition">true</param>
		<definition>
			<onunload condition="$PARAM[condition]">ClearProperty(Bald.FocusContainer,$PARAM[window])</onunload>
			<onunload condition="$PARAM[condition]">ClearProperty(TMDbHelper.WidgetContainer,$PARAM[window])</onunload>
		</definition>
	</include>
	<expression name="Bald_ShowClearlogo">[!Skin.HasSetting(Bald.HideClearlogo)]</expression>
	<expression name="Bald_ShowMediaFlags">[!Skin.HasSetting(Bald.HideMediaFlags)]</expression>
	<!-- Watch-state marks (Appearance › Information): the watched check and the progress bar on TV episode cards and the
	     Resume / Watched note in list rows. Negative names, so unset shows them. -->
	<expression name="Bald_ShowWatchedMarks">[!Skin.HasSetting(Bald.HideWatchedMarks)]</expression>
	<expression name="Bald_ShowProgressMarks">[!Skin.HasSetting(Bald.HideProgressMarks)]</expression>
	<!-- Global Search's right-hand options menu has focus (script-globalsearch.xml sets it on its own window). -->
	<expression name="Bald_SearchMenuOpen">[!String.IsEmpty(Window.Property(Bald.SearchMenu))]</expression>

	<!-- ============ Clock ============ -->
	<!-- Appearance › Date & time. Skin.String(Bald.ClockFormat): empty follows Kodi's region (its time format decides
	     12 or 24 hours), 12 or 24 forces one. Kodi 22 has no format that forces a 24-hour hour: System.Time(hh) is the
	     region's hour (h in a 12-hour region), so Bald_Clock24 names the hour from the 24 one-hour System.Time(start,end)
	     ranges (minute of day, end exclusive; 23:00-00:00 wraps). System.Time(h) is always the 12-hour hour. -->
	<!-- The big clock (Home, the player's seek layer): hours and minutes, no AM or PM, as the region's hh:mm. -->
	<variable name="Bald_Clock">
		<value condition="String.IsEqual(Skin.String(Bald.ClockFormat),12)">$INFO[System.Time(h)]:$INFO[System.Time(mm)]</value>
		<value condition="String.IsEqual(Skin.String(Bald.ClockFormat),24)">$VAR[Bald_Clock24]</value>
		<value>$INFO[System.Time(hh:mm)]</value>
	</variable>
	<!-- The small clock in page headers (Live TV, the guide, the login screen): with AM or PM on a 12-hour clock
	     (Kodi's own 378 and 379, the words its region settings use), as the region's plain System.Time. -->
	<variable name="Bald_ClockTime">
		<value condition="String.IsEqual(Skin.String(Bald.ClockFormat),12) + System.Time(00:00,12:00)">$INFO[System.Time(h)]:$INFO[System.Time(mm)] $LOCALIZE[378]</value>
		<value condition="String.IsEqual(Skin.String(Bald.ClockFormat),12)">$INFO[System.Time(h)]:$INFO[System.Time(mm)] $LOCALIZE[379]</value>
		<value condition="String.IsEqual(Skin.String(Bald.ClockFormat),24)">$VAR[Bald_Clock24]</value>
		<value>$INFO[System.Time]</value>
	</variable>
	<variable name="Bald_ClockFormatLabel">
		<value condition="String.IsEqual(Skin.String(Bald.ClockFormat),12)">$LOCALIZE[12383]</value>
		<value condition="String.IsEqual(Skin.String(Bald.ClockFormat),24)">$LOCALIZE[12384]</value>
		<value>$LOCALIZE[14271]</value>
	</variable>
	<variable name="Bald_Clock24">
		<value condition="System.Time(00:00,01:00)">00:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(01:00,02:00)">01:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(02:00,03:00)">02:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(03:00,04:00)">03:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(04:00,05:00)">04:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(05:00,06:00)">05:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(06:00,07:00)">06:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(07:00,08:00)">07:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(08:00,09:00)">08:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(09:00,10:00)">09:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(10:00,11:00)">10:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(11:00,12:00)">11:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(12:00,13:00)">12:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(13:00,14:00)">13:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(14:00,15:00)">14:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(15:00,16:00)">15:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(16:00,17:00)">16:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(17:00,18:00)">17:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(18:00,19:00)">18:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(19:00,20:00)">19:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(20:00,21:00)">20:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(21:00,22:00)">21:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(22:00,23:00)">22:$INFO[System.Time(mm)]</value>
		<value condition="System.Time(23:00,00:00)">23:$INFO[System.Time(mm)]</value>
		<value>$INFO[System.Time(hh:mm)]</value>
	</variable>
	<!-- Headers that pair the date with the time: the date goes when Appearance turns the date off (Bald.HideClockDate). -->
	<variable name="Bald_ClockDateTime">
		<value condition="Skin.HasSetting(Bald.HideClockDate)">$VAR[Bald_ClockTime]</value>
		<value>$INFO[System.Date] · $VAR[Bald_ClockTime]</value>
	</variable>
	<expression name="Bald_ShowClockDate">[!Skin.HasSetting(Bald.HideClockDate)]</expression>
	<expression name="Bald_ShowHomeClock">[!Skin.HasSetting(Bald.HideHomeClock)]</expression>

	<!-- ============ Artwork fallbacks ============ -->
	<!-- Named by what they pick, suffixed with the container id when they read Container(id).ListItem.* (Kodi variables
	     take no params); the plain names read ListItem.*, so they follow the list layout or window that uses them. -->
	<!-- Landscape art: fanart, else the show's, else the thumb (not a hidden still, Includes_Bald_Spoilers.xml). Home row
	     tiles and the info dialog's own backdrop. -->
	<variable name="Bald_ItemFanart">
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
		<value condition="$EXP[Bald_SpoilerThumb]">$VAR[Bald_SpoilerArt]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<!-- Clearlogo, else the show's. -->
	<variable name="Bald_ItemLogo">
		<value condition="!String.IsEmpty(ListItem.Art(clearlogo))">$INFO[ListItem.Art(clearlogo)]</value>
		<value>$INFO[ListItem.Art(tvshow.clearlogo)]</value>
	</variable>
	<!-- Thumbnail-style landscape art (Home rows with the Thumbnail style): an episode's still (Bald_EpisodeThumb), else
	     the item's landscape art, else the fanart chain. A movie's thumb is usually its poster, so it is not used. -->
	<variable name="Bald_ItemThumbnail">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$VAR[Bald_EpisodeThumb]</value>
		<value condition="!String.IsEmpty(ListItem.Art(landscape)) + !$EXP[Bald_SpoilerThumb]">$INFO[ListItem.Art(landscape)]</value>
		<value>$VAR[Bald_ItemFanart]</value>
	</variable>
	<!-- Episode still: thumb, else fanart, else the show's fanart. The library's Bald_EpisodeThumb540/541/542 end on the
	     folder's Container.Art(tvshow.fanart) instead, which the TV info episode list does not have. A hidden still
	     (Includes_Bald_Spoilers.xml) is the show's art, under Bald_SpoilerStill. -->
	<variable name="Bald_EpisodeThumb">
		<value condition="$EXP[Bald_SpoilerThumb]">$VAR[Bald_SpoilerArt]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value>$INFO[ListItem.Art(tvshow.fanart)]</value>
	</variable>

	<!-- ============ Meta lines ============ -->
	<!-- One-line captions for the library views, as the <label> of the caller's label control. Home's caption and the
	     info dialog format their own lines (hours and minutes, season counts, the show title), see docs/NOTES.md. -->
	<!-- Movie: "2019 · 132 min · Drama". -->
	<include name="Bald_MetaLibraryMovie">
		<param name="container" />
		<definition>
			<label>$INFO[$PARAM[container]ListItem.Year]$INFO[$PARAM[container]ListItem.Duration(mins), · , $LOCALIZE[31710]]$INFO[$PARAM[container]ListItem.Genre, · ,]</label>
		</definition>
	</include>
	<!-- Episode: "S1 E2 · 2024-03-03 · 52 min". -->
	<include name="Bald_MetaLibraryEpisode">
		<param name="container" />
		<definition>
			<label>S$INFO[$PARAM[container]ListItem.Season] E$INFO[$PARAM[container]ListItem.Episode] · $INFO[$PARAM[container]ListItem.Premiered]$INFO[$PARAM[container]ListItem.Duration(mins), · , $LOCALIZE[31710]]</label>
		</definition>
	</include>

	<!-- ============ Media flags ============ -->
	<!-- One outlined media flag chip. Defaults are the caption chip (26 px, Bald_Flag); the info Overview passes
	     30 px and Bald_FlagL. -->
	<include name="Bald_FlagChip">
		<param name="label" />
		<param name="visible">true</param>
		<param name="height">26</param>
		<param name="font">Bald_Flag</param>
		<definition>
			<control type="button">
				<width>auto</width>
				<height>$PARAM[height]</height>
				<label>$PARAM[label]</label>
				<font>$PARAM[font]</font>
				<textoffsetx>10</textoffsetx>
				<aligny>center</aligny>
				<textcolor>bald_ink</textcolor>
				<disabledcolor>bald_ink</disabledcolor>
				<texturenofocus border="6" colordiffuse="bald_ink45">bald/chip.png</texturenofocus>
				<texturefocus border="6" colordiffuse="bald_ink45">bald/chip.png</texturefocus>
				<enable>false</enable>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<!-- The flag chips for one item, as children of the caller's horizontal grouplist (hidden chips take no space).
	     The <visible> applies to that grouplist: the Media flags setting hides every chip row. -->
	<include name="Bald_MediaFlags">
		<param name="container" />
		<param name="height">26</param>
		<param name="font">Bald_Flag</param>
		<definition>
			<visible>$EXP[Bald_ShowMediaFlags]</visible>
			<include content="Bald_FlagChip"><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param><param name="label">4K</param><param name="visible">String.IsEqual($PARAM[container]ListItem.VideoResolution,4K)</param></include>
			<include content="Bald_FlagChip"><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param><param name="label">1080p</param><param name="visible">String.IsEqual($PARAM[container]ListItem.VideoResolution,1080)</param></include>
			<include content="Bald_FlagChip"><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param><param name="label">Dolby Vision</param><param name="visible">String.IsEqual($PARAM[container]ListItem.HdrType,dolbyvision)</param></include>
			<include content="Bald_FlagChip"><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param><param name="label">HDR10</param><param name="visible">String.IsEqual($PARAM[container]ListItem.HdrType,hdr10)</param></include>
			<include content="Bald_FlagChip"><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param><param name="label">HDR10+</param><param name="visible">String.StartsWith($PARAM[container]ListItem.HdrType,hdr10) + !String.IsEqual($PARAM[container]ListItem.HdrType,hdr10)</param></include>
			<include content="Bald_FlagChip"><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param><param name="label">HLG</param><param name="visible">String.IsEqual($PARAM[container]ListItem.HdrType,hlg)</param></include>
			<include content="Bald_FlagChip"><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param><param name="label">$MAP[DefaultCodecMap, $PARAM[container]ListItem.AudioCodec]</param><param name="visible">!String.IsEmpty($PARAM[container]ListItem.AudioCodec)</param></include>
			<include content="Bald_FlagChip"><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param><param name="label">7.1</param><param name="visible">String.IsEqual($PARAM[container]ListItem.AudioChannels,8)</param></include>
			<include content="Bald_FlagChip"><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param><param name="label">5.1</param><param name="visible">String.IsEqual($PARAM[container]ListItem.AudioChannels,6)</param></include>
		</definition>
	</include>
	<!-- Moving between full windows (Home, the library, settings): only the content moves, the backgrounds stay still,
	     and Kodi finishes one window's close before the next opens, so nothing flashes. Leaving: 160 FADE and a 40 px
	     move over 180. Arriving: 380 FADE and a 40 px move over 480. Deeper moves right to left; back moves left to right.
	     back_in: the opening window is being returned to. back_out: the closing window is going back. -->
	<!-- The curtain (Custom_1129_BaldCurtain.xml) covers every change between two of Bald's full windows: Home, the
	     video and music libraries, the TV guide, Kodi's settings hub and pages, and Bald Settings and its pages.
	     Window.Next is only valid while windows change. Global Search is a script window and keeps its own transition. -->
	<expression name="Bald_CurtainWindow">[Window.IsActive(home) | Window.IsActive(videos) | Window.IsActive(music) | Window.IsActive(tvguide) | Window.IsActive(settings) | Window.IsActive(1115) | Window.IsActive(skinsettings) | Window.IsActive(1116) | Window.IsActive(1117) | Window.IsActive(1118) | Window.IsActive(1119) | Window.IsActive(profiles) | Window.IsActive(systeminfo) | Window.IsActive(systemsettings) | Window.IsActive(servicesettings) | Window.IsActive(pvrsettings) | Window.IsActive(playersettings) | Window.IsActive(mediasettings) | Window.IsActive(interfacesettings) | Window.IsActive(gamesettings) | Window.IsActive(appearancesettings)]</expression>
	<expression name="Bald_CurtainNext">[Window.Next(home) | Window.Next(videos) | Window.Next(music) | Window.Next(tvguide) | Window.Next(settings) | Window.Next(1115) | Window.Next(skinsettings) | Window.Next(1116) | Window.Next(1117) | Window.Next(1118) | Window.Next(1119) | Window.Next(profiles) | Window.Next(systeminfo) | Window.Next(systemsettings) | Window.Next(servicesettings) | Window.Next(pvrsettings) | Window.Next(playersettings) | Window.Next(mediasettings) | Window.Next(interfacesettings) | Window.Next(gamesettings) | Window.Next(appearancesettings)]</expression>
	<expression name="Bald_CurtainChange">[$EXP[Bald_CurtainWindow] + $EXP[Bald_CurtainNext]]</expression>
	<!-- Each curtain window lifts the curtain once it is drawn, and holds it up when it is left for another. -->
	<include name="Bald_CurtainHandoff">
		<onload>ClearProperty(Bald.Curtain,home)</onload>
		<onunload condition="$EXP[Bald_CurtainNext]">SetProperty(Bald.Curtain,1,home)</onunload>
		<!-- TMDb Helper's blur: the last one seen, for windows without one of their own (Bald_BlurImage). Bald Helper
		     keeps its own (Bald.Blur.Last). -->
		<onunload condition="!$EXP[Bald_HasHelper] + !String.IsEmpty(Window(home).Property(TMDbHelper.ListItem.BlurImage))">SetProperty(Bald.LastBlur,$ESCINFO[Window(home).Property(TMDbHelper.ListItem.BlurImage)],home)</onunload>
	</include>
	<include name="Bald_AnimWindowDepth">
		<param name="back_in">false</param>
		<param name="back_out">false</param>
		<definition>
			<!-- Not under the Home <-> library curtain (Custom_1129_BaldCurtain.xml): the window is already fully drawn
			     when the curtain fades away. The condition is read when the open is queued, before the onload clears it.
			     With background video (Bald_VideoBackdropOn) the slide is dropped and only the fade stays: a window that
			     vanished at once left frames with nothing drawn, which on CoreELEC show the video undimmed (a flash).
			     Reduce motion drops it the same way (Bald_FadeOnly). -->
			<animation type="WindowOpen" condition="![$PARAM[back_in]] + String.IsEmpty(Window(home).Property(Bald.Curtain)) + !$EXP[Bald_FadeOnly]">
				<effect type="fade" start="0" end="100" time="380" tween="sine" easing="inout" />
				<effect type="slide" start="40,0" end="0,0" time="480" tween="cubic" easing="out" />
			</animation>
			<animation type="WindowOpen" condition="$PARAM[back_in] + String.IsEmpty(Window(home).Property(Bald.Curtain)) + !$EXP[Bald_FadeOnly]">
				<effect type="fade" start="0" end="100" time="380" tween="sine" easing="inout" />
				<effect type="slide" start="-40,0" end="0,0" time="480" tween="cubic" easing="out" />
			</animation>
			<animation type="WindowClose" condition="![$PARAM[back_out]] + !$EXP[Bald_FadeOnly]">
				<effect type="fade" start="100" end="0" time="160" tween="sine" easing="inout" />
				<effect type="slide" start="0,0" end="-40,0" time="180" tween="cubic" easing="out" />
			</animation>
			<animation type="WindowClose" condition="$PARAM[back_out] + !$EXP[Bald_FadeOnly]">
				<effect type="fade" start="100" end="0" time="160" tween="sine" easing="inout" />
				<effect type="slide" start="0,0" end="40,0" time="180" tween="cubic" easing="out" />
			</animation>
			<animation type="WindowOpen" condition="String.IsEmpty(Window(home).Property(Bald.Curtain)) + $EXP[Bald_FadeOnly]">
				<effect type="fade" start="0" end="100" time="380" tween="sine" easing="inout" />
			</animation>
			<animation type="WindowClose" condition="$EXP[Bald_FadeOnly]">
				<effect type="fade" start="100" end="0" time="160" tween="sine" easing="inout" />
			</animation>
		</definition>
	</include>
</includes>
