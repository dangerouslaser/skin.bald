	<!-- Bald_ItemFanart (Includes_Bald_Common.xml) for whichever library view is showing (Container(0)), with the show
	     folder's fanart before the thumb so seasons and episodes without their own keep a backdrop. -->
	<variable name="Bald_LibraryFanart">
		<value condition="!String.IsEmpty(Container(0).ListItem.Art(fanart))">$INFO[Container(0).ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(Container(0).ListItem.Art(tvshow.fanart))">$INFO[Container(0).ListItem.Art(tvshow.fanart)]</value>
		<value condition="!String.IsEmpty(Container.Art(tvshow.fanart))">$INFO[Container.Art(tvshow.fanart)]</value>
		<value condition="$EXP[Bald_SpoilerThumb0]">$VAR[Bald_SpoilerArt0]</value>
		<value>$INFO[Container(0).ListItem.Art(thumb)]</value>
	</variable>
	<!-- Jellyfin for Kodi stores an episode's primary image as both its thumb and its poster, so a hidden still skips
	     the episode's own poster and icon (Includes_Bald_Spoilers.xml). -->
	<variable name="Bald_LibraryPoster">
		<value condition="!String.IsEmpty(ListItem.Art(poster)) + !$EXP[Bald_SpoilerThumb]">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(season.poster))">$INFO[ListItem.Art(season.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(Container.Art(tvshow.poster))">$INFO[Container.Art(tvshow.poster)]</value>
		<value condition="$EXP[Bald_SpoilerThumb]" />
		<value>$INFO[ListItem.Icon]</value>
	</variable>
	<include name="Bald_LibraryPosterItem">
