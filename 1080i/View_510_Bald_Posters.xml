<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald movie library: three large posters, selected artwork and the shared media caption. -->
<includes>
	<expression name="Bald_LibraryMenuOpen">Control.HasFocus(9150)</expression>
	<variable name="Bald_LibraryMenuNote">
		<value condition="String.IsEqual(Container(9150).ListItem.Property(option),view)">$INFO[Container.Viewmode,Current view: ,. Select to switch to the next library layout.]</value>
		<value condition="String.IsEqual(Container(9150).ListItem.Property(option),sort)">$INFO[Container.SortMethod,Currently sorted by ,. Choose how movies are arranged.]</value>
		<value condition="String.IsEqual(Container(9150).ListItem.Property(option),order)">$INFO[Container.SortOrder,Current order: ,. Select to reverse it.]</value>
		<value condition="String.IsEqual(Container(9150).ListItem.Property(option),watched)">$INFO[Control.GetLabel(10),Showing: ,. Cycle all movies, unwatched and watched.]</value>
		<value>$INFO[Container(9150).ListItem.Property(note)]</value>
	</variable>
	<include name="Bald_LibraryOptions">
		<control type="group">
			<visible>$EXP[Bald_LibraryMenuOpen]</visible><include>Bald_AnimMenuShows</include>
			<control type="label"><left>1322</left><top>292</top><width>502</width><height>30</height><font>Bald_CaptionMeta</font><textcolor>bald_ink60</textcolor><label>Library options</label></control>
			<include content="Bald_MenuNote"><param name="x">1322</param><param name="width">502</param><param name="text">$VAR[Bald_LibraryMenuNote]</param></include>
		</control>
		<control type="list" id="9150">
			<left>1296</left><top>392</top><width>528</width><height>310</height><orientation>vertical</orientation><scrolltime>0</scrolltime>
			<visible allowhiddenfocus="true">$EXP[Bald_LibraryMenuOpen]</visible><include>Bald_AnimMenuShows</include>
			<onleft>510</onleft><onback>510</onback><onright>noop</onright><onup>noop</onup><ondown>noop</ondown>
			<itemlayout width="528" height="62">
				<control type="label"><left>20</left><width>508</width><height>56</height><font>Bald_MenuItem</font><textcolor>bald_ink34</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label]</label></control>
			</itemlayout>
			<focusedlayout width="528" height="62">
				<control type="image"><top>23</top><width>10</width><height>10</height><texture colordiffuse="bald_accent">bald/dot.png</texture></control>
				<control type="label"><left>26</left><width>502</width><height>56</height><font>Bald_MenuItem</font><textcolor>bald_ink</textcolor><aligny>center</aligny><label>$INFO[ListItem.Label]</label>
					<animation type="Focus"><effect type="fade" start="34" end="100" time="240" tween="sine" easing="inout" /><effect type="slide" start="-6,0" end="0,0" time="320" tween="cubic" easing="out" /></animation>
				</control>
			</focusedlayout>
			<content>
				<item><label>View</label><property name="option">view</property><onclick>Container.NextViewMode</onclick><onclick>SetFocus(50)</onclick><visible>Integer.IsGreater(Container.ViewCount,1)</visible></item>
				<item><label>Sort by</label><property name="option">sort</property><onclick>SendClick(3)</onclick><visible>Control.IsEnabled(3)</visible></item>
				<item><label>Order</label><property name="option">order</property><onclick>SendClick(4)</onclick><visible>Control.IsEnabled(4)</visible></item>
				<item><label>Search</label><property name="note">Find a title in your video library.</property><onclick>SendClick(8)</onclick></item>
				<item><label>Filter</label><property name="note">Narrow the movies shown by genre, year, rating and other library details.</property><onclick>Filter</onclick><visible>Container.CanFilterAdvanced</visible></item>
				<item><label>Filter</label><property name="note">Narrow the movies shown by matching their titles.</property><onclick>SendClick(19)</onclick><visible>Container.CanFilter + !Container.CanFilterAdvanced</visible></item>
				<item><label>Watched status</label><property name="option">watched</property><onclick>SendClick(10)</onclick></item>
				<item><label>Update library</label><property name="note">Scan your configured video sources for new or changed items.</property><onclick>UpdateLibrary(video)</onclick><visible>!Library.IsScanningVideo</visible></item>
				<item><label>Stop update</label><property name="note">Stop the current video-library scan.</property><onclick>UpdateLibrary(video)</onclick><visible>Library.IsScanningVideo</visible></item>
			</content>
		</control>
	</include>
	<variable name="Bald_LibraryFanart">
		<value condition="!String.IsEmpty(Container(510).ListItem.Art(fanart))">$INFO[Container(510).ListItem.Art(fanart)]</value>
		<value>$INFO[Container(510).ListItem.Art(thumb)]</value>
	</variable>
	<variable name="Bald_LibraryPoster">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>
	<include name="Bald_LibraryPosterItem">
		<param name="diffuse">bald_ink55</param><param name="focused">false</param>
		<definition>
			<control type="group">
				<animation type="Focus"><effect type="zoom" start="100" end="102.5" center="192,282" time="280" tween="back" easing="out" /></animation>
				<control type="image"><left>12</left><top>12</top><width>360</width><height>540</height><texture colordiffuse="bald_placeholder">bald/white.png</texture></control>
				<control type="image"><left>12</left><top>12</top><width>360</width><height>540</height><aspectratio>scale</aspectratio><texture background="true" colordiffuse="$PARAM[diffuse]">$VAR[Bald_LibraryPoster]</texture></control>
				<control type="image"><left>9</left><top>9</top><width>366</width><height>546</height><texture border="8" colordiffuse="bald_ink">bald/focus_ring.png</texture><visible>$PARAM[focused]</visible></control>
			</control>
			<control type="label"><left>12</left><top>574</top><width>360</width><height>60</height><font>Bald_CaptionMeta</font><textcolor>bald_ink70</textcolor><wrapmultiline>true</wrapmultiline><aligny>top</aligny><label>$INFO[ListItem.Label]</label></control>
		</definition>
	</include>
	<include name="Bald_LibraryCaption">
		<param name="p" />
		<definition>
			<include content="Bald_Caption">
				<param name="c">510</param><param name="p">$PARAM[p]</param><param name="ignore_home_row">true</param>
				<param name="x">1276</param><param name="title_y">548</param><param name="title_height">88</param><param name="body_y">636</param><param name="width">528</param><param name="clip_width">568</param>
			</include>
		</definition>
	</include>
	<include name="Bald_LibraryArt">
		<param name="p" />
		<definition>
			<include content="Bald_ArtLayer"><param name="texture">$VAR[Bald_LibraryFanart]</param><param name="width">528</param><param name="height">297</param><param name="center">264,148.5</param><param name="visible">Integer.Is$PARAM[p](Container(510).CurrentItem)</param></include>
		</definition>
	</include>
	<include name="View_510_Bald_Posters">
		<control type="group">
			<visible>Control.IsVisible(510)</visible>
			<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field">bald/white.png</texture></control>
			<include>Bald_BackdropImage</include>
			<control type="label"><left>96</left><top>108</top><width>1100</width><height>52</height><font>Bald_CaptionTitle</font><textcolor>bald_ink</textcolor><label>Movies</label></control>
			<control type="label"><left>1296</left><top>120</top><width>528</width><height>28</height><align>right</align><font>Bald_CaptionMeta</font><textcolor>bald_ink60</textcolor><label>$INFO[Container.SortMethod] · $INFO[Container.SortOrder]</label></control>
			<control type="list" id="510">
				<left>84</left><top>210</top><width>1152</width><height>648</height>
				<orientation>horizontal</orientation><scrolltime tween="cubic" easing="out">440</scrolltime><preloaditems>3</preloaditems>
				<viewtype label="Bald posters">icon</viewtype><visible>Container.Content(movies)</visible>
				<onfocus>SetProperty(TMDbHelper.WidgetContainer,510,videos)</onfocus>
				<onunfocus>ClearProperty(TMDbHelper.WidgetContainer,videos)</onunfocus>
				<onup>9150</onup><ondown>noop</ondown><onleft>noop</onleft><onright>noop</onright>
				<animation effect="fade" start="100" end="72" time="180" tween="sine" easing="inout" condition="$EXP[Bald_LibraryMenuOpen]">Conditional</animation>
				<itemlayout width="384" height="648"><include>Bald_LibraryPosterItem</include></itemlayout>
				<focusedlayout width="384" height="648"><include content="Bald_LibraryPosterItem"><param name="diffuse">bald_ink</param><param name="focused">Control.HasFocus(510)</param></include></focusedlayout>
			</control>
			<control type="group">
				<visible>!$EXP[Bald_LibraryMenuOpen] + !Container(510).ListItem.IsParentFolder + !String.IsEmpty(Container(510).ListItem.Title)</visible>
				<animation type="Hidden"><effect type="fade" start="100" end="0" time="180" tween="sine" easing="inout" /></animation>
				<animation type="Visible"><effect type="fade" start="0" end="100" time="380" delay="140" tween="sine" easing="inout" /></animation>
				<control type="group"><left>1296</left><top>222</top>
					<control type="image"><width>528</width><height>297</height><texture colordiffuse="bald_placeholder">bald/white.png</texture></control>
					<include content="Bald_LibraryArt"><param name="p">Odd</param></include>
					<include content="Bald_LibraryArt"><param name="p">Even</param></include>
				</control>
				<control type="group">
					<visible>!$EXP[Bald_LibraryMenuOpen]</visible>
					<!-- Retain the caption while the parent completes its outgoing fade. -->
					<animation type="Hidden"><effect type="fade" start="100" end="100" time="180" tween="sine" easing="inout" /></animation>
					<animation type="Visible"><effect type="slide" start="40,0" end="0,0" time="480" delay="140" tween="cubic" easing="out" /></animation>
					<include content="Bald_LibraryCaption"><param name="p">Odd</param></include>
					<include content="Bald_LibraryCaption"><param name="p">Even</param></include>
				</control>
			</control>
			<!-- Keep masks opaque and fixed in screen space: fading their base and blur separately creates a dark border. -->
			<include content="Bald_BackdropWindow"><param name="x">1264</param><param name="y">198</param><param name="w">32</param><param name="h">345</param></include>
			<include content="Bald_BackdropWindow"><param name="x">1824</param><param name="y">198</param><param name="w">32</param><param name="h">345</param></include>
			<include content="Bald_BackdropWindow"><param name="x">1296</param><param name="y">198</param><param name="w">528</param><param name="h">24</param></include>
			<include content="Bald_BackdropWindow"><param name="x">1296</param><param name="y">519</param><param name="w">528</param><param name="h">24</param></include>
			<control type="label"><left>96</left><top>954</top><width>900</width><height>24</height><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$INFO[Container(510).CurrentItem] / $INFO[Container(510).NumItems]</label></control>
			<control type="group"><left>1000</left><top>954</top>
				<visible>!$EXP[Bald_LibraryMenuOpen]</visible>
				<include content="Bald_InfoHintPair"><param name="width">824</param><param name="first">Left / Right to browse</param><param name="second">Info for details</param><param name="third">Up for options</param><param name="third_visible">true</param></include>
			</control>
			<control type="group"><left>1296</left><top>954</top><visible>$EXP[Bald_LibraryMenuOpen]</visible>
				<include content="Bald_InfoHintPair"><param name="width">528</param><param name="first">Left / Back to browse</param><param name="second">Select to change</param></include>
			</control>
			<include>Bald_LibraryOptions</include>
		</control>
	</include>
</includes>
