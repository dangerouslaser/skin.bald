	<include name="Bald_LibraryPreview">
		<param name="c">510</param><param name="show_logo">false</param>
		<definition>
			<control type="group">
				<visible>!$EXP[Bald_LibraryMenuOpen] + !Container($PARAM[c]).ListItem.IsParentFolder + !String.IsEmpty(Container($PARAM[c]).ListItem.Title)</visible>
				<animation type="Hidden"><effect type="fade" start="100" end="0" time="180" tween="sine" easing="inout" /></animation>
				<animation type="Visible"><effect type="fade" start="0" end="100" time="380" delay="140" tween="sine" easing="inout" /></animation>
				<control type="group"><left>Bald_PreviewLeft</left><top>Bald_ContentTop</top>
					<control type="image"><width>528</width><height>297</height><texture colordiffuse="bald_placeholder">bald/white.png</texture></control>
					<include content="Bald_LibraryArt"><param name="c">$PARAM[c]</param><param name="p">Odd</param></include>
					<include content="Bald_LibraryArt"><param name="c">$PARAM[c]</param><param name="p">Even</param></include>
					<control type="group"><visible>$PARAM[show_logo]</visible>
						<control type="image"><width>528</width><height>297</height><texture>bald/scrim_logo.png</texture><visible>!String.IsEmpty(Container($PARAM[c]).ListItem.Art(clearlogo)) | !String.IsEmpty(Container($PARAM[c]).ListItem.Art(tvshow.clearlogo)) | !String.IsEmpty(Container.Art(tvshow.clearlogo))</visible></control>
						<include content="Bald_ArtLogo"><param name="c">$PARAM[c]</param><param name="p">Odd</param><param name="ignore_home_row">true</param><param name="x">28</param><param name="y">174</param><param name="width">300</param><param name="height">86</param></include>
						<include content="Bald_ArtLogo"><param name="c">$PARAM[c]</param><param name="p">Even</param><param name="ignore_home_row">true</param><param name="x">28</param><param name="y">174</param><param name="width">300</param><param name="height">86</param></include>
					</control>
				</control>
				<control type="group">
					<visible>!$EXP[Bald_LibraryMenuOpen]</visible>
					<!-- Retain the caption while the parent completes its outgoing fade. -->
					<animation type="Hidden"><effect type="fade" start="100" end="100" time="180" tween="sine" easing="inout" /></animation>
					<animation type="Visible" condition="$EXP[Bald_FullMotion]"><effect type="slide" start="40,0" end="0,0" time="480" delay="140" tween="cubic" easing="out" /></animation>
					<include content="Bald_LibraryCaption"><param name="c">$PARAM[c]</param><param name="p">Odd</param></include>
					<include content="Bald_LibraryCaption"><param name="c">$PARAM[c]</param><param name="p">Even</param></include>
				</control>
			</control>
			<!-- Keep masks opaque and fixed in screen space: fading their base and blur separately creates a dark border. -->
			<include content="Bald_BackdropWindow"><param name="x">1264</param><param name="y">198</param><param name="w">32</param><param name="h">345</param></include>
