<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald video OSD, details on the controls (docs/SPEC.md 5.16, "Video OSD"): the clearlogo or title, the info line
     and the plot at the top left while the OSD is up with "Details on the controls" on (Bald Settings, Playback), and
     always while the information button's panel (1120) is up. A modeless dialog with nothing to focus, shown by its
     visibility condition. The column is Bald_OSDInfoStack (Includes_Bald_OSD.xml) without the art and the times. -->
<window type="dialog" id="1128">
	<zorder>0</zorder>
	<visible>Window.IsVisible(1120) | [Window.IsVisible(videoosd) + Skin.HasSetting(Bald.OSD.DetailsOnControls)]</visible>
	<visible>!$EXP[Bald_OSDPanelUp] + !$EXP[Bald_OSDPVRPanelUp] + !Window.IsVisible(sliderdialog) + !Window.IsVisible(playerprocessinfo) + !Window.IsVisible(1124)</visible>
	<include>Bald_OSDAnimPanel</include>
	<controls>
		<include>Bald_OSDInfoScrim</include>
		<include content="Bald_OSDInfoStack">
			<param name="height">604</param>
			<param name="art">false</param>
			<param name="ends">false</param>
		</include>
	</controls>
</window>
