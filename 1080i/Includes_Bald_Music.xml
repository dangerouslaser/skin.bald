				<control type="label"><left>26</left><width>646</width><height>48</height><aligny>center</aligny><font>Bald_Section</font><textcolor>$PARAM[ink]</textcolor><scroll>$PARAM[scroll]</scroll><label>$INFO[ListItem.Label]</label></control>
				<control type="label"><left>696</left><width>320</width><height>48</height><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>$PARAM[meta]</textcolor><label>$INFO[ListItem.Artist]</label></control>
				<control type="label"><left>1030</left><width>110</width><height>48</height><align>right</align><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>$PARAM[meta]</textcolor><label>$INFO[ListItem.Year]</label></control>
			</control>
