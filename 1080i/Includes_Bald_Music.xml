		<definition>
			<control type="image"><left>26</left><top>8</top><width>72</width><height>72</height><texture colordiffuse="bald_placeholder">bald/white.png</texture></control>
			<control type="image"><left>26</left><top>8</top><width>72</width><height>72</height><aspectratio>scale</aspectratio><texture background="true" colordiffuse="$PARAM[diffuse]">$INFO[ListItem.Art(thumb)]</texture></control>
			<control type="label"><left>118</left><top>6</top><width>506</width><height>40</height><font>Bald_InfoTagline</font><textcolor>$PARAM[ink]</textcolor><scroll>$PARAM[scroll]</scroll><label>$INFO[ListItem.Label]</label></control>
			<control type="label"><left>118</left><top>48</top><width>506</width><height>28</height><font>Bald_CaptionMeta</font><textcolor>bald_ink60</textcolor><label>$INFO[ListItem.Artist]$INFO[ListItem.Year, · ,]</label><visible>Container.Content(albums)</visible></control>
			<control type="label"><left>118</left><top>48</top><width>506</width><height>28</height><font>Bald_CaptionMeta</font><textcolor>bald_ink60</textcolor><label>$INFO[ListItem.Genre]</label><visible>!Container.Content(albums)</visible></control>
		</definition>
