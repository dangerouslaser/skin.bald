				<control type="label"><left>1030</left><width>110</width><height>48</height><align>right</align><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>$PARAM[meta]</textcolor><label>$INFO[ListItem.Duration]</label></control>
