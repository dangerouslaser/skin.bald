				<control type="label"><left>880</left><width>260</width><height>48</height><align>right</align><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>$PARAM[meta]</textcolor><label>$INFO[ListItem.Label2]</label></control>
			</control>
		</definition>
	</include>
	<!-- Column headings over the compact list (y 180), for songs and albums. -->
	<include name="Bald_MusicCompactHeader">
		<control type="group"><left>Bald_SafeLeft</left><top>180</top><visible>Container.Content(songs)</visible>
			<control type="label"><left>26</left><width>64</width><height>28</height><align>right</align><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$LOCALIZE[554]</label></control>
			<control type="label"><left>112</left><width>560</width><height>28</height><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$LOCALIZE[556]</label></control>
			<control type="label"><left>696</left><width>320</width><height>28</height><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$LOCALIZE[557]</label></control>
			<control type="label"><left>1030</left><width>110</width><height>28</height><align>right</align><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$LOCALIZE[180]</label></control>
		</control>
		<control type="group"><left>Bald_SafeLeft</left><top>180</top><visible>Container.Content(albums)</visible>
			<control type="label"><left>26</left><width>646</width><height>28</height><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$LOCALIZE[558]</label></control>
			<control type="label"><left>696</left><width>320</width><height>28</height><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$LOCALIZE[557]</label></control>
			<control type="label"><left>1030</left><width>110</width><height>28</height><align>right</align><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$LOCALIZE[562]</label></control>
