				<control type="label"><left>112</left><width>560</width><height>48</height><aligny>center</aligny><font>Bald_Section</font><textcolor>$PARAM[ink]</textcolor><scroll>$PARAM[scroll]</scroll><label>$INFO[ListItem.Label]</label><visible>String.IsEmpty(ListItem.Title)</visible></control>
