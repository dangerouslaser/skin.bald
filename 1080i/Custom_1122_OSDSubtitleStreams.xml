<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald video OSD, subtitles: the subtitle streams (script.skinvariables get_player_streams); Select switches
     stream and turns subtitles on (set_player_subtitle); Select on the current one while they are on turns
     them off.
     A companion panel of the video OSD (docs/SPEC.md 5.16, "Video OSD"; Includes_Bald_OSD.xml): VideoOSD opens it when
     its button (70061) takes focus. The row is repeated with that button real and the others as stand-ins that
     close this panel and focus the OSD's own button, so Left and Right keep moving along the row. -->
<window type="dialog" id="1122">
	<defaultcontrol always="true">70061</defaultcontrol>
	<zorder>1</zorder>
	<depth>DepthOSD</depth>
	<controls>
		<include content="Bald_OSDStreamPanel">
			<param name="id">8120</param>
			<param name="button">70061</param>
			<param name="type">subtitle</param>
			<param name="method">set_player_subtitle</param>
			<param name="heading">$LOCALIZE[287]</param>
			<param name="current">!String.IsEmpty(ListItem.Property(iscurrent)) + VideoPlayer.SubtitlesEnabled</param>
			<param name="toggle">true</param>
		</include>
		<include content="Bald_OSDRow">
			<param name="owner">1122</param>
			<param name="play">Fake</param>
			<param name="back">Fake</param>
			<param name="forward">Fake</param>
			<param name="stop">Fake</param>
			<param name="menu">Fake</param>
			<param name="teletext">Fake</param>
			<param name="stereo">Fake</param>
			<param name="info">Fake</param>
			<param name="audio">Fake</param>
			<param name="subtitles">Panel</param>
			<param name="video">Fake</param>
		</include>
		<include>Bald_OSDHints</include>
	</controls>
</window>
