<?xml version="1.0" encoding="UTF-8"?>
<window type="window" id="1116">
	<defaultcontrol always="true">9100</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<!-- Home rebuilds its rows on its next load when this stamp changed (see Home.xml). -->
	<onunload>Skin.SetString(Bald.WidgetsStamp,$INFO[System.Date(yyyy-mm-dd)]_$INFO[System.Time(hh:mm:ss)])</onunload>
	<controls>
		<include content="Bald_SettingsFrame"><param name="title">$INFO[Window(home).Property(Bald.ConfigureLabel)] $LOCALIZE[31748]</param></include>
		<control type="list" id="9100">
			<!-- Widget names run longer than category names: the menu font would truncate them. -->
			<include content="Bald_SettingsCategories"><param name="id">9100</param><param name="right">9200</param><param name="font">Bald_InfoTagline</param></include>
			<!-- The rows of Home and Live TV are their own menus (homewidgets, livetvwidgets); a hub's rows are the "widgets"
			     of its entry in the hubs menu (Bald.ConfigureNode hubs, Bald.ConfigureItem its position, Bald.ConfigureMode
			     widgets). Home Screens (1117) sets all three. Actions address the focused row through $VAR[Bald_WidgetItemUrl],
			     not the row's own url (Skin Variables drops the node from it, see Includes_Bald_Configure.xml). -->
			<content>plugin://script.skinvariables/?info=get_shortcuts_node&amp;edit=true&amp;skin=skin.bald&amp;menu=$INFO[Window(home).Property(Bald.ConfigureNode)]$INFO[Window(home).Property(Bald.ConfigureItem),&amp;node=,]&amp;mode=$INFO[Window(home).Property(Bald.ConfigureMode)]$INFO[Window(Home).Property(SkinVariables.ShortcutsNode.Reload),&amp;reload=,]</content>
		</control>
		<include content="Bald_SettingsDetail">
			<param name="heading">$INFO[Container(9100).ListItem.Label]</param>
			<param name="note">$INFO[Container(9100).ListItem.Property(path)]</param>
			<control type="grouplist" id="9200">
				<include content="Bald_SettingsRows"><param name="left">9100</param></include>
				<control type="button" id="9201"><include>Bald_ConfigureButton</include><label>$LOCALIZE[31749]</label><onclick condition="!String.IsEmpty(Container(9100).ListItem.Property(item))">RunPlugin($VAR[Bald_WidgetItemUrl]&amp;func=do_choose&amp;&amp;use_rawpath::True&amp;&amp;limit::25&amp;&amp;secondary::0&amp;&amp;path2::)</onclick></control>
				<!-- The placeholder item of an empty list has only Choose content and Add widget. -->
				<control type="button" id="9202"><include>Bald_ConfigureButton</include><visible>String.IsEmpty(Container(9100).ListItem.Property(blank))</visible><label>$LOCALIZE[118]</label><onclick>RunPlugin($VAR[Bald_WidgetItemUrl]&amp;func=do_edit&amp;&amp;label)</onclick></control>
				<control type="button" id="9203"><include>Bald_ConfigureButton</include><visible>String.IsEmpty(Container(9100).ListItem.Property(blank))</visible><label>$LOCALIZE[31750]</label><label2>$INFO[Container(9100).ListItem.Property(limit)]</label2><onclick>RunPlugin($VAR[Bald_WidgetItemUrl]&amp;func=do_numeric&amp;&amp;limit)</onclick></control>
				<!-- Row style: a choice list from Skin Variables (do_edit key, label=value pairs, heading, use_prop_pairs).
				     Labels must not contain & = , or + (the plugin splits and unquotes them). -->
				<control type="button" id="9208"><include>Bald_ConfigureButton</include><visible>String.IsEmpty(Container(9100).ListItem.Property(blank))</visible><label>$LOCALIZE[31767]</label><label2>$VAR[Bald_WidgetStyleLabel]</label2><onclick>RunPlugin($VAR[Bald_WidgetItemUrl]&amp;func=do_edit&amp;&amp;style&amp;&amp;$LOCALIZE[31720]=fanart&amp;$LOCALIZE[31721]=thumbnail&amp;$LOCALIZE[31722]=logo&amp;$LOCALIZE[31723]=poster&amp;&amp;$LOCALIZE[31767]&amp;&amp;True)</onclick></control>
				<!-- The row's clearlogo on the big artwork (row field "logo", empty meaning on); the tile logo of the Fanart with
				     logo style is separate. Same do_edit choice list as Style. -->
				<control type="button" id="9209"><include>Bald_ConfigureButton</include><visible>String.IsEmpty(Container(9100).ListItem.Property(blank))</visible><label>$LOCALIZE[31768]</label><label2>$VAR[Bald_WidgetLogoLabel]</label2><onclick>RunPlugin($VAR[Bald_WidgetItemUrl]&amp;func=do_edit&amp;&amp;logo&amp;&amp;$LOCALIZE[31724]=on&amp;$LOCALIZE[31725]=off&amp;&amp;$LOCALIZE[31768]&amp;&amp;True)</onclick></control>
				<!-- Sort by and Order: the row's sortby / sortorder fields, written into its <content> by the generator
				     (shortcuts/generator/screen.xml content_sort). Default clears the field (null), so the path's own order
				     stays; Order only matters for a set method other than Random. -->
				<control type="button" id="9210"><include>Bald_ConfigureButton</include><visible>String.IsEmpty(Container(9100).ListItem.Property(blank))</visible><label>$LOCALIZE[581]</label><label2>$VAR[Bald_WidgetSortLabel]</label2><onclick>RunPlugin($VAR[Bald_WidgetItemUrl]&amp;func=do_edit&amp;&amp;sortby&amp;&amp;$LOCALIZE[571]=null&amp;$LOCALIZE[556]=title&amp;$LOCALIZE[562]=year&amp;$LOCALIZE[563]=rating&amp;$LOCALIZE[570]=dateadded&amp;$LOCALIZE[568]=lastplayed&amp;$LOCALIZE[567]=playcount&amp;$LOCALIZE[180]=time&amp;$LOCALIZE[590]=random&amp;&amp;$LOCALIZE[581]&amp;&amp;True)</onclick></control>
				<control type="button" id="9211"><include>Bald_ConfigureButton</include><visible>String.IsEmpty(Container(9100).ListItem.Property(blank)) + !String.IsEmpty(Container(9100).ListItem.Property(sortby)) + !String.IsEqual(Container(9100).ListItem.Property(sortby),random)</visible><label>$LOCALIZE[580]</label><label2>$VAR[Bald_WidgetOrderLabel]</label2><onclick>RunPlugin($VAR[Bald_WidgetItemUrl]&amp;func=do_edit&amp;&amp;sortorder&amp;&amp;$LOCALIZE[584]=ascending&amp;$LOCALIZE[585]=descending&amp;&amp;$LOCALIZE[580]&amp;&amp;True)</onclick></control>
				<control type="button" id="9204"><include>Bald_ConfigureButton</include><visible>String.IsEmpty(Container(9100).ListItem.Property(blank))</visible><label>$LOCALIZE[13332]</label><onclick>RunPlugin($VAR[Bald_WidgetItemUrl]&amp;func=do_move&amp;&amp;-1&amp;&amp;refocus::9100)</onclick></control>
				<control type="button" id="9205"><include>Bald_ConfigureButton</include><visible>String.IsEmpty(Container(9100).ListItem.Property(blank))</visible><label>$LOCALIZE[13333]</label><onclick>RunPlugin($VAR[Bald_WidgetItemUrl]&amp;func=do_move&amp;&amp;1&amp;&amp;refocus::9100)</onclick></control>
				<control type="button" id="9206"><include>Bald_ConfigureButton</include><label>$LOCALIZE[31751]</label><visible>Integer.IsLess(Container(9100).NumItems,20)</visible><onclick condition="!String.IsEmpty(Container(9100).ListItem.Property(item))">RunPlugin($VAR[Bald_WidgetItemUrl]&amp;func=do_new&amp;&amp;use_rawpath::True&amp;&amp;limit::25&amp;&amp;secondary::0&amp;&amp;path2::&amp;&amp;refocus::9100)</onclick></control>
				<!-- Home keeps at least one row; a hub or Live TV may have none (Skin Variables lists a placeholder "blank"
				     item for an empty list, which Choose content fills). -->
				<control type="button" id="9207"><include>Bald_ConfigureButton</include><label>$LOCALIZE[31752]</label><visible>[Integer.IsGreater(Container(9100).NumItems,1) | !String.IsEqual(Window(home).Property(Bald.ConfigureNode),homewidgets)] + String.IsEmpty(Container(9100).ListItem.Property(blank))</visible><onclick>RunPlugin($VAR[Bald_WidgetItemUrl]&amp;func=do_delete)</onclick></control>
			</control>
		</include>
		<include content="Bald_SettingsHints"><param name="first">$LOCALIZE[31753]</param><param name="second">$LOCALIZE[31754]</param></include>
	</controls>
</window>
