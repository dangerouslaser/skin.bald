<?xml version="1.0" encoding="UTF-8"?>
<window type="window" id="1116">
	<defaultcontrol always="true">9100</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<!-- Home rebuilds its rows on its next load when this stamp changed (see Home.xml). -->
	<onunload>Skin.SetString(Bald.WidgetsStamp,$INFO[System.Date(yyyy-mm-dd)]_$INFO[System.Time(hh:mm:ss)])</onunload>
	<controls>
		<include content="Bald_SettingsFrame"><param name="title">$INFO[Window(home).Property(Bald.ConfigureLabel)] $LOCALIZE[31748]</param></include>
		<control type="list" id="9100">
			<!-- Widget names run longer than category names: the menu font would truncate them. -->
			<include content="Bald_SettingsCategories"><param name="id">9100</param><param name="right">9200</param><param name="font">Bald_InfoTagline</param></include>
			<content>plugin://script.skinvariables/?info=get_shortcuts_node&amp;edit=true&amp;skin=skin.bald&amp;menu=$INFO[Window(home).Property(Bald.ConfigureNode)]&amp;mode=submenu$INFO[Window(Home).Property(SkinVariables.ShortcutsNode.Reload),&amp;reload=,]</content>
		</control>
		<include content="Bald_SettingsDetail">
			<param name="heading">$INFO[Container(9100).ListItem.Label]</param>
			<param name="note">$INFO[Container(9100).ListItem.Property(path)]</param>
			<control type="grouplist" id="9200">
				<include content="Bald_SettingsRows"><param name="left">9100</param></include>
				<control type="button" id="9201"><include>Bald_ConfigureButton</include><label>$LOCALIZE[31749]</label><onclick>RunPlugin($INFO[Container(9100).ListItem.Property(url),,&amp;func=do_choose&amp;&amp;use_rawpath::True&amp;&amp;limit::25&amp;&amp;secondary::0&amp;&amp;path2::])</onclick></control>
				<control type="button" id="9202"><include>Bald_ConfigureButton</include><label>$LOCALIZE[118]</label><onclick>RunPlugin($INFO[Container(9100).ListItem.Property(url)]&amp;func=do_edit&amp;&amp;label)</onclick></control>
				<control type="button" id="9203"><include>Bald_ConfigureButton</include><label>$LOCALIZE[31750]</label><label2>$INFO[Container(9100).ListItem.Property(limit)]</label2><onclick>RunPlugin($INFO[Container(9100).ListItem.Property(url)]&amp;func=do_numeric&amp;&amp;limit)</onclick></control>
				<control type="button" id="9204"><include>Bald_ConfigureButton</include><label>$LOCALIZE[13332]</label><onclick>RunPlugin($INFO[Container(9100).ListItem.Property(url)]&amp;func=do_move&amp;&amp;-1&amp;&amp;refocus::9100)</onclick></control>
				<control type="button" id="9205"><include>Bald_ConfigureButton</include><label>$LOCALIZE[13333]</label><onclick>RunPlugin($INFO[Container(9100).ListItem.Property(url)]&amp;func=do_move&amp;&amp;1&amp;&amp;refocus::9100)</onclick></control>
				<control type="button" id="9206"><include>Bald_ConfigureButton</include><label>$LOCALIZE[31751]</label><visible>Integer.IsLess(Container(9100).NumItems,20)</visible><onclick>RunPlugin($INFO[Container(9100).ListItem.Property(url),,&amp;func=do_new&amp;&amp;use_rawpath::True&amp;&amp;limit::25&amp;&amp;secondary::0&amp;&amp;path2::&amp;&amp;refocus::9100])</onclick></control>
				<control type="button" id="9207"><include>Bald_ConfigureButton</include><label>$LOCALIZE[31752]</label><visible>Integer.IsGreater(Container(9100).NumItems,1)</visible><onclick>RunPlugin($INFO[Container(9100).ListItem.Property(url)]&amp;func=do_delete)</onclick></control>
			</control>
		</include>
		<include content="Bald_SettingsHints"><param name="first">$LOCALIZE[31753]</param><param name="second">$LOCALIZE[31754]</param></include>
	</controls>
</window>
