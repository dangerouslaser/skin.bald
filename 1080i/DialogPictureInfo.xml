<?xml version="1.0" encoding="utf-8"?>
<!-- From Kodi 22 Estuary's DialogPictureInfo.xml (GPL-2.0-or-later, see LICENSE-Estuary.txt), restyled for Bald
     (docs/NOTES.md, "Media windows restyle"). Kodi binds 5 (the label / value list it fills with the picture's
     details); 9000 wraps it with its scrollbar 60. From the pictures window the picture sits sharp on the field at
     the left; over a running slideshow only the right column draws, on a right-hand field scrim. -->
<window>
	<depth>DepthOSD</depth>
	<defaultcontrol always="true">9000</defaultcontrol>
	<onload>SetProperty(infobackground,$ESCINFO[ListItem.FolderPath],home)</onload>
	<onunload>ClearProperty(infobackground,home)</onunload>
	<include>Bald_MediaOpenClose</include>
	<controls>
		<control type="group">
			<visible>!Window.IsActive(Slideshow)</visible>
			<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field">bald/white.png</texture></control>
			<control type="image">
				<left>Bald_SafeLeft</left>
				<top>Bald_PageTitleTop</top>
				<width>1136</width>
				<height>846</height>
				<aspectratio>keep</aspectratio>
				<fadetime>300</fadetime>
				<texture background="true">$INFO[ListItem.FolderPath]</texture>
			</control>
		</control>
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<texture flipx="true" colordiffuse="bald_field">bald/scrim_info_h.png</texture>
			<visible>Window.IsActive(Slideshow)</visible>
		</control>
		<control type="group">
			<left>Bald_PreviewLeft</left>
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="100" time="380" delay="120" tween="sine" easing="inout" />
				<effect type="slide" start="40,0" end="0,0" time="480" delay="120" tween="cubic" easing="out" />
			</animation>
			<control type="label">
				<top>Bald_PageTitleTop</top>
				<width>528</width>
				<height>40</height>
				<aligny>center</aligny>
				<font>Bald_InfoTagline</font>
				<textcolor>bald_ink</textcolor>
				<scroll>true</scroll>
				<label>$VAR[PictureInfoMainLabelVar]</label>
			</control>
			<control type="label">
				<top>152</top>
				<width>528</width>
				<height>30</height>
				<aligny>center</aligny>
				<font>Bald_InfoMeta</font>
				<textcolor>bald_ink70</textcolor>
				<label>$VAR[PictureInfoSubLabelVar]</label>
			</control>
			<control type="group" id="9000">
				<control type="list" id="5">
					<left>-20</left>
					<top>Bald_ContentTop</top>
					<width>528</width>
					<height>680</height>
					<orientation>vertical</orientation>
					<onleft>Dialog.Close(all,true)</onleft>
					<onleft>Action(left)</onleft>
					<onleft>info</onleft>
					<onright>Dialog.Close(all,true)</onright>
					<onright>Action(right)</onright>
					<onright>info</onright>
					<onup>5</onup>
					<ondown>5</ondown>
					<pagecontrol>60</pagecontrol>
					<scrolltime tween="cubic" easing="out">200</scrolltime>
					<include content="Bald_MediaDetailLayout">
						<param name="width">528</param>
					</include>
				</control>
				<control type="scrollbar" id="60">
					<left>524</left>
					<top>Bald_ContentTop</top>
					<height>680</height>
					<include>Bald_MediaScrollbarLook</include>
				</control>
			</control>
		</control>
		<control type="group">
			<left>Bald_RightColumn</left>
			<top>Bald_HintTop</top>
			<include content="Bald_InfoHintPair">
				<param name="first">$LOCALIZE[31966]</param>
				<param name="second">$LOCALIZE[31982]</param>
			</include>
		</control>
	</controls>
</window>
