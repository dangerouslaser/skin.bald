	<variable name="Bald_SpoilerArt8150">
		<value condition="!String.IsEmpty(Container(8150).ListItem.Art(tvshow.fanart))">$INFO[Container(8150).ListItem.Art(tvshow.fanart)]</value>
		<value condition="!String.IsEmpty(Container.Art(tvshow.fanart))">$INFO[Container.Art(tvshow.fanart)]</value>
		<value condition="String.IsEqual(Container(8150).ListItem.DBType,episode)">$INFO[Container(8150).ListItem.Art(fanart)]</value>
		<value />
	</variable>

	<!-- The note's text for a ListItem.* plot variable (Bald_SpoilerNote draws the same two lines as controls). -->
	<variable name="Bald_SpoilerNoteText">
		<value condition="ListItem.HasEpg">$LOCALIZE[31266]</value>
		<value>$LOCALIZE[31265]</value>
	</variable>

	<!-- ============ Controls ============ -->
	<!-- Visibility for a plot control and for the note that replaces it. `item` is the infolabel prefix. -->
	<include name="Bald_SpoilerPlotShown">
		<param name="item">ListItem.</param>
		<definition>
			<visible>![[[$EXP[Bald_SpoilerPlotsOn] + String.IsEqual($PARAM[item]DBType,episode) + !Integer.IsGreater($PARAM[item]PlayCount,0) + !$PARAM[item]IsResumable] | [$EXP[Bald_SpoilerMoviesOn] + String.IsEqual($PARAM[item]DBType,movie) + !Integer.IsGreater($PARAM[item]PlayCount,0) + !$PARAM[item]IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + [$PARAM[item]HasEpg | [String.StartsWith($PARAM[item]FileNameAndPath,pvr://recordings/) + !Integer.IsGreater($PARAM[item]PlayCount,0) + !$PARAM[item]IsResumable]]] | String.IsEqual($PARAM[item]Plot,$LOCALIZE[20370])]]</visible>
		</definition>
	</include>
	<include name="Bald_SpoilerPlotHidden">
		<param name="item">ListItem.</param>
		<definition>
			<visible>[[$EXP[Bald_SpoilerPlotsOn] + String.IsEqual($PARAM[item]DBType,episode) + !Integer.IsGreater($PARAM[item]PlayCount,0) + !$PARAM[item]IsResumable] | [$EXP[Bald_SpoilerMoviesOn] + String.IsEqual($PARAM[item]DBType,movie) + !Integer.IsGreater($PARAM[item]PlayCount,0) + !$PARAM[item]IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + [$PARAM[item]HasEpg | [String.StartsWith($PARAM[item]FileNameAndPath,pvr://recordings/) + !Integer.IsGreater($PARAM[item]PlayCount,0) + !$PARAM[item]IsResumable]]] | String.IsEqual($PARAM[item]Plot,$LOCALIZE[20370])]</visible>
		</definition>
	</include>
	<!-- The line in place of a hidden plot: "Plot hidden, not watched yet", or for a Live TV programme "Description
	     hidden to avoid spoilers". The caller gives geometry and font; its other children (animations) go inside. -->
	<include name="Bald_SpoilerNote">
		<param name="item">ListItem.</param>
		<param name="left">0</param>
		<param name="top">0</param>
		<param name="width">528</param>
		<param name="height">30</param>
		<param name="font">Bald_CaptionPlot</param>
		<param name="visible">true</param>
		<definition>
			<control type="label">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<aligny>top</aligny>
				<font>$PARAM[font]</font>
				<textcolor>bald_ink45</textcolor>
				<label>$LOCALIZE[31265]</label>
				<visible>[$PARAM[visible]] + !$PARAM[item]HasEpg</visible>
				<include content="Bald_SpoilerPlotHidden"><param name="item">$PARAM[item]</param></include>
				<nested />
			</control>
			<control type="label">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<aligny>top</aligny>
				<font>$PARAM[font]</font>
				<textcolor>bald_ink45</textcolor>
				<label>$LOCALIZE[31266]</label>
				<visible>[$PARAM[visible]] + $PARAM[item]HasEpg</visible>
				<include content="Bald_SpoilerPlotHidden"><param name="item">$PARAM[item]</param></include>
				<nested />
			</control>
		</definition>
	</include>
	<!-- Over a hidden still (the art under it is Bald_SpoilerArt*): Bald Helper's frosted copy of the still when it has
	     one, a veil of the field colour, and (unless `number` is false: cards that print it already) the episode's
	     number in the middle. Drawn right after the art, in the same box; `mask`
	     rounds the corners like the tile under it (empty for square frames), `diffuse` dims it like the art; the
	     caller's other children (animations) go on the group. The copy
	     crossfades (fadetime) when the helper switches its folder's spelling after new stills. -->
	<include name="Bald_SpoilerStill">
		<param name="item">ListItem.</param>
		<param name="x">0</param>
		<param name="y">0</param>
		<param name="w">176</param>
		<param name="h">99</param>
		<param name="mask">bald/tile.png</param>
		<param name="diffuse">bald_ink</param>
		<param name="font">Bald_Hint</param>
		<param name="number">true</param>
		<param name="visible">true</param>
		<definition>
			<control type="group">
				<left>$PARAM[x]</left>
				<top>$PARAM[y]</top>
				<visible>[$PARAM[visible]] + [[$EXP[Bald_SpoilerThumbsOn] + String.IsEqual($PARAM[item]DBType,episode) + !Integer.IsGreater($PARAM[item]PlayCount,0) + !$PARAM[item]IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + String.StartsWith($PARAM[item]FileNameAndPath,pvr://recordings/) + !Integer.IsGreater($PARAM[item]PlayCount,0) + !$PARAM[item]IsResumable]]</visible>
				<control type="image">
					<width>$PARAM[w]</width>
					<height>$PARAM[h]</height>
					<aspectratio scalediffuse="false">stretch</aspectratio>
					<fadetime>200</fadetime>
					<texture diffuse="$PARAM[mask]" colordiffuse="$PARAM[diffuse]" background="true">$INFO[Window(home).Property(Bald.Spoilers.Path)]$INFO[$PARAM[item]DBID,,.jpg]</texture>
					<visible>$EXP[Bald_SpoilerStills] + String.IsEqual($PARAM[item]DBType,episode) + !String.IsEmpty($PARAM[item]DBID)</visible>
				</control>
				<control type="image">
					<width>$PARAM[w]</width>
					<height>$PARAM[h]</height>
					<texture diffuse="$PARAM[mask]" colordiffuse="bald_field60">bald/white.png</texture>
				</control>
				<control type="label">
					<width>$PARAM[w]</width>
					<height>$PARAM[h]</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>$PARAM[font]</font>
					<textcolor>bald_ink80</textcolor>
					<label>$INFO[$PARAM[item]Season,S]$INFO[$PARAM[item]Episode, E]</label>
					<visible>$PARAM[number]</visible>
				</control>
				<nested />
			</control>
		</definition>
	</include>
	<!-- Bald_SpoilerStill over a square preview frame (the library's episode art, 540, 541 and 542), fading with the
	     item change, the number in the section font. -->
	<include name="Bald_SpoilerFrame">
		<param name="item" />
		<param name="w" />
		<param name="h" />
		<definition>
			<include content="Bald_SpoilerStill">
				<param name="item">$PARAM[item]</param>
				<param name="w">$PARAM[w]</param>
				<param name="h">$PARAM[h]</param>
				<param name="mask" />
				<param name="font">Bald_Section</param>
				<animation type="Visible"><effect type="fade" start="0" end="100" time="380" tween="sine" easing="inout" /></animation>
				<animation type="Hidden"><effect type="fade" start="100" end="0" time="180" tween="sine" easing="inout" /></animation>
			</include>
		</definition>
	</include>
</includes>
