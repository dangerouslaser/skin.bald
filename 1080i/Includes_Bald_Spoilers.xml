<?xml version="1.0" encoding="UTF-8"?>
<!-- Spoiler protection (Bald Settings, Appearance, Information, "Hide spoilers for unwatched items"): an unwatched
     episode's still and plot, optionally a movie's plot, and optionally Live TV's programme descriptions and images and
     unwatched recordings, are replaced by a frosted still and a quiet line. docs/NOTES.md, "Spoiler protection".

     Kodi 22 facts this file rests on (xbmc e513e0ff43, the build in /Applications/Kodi.app):
     - Kodi's own "Show information for unwatched items" (videolibrary.showunwatchedplots, a list of 0 movie plot,
       1 episode plot, 2 episode thumb; all three by default) replaces ListItem.Plot of a movie or episode with play
       count 0 by string 20370 "* Hidden to prevent spoilers *" in every window and container (CVideoGUIInfo), and
       the info dialog's plot too. It does not touch PlotOutline, VideoPlayer.Plot, PVR programmes or recordings.
     - Its thumb option only reaches skins through System.Setting(hideunwatchedepisodethumbs); Kodi never swaps
       ListItem.Art(thumb) itself (CFileItem::GetThumbHideIfUnwatched has no caller), Estuary's variables do.
     - A PVR programme has no play count; a recording has one (ListItem.PlayCount), and its path starts
       pvr://recordings/. ListItem.HasEpg is true for a channel with a programme, a programme and a timer.

     Bald's rule for "unwatched": play count 0 and no resume point. A partly watched item is shown as it is; Kodi's own
     option counts it as unwatched, and when Kodi hides a plot Bald shows its own line in its place.

     Item prefixes: Bald_SpoilerPlot<n> and Bald_SpoilerThumb<n> read Container(<n>).ListItem.* (no suffix:
     ListItem.*, which follows the list layout or window that uses it). The includes Bald_SpoilerPlotShown,
     Bald_SpoilerPlotHidden and Bald_SpoilerStill take any prefix as `item` and repeat the same conditions
     (tests/test_spoilers.py keeps them identical). -->
<includes>
	<!-- ============ Settings (Appearance > Information, Custom_1118_BaldAppearance.xml) ============
	     Opt-in: nothing changes until Bald.Spoilers is set. Under it, episode stills and plots are on (unset means on)
	     and movie plots and Live TV are off until asked for. Kodi's own episode thumb option also turns the stills on. -->
	<expression name="Bald_SpoilersOn">[Skin.HasSetting(Bald.Spoilers)]</expression>
	<expression name="Bald_SpoilerThumbsOn">[[Skin.HasSetting(Bald.Spoilers) + !Skin.HasSetting(Bald.Spoilers.ShowThumbs)] | System.Setting(hideunwatchedepisodethumbs)]</expression>
	<expression name="Bald_SpoilerPlotsOn">[Skin.HasSetting(Bald.Spoilers) + !Skin.HasSetting(Bald.Spoilers.ShowPlots)]</expression>
	<expression name="Bald_SpoilerMoviesOn">[Skin.HasSetting(Bald.Spoilers) + Skin.HasSetting(Bald.Spoilers.Movies)]</expression>
	<expression name="Bald_SpoilerLiveTVOn">[Skin.HasSetting(Bald.Spoilers) + Skin.HasSetting(Bald.Spoilers.LiveTV)]</expression>
	<!-- Bald Helper keeps frosted stills (addons/script.bald.helper/resources/lib/spoilers.py) and names their folder. -->
	<expression name="Bald_SpoilerStills">[$EXP[Bald_HasHelper] + !String.IsEmpty(Window(home).Property(Bald.Spoilers.Path))]</expression>
	<!-- A Live TV programme's own image (the channel's or guide's event icon) is hidden under the Live TV option. -->
	<expression name="Bald_SpoilerEpgArt">[$EXP[Bald_SpoilerLiveTVOn] + ListItem.HasEpg]</expression>

	<!-- ============ Per item ============ -->
	<expression name="Bald_SpoilerPlot">[[$EXP[Bald_SpoilerPlotsOn] + String.IsEqual(ListItem.DBType,episode) + !Integer.IsGreater(ListItem.PlayCount,0) + !ListItem.IsResumable] | [$EXP[Bald_SpoilerMoviesOn] + String.IsEqual(ListItem.DBType,movie) + !Integer.IsGreater(ListItem.PlayCount,0) + !ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + [ListItem.HasEpg | [String.StartsWith(ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(ListItem.PlayCount,0) + !ListItem.IsResumable]]] | String.IsEqual(ListItem.Plot,$LOCALIZE[20370])]</expression>
	<expression name="Bald_SpoilerThumb">[[$EXP[Bald_SpoilerThumbsOn] + String.IsEqual(ListItem.DBType,episode) + !Integer.IsGreater(ListItem.PlayCount,0) + !ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + String.StartsWith(ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(ListItem.PlayCount,0) + !ListItem.IsResumable]]</expression>
	<expression name="Bald_SpoilerPlot0">[[$EXP[Bald_SpoilerPlotsOn] + String.IsEqual(Container(0).ListItem.DBType,episode) + !Integer.IsGreater(Container(0).ListItem.PlayCount,0) + !Container(0).ListItem.IsResumable] | [$EXP[Bald_SpoilerMoviesOn] + String.IsEqual(Container(0).ListItem.DBType,movie) + !Integer.IsGreater(Container(0).ListItem.PlayCount,0) + !Container(0).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + [Container(0).ListItem.HasEpg | [String.StartsWith(Container(0).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(0).ListItem.PlayCount,0) + !Container(0).ListItem.IsResumable]]] | String.IsEqual(Container(0).ListItem.Plot,$LOCALIZE[20370])]</expression>
	<expression name="Bald_SpoilerThumb0">[[$EXP[Bald_SpoilerThumbsOn] + String.IsEqual(Container(0).ListItem.DBType,episode) + !Integer.IsGreater(Container(0).ListItem.PlayCount,0) + !Container(0).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + String.StartsWith(Container(0).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(0).ListItem.PlayCount,0) + !Container(0).ListItem.IsResumable]]</expression>
	<expression name="Bald_SpoilerPlot540">[[$EXP[Bald_SpoilerPlotsOn] + String.IsEqual(Container(540).ListItem.DBType,episode) + !Integer.IsGreater(Container(540).ListItem.PlayCount,0) + !Container(540).ListItem.IsResumable] | [$EXP[Bald_SpoilerMoviesOn] + String.IsEqual(Container(540).ListItem.DBType,movie) + !Integer.IsGreater(Container(540).ListItem.PlayCount,0) + !Container(540).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + [Container(540).ListItem.HasEpg | [String.StartsWith(Container(540).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(540).ListItem.PlayCount,0) + !Container(540).ListItem.IsResumable]]] | String.IsEqual(Container(540).ListItem.Plot,$LOCALIZE[20370])]</expression>
	<expression name="Bald_SpoilerThumb540">[[$EXP[Bald_SpoilerThumbsOn] + String.IsEqual(Container(540).ListItem.DBType,episode) + !Integer.IsGreater(Container(540).ListItem.PlayCount,0) + !Container(540).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + String.StartsWith(Container(540).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(540).ListItem.PlayCount,0) + !Container(540).ListItem.IsResumable]]</expression>
	<expression name="Bald_SpoilerPlot541">[[$EXP[Bald_SpoilerPlotsOn] + String.IsEqual(Container(541).ListItem.DBType,episode) + !Integer.IsGreater(Container(541).ListItem.PlayCount,0) + !Container(541).ListItem.IsResumable] | [$EXP[Bald_SpoilerMoviesOn] + String.IsEqual(Container(541).ListItem.DBType,movie) + !Integer.IsGreater(Container(541).ListItem.PlayCount,0) + !Container(541).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + [Container(541).ListItem.HasEpg | [String.StartsWith(Container(541).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(541).ListItem.PlayCount,0) + !Container(541).ListItem.IsResumable]]] | String.IsEqual(Container(541).ListItem.Plot,$LOCALIZE[20370])]</expression>
	<expression name="Bald_SpoilerThumb541">[[$EXP[Bald_SpoilerThumbsOn] + String.IsEqual(Container(541).ListItem.DBType,episode) + !Integer.IsGreater(Container(541).ListItem.PlayCount,0) + !Container(541).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + String.StartsWith(Container(541).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(541).ListItem.PlayCount,0) + !Container(541).ListItem.IsResumable]]</expression>
	<expression name="Bald_SpoilerPlot542">[[$EXP[Bald_SpoilerPlotsOn] + String.IsEqual(Container(542).ListItem.DBType,episode) + !Integer.IsGreater(Container(542).ListItem.PlayCount,0) + !Container(542).ListItem.IsResumable] | [$EXP[Bald_SpoilerMoviesOn] + String.IsEqual(Container(542).ListItem.DBType,movie) + !Integer.IsGreater(Container(542).ListItem.PlayCount,0) + !Container(542).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + [Container(542).ListItem.HasEpg | [String.StartsWith(Container(542).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(542).ListItem.PlayCount,0) + !Container(542).ListItem.IsResumable]]] | String.IsEqual(Container(542).ListItem.Plot,$LOCALIZE[20370])]</expression>
	<expression name="Bald_SpoilerThumb542">[[$EXP[Bald_SpoilerThumbsOn] + String.IsEqual(Container(542).ListItem.DBType,episode) + !Integer.IsGreater(Container(542).ListItem.PlayCount,0) + !Container(542).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + String.StartsWith(Container(542).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(542).ListItem.PlayCount,0) + !Container(542).ListItem.IsResumable]]</expression>
	<expression name="Bald_SpoilerPlot50">[[$EXP[Bald_SpoilerPlotsOn] + String.IsEqual(Container(50).ListItem.DBType,episode) + !Integer.IsGreater(Container(50).ListItem.PlayCount,0) + !Container(50).ListItem.IsResumable] | [$EXP[Bald_SpoilerMoviesOn] + String.IsEqual(Container(50).ListItem.DBType,movie) + !Integer.IsGreater(Container(50).ListItem.PlayCount,0) + !Container(50).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + [Container(50).ListItem.HasEpg | [String.StartsWith(Container(50).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(50).ListItem.PlayCount,0) + !Container(50).ListItem.IsResumable]]] | String.IsEqual(Container(50).ListItem.Plot,$LOCALIZE[20370])]</expression>
	<expression name="Bald_SpoilerThumb50">[[$EXP[Bald_SpoilerThumbsOn] + String.IsEqual(Container(50).ListItem.DBType,episode) + !Integer.IsGreater(Container(50).ListItem.PlayCount,0) + !Container(50).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + String.StartsWith(Container(50).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(50).ListItem.PlayCount,0) + !Container(50).ListItem.IsResumable]]</expression>
	<expression name="Bald_SpoilerPlot5100">[[$EXP[Bald_SpoilerPlotsOn] + String.IsEqual(Container(5100).ListItem.DBType,episode) + !Integer.IsGreater(Container(5100).ListItem.PlayCount,0) + !Container(5100).ListItem.IsResumable] | [$EXP[Bald_SpoilerMoviesOn] + String.IsEqual(Container(5100).ListItem.DBType,movie) + !Integer.IsGreater(Container(5100).ListItem.PlayCount,0) + !Container(5100).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + [Container(5100).ListItem.HasEpg | [String.StartsWith(Container(5100).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(5100).ListItem.PlayCount,0) + !Container(5100).ListItem.IsResumable]]] | String.IsEqual(Container(5100).ListItem.Plot,$LOCALIZE[20370])]</expression>
	<expression name="Bald_SpoilerThumb5100">[[$EXP[Bald_SpoilerThumbsOn] + String.IsEqual(Container(5100).ListItem.DBType,episode) + !Integer.IsGreater(Container(5100).ListItem.PlayCount,0) + !Container(5100).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + String.StartsWith(Container(5100).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(5100).ListItem.PlayCount,0) + !Container(5100).ListItem.IsResumable]]</expression>
	<expression name="Bald_SpoilerPlot8140">[[$EXP[Bald_SpoilerPlotsOn] + String.IsEqual(Container(8140).ListItem.DBType,episode) + !Integer.IsGreater(Container(8140).ListItem.PlayCount,0) + !Container(8140).ListItem.IsResumable] | [$EXP[Bald_SpoilerMoviesOn] + String.IsEqual(Container(8140).ListItem.DBType,movie) + !Integer.IsGreater(Container(8140).ListItem.PlayCount,0) + !Container(8140).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + [Container(8140).ListItem.HasEpg | [String.StartsWith(Container(8140).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(8140).ListItem.PlayCount,0) + !Container(8140).ListItem.IsResumable]]] | String.IsEqual(Container(8140).ListItem.Plot,$LOCALIZE[20370])]</expression>
	<expression name="Bald_SpoilerThumb8140">[[$EXP[Bald_SpoilerThumbsOn] + String.IsEqual(Container(8140).ListItem.DBType,episode) + !Integer.IsGreater(Container(8140).ListItem.PlayCount,0) + !Container(8140).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + String.StartsWith(Container(8140).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(8140).ListItem.PlayCount,0) + !Container(8140).ListItem.IsResumable]]</expression>
	<expression name="Bald_SpoilerPlot8150">[[$EXP[Bald_SpoilerPlotsOn] + String.IsEqual(Container(8150).ListItem.DBType,episode) + !Integer.IsGreater(Container(8150).ListItem.PlayCount,0) + !Container(8150).ListItem.IsResumable] | [$EXP[Bald_SpoilerMoviesOn] + String.IsEqual(Container(8150).ListItem.DBType,movie) + !Integer.IsGreater(Container(8150).ListItem.PlayCount,0) + !Container(8150).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + [Container(8150).ListItem.HasEpg | [String.StartsWith(Container(8150).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(8150).ListItem.PlayCount,0) + !Container(8150).ListItem.IsResumable]]] | String.IsEqual(Container(8150).ListItem.Plot,$LOCALIZE[20370])]</expression>
	<expression name="Bald_SpoilerThumb8150">[[$EXP[Bald_SpoilerThumbsOn] + String.IsEqual(Container(8150).ListItem.DBType,episode) + !Integer.IsGreater(Container(8150).ListItem.PlayCount,0) + !Container(8150).ListItem.IsResumable] | [$EXP[Bald_SpoilerLiveTVOn] + String.StartsWith(Container(8150).ListItem.FileNameAndPath,pvr://recordings/) + !Integer.IsGreater(Container(8150).ListItem.PlayCount,0) + !Container(8150).ListItem.IsResumable]]</expression>

	<!-- The quiet art under a hidden still: the show's fanart (the item's, else the folder's), else an episode's own
	     fanart (Kodi gives an episode its show's), else nothing (the tile's placeholder). -->
	<variable name="Bald_SpoilerArt">
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
		<value condition="!String.IsEmpty(Container.Art(tvshow.fanart))">$INFO[Container.Art(tvshow.fanart)]</value>
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.Art(fanart)]</value>
		<value />
	</variable>
	<variable name="Bald_SpoilerArt0">
		<value condition="!String.IsEmpty(Container(0).ListItem.Art(tvshow.fanart))">$INFO[Container(0).ListItem.Art(tvshow.fanart)]</value>
		<value condition="!String.IsEmpty(Container.Art(tvshow.fanart))">$INFO[Container.Art(tvshow.fanart)]</value>
		<value condition="String.IsEqual(Container(0).ListItem.DBType,episode)">$INFO[Container(0).ListItem.Art(fanart)]</value>
		<value />
	</variable>
	<variable name="Bald_SpoilerArt540">
		<value condition="!String.IsEmpty(Container(540).ListItem.Art(tvshow.fanart))">$INFO[Container(540).ListItem.Art(tvshow.fanart)]</value>
		<value condition="!String.IsEmpty(Container.Art(tvshow.fanart))">$INFO[Container.Art(tvshow.fanart)]</value>
		<value condition="String.IsEqual(Container(540).ListItem.DBType,episode)">$INFO[Container(540).ListItem.Art(fanart)]</value>
		<value />
	</variable>
	<variable name="Bald_SpoilerArt541">
		<value condition="!String.IsEmpty(Container(541).ListItem.Art(tvshow.fanart))">$INFO[Container(541).ListItem.Art(tvshow.fanart)]</value>
		<value condition="!String.IsEmpty(Container.Art(tvshow.fanart))">$INFO[Container.Art(tvshow.fanart)]</value>
		<value condition="String.IsEqual(Container(541).ListItem.DBType,episode)">$INFO[Container(541).ListItem.Art(fanart)]</value>
		<value />
	</variable>
	<variable name="Bald_SpoilerArt542">
		<value condition="!String.IsEmpty(Container(542).ListItem.Art(tvshow.fanart))">$INFO[Container(542).ListItem.Art(tvshow.fanart)]</value>
		<value condition="!String.IsEmpty(Container.Art(tvshow.fanart))">$INFO[Container.Art(tvshow.fanart)]</value>
		<value condition="String.IsEqual(Container(542).ListItem.DBType,episode)">$INFO[Container(542).ListItem.Art(fanart)]</value>
		<value />
	</variable>
	<variable name="Bald_SpoilerArt50">
		<value condition="!String.IsEmpty(Container(50).ListItem.Art(tvshow.fanart))">$INFO[Container(50).ListItem.Art(tvshow.fanart)]</value>
		<value condition="!String.IsEmpty(Container.Art(tvshow.fanart))">$INFO[Container.Art(tvshow.fanart)]</value>
		<value condition="String.IsEqual(Container(50).ListItem.DBType,episode)">$INFO[Container(50).ListItem.Art(fanart)]</value>
		<value />
	</variable>
	<variable name="Bald_SpoilerArt5100">
		<value condition="!String.IsEmpty(Container(5100).ListItem.Art(tvshow.fanart))">$INFO[Container(5100).ListItem.Art(tvshow.fanart)]</value>
		<value condition="!String.IsEmpty(Container.Art(tvshow.fanart))">$INFO[Container.Art(tvshow.fanart)]</value>
		<value condition="String.IsEqual(Container(5100).ListItem.DBType,episode)">$INFO[Container(5100).ListItem.Art(fanart)]</value>
		<value />
	</variable>
	<variable name="Bald_SpoilerArt8140">
		<value condition="!String.IsEmpty(Container(8140).ListItem.Art(tvshow.fanart))">$INFO[Container(8140).ListItem.Art(tvshow.fanart)]</value>
		<value condition="!String.IsEmpty(Container.Art(tvshow.fanart))">$INFO[Container.Art(tvshow.fanart)]</value>
		<value condition="String.IsEqual(Container(8140).ListItem.DBType,episode)">$INFO[Container(8140).ListItem.Art(fanart)]</value>
		<value />
