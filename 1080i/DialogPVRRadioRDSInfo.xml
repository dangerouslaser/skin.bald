<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald radio RDS information (pvrradiordsinfo). Started from Kodi 22 Estuary's DialogPVRRadioRDSInfo.xml (Team Kodi,
     GPL-2.0-or-later). Like Estuary, it shows RDS info labels only: Kodi's optional OK button 10, spinner 21, text 22
     and list 70 are absent, which CGUIDialogPVRRadioRDSInfo tolerates. Default control 9000 is Estuary's; nothing
     here takes focus, and Back closes the dialog. -->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<onunload>ClearProperty(infobackground,home)</onunload>
	<include>Bald_PVRAnimWindow</include>
	<controls>
		<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field60">bald/white.png</texture></control>
		<include>Bald_PVRScrims</include>
		<include content="Bald_PVRHeader">
			<param name="title">$LOCALIZE[29900]</param>
			<param name="section">$VAR[RDSInfoSubTitle]</param>
			<param name="width">1728</param>
		</include>
		<!-- Song, then the studio's contacts. -->
		<control type="grouplist">
			<left>Bald_SafeLeft</left><top>Bald_ContentTop</top><width>820</width><height>320</height><orientation>vertical</orientation>
			<include content="Bald_AnimInfoIn"><param name="delay">0</param></include>
			<include content="Bald_PVRRDSHeading"><param name="label">$LOCALIZE[179]</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[29901]</param><param name="value">RDS.Band</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[557]</param><param name="value">RDS.Artist</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[556]</param><param name="value">RDS.Title</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[29903]</param><param name="value">RDS.Composer</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[29905]</param><param name="value">RDS.Conductor</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[558]</param><param name="value">RDS.Album</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[569]</param><param name="value">RDS.Comment</param></include>
		</control>
		<control type="grouplist">
			<left>Bald_SafeLeft</left><top>566</top><width>820</width><height>160</height><orientation>vertical</orientation>
			<include content="Bald_AnimInfoIn"><param name="delay">60</param></include>
			<include content="Bald_PVRRDSHeading"><param name="label">$LOCALIZE[29909]</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[29910]</param><param name="value">RDS.PhoneStudio</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[29911]</param><param name="value">RDS.EmailStudio</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[29912]</param><param name="value">RDS.SMSStudio</param></include>
		</control>
		<!-- Programme, then the hotline. -->
		<control type="grouplist">
			<left>1004</left><top>Bald_ContentTop</top><width>820</width><height>320</height><orientation>vertical</orientation>
			<include content="Bald_AnimInfoIn"><param name="delay">100</param></include>
			<include content="Bald_PVRRDSHeading"><param name="label">$LOCALIZE[29908]</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[19030]</param><param name="value">RDS.ProgNow</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[19031]</param><param name="value">RDS.ProgNext</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[29902]</param><param name="value">RDS.ProgStyle</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[19148]</param><param name="value">RDS.ProgStation</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[29906]</param><param name="value">RDS.ProgHost</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[29907]</param><param name="value">RDS.ProgEditStaff</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[29914]</param><param name="value">RDS.ProgHomepage</param></include>
		</control>
		<control type="grouplist">
			<left>1004</left><top>566</top><width>820</width><height>160</height><orientation>vertical</orientation>
			<include content="Bald_AnimInfoIn"><param name="delay">140</param></include>
			<include content="Bald_PVRRDSHeading"><param name="label">$LOCALIZE[29913]</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[29910]</param><param name="value">RDS.PhoneHotline</param></include>
			<include content="Bald_PVRRDSLine"><param name="label">$LOCALIZE[29911]</param><param name="value">RDS.EmailHotline</param></include>
		</control>
		<!-- Info services (news, sport, weather ...) and the last four radiotext lines. -->
		<control type="group">
			<left>Bald_SafeLeft</left><top>742</top>
			<include content="Bald_AnimInfoIn"><param name="delay">180</param></include>
			<include content="Bald_PVRRDSHeading"><param name="label">$LOCALIZE[29915]</param></include>
			<control type="textbox">
				<top>44</top><width>820</width><height>150</height><font>Bald_CaptionPlot</font><textcolor>bald_ink80</textcolor>
				<label>$INFO[RDS.InfoNews,$LOCALIZE[29916] · ,[CR]]$INFO[RDS.InfoNewsLocal,$LOCALIZE[29917] · ,[CR]]$INFO[RDS.InfoStock,$LOCALIZE[29920] · ,[CR]]$INFO[RDS.InfoSport,$LOCALIZE[29918] · ,[CR]]$INFO[RDS.Infolottery,$LOCALIZE[29919] · ,[CR]]$INFO[RDS.InfoWeather,$LOCALIZE[400] · ,[CR]]$INFO[RDS.InfoCinema,$LOCALIZE[19602] · ,[CR]]$INFO[RDS.InfoHoroscope,$LOCALIZE[29922] · ,[CR]]$INFO[RDS.InfoOther,$LOCALIZE[29921] · ,[CR]]</label>
				<autoscroll delay="5000" time="3000" repeat="10000">true</autoscroll>
			</control>
		</control>
		<control type="group">
			<left>1004</left><top>742</top>
			<include content="Bald_AnimInfoIn"><param name="delay">220</param></include>
			<include content="Bald_PVRRDSHeading"><param name="label">$LOCALIZE[14304]</param></include>
			<control type="grouplist">
				<top>44</top><width>820</width><height>152</height><orientation>vertical</orientation>
				<control type="label"><width>820</width><height>38</height><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink</textcolor><scroll>true</scroll><label>$INFO[RDS.GetLine(3)]</label></control>
				<control type="label"><width>820</width><height>38</height><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink80</textcolor><scroll>true</scroll><label>$INFO[RDS.GetLine(2)]</label></control>
				<control type="label"><width>820</width><height>38</height><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink70</textcolor><scroll>true</scroll><label>$INFO[RDS.GetLine(1)]</label></control>
				<control type="label"><width>820</width><height>38</height><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink60</textcolor><scroll>true</scroll><label>$INFO[RDS.GetLine(0)]</label></control>
			</control>
		</control>
	</controls>
</window>
