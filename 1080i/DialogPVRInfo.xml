<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald programme and recording information (pvrguideinfo, pvrrecordinginfo). Started from Kodi 22 Estuary's
     DialogPVRInfo.xml (Team Kodi, GPL-2.0-or-later). Kodi handles the actions by id and relabels or hides them:
     4 Find similar, 5 Switch to channel, 6 Record / Stop recording / Delete timer, 8 Play recording, 9 Add timer,
     10 Play programme, 11 Set reminder (CGUIDialogPVRGuideInfo, CGUIDialogPVRRecordingInfo). Grouplist 5000 holds
     them; 138 opens the whole plot in the text viewer (1102) and 102 the fanart (1104), as in Estuary. -->
<window>
	<defaultcontrol always="true">5000</defaultcontrol>
	<onload>SetProperty(infobackground,$ESCINFO[ListItem.Art(fanart)],home)</onload>
	<onunload>ClearProperty(infobackground,home)</onunload>
	<include>Bald_PVRAnimWindow</include>
	<controls>
		<!-- Over video or a Live TV window: fanart when the programme has some, then the field and Bald's scrims. -->
		<control type="image"><width>1920</width><height>1080</height><aspectratio>scale</aspectratio><fadetime>700</fadetime><texture background="true" colordiffuse="bald_backdrop">$INFO[ListItem.Art(fanart)]</texture><visible>!String.IsEmpty(ListItem.Art(fanart))</visible></control>
		<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field60">bald/white.png</texture></control>
		<include>Bald_PVRScrims</include>
		<!-- Channel, title, accent line, when, episode and progress. -->
		<control type="group">
			<left>Bald_SafeLeft</left><top>Bald_PageTitleTop</top>
			<include content="Bald_AnimInfoIn"><param name="delay">0</param></include>
			<control type="image"><width>96</width><height>54</height><aspectratio align="left">keep</aspectratio><texture background="true">$INFO[ListItem.ChannelLogo]</texture><visible>!String.IsEmpty(ListItem.ChannelLogo)</visible></control>
			<control type="label"><left>120</left><width>1000</width><height>54</height><aligny>center</aligny><font>Bald_InfoMeta</font><textcolor>bald_ink70</textcolor><label>$INFO[ListItem.ChannelNumberLabel,, ]$INFO[ListItem.ChannelName]</label><visible>!String.IsEmpty(ListItem.ChannelLogo)</visible></control>
			<control type="label"><width>1120</width><height>54</height><aligny>center</aligny><font>Bald_InfoMeta</font><textcolor>bald_ink70</textcolor><label>$INFO[ListItem.ChannelNumberLabel,, ]$INFO[ListItem.ChannelName]</label><visible>String.IsEmpty(ListItem.ChannelLogo)</visible></control>
			<control type="label"><top>74</top><width>1120</width><height>96</height><aligny>center</aligny><font>Bald_InfoTitle</font><textcolor>bald_ink</textcolor><scroll>true</scroll><label>$VAR[Bald_PVRTitle]</label></control>
		</control>
		<control type="grouplist">
			<left>Bald_SafeLeft</left><top>294</top><width>1120</width><height>130</height><orientation>vertical</orientation><itemgap>8</itemgap>
			<include content="Bald_AnimInfoIn"><param name="delay">60</param></include>
			<control type="label"><width>1120</width><height>26</height><font>Bald_Accent</font><textcolor>bald_accent</textcolor><label>$VAR[Bald_PVRAccent]</label><visible>$EXP[Bald_PVRHasFlag] | !String.IsEmpty(ListItem.Genre)</visible></control>
			<control type="label"><width>1120</width><height>32</height><font>Bald_InfoMeta</font><textcolor>bald_ink80</textcolor><label>$INFO[ListItem.StartDate,, · ]$INFO[ListItem.StartTime]$INFO[ListItem.EndTime,–]$INFO[ListItem.Duration, · ]</label></control>
			<control type="label"><width>1120</width><height>32</height><font>Bald_InfoMeta</font><textcolor>bald_ink70</textcolor><label>$VAR[SeasonEpisodeAndNameLabel]</label><visible>$EXP[listitem_has_episode_info]</visible></control>
			<control type="progress"><width>560</width><height>4</height><include>Bald_PVRProgress</include><visible>Integer.IsGreater(ListItem.Progress,0)</visible></control>
		</control>
		<!-- The plot. Select reads all of it in the text viewer, as in Estuary. -->
		<control type="group">
			<left>Bald_SafeLeft</left><top>440</top>
			<include content="Bald_AnimInfoIn"><param name="delay">100</param></include>
			<control type="button" id="138">
				<left>-20</left><top>-12</top><width>1160</width><height>256</height>
				<label></label><font>Bald_InfoPlot</font>
				<texturenofocus />
				<texturefocus colordiffuse="bald_ink10">bald/white.png</texturefocus>
				<onclick condition="!String.IsEmpty(ListItem.Plot)">SetProperty(TextViewer_Header,$LOCALIZE[207],home)</onclick>
				<onclick condition="!String.IsEmpty(ListItem.Plot)">SetProperty(TextViewer_Text,$ESCINFO[ListItem.Plot],home)</onclick>
				<onclick condition="!String.IsEmpty(ListItem.Plot)">ActivateWindow(1102)</onclick>
				<onup>5000</onup><ondown>5000</ondown><onleft>5000</onleft><onright>5000</onright>
			</control>
			<control type="textbox"><width>1120</width><height>232</height><font>Bald_InfoPlot</font><textcolor>bald_ink80</textcolor><label fallback="19055">$INFO[ListItem.Plot]</label></control>
		</control>
		<!-- Actions: Kodi's ids, in Estuary's order. -->
		<control type="grouplist" id="5000">
			<left>Bald_SafeLeft</left><top>744</top><width>1728</width><height>80</height><orientation>horizontal</orientation><itemgap>16</itemgap>
			<onleft>5000</onleft><onright>5000</onright><onup>138</onup><ondown>138</ondown>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<include content="Bald_AnimInfoIn"><param name="delay">140</param></include>
			<include content="Bald_PVRAction"><param name="id">5</param><param name="label">$LOCALIZE[19165]</param><param name="visible">Window.IsActive(PVRGuideInfo)</param></include>
			<include content="Bald_PVRAction"><param name="id">10</param><param name="label">$LOCALIZE[19190]</param><param name="visible">Window.IsActive(PVRGuideInfo)</param></include>
			<include content="Bald_PVRAction"><param name="id">8</param><param name="label">$LOCALIZE[19687]</param><param name="visible">Window.IsActive(PVRGuideInfo) | Window.IsActive(PVRRecordingInfo)</param></include>
			<include content="Bald_PVRAction"><param name="id">6</param><param name="label">$LOCALIZE[264]</param><param name="visible">Window.IsActive(PVRGuideInfo)</param></include>
			<include content="Bald_PVRAction"><param name="id">9</param><param name="label">$LOCALIZE[19061]</param><param name="visible">Window.IsActive(PVRGuideInfo)</param></include>
			<include content="Bald_PVRAction"><param name="id">11</param><param name="label">$LOCALIZE[826]</param><param name="visible">Window.IsActive(PVRGuideInfo)</param></include>
			<include content="Bald_PVRAction"><param name="id">4</param><param name="label">$LOCALIZE[19003]</param><param name="visible">Window.IsActive(PVRGuideInfo) | Window.IsActive(PVRRecordingInfo)</param></include>
			<control type="button" id="102">
				<include>Bald_PVRActionStyle</include>
				<label>$LOCALIZE[31028]</label>
				<onclick>SetProperty(fanart,$ESCINFO[ListItem.Art(fanart)],home)</onclick>
				<onclick>ActivateWindow(1104)</onclick>
				<visible>!String.IsEmpty(ListItem.Art(fanart))</visible>
			</control>
		</control>
		<!-- Right column: programme art and the facts Estuary listed beside the plot. -->
		<control type="group">
			<left>Bald_PreviewLeft</left><top>Bald_ContentTop</top><width>528</width>
			<include content="Bald_AnimInfoIn"><param name="delay">180</param></include>
			<control type="group">
				<visible>$EXP[Bald_PVRHasArt]</visible>
				<control type="image"><width>528</width><height>297</height><texture colordiffuse="bald_placeholder">bald/white.png</texture></control>
				<control type="image"><width>528</width><height>297</height><aspectratio>keep</aspectratio><fadetime>380</fadetime><texture background="true">$VAR[Bald_PVRArt]</texture></control>
			</control>
			<control type="grouplist">
				<top>329</top><width>528</width><height>380</height><orientation>vertical</orientation><itemgap>12</itemgap>
				<visible>$EXP[Bald_PVRHasArt]</visible>
				<include>Bald_PVRInfoDetails</include>
			</control>
			<control type="grouplist">
				<width>528</width><height>709</height><orientation>vertical</orientation><itemgap>12</itemgap>
				<visible>!$EXP[Bald_PVRHasArt]</visible>
				<include>Bald_PVRInfoDetails</include>
			</control>
		</control>
		<include content="Bald_PVRHints">
			<param name="first">$LOCALIZE[31679]</param>
			<param name="second">$LOCALIZE[31678]</param>
			<param name="third">$LOCALIZE[31669]</param>
			<param name="third_visible">true</param>
		</include>
	</controls>
</window>
