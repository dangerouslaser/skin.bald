<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald Live TV Search (TVSearch, RadioSearch). Started from Kodi 22 Estuary's MyPVRSearch.xml (Team Kodi,
     GPL-2.0-or-later); Kodi's ids are kept: view 50, channel groups 28, sort 3 and 4, header labels 29 (the search)
     and 30 (its result count), menucontrol 9000. Estuary also named 6053 as a second menucontrol; Kodi reads the
     first, 9000, so the duplicate was dropped. -->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<views>50</views>
	<menucontrol>9000</menucontrol>
	<include>Bald_PVRAnimWindow</include>
	<controls>
		<include>Bald_PVRBackground</include>
		<control type="group">
			<include>Bald_PVRInfoDim</include>
			<include content="Bald_PVRWindowChrome">
				<param name="title">$LOCALIZE[137]</param>
				<param name="section">$VAR[Bald_PVRArea]$INFO[Control.GetLabel(29), · ]$INFO[Control.GetLabel(30), · ]</param>
				<param name="hint">$LOCALIZE[31666]</param>
			</include>
			<include content="Bald_PVRList">
				<include content="Bald_PVRItemLayouts">
					<param name="only_label">String.IsEmpty(ListItem.Date)</param>
					<param name="label1">$VAR[PVRMySearchLabel1Var]</param>
					<param name="label2">$INFO[ListItem.Date]</param>
				</include>
			</include>
			<include content="Bald_PVROptions">
				<include>Bald_PVRSortOptions</include>
				<include>Bald_PVRAreaOptions</include>
			</include>
		</control>
		<include>Bald_PVRNativeLabels</include>
	</controls>
</window>
