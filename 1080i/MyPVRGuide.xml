<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald primary Live TV guide. Native Kodi 22 PVR controls and actions are retained. -->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<views>50</views>
	<menucontrol>9000</menucontrol>
	<controls>
		<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field">bald/white.png</texture></control>
		<control type="image"><width>1920</width><height>1080</height><aspectratio>scale</aspectratio><fadetime>800</fadetime><texture background="true">$INFO[ListItem.EpgEventIcon]</texture><colordiffuse>bald_backdrop</colordiffuse><visible>!String.IsEmpty(ListItem.EpgEventIcon)</visible></control>
		<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field60">bald/white.png</texture></control>
		<control type="label"><left>96</left><top>82</top><width>900</width><height>52</height><font>Bald_CaptionTitle</font><textcolor>bald_ink</textcolor><label>Live TV</label></control>
		<control type="label"><left>1296</left><top>92</top><width>528</width><height>30</height><align>right</align><font>Bald_CaptionMeta</font><textcolor>bald_ink60</textcolor><label>$INFO[System.Date] · $INFO[System.Time]</label></control>
		<control type="group"><left>96</left><top>154</top><width>1728</width><height>190</height>
			<animation effect="fade" start="0" end="100" time="380" tween="sine" easing="inout">WindowOpen</animation>
			<control type="image"><left>0</left><top>8</top><width>150</width><height>112</height><aspectratio align="center" aligny="center">keep</aspectratio><fadetime>380</fadetime><texture>$INFO[ListItem.ChannelLogo]</texture></control>
			<control type="label"><left>184</left><top>0</top><width>980</width><height>48</height><font>Bald_CaptionTitle</font><textcolor>bald_ink</textcolor><label>$INFO[ListItem.EpgEventTitle]</label></control>
			<control type="label"><left>184</left><top>52</top><width>980</width><height>30</height><font>Bald_CaptionMeta</font><textcolor>bald_ink70</textcolor><label>$INFO[ListItem.ChannelNumberLabel]$INFO[ListItem.ChannelName, · ]$INFO[ListItem.StartTime, · ]$INFO[ListItem.EndTime,– ]</label></control>
			<control type="textbox"><left>184</left><top>94</top><width>980</width><height>82</height><font>Bald_CaptionPlot</font><textcolor>bald_ink76</textcolor><label>$INFO[ListItem.Plot]</label></control>
			<control type="image"><left>1200</left><top>0</top><width>528</width><height>176</height><aspectratio>scale</aspectratio><fadetime>700</fadetime><texture background="true">$INFO[ListItem.EpgEventIcon]</texture><visible>!String.IsEmpty(ListItem.EpgEventIcon)</visible></control>
		</control>
		<control type="fixedlist" id="11"><left>96</left><top>354</top><width>1728</width><height>44</height><orientation>horizontal</orientation><scrolltime tween="cubic" easing="out">440</scrolltime><onleft>noop</onleft><onright>noop</onright><onup>50</onup><ondown>50</ondown>
			<itemlayout width="288" height="44"><control type="label"><width>280</width><height>44</height><align>center</align><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink45</textcolor><label>$INFO[ListItem.Label]</label></control></itemlayout>
			<focusedlayout width="288" height="44"><control type="image"><left>140</left><top>36</top><width>8</width><height>8</height><texture colordiffuse="bald_accent">bald/dot.png</texture></control><control type="label"><width>280</width><height>38</height><align>center</align><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink</textcolor><label>$INFO[ListItem.Label]</label></control></focusedlayout>
		</control>
		<control type="group" id="63"><include content="Bald_EpgGrid"><param name="control_id" value="50" /></include></control>
		<include>PVRChannelNumberInput</include>
		<control type="group"><include>MediaMenuCommon</include><include content="PVRSideBar"><param name="group_label2" value="$INFO[Control.GetLabel(30)]" /></include></control>
		<control type="label" id="29"><font></font><include>HiddenObject</include></control>
		<control type="label" id="30"><font></font><include>HiddenObject</include></control>
		<control type="label"><left>96</left><top>1010</top><width>800</width><height>24</height><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$INFO[Control.GetLabel(30)]</label></control>
		<control type="label"><left>1024</left><top>1010</top><width>800</width><height>24</height><align>right</align><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>Menu for options · Info for programme details</label></control>
	</controls>
</window>
