<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald Live TV Timers and Timer rules (TVTimers, RadioTimers, TVTimerRules, RadioTimerRules). Started from Kodi 22
     Estuary's MyPVRTimers.xml (Team Kodi, GPL-2.0-or-later); Kodi's ids are kept: view 50, hide disabled 8, channel
     groups 28, sort 3 and 4, header labels 29 and 30, menucontrol 9000. -->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<views>50</views>
	<menucontrol>9000</menucontrol>
	<include>Bald_PVRAnimWindow</include>
	<controls>
		<include>Bald_PVRBackground</include>
		<control type="group">
			<include>Bald_PVRInfoDim</include>
			<include content="Bald_PVRWindowChrome">
				<param name="title">$VAR[Bald_PVRTimersTitle]</param>
				<param name="section">$VAR[Bald_PVRArea]$INFO[Control.GetLabel(29), · ]$INFO[PVR.NextTimer, · ]</param>
				<param name="hint">$LOCALIZE[31665]</param>
				<param name="extra">$INFO[ListItem.TimerType]$INFO[ListItem.Comment, · ]</param>
				<param name="extra_visible">!String.IsEmpty(ListItem.TimerType) | !String.IsEmpty(ListItem.Comment)</param>
			</include>
			<include content="Bald_PVRList">
				<include content="Bald_PVRItemLayouts">
					<param name="only_label">String.IsEmpty(ListItem.Date)</param>
					<param name="has_info_icon">true</param>
					<param name="info_icon">$VAR[ListPVRTimersIconVar]</param>
					<param name="text_left">74</param>
					<param name="label2">$INFO[ListItem.Date]</param>
				</include>
			</include>
			<include content="Bald_PVROptions">
				<include content="Bald_PVROptionToggle"><param name="id">8</param><param name="label">$LOCALIZE[19077]</param></include>
				<include>Bald_PVRSortOptions</include>
				<include>Bald_PVRAreaOptions</include>
			</include>
		</control>
		<include>Bald_PVRNativeLabels</include>
	</controls>
</window>
