<?xml version="1.0" encoding="UTF-8"?>
<!-- Channel manager (pvrchannelmanager). Started from Kodi 22 Estuary's DialogPVRChannelManager.xml (Team Kodi,
     GPL-2.0-or-later); the shared popup surface and dialog actions were already Bald's, and the inner layout now is
     too. Kodi binds heading 2, OK 4, Apply 5, Cancel 6, active 7, name 8, logo 9, use guide 12, guide source 13,
     parental lock 14, channel list 20, group manager 30, new channel 31, TV/radio 34 and refresh logos 35
     (CGUIDialogPVRChannelManager). Navigation is Estuary's. -->
<window>
	<defaultcontrol always="true">4</defaultcontrol>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centertop>50%</centertop>
			<height>995</height>
			<centerleft>50%</centerleft>
			<width>1820</width>
			<include content="DialogBackgroundCommons">
				<param name="width" value="1820" />
				<param name="height" value="995" />
				<param name="header_label" value="$VAR[PVRChannelMgrHeader]$INFO[Container(20).NumItems, (,)]" />
				<param name="header_id" value="2" />
			</include>
			<!-- Channels -->
			<control type="group">
				<left>30</left>
				<top>100</top>
				<control type="list" id="20">
					<left>0</left><top>0</top><width>630</width><height>868</height>
					<onup>20</onup><ondown>20</ondown><onleft>9000</onleft><onright>60</onright>
					<pagecontrol>60</pagecontrol><scrolltime tween="cubic" easing="out">200</scrolltime>
					<itemlayout height="70" width="630"><include>Bald_PVRManagerChannel</include></itemlayout>
					<focusedlayout height="70" width="630">
						<include content="Bald_PVRManagerFocus"><param name="list_id">20</param></include>
						<include content="Bald_PVRManagerChannel"><param name="focused">true</param><param name="c1">bald_ink</param></include>
					</focusedlayout>
				</control>
				<control type="scrollbar" id="60">
					<left>644</left><top>0</top><width>6</width><height>868</height>
					<orientation>vertical</orientation><showonepage>false</showonepage>
					<texturesliderbackground colordiffuse="bald_ink10">bald/white.png</texturesliderbackground>
					<texturesliderbar colordiffuse="bald_ink34">bald/white.png</texturesliderbar>
					<texturesliderbarfocus colordiffuse="bald_accent">bald/white.png</texturesliderbarfocus>
					<textureslidernib /><textureslidernibfocus />
					<onleft>20</onleft>
					<onright condition="Integer.IsGreater(Container(20).NumItems, 0)">9002</onright>
					<onright condition="Integer.IsEqual(Container(20).NumItems, 0)">9003</onright>
				</control>
			</control>
			<!-- The focused channel's settings, then the manager's other actions. -->
			<control type="group">
				<left>710</left>
				<control type="grouplist" id="9002">
					<top>96</top><width>700</width><height>420</height><itemgap>6</itemgap>
					<onleft>60</onleft><onright>9000</onright><onup>34</onup><ondown>35</ondown>
					<include content="Bald_PVRManagerHeading"><param name="id">9001</param><param name="label">$LOCALIZE[31097]</param></include>
					<control type="radiobutton" id="7">
						<description>Channel activated</description>
						<include>Bald_PVRManagerRow</include>
						<label>$LOCALIZE[19074]</label>
					</control>
					<control type="edit" id="8">
						<description>Channel name</description>
						<include>Bald_PVRManagerRow</include>
						<label>$LOCALIZE[19201]</label>
					</control>
					<control type="button" id="9">
						<description>Channel logo Button</description>
						<include>Bald_PVRManagerRow</include>
						<label>$LOCALIZE[19202]</label>
					</control>
					<control type="radiobutton" id="12">
						<description>EPG activated</description>
						<include>Bald_PVRManagerRow</include>
						<label>$LOCALIZE[19206]</label>
					</control>
					<control type="spincontrolex" id="13">
						<description>EPG source</description>
						<include>Bald_PVRManagerSpinner</include>
						<label>$LOCALIZE[19200]</label>
					</control>
					<control type="radiobutton" id="14">
						<description>Parental locked</description>
						<include>Bald_PVRManagerRow</include>
						<label>$LOCALIZE[19267]</label>
					</control>
				</control>
				<!-- The focused channel's logo beside its logo row. -->
				<control type="image">
					<left>600</left><top>264</top><width>72</width><height>48</height>
					<aspectratio>keep</aspectratio>
					<texture background="true">$INFO[Container(20).ListItem.Property(icon)]</texture>
				</control>
				<control type="grouplist" id="9003">
					<top>560</top><width>700</width><height>300</height><itemgap>6</itemgap>
					<onleft>60</onleft><onright>9000</onright><onup>14</onup><ondown>7</ondown>
					<include content="Bald_PVRManagerHeading"><param name="label">$LOCALIZE[31021]</param></include>
					<control type="button" id="35">
						<description>Refresh channel logos Button</description>
						<include>Bald_PVRManagerRow</include>
						<label>$LOCALIZE[19041]</label>
					</control>
					<control type="button" id="31">
						<description>New channel Button</description>
						<include>Bald_PVRManagerRow</include>
						<label>$LOCALIZE[19204]</label>
					</control>
					<control type="button" id="30">
						<description>Group Manager Button</description>
						<include>Bald_PVRManagerRow</include>
						<label>$LOCALIZE[19205]</label>
					</control>
					<control type="togglebutton" id="34">
						<description>TV/Radio toggle</description>
						<include>Bald_PVRManagerRow</include>
						<label>$LOCALIZE[19024]</label>
						<altlabel>$LOCALIZE[19023]</altlabel>
						<usealttexture>!String.IsEmpty(Window.Property(IsRadio))</usealttexture>
					</control>
				</control>
			</control>
			<control type="grouplist" id="9000">
				<right>20</right>
				<top>90</top>
				<onleft condition="Integer.IsGreater(Container(20).NumItems, 0)">9002</onleft>
				<onleft condition="Integer.IsEqual(Container(20).NumItems, 0)">9003</onleft>
				<onright>20</onright>
				<itemgap>dialogbuttons_itemgap</itemgap>
				<width>400</width>
				<include content="DefaultDialogButton">
					<param name="width" value="400" />
					<param name="id" value="4" />
					<param name="label" value="$LOCALIZE[186]" />
				</include>
				<include content="DefaultDialogButton">
					<param name="width" value="400" />
					<param name="id" value="5" />
					<param name="label" value="$LOCALIZE[14070]" />
				</include>
				<include content="DefaultDialogButton">
					<param name="width" value="400" />
					<param name="id" value="6" />
					<param name="label" value="$LOCALIZE[222]" />
				</include>
			</control>
		</control>
	</controls>
</window>
