<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald music library (docs/NOTES.md, "Music"). Artists, albums, songs and the library's plain lists open in the Bald
     views (View_550_Bald_Music.xml, Includes_Bald_Music.xml); files, sources, add-ons, playlists and music videos keep
     the restyled Estuary views. Started from Kodi 22 Estuary's MyMusicNav.xml (GPL-2.0-or-later, see
     LICENSE-Estuary.txt).
     Kodi (CGUIWindowMusicNav, CGUIWindowMusicBase, CGUIMediaWindow) binds 2 view as, 3 sort by, 4 sort order,
     8 search, 12 item count, 15 filter label, 16 party mode, 19 filter, 20 update library and the <views> containers;
     the Bald options send clicks to the hidden 3, 4, 8, 16 and 19 of the Estuary menu below. -->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<views>550,551,552,50,52,53,54,55,500</views>
	<menucontrol>9151</menucontrol>
	<include content="Bald_UnfollowContainerOnLoad"><param name="window">music</param></include>
	<!-- Opened from Home: remember the folder, whose heading is the hub's name if a hub opened it (Bald_InHubFolder). -->
	<onload condition="Window.Previous(home)">SetProperty(Bald.HubPath,$ESCINFO[Container.FolderPath],home)</onload>
	<include content="Bald_UnfollowContainerOnUnload"><param name="window">music</param></include>
	<include>Bald_CurtainHandoff</include>
	<onload condition="$EXP[Bald_HasTMDbHelper]">Skin.SetBool(TMDbHelper.UseLocalWidgetContainer)</onload>
	<!-- Blur: Bald Helper's, else TMDb Helper's, never both (Home.xml). -->
	<onload condition="$EXP[Bald_HasTMDbHelper] + !$EXP[Bald_HasHelper]">Skin.SetBool(TMDbHelper.EnableBlur)</onload>
	<onload condition="$EXP[Bald_HasHelper] + Skin.HasSetting(TMDbHelper.EnableBlur)">Skin.Reset(TMDbHelper.EnableBlur)</onload>
	<!-- Library content always enters a Bald view, even where an Estuary view was saved for it before: artists and
	     albums the covers, songs and the plain lists the compact list. -->
	<onload condition="$EXP[Bald_MusicCoverContent] + !$EXP[Bald_MusicViewActive]">Container.SetViewMode(550)</onload>
	<onload condition="$EXP[Bald_MusicListContent] + !$EXP[Bald_MusicCoverContent] + !Control.IsVisible(551)">Container.SetViewMode(551)</onload>
	<controls>
		<!-- Kodi's Menu action focuses the menu control; route it to the Bald options or Estuary's menu. -->
		<control type="button" id="9151">
			<include>HiddenObject</include>
			<onfocus condition="$EXP[Bald_MusicViewActive]">SetFocus(9150)</onfocus>
			<onfocus condition="!$EXP[Bald_MusicViewActive]">SetFocus(9000)</onfocus>
		</control>
		<include>DefaultBackground</include>
		<include>Bald_VideoBackdrop</include>
		<control type="group">
			<!-- Entered from Home (in from the right); returned to from anything deeper, such as Now Playing. Leaving for
			     Home is back (out to the right). -->
			<include content="Bald_AnimWindowDepth">
				<param name="back_in">!Window.Previous(home)</param>
				<param name="back_out">Window.Next(home)</param>
			</include>
			<animation effect="fade" start="100" end="0" time="200" tween="sine" condition="$EXP[infodialog_active]">Conditional</animation>
			<include>View_550_Bald_Covers</include>
			<include>View_551_Bald_MusicCompact</include>
			<include>View_552_Bald_MusicArtwork</include>
			<control type="group">
				<visible>$EXP[Bald_MusicViewActive]</visible>
				<include content="Bald_LibraryOptions"><param name="items">Bald_MusicOptionItems</param></include>
				<include content="Bald_LibraryLetters">
					<param name="window">music</param>
					<param name="sorted">$EXP[Bald_MusicLettersSorted]</param>
					<param name="label">$VAR[Bald_MusicLetterLabel]</param>
					<param name="empty">$EXP[Bald_MusicEmpty]</param>
				</include>
			</control>
			<include>View_50_List</include>
			<include>View_52_IconWall</include>
			<include>View_53_Shift</include>
			<include>View_54_InfoWall</include>
			<include>View_55_WideList</include>
			<include>View_500_Wall</include>
			<!-- Estuary views: the shared preview column for the list and wall views that do not draw their own. -->
			<include content="ListThumbInfoPanel"><param name="visible">Control.IsVisible(55) | Control.IsVisible(54)</param></include>
			<control type="group">
				<visible>!$EXP[Bald_MusicViewActive]</visible>
				<include content="TopBar"><param name="breadcrumbs_label" value="$LOCALIZE[2]" /><param name="top" value="108" /></include>
				<include content="BottomBar"><param name="info_visible" value="true" /></include>
				<control type="group">
					<depth>DepthBars</depth>
					<bottom>10</bottom>
					<height>40</height>
					<include condition="!Skin.HasSetting(Bald.HideMediaFlags)">MediaFlags</include>
				</control>
			</control>
			<include>CommonScrollbars</include>
			<control type="group"><visible>!$EXP[Bald_MusicViewActive]</visible><include>MediaMenuMouseOverlay</include></control>
			<!-- Estuary's menu: shown for the Estuary views; hidden under the Bald views, where its 3, 4, 8, 16 and 19
			     still take the options' clicks. -->
			<control type="group">
				<include>MediaMenuCommon</include>
				<visible>!$EXP[Bald_MusicViewActive]</visible>
				<control type="grouplist" id="9000">
					<top>50</top>
					<include>MediaMenuListCommon</include>
					<control type="label" id="203">
						<description>Actions</description>
						<include>MediaMenuLabelCommon</include>
						<label>$LOCALIZE[31020]</label>
					</control>
					<control type="togglebutton" id="619">
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[653]</label>
						<onclick>UpdateLibrary(music)</onclick>
						<visible>!Container.Content(addons)+ String.IsEmpty(Container.PluginName)</visible>
						<altlabel>$LOCALIZE[13353]</altlabel>
						<usealttexture>library.isscanningmusic</usealttexture>
					</control>
					<control type="radiobutton" id="16">
						<label>$LOCALIZE[589]</label>
						<include>MediaMenuItemsCommon</include>
					</control>
					<control type="button" id="612">
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[31056]</label>
						<onclick>ActivateWindow(musicplaylist)</onclick>
						<visible>Integer.IsGreater(Playlist.Length(music),0)</visible>
					</control>
					<control type="button" id="621">
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[21452]</label>
						<onclick>ActivateWindow(addonbrowser,addons://more/audio/,return)</onclick>
						<visible>Container.Content(addons)</visible>
					</control>
					<control type="button" id="624">
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[10140]</label>
						<onclick>Addon.OpenSettings($INFO[Container.PluginName])</onclick>
						<visible>!String.IsEmpty(Container.PluginName)</visible>
					</control>
					<control type="button" id="622">
						<include>MediaMenuItemsCommon</include>
						<label>$LOCALIZE[31117]</label>
						<onclick condition="System.AddonIsEnabled(plugin.library.node.editor)">ActivateWindow(programs,plugin://plugin.library.node.editor/?ltype=music,return)</onclick>
						<onclick condition="System.HasAddon(plugin.library.node.editor) + !System.AddonIsEnabled(plugin.library.node.editor)">EnableAddon(plugin.library.node.editor)</onclick>
						<onclick condition="!System.HasAddon(plugin.library.node.editor)">InstallAddon(plugin.library.node.editor)</onclick>
						<visible>String.IsEmpty(Container.FolderPath) + String.IsEmpty(Container.PluginName)</visible>
					</control>
					<include>MediaMenuNowPlaying</include>
				</control>
			</control>
		</control>
	</controls>
</window>
