<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- Bald is remote-only; see RunScript(skin.bald,mouse) in scripts/info.py. -->
	<onload condition="System.GetBool(input.enablemouse)">RunScript(skin.bald,mouse)</onload>
	<!-- Startup splash, only when Kodi starts on Home (window 10000) and Appearance's "Preload Home at startup" is on:
	     Home shows it while Bald.Preload is set and every row loads behind it (Includes_Bald_Home.xml, Bald_Preloading).
	     Startup.xml does not run on ReloadSkin or a skin switch, so neither shows it. The alarm is the hard timeout
	     (Timers.xml bald_preload); alarms and Home's properties outlive the reload a Home row rebuild triggers. -->
	<onload condition="!Skin.HasSetting(Bald.DisablePreload) + String.IsEqual(System.StartupWindow,10000)">SetProperty(Bald.Preload,1,home)</onload>
	<onload condition="!Skin.HasSetting(Bald.DisablePreload) + String.IsEqual(System.StartupWindow,10000)">AlarmClock(bald_preload,noop,00:10,silent)</onload>
	<!-- Estuary's video OSD auto-close (OSDAutoClose, OSDAutoCloseTime, default 4 s) became Bald.OSD.AutoClose
	     (Bald Settings, Playback). Carry an old choice over once, then clear the old settings. -->
	<onload condition="Skin.HasSetting(OSDAutoClose) + String.IsEmpty(Skin.String(Bald.OSD.AutoClose)) + String.IsEmpty(Skin.String(OSDAutoCloseTime))">Skin.SetString(Bald.OSD.AutoClose,4)</onload>
	<onload condition="Skin.HasSetting(OSDAutoClose) + String.IsEmpty(Skin.String(Bald.OSD.AutoClose)) + !String.IsEmpty(Skin.String(OSDAutoCloseTime))">Skin.SetString(Bald.OSD.AutoClose,$INFO[Skin.String(OSDAutoCloseTime)])</onload>
	<onload condition="Skin.HasSetting(OSDAutoClose)">Skin.Reset(OSDAutoClose)</onload>
	<!-- 0.2 "Details on the controls" became three switches (clearlogo, media flags, plot): carry it over once. -->
	<onload condition="Skin.HasSetting(Bald.OSD.DetailsOnControls)">Skin.SetBool(Bald.OSD.DetailsLogo)</onload>
	<onload condition="Skin.HasSetting(Bald.OSD.DetailsOnControls)">Skin.SetBool(Bald.OSD.DetailsFlags)</onload>
	<onload condition="Skin.HasSetting(Bald.OSD.DetailsOnControls)">Skin.SetBool(Bald.OSD.DetailsPlot)</onload>
	<onload condition="Skin.HasSetting(Bald.OSD.DetailsOnControls)">Skin.Reset(Bald.OSD.DetailsOnControls)</onload>
	<onload condition="!String.IsEmpty(Skin.String(OSDAutoCloseTime))">Skin.Reset(OSDAutoCloseTime)</onload>
	<!-- Estuary settings folded into Bald's Appearance (docs/NOTES.md, "Estuary windows settings folded into Bald"):
	     carry an old choice over once, then clear the old setting. Image packs copy name and extension before the path,
	     because each copy only runs while the Bald path is still empty, and never copy an empty value (Skin.SetString
	     with no value opens the keyboard). -->
	<onload condition="Skin.HasSetting(no_fanart)">Skin.SetBool(Bald.HideBrowseFanart)</onload>
	<onload condition="Skin.HasSetting(no_fanart)">Skin.Reset(no_fanart)</onload>
	<onload condition="Skin.HasSetting(show_musicvideoposter)">Skin.SetBool(Bald.MusicVideoPosters)</onload>
	<onload condition="Skin.HasSetting(show_musicvideoposter)">Skin.Reset(show_musicvideoposter)</onload>
	<onload condition="!String.IsEmpty(Skin.String(MovieGenreFanart.path)) + String.IsEmpty(Skin.String(Bald.GenreFanart.path)) + !String.IsEmpty(Skin.String(MovieGenreFanart.name))">Skin.SetString(Bald.GenreFanart.name,$INFO[Skin.String(MovieGenreFanart.name)])</onload>
	<onload condition="!String.IsEmpty(Skin.String(MovieGenreFanart.path)) + String.IsEmpty(Skin.String(Bald.GenreFanart.path)) + !String.IsEmpty(Skin.String(MovieGenreFanart.ext))">Skin.SetString(Bald.GenreFanart.ext,$INFO[Skin.String(MovieGenreFanart.ext)])</onload>
	<onload condition="!String.IsEmpty(Skin.String(MovieGenreFanart.path)) + String.IsEmpty(Skin.String(Bald.GenreFanart.path))">Skin.SetString(Bald.GenreFanart.path,$INFO[Skin.String(MovieGenreFanart.path)])</onload>
	<onload condition="!String.IsEmpty(Skin.String(MovieGenreFanart.path))">Skin.Reset(MovieGenreFanart.name)</onload>
	<onload condition="!String.IsEmpty(Skin.String(MovieGenreFanart.path))">Skin.Reset(MovieGenreFanart.ext)</onload>
	<onload condition="!String.IsEmpty(Skin.String(MovieGenreFanart.path))">Skin.Reset(MovieGenreFanart.path)</onload>
	<onload condition="!String.IsEmpty(Skin.String(WeatherFanart.path)) + String.IsEmpty(Skin.String(Bald.WeatherFanart.path)) + !String.IsEmpty(Skin.String(WeatherFanart.name))">Skin.SetString(Bald.WeatherFanart.name,$INFO[Skin.String(WeatherFanart.name)])</onload>
	<onload condition="!String.IsEmpty(Skin.String(WeatherFanart.path)) + String.IsEmpty(Skin.String(Bald.WeatherFanart.path)) + !String.IsEmpty(Skin.String(WeatherFanart.ext))">Skin.SetString(Bald.WeatherFanart.ext,$INFO[Skin.String(WeatherFanart.ext)])</onload>
	<onload condition="!String.IsEmpty(Skin.String(WeatherFanart.path)) + String.IsEmpty(Skin.String(Bald.WeatherFanart.path))">Skin.SetString(Bald.WeatherFanart.path,$INFO[Skin.String(WeatherFanart.path)])</onload>
	<onload condition="!String.IsEmpty(Skin.String(WeatherFanart.path))">Skin.Reset(WeatherFanart.name)</onload>
	<onload condition="!String.IsEmpty(Skin.String(WeatherFanart.path))">Skin.Reset(WeatherFanart.ext)</onload>
	<onload condition="!String.IsEmpty(Skin.String(WeatherFanart.path))">Skin.Reset(WeatherFanart.path)</onload>
	<onload condition="!String.IsEmpty(Skin.String(WeatherOutlookIcon.path)) + String.IsEmpty(Skin.String(Bald.WeatherIcons.path)) + !String.IsEmpty(Skin.String(WeatherOutlookIcon.name))">Skin.SetString(Bald.WeatherIcons.name,$INFO[Skin.String(WeatherOutlookIcon.name)])</onload>
	<onload condition="!String.IsEmpty(Skin.String(WeatherOutlookIcon.path)) + String.IsEmpty(Skin.String(Bald.WeatherIcons.path)) + !String.IsEmpty(Skin.String(WeatherOutlookIcon.ext))">Skin.SetString(Bald.WeatherIcons.ext,$INFO[Skin.String(WeatherOutlookIcon.ext)])</onload>
	<onload condition="!String.IsEmpty(Skin.String(WeatherOutlookIcon.path)) + String.IsEmpty(Skin.String(Bald.WeatherIcons.path))">Skin.SetString(Bald.WeatherIcons.path,$INFO[Skin.String(WeatherOutlookIcon.path)])</onload>
	<onload condition="!String.IsEmpty(Skin.String(WeatherOutlookIcon.path))">Skin.Reset(WeatherOutlookIcon.name)</onload>
	<onload condition="!String.IsEmpty(Skin.String(WeatherOutlookIcon.path))">Skin.Reset(WeatherOutlookIcon.ext)</onload>
	<onload condition="!String.IsEmpty(Skin.String(WeatherOutlookIcon.path))">Skin.Reset(WeatherOutlookIcon.path)</onload>
	<onload condition="Skin.HasSetting(autoscroll)">Skin.SetBool(Bald.ScrollPlots)</onload>
	<onload condition="Skin.HasSetting(autoscroll)">Skin.Reset(autoscroll)</onload>
	<onload condition="Skin.HasSetting(show_weatherinfo)">Skin.SetBool(Bald.HeaderWeather)</onload>
	<onload condition="Skin.HasSetting(show_weatherinfo)">Skin.Reset(show_weatherinfo)</onload>
	<onload condition="Skin.HasSetting(show_profilename)">Skin.SetBool(Bald.HeaderProfile)</onload>
	<onload condition="Skin.HasSetting(show_profilename)">Skin.Reset(show_profilename)</onload>
	<onload condition="Skin.HasSetting(show_profileavatar)">Skin.Reset(show_profileavatar)</onload>
	<onload condition="Skin.HasSetting(show_none)">Skin.Reset(show_none)</onload>
	<onload condition="Skin.HasSetting(OriginalTitleFormat_Only) + String.IsEmpty(Skin.String(Bald.OriginalTitle))">Skin.SetString(Bald.OriginalTitle,original)</onload>
	<onload condition="Skin.HasSetting(OriginalTitleFormat_1st) + String.IsEmpty(Skin.String(Bald.OriginalTitle))">Skin.SetString(Bald.OriginalTitle,originalfirst)</onload>
	<onload condition="Skin.HasSetting(OriginalTitleFormat_2nd) + String.IsEmpty(Skin.String(Bald.OriginalTitle))">Skin.SetString(Bald.OriginalTitle,localisedfirst)</onload>
	<onload condition="Skin.HasSetting(OriginalTitleFormat_Default)">Skin.Reset(OriginalTitleFormat_Default)</onload>
	<onload condition="Skin.HasSetting(OriginalTitleFormat_Only)">Skin.Reset(OriginalTitleFormat_Only)</onload>
	<onload condition="Skin.HasSetting(OriginalTitleFormat_1st)">Skin.Reset(OriginalTitleFormat_1st)</onload>
	<onload condition="Skin.HasSetting(OriginalTitleFormat_2nd)">Skin.Reset(OriginalTitleFormat_2nd)</onload>
	<!-- Estuary settings retired with Appearance's "Estuary windows" category (docs/NOTES.md, "Estuary windows
	     settings folded into Bald"): clear what an old install left behind. -->
	<onload condition="Skin.HasSetting(touchmode)">Skin.Reset(touchmode)</onload>
	<onload condition="Skin.HasSetting(no_slide_animations)">Skin.Reset(no_slide_animations)</onload>
	<onload condition="Skin.HasSetting(hide_mediaflags)">Skin.Reset(hide_mediaflags)</onload>
	<onload condition="!String.IsEmpty(Skin.String(background_overlay))">Skin.Reset(background_overlay)</onload>
	<onload condition="!String.IsEmpty(Skin.String(HomeFanart.path))">Skin.Reset(HomeFanart.name)</onload>
	<onload condition="!String.IsEmpty(Skin.String(HomeFanart.path))">Skin.Reset(HomeFanart.ext)</onload>
	<onload condition="!String.IsEmpty(Skin.String(HomeFanart.path))">Skin.Reset(HomeFanart.path)</onload>
	<onload>ReplaceWindow($INFO[System.StartupWindow])</onload>
	<controls />
</window>
