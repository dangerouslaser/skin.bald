<?xml version="1.0" encoding="UTF-8"?>
<!-- Subtitle search, Bald (docs/SPEC.md 5.16, "Other playback windows"). The Bald popup surface (DialogBackgroundCommons)
     with three columns: the services (a standard popup list), the results (language chip, release name, rating,
     hearing-impaired and sync marks; 10% ink focus row) and the manual search action with the status. Started from
     Kodi 22 Estuary's DialogSubtitles.xml (GPL-2.0-or-later, see LICENSE-Estuary.txt).
     Kodi (CGUIDialogSubtitles) binds 100 (service name, the popup heading), 110 (service logo), 120 (results),
     130 (local subtitles notice, shown or hidden), 140 (status text), 150 (services) and 160 (manual search); 73 is
     the results' page control and 250 Estuary's surface group. -->
<window>
	<!-- Parks the video OSD's auto-close while this dialog is open over it (Includes_Bald_OSD.xml). -->
	<include>Bald_OSDSuspendAutoClose</include>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="group">
			<centertop>50%</centertop>
			<height>750</height>
			<centerleft>50%</centerleft>
			<width>1720</width>
			<control type="group" id="250">
				<include content="DialogBackgroundCommons">
					<param name="width" value="1720" />
					<param name="height" value="750" />
					<param name="header_label" value="$LOCALIZE[24012]" />
					<param name="header_id" value="100" />
				</include>
				<!-- Right column: manual search, status and the local subtitles notice. -->
				<control type="group">
					<left>1320</left>
					<control type="grouplist">
						<top>130</top>
						<width>380</width>
						<height>72</height>
						<onright>150</onright>
						<onleft>73</onleft>
						<orientation>vertical</orientation>
						<include content="DefaultDialogButton">
							<param name="id" value="160" />
							<param name="label" value="$LOCALIZE[24120]" />
							<param name="width" value="380" />
						</include>
					</control>
					<control type="label" id="140">
						<description>textarea</description>
						<top>226</top>
						<width>380</width>
						<height>120</height>
						<align>center</align>
						<aligny>top</aligny>
						<wrapmultiline>true</wrapmultiline>
						<font>Bald_MenuNote</font>
						<textcolor>bald_ink70</textcolor>
					</control>
					<control type="grouplist" id="130">
						<top>630</top>
						<width>380</width>
						<height>90</height>
						<orientation>vertical</orientation>
						<itemgap>8</itemgap>
						<control type="image">
							<width>380</width>
							<height>32</height>
							<aspectratio align="center">keep</aspectratio>
							<texture colordiffuse="bald_ink60">DefaultIconInfo.png</texture>
						</control>
						<control type="label">
							<description>notification</description>
							<width>380</width>
							<height>30</height>
							<label>$LOCALIZE[31096]</label>
							<align>center</align>
							<aligny>center</aligny>
							<font>Bald_Hint</font>
							<textcolor>bald_ink60</textcolor>
						</control>
					</control>
				</control>
			</control>
			<!-- Results. -->
			<control type="group">
				<top>130</top>
				<left>360</left>
				<control type="label">
					<description>Video label</description>
					<left>20</left>
					<top>-40</top>
					<width>900</width>
					<height>28</height>
					<font>Bald_RowLabel</font>
					<label>$INFO[Player.Filename]</label>
					<aligny>center</aligny>
					<textcolor>bald_ink60</textcolor>
					<scroll>true</scroll>
				</control>
				<control type="list" id="120">
					<width>920</width>
					<height>588</height>
					<onleft>150</onleft>
					<onright>73</onright>
					<onup>120</onup>
					<ondown>120</ondown>
					<pagecontrol>73</pagecontrol>
					<scrolltime tween="cubic" easing="out">200</scrolltime>
					<itemlayout width="920" height="84">
						<include content="Bald_PlaybackSubtitleRow">
							<param name="name_color">bald_ink70</param>
						</include>
					</itemlayout>
					<focusedlayout width="920" height="84">
						<control type="image">
							<left>0</left>
							<top>0</top>
							<width>920</width>
							<height>84</height>
							<texture colordiffuse="bald_ink10">bald/white.png</texture>
							<visible>Control.HasFocus(120)</visible>
						</control>
						<include content="Bald_PlaybackSubtitleRow">
							<param name="name_color">bald_ink</param>
						</include>
					</focusedlayout>
				</control>
				<control type="scrollbar" id="73">
					<left>932</left>
					<width>4</width>
					<height>588</height>
					<onleft>120</onleft>
					<onright>160</onright>
					<ondown>73</ondown>
					<onup>73</onup>
					<orientation>vertical</orientation>
					<showonepage>false</showonepage>
					<texturesliderbackground colordiffuse="bald_ink10">bald/white.png</texturesliderbackground>
					<texturesliderbar colordiffuse="bald_ink34">bald/white.png</texturesliderbar>
					<texturesliderbarfocus colordiffuse="bald_ink">bald/white.png</texturesliderbarfocus>
					<textureslidernib />
					<textureslidernibfocus />
				</control>
			</control>
			<!-- Services. -->
			<control type="group">
				<left>20</left>
				<top>130</top>
				<control type="label">
					<left>20</left>
					<top>-40</top>
					<width>300</width>
					<height>28</height>
					<label>$LOCALIZE[24018]</label>
					<font>Bald_RowLabel</font>
					<aligny>center</aligny>
					<textcolor>bald_ink60</textcolor>
				</control>
				<control type="image" id="110">
					<description>Service Logo</description>
					<top>500</top>
					<width>320</width>
					<height>80</height>
					<fadetime>200</fadetime>
					<aspectratio>keep</aspectratio>
				</control>
				<control type="list" id="150">
					<width>320</width>
					<height>480</height>
					<onleft>160</onleft>
					<onright>120</onright>
					<onup>150</onup>
					<ondown>150</ondown>
					<scrolltime tween="cubic" easing="out">200</scrolltime>
					<include content="DefaultSimpleListLayout">
						<param name="width" value="320" />
						<param name="height" value="80" />
						<param name="list_id" value="150" />
						<param name="align" value="left" />
					</include>
				</control>
			</control>
		</control>
	</controls>
</window>
