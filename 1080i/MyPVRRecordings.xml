<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald Live TV Recordings (TVRecordings, RadioRecordings). Started from Kodi 22 Estuary's MyPVRRecordings.xml
     (Team Kodi, GPL-2.0-or-later); Kodi's ids are kept: view 50, group items 5, show deleted 7, show mode 10,
     channel groups 28, sort 3 and 4, header labels 29 and 30, menucontrol 9000. -->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<views>50</views>
	<menucontrol>9000</menucontrol>
	<include>Bald_PVRAnimWindow</include>
	<controls>
		<include>Bald_PVRBackground</include>
		<control type="group">
			<include>Bald_PVRInfoDim</include>
			<include content="Bald_PVRWindowChrome">
				<param name="title">$LOCALIZE[19017]</param>
				<param name="section">$VAR[Bald_PVRArea]$INFO[Control.GetLabel(30), · ]$INFO[Control.GetLabel(29), · ]</param>
				<param name="hint">$LOCALIZE[31663]</param>
				<param name="footer_extra">$LOCALIZE[19116] $INFO[PVR.BackendDiskspace]</param>
				<param name="footer_extra_visible">!String.IsEmpty(PVR.BackendDiskspace) + !Integer.IsGreater(PVR.BackendDiskspaceProgr,100)</param>
			</include>
			<include content="Bald_PVRList">
				<include content="Bald_PVRItemLayouts">
					<param name="has_info_icon">true</param>
					<param name="info_icon">$VAR[ListPVRRecordingsIconVar]</param>
					<param name="text_left">74</param>
					<param name="label2">$VAR[ListLabel2Var]</param>
				</include>
			</include>
			<include content="Bald_PVROptions">
				<include content="Bald_PVROptionToggle"><param name="id">5</param><param name="label">$LOCALIZE[19270]</param></include>
				<include content="Bald_PVROptionToggle"><param name="id">7</param><param name="label">$LOCALIZE[19184]</param></include>
				<include content="Bald_PVROption"><param name="id">10</param><param name="label">$LOCALIZE[20367]</param><param name="label2">$INFO[Container.NumNonFolderItems]</param></include>
				<include>Bald_PVRSortOptions</include>
				<include content="Bald_PVROption"><param name="id">302</param><param name="label">$LOCALIZE[31056]</param><param name="onclick">ActivateWindow(videoplaylist)</param><param name="visible">Integer.IsGreater(Playlist.Length(video),0)</param></include>
				<include>Bald_PVRAreaOptions</include>
			</include>
		</control>
		<include>Bald_PVRNativeLabels</include>
	</controls>
</window>
