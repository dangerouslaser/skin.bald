<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald movie info dialog: variables, animations and repeated controls (docs/SPEC.md 5.2). -->
<includes>
	<expression name="Bald_InfoOwnBackdrop">[!Window.IsVisible(home)]</expression>
	<!-- The page in view (Bald.InfoSec on Home, set by each page's focusable controls): 0 Overview, 1 Cast & details,
	     2 More like this. -->
	<expression name="Bald_InfoOnOverview">[String.IsEqual(Window(home).Property(Bald.InfoSec),0)]</expression>
	<expression name="Bald_InfoOnCast">[String.IsEqual(Window(home).Property(Bald.InfoSec),1)]</expression>
	<expression name="Bald_InfoOnMore">[String.IsEqual(Window(home).Property(Bald.InfoSec),2)]</expression>
	<expression name="Bald_InfoHasCast">[Integer.IsGreater(Container(50).NumItems,0)]</expression>
	<!-- scripts/info.py found a recommendations path; the list may still be loading. -->
	<expression name="Bald_InfoHasMorePath">[!String.IsEmpty(Window(movieinformation).Property(Bald.MorePath))]</expression>
	<expression name="Bald_HasRecommendations">[$EXP[Bald_InfoHasMorePath] + Integer.IsGreater(Container(5100).NumItems,0)]</expression>
	<!-- A hidden still (Includes_Bald_Spoilers.xml) skips the episode's own poster, which Jellyfin sets to the still. -->
	<variable name="Bald_InfoPoster">
		<value condition="!String.IsEmpty(ListItem.Art(poster)) + !$EXP[Bald_SpoilerThumb]">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="$EXP[Bald_SpoilerThumb]" />
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<!-- Bald_ItemFanart for the highlighted recommendation. -->
	<variable name="Bald_ItemFanart5100">
		<value condition="!String.IsEmpty(Container(5100).ListItem.Art(fanart))">$INFO[Container(5100).ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(Container(5100).ListItem.Art(tvshow.fanart))">$INFO[Container(5100).ListItem.Art(tvshow.fanart)]</value>
		<value condition="$EXP[Bald_SpoilerThumb5100]">$VAR[Bald_SpoilerArt5100]</value>
		<value>$INFO[Container(5100).ListItem.Art(thumb)]</value>
	</variable>
	<variable name="Bald_MoreStatus">
		<value condition="$EXP[Bald_InfoHasMorePath] + Container(5100).IsUpdating">$LOCALIZE[31777]</value>
		<value>$LOCALIZE[31778]</value>
	</variable>
	<variable name="Bald_InfoPageTrail">
		<value condition="$EXP[Bald_InfoOnOverview]">[COLOR bald_ink]$LOCALIZE[31770][/COLOR]     ·     $LOCALIZE[31771]     ·     $LOCALIZE[31772]</value>
		<value>[COLOR bald_ink60]$LOCALIZE[31770][/COLOR]     ·     [COLOR bald_ink]$LOCALIZE[31771][/COLOR]     ·     $LOCALIZE[31772]</value>
	</variable>
	<!-- ============ Variables (ListItem.* is the dialog's item) ============ -->
	<variable name="Bald_InfoTitle">
		<value>$INFO[ListItem.Title]</value>
	</variable>
	<variable name="Bald_InfoMeta">
		<value condition="$EXP[Bald_InfoTVIsEpisode]">$INFO[ListItem.TVShowTitle] · S$INFO[ListItem.Season] E$INFO[ListItem.Episode]$INFO[ListItem.Duration(mins), · , $LOCALIZE[31710]]</value>
		<value condition="$EXP[Bald_InfoTVIsShow]">$VAR[Bald_InfoSeasons]</value>
		<value condition="Integer.IsGreaterOrEqual(ListItem.Duration(mins),60)">$INFO[ListItem.Year,,$COMMA ]$INFO[ListItem.Duration(h),,h ]$INFO[ListItem.Duration(mm),,m]</value>
		<value>$INFO[ListItem.Year]$INFO[ListItem.Duration(mins),$COMMA , $LOCALIZE[31710]]</value>
	</variable>
	<!-- A show's year and season count, shared by Cast & details and the TV Overview (which adds the rating). -->
	<variable name="Bald_InfoSeasons">
		<value condition="String.IsEqual(ListItem.Property(TotalSeasons),1)">$INFO[ListItem.Year,,$COMMA ]$LOCALIZE[31711]</value>
		<value>$INFO[ListItem.Year]$INFO[ListItem.Property(TotalSeasons),$COMMA , $LOCALIZE[31712]]</value>
	</variable>
	<variable name="Bald_InfoResolution">
		<value condition="String.IsEqual(ListItem.VideoResolution,4K)">4K</value>
		<value>$INFO[ListItem.VideoResolution,,p]</value>
	</variable>
	<variable name="Bald_InfoVideo">
		<!-- Kodi leaves the HDR type empty for SDR; with stream details present (a codec), that is SDR. -->
		<value condition="String.IsEmpty(ListItem.HdrType) + !String.IsEmpty(ListItem.VideoCodec)">$VAR[Bald_InfoResolution]$MAP[DefaultCodecMap, ListItem.VideoCodec, · ] · SDR</value>
		<value>$VAR[Bald_InfoResolution]$MAP[DefaultCodecMap, ListItem.VideoCodec, · ]$MAP[DefaultHdrMap, ListItem.HdrType, · ]</value>
	</variable>
	<variable name="Bald_InfoAudio">
		<value>$MAP[Bald_AudioCodec, ListItem.AudioCodec]$VAR[Bald_InfoChannels]$MAP[Bald_Language, ListItem.AudioLanguage, · ]</value>
	</variable>
	<variable name="Bald_InfoChannels">
		<value condition="Integer.IsGreater(ListItem.AudioChannels,10)">$INFO[ListItem.AudioChannels, · , $LOCALIZE[31714]]</value>
		<value>$MAP[Bald_AudioChannels, ListItem.AudioChannels, · ]</value>
	</variable>
	<variable name="Bald_InfoSubtitle">
		<value>$MAP[Bald_Language, ListItem.SubtitleLanguage]</value>
	</variable>
