<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald movie info dialog: variables, animations and repeated controls (docs/SPEC.md 5.2). -->
<includes>
	<expression name="Bald_InfoOwnBackdrop">!Window.IsVisible(home)</expression>
	<expression name="Bald_HasRecommendations">!String.IsEmpty(Window(movieinformation).Property(Bald.MorePath)) + Integer.IsGreater(Container(5100).NumItems,0)</expression>
	<variable name="Bald_InfoPoster">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<!-- Bald_ItemFanart for the highlighted recommendation. -->
	<variable name="Bald_ItemFanart5100">
		<value condition="!String.IsEmpty(Container(5100).ListItem.Art(fanart))">$INFO[Container(5100).ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(Container(5100).ListItem.Art(tvshow.fanart))">$INFO[Container(5100).ListItem.Art(tvshow.fanart)]</value>
		<value>$INFO[Container(5100).ListItem.Art(thumb)]</value>
	</variable>
	<variable name="Bald_MoreStatus">
		<value condition="!String.IsEmpty(Window(movieinformation).Property(Bald.MorePath)) + Container(5100).IsUpdating">Loading recommendations…</value>
		<value>No related titles in your library.</value>
	</variable>
	<variable name="Bald_InfoPageTrail">
		<value condition="String.IsEqual(Window(home).Property(Bald.InfoSec),0)">[COLOR bald_ink]Overview[/COLOR]     ·     Cast &amp; details     ·     More like this</value>
		<value>[COLOR bald_ink58]Overview[/COLOR]     ·     [COLOR bald_ink]Cast &amp; details[/COLOR]     ·     More like this</value>
	</variable>
	<!-- ============ Variables (ListItem.* is the dialog's item) ============ -->
	<variable name="Bald_InfoTitle">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.Title]</value>
		<value>$INFO[ListItem.Title]</value>
	</variable>
	<variable name="Bald_InfoMeta">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.TVShowTitle] · S$INFO[ListItem.Season] E$INFO[ListItem.Episode]$INFO[ListItem.Duration(mins), · , min]</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow)">$VAR[Bald_InfoSeasons]</value>
		<value condition="Integer.IsGreaterOrEqual(ListItem.Duration(mins),60)">$INFO[ListItem.Year,,$COMMA ]$INFO[ListItem.Duration(h),,h ]$INFO[ListItem.Duration(mm),,m]</value>
		<value>$INFO[ListItem.Year]$INFO[ListItem.Duration(mins),$COMMA , min]</value>
	</variable>
	<!-- A show's year and season count, shared by Cast & details and the TV Overview (which adds the rating). -->
	<variable name="Bald_InfoSeasons">
		<value condition="String.IsEqual(ListItem.Property(TotalSeasons),1)">$INFO[ListItem.Year,,$COMMA ]1 season</value>
		<value>$INFO[ListItem.Year]$INFO[ListItem.Property(TotalSeasons),$COMMA , seasons]</value>
	</variable>
	<variable name="Bald_InfoResolution">
		<value condition="String.IsEqual(ListItem.VideoResolution,4K)">4K</value>
		<value>$INFO[ListItem.VideoResolution,,p]</value>
	</variable>
	<variable name="Bald_InfoVideo">
		<value>$VAR[Bald_InfoResolution]$INFO[ListItem.VideoCodec,$COMMA ,]$INFO[ListItem.HdrType,$COMMA ,]</value>
	</variable>
	<variable name="Bald_InfoAudio">
		<value>$INFO[ListItem.AudioCodec]$INFO[ListItem.AudioChannels,$COMMA , channels]$INFO[ListItem.AudioLanguage,$COMMA ,]</value>
	</variable>

	<!-- ============ Animations ============ -->
	<!-- Info content in: fade 400 and rise 18 px over 560, base delay 380 plus the stagger (0, 60, 100, 140, 180, 220,
	     270, 310 in the prototype). -->
	<include name="Bald_AnimInfoIn">
		<param name="delay" />
		<definition>
			<animation type="WindowOpen">
				<effect type="fade" start="0" end="100" time="400" delay="$PARAM[delay]" tween="sine" easing="inout" />
				<effect type="slide" start="0,18" end="0,0" time="560" delay="$PARAM[delay]" tween="cubic" easing="out" />
			</animation>
		</definition>
	</include>
	<!-- Each fixed page owns one visibility transition; no compounded/reversing scroll offsets. -->
	<include name="Bald_InfoPage">
		<param name="page" />
		<definition>
			<visible allowhiddenfocus="true">String.IsEqual(Window(home).Property(Bald.InfoSec),$PARAM[page])</visible>
			<animation type="Visible" reversible="false">
				<effect type="fade" start="0" end="100" time="360" tween="sine" easing="inout" />
				<effect type="slide" start="0,18" end="0,0" time="560" tween="cubic" easing="out" />
			</animation>
			<animation type="Hidden" reversible="false">
				<effect type="fade" start="100" end="0" time="130" tween="sine" easing="inout" />
			</animation>
		</definition>
	</include>
	<!-- Movie Overview opens on Resume or Play (the grouplist remembers its last child, so focus it explicitly). -->
	<include name="Bald_InfoMovieOnLoad">
		<onload condition="ListItem.IsResumable">SetFocus(5001)</onload>
		<onload condition="!ListItem.IsResumable">SetFocus(5003)</onload>
	</include>
	<!-- Down to Cast & details: focus cast, or Details (5050) if cast is empty. Also the TV episode row's Down. -->
	<include name="Bald_InfoActionToCast">
		<ondown>SetProperty(Bald.InfoSec,1,home)</ondown>
		<ondown>ClearProperty(TMDbHelper.WidgetContainer,movieinformation)</ondown>
		<ondown condition="Integer.IsGreater(Container(50).NumItems,0)">SetFocus(50)</ondown>
		<ondown condition="!Integer.IsGreater(Container(50).NumItems,0)">SetFocus(5050)</ondown>
	</include>
	<!-- Up to Overview restores the actions; TV returns to the lowest filled row (episodes, then seasons).
	     Movies have no 5301/5302, so those conditions are false there. -->
	<include name="Bald_InfoToOverview">
		<onup>ClearProperty(TMDbHelper.WidgetContainer,movieinformation)</onup>
		<onup>SetProperty(Bald.InfoSec,0,home)</onup>
		<onup condition="$EXP[Bald_InfoTVHasEpisodes]">SetFocus(5302)</onup>
		<onup condition="!$EXP[Bald_InfoTVHasEpisodes] + $EXP[Bald_InfoTVHasSeasons]">SetFocus(5301)</onup>
		<onup condition="!$EXP[Bald_InfoTVHasEpisodes] + !$EXP[Bald_InfoTVHasSeasons]">SetFocus(5000)</onup>
	</include>
	<include name="Bald_InfoToMore">
		<ondown>SetProperty(Bald.InfoSec,2,home)</ondown>
		<ondown>SetProperty(TMDbHelper.WidgetContainer,5100,movieinformation)</ondown>
		<ondown condition="$EXP[Bald_HasRecommendations]">SetFocus(5100)</ondown>
		<ondown condition="!$EXP[Bald_HasRecommendations]">SetFocus(5150)</ondown>
	</include>
	<include name="Bald_InfoBackToCast">
		<onup>ClearProperty(TMDbHelper.WidgetContainer,movieinformation)</onup>
		<onup>SetProperty(Bald.InfoSec,1,home)</onup>
		<onup condition="Integer.IsGreater(Container(50).NumItems,0)">SetFocus(50)</onup>
		<onup condition="!Integer.IsGreater(Container(50).NumItems,0)">SetFocus(5050)</onup>
	</include>

	<!-- ============ Controls ============ -->
	<!-- A centered dot occupies the entire 20 px separator between the two directives. -->
	<include name="Bald_InfoHintPair">
		<param name="first" /><param name="second" />
		<param name="width">384</param><param name="third" /><param name="third_visible">false</param>
		<definition>
			<control type="grouplist">
				<width>$PARAM[width]</width><height>24</height><orientation>horizontal</orientation><align>right</align><itemgap>0</itemgap>
				<control type="label"><width>auto</width><height>24</height><aligny>center</aligny><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$PARAM[first]</label></control>
				<control type="label"><width>20</width><height>24</height><align>center</align><aligny>center</aligny><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>·</label></control>
				<control type="label"><width>auto</width><height>24</height><aligny>center</aligny><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$PARAM[second]</label></control>
				<control type="label"><width>20</width><height>24</height><align>center</align><aligny>center</aligny><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>·</label><visible>$PARAM[third_visible]</visible></control>
				<control type="label"><width>auto</width><height>24</height><aligny>center</aligny><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$PARAM[third]</label><visible>$PARAM[third_visible]</visible></control>
			</control>
		</definition>
	</include>
	<!-- Action pill: 54 px tall, 28 px side padding. Focused: filled ink, label in field, pop to 1.04 (260). -->
	<include name="Bald_InfoAction">
		<param name="id" />
		<param name="label" />
		<param name="onclick" />
		<param name="visible">true</param>
		<!-- Include holding the Down route: Cast & details for movies, the season tabs for TV. -->
		<param name="down">Bald_InfoActionToCast</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>auto</width>
				<height>54</height>
				<label>$PARAM[label]</label>
				<font>Bald_Section</font>
				<textoffsetx>28</textoffsetx>
				<aligny>center</aligny>
				<textcolor>bald_ink</textcolor>
				<focusedcolor>bald_field</focusedcolor>
				<texturenofocus border="27" colordiffuse="bald_ink45">bald/pill_outline.png</texturenofocus>
				<texturefocus border="27" colordiffuse="bald_ink">bald/pill.png</texturefocus>
				<onclick>$PARAM[onclick]</onclick>
				<!-- Navigation belongs to the focused button, not its grouplist. -->
				<include>$PARAM[down]</include>
				<onup>noop</onup>
				<onfocus>SetProperty(Bald.InfoSec,0,home)</onfocus>
				<onfocus>ClearProperty(TMDbHelper.WidgetContainer,movieinformation)</onfocus>
				<visible>$PARAM[visible]</visible>
				<animation type="Focus">
					<effect type="zoom" start="100" end="104" center="auto" time="260" tween="back" easing="out" />
				</animation>
				<animation type="Unfocus">
					<effect type="zoom" start="104" end="100" center="auto" time="220" tween="sine" easing="inout" />
				</animation>
			</control>
		</definition>
	</include>
	<!-- Cast member: 240 px slot: 112 px circle, two-line name and role. Focused: 3 px ink ring, pop to 1.06. -->
	<include name="Bald_CastItem">
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<animation type="Focus">
					<effect type="zoom" start="100" end="106" center="120,68" time="280" tween="back" easing="out" />
				</animation>
				<control type="image">
					<left>64</left>
					<top>12</top>
					<width>112</width>
					<height>112</height>
					<texture colordiffuse="bald_ink10">bald/circle_112.png</texture>
				</control>
				<control type="image">
					<left>64</left>
					<top>12</top>
					<width>112</width>
					<height>112</height>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<texture diffuse="bald/circle_112.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
				</control>
				<control type="image">
					<left>61</left>
					<top>9</top>
					<width>118</width>
					<height>118</height>
					<texture colordiffuse="bald_ink">bald/ring_118.png</texture>
					<visible>$PARAM[focused]</visible>
				</control>
			</control>
			<control type="label">
				<left>10</left>
				<top>138</top>
				<width>220</width>
				<height>44</height>
				<wrapmultiline>true</wrapmultiline><aligny>top</aligny>
				<align>center</align>
				<font>Bald_CastName</font>
				<textcolor>bald_ink</textcolor>
				<label>$INFO[ListItem.Label]</label>
			</control>
			<control type="label">
				<left>10</left>
				<top>188</top>
				<width>220</width>
				<height>44</height>
				<wrapmultiline>true</wrapmultiline><aligny>top</aligny>
				<align>center</align>
				<font>Bald_CastRole</font>
				<textcolor>bald_ink60</textcolor>
				<label>$INFO[ListItem.Label2]</label>
			</control>
		</definition>
	</include>
	<!-- Detail cell: 380 px wide; label 17 px at 58%, two-line value 21 px medium. -->
	<include name="Bald_Detail">
		<param name="x" />
		<param name="y" />
		<param name="vy" />
		<param name="label" />
		<param name="value" />
		<definition>
			<control type="label">
				<left>$PARAM[x]</left>
				<top>$PARAM[y]</top>
				<width>380</width>
				<height>22</height>
				<font>Bald_DetailLabel</font>
				<textcolor>bald_ink58</textcolor>
				<label>$PARAM[label]</label>
			</control>
			<control type="label">
				<left>$PARAM[x]</left>
				<top>$PARAM[vy]</top>
				<width>380</width>
				<height>56</height>
				<wrapmultiline>true</wrapmultiline><aligny>top</aligny>
				<font>Bald_DetailValue</font>
				<textcolor>bald_ink</textcolor>
				<label>$PARAM[value]</label>
			</control>
		</definition>
	</include>
</includes>
