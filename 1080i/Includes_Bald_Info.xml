	<!-- ============ Animations ============ -->
	<!-- Info content in: fade 400 and rise 18 px over 560, base delay 380 plus the stagger (0, 60, 100, 140, 180, 220,
	     270, 310 in the prototype). -->
	<include name="Bald_AnimInfoIn">
		<param name="delay" />
		<definition>
			<animation type="WindowOpen" condition="$EXP[Bald_FullMotion]">
				<effect type="fade" start="0" end="100" time="400" delay="$PARAM[delay]" tween="sine" easing="inout" />
				<effect type="slide" start="0,18" end="0,0" time="560" delay="$PARAM[delay]" tween="cubic" easing="out" />
			</animation>
			<animation type="WindowOpen" condition="$EXP[Bald_ReduceMotion]">
				<effect type="fade" start="0" end="100" time="400" delay="$PARAM[delay]" tween="sine" easing="inout" />
			</animation>
		</definition>
	</include>
	<!-- Each fixed page owns one visibility transition; no compounded/reversing scroll offsets. -->
	<include name="Bald_InfoPage">
		<param name="page" />
		<definition>
			<visible allowhiddenfocus="true">String.IsEqual(Window(home).Property(Bald.InfoSec),$PARAM[page])</visible>
			<animation type="Visible" condition="$EXP[Bald_FullMotion]" reversible="false">
				<effect type="fade" start="0" end="100" time="360" tween="sine" easing="inout" />
				<effect type="slide" start="0,18" end="0,0" time="560" tween="cubic" easing="out" />
			</animation>
			<animation type="Visible" condition="$EXP[Bald_ReduceMotion]" reversible="false">
				<effect type="fade" start="0" end="100" time="360" tween="sine" easing="inout" />
			</animation>
			<animation type="Hidden" reversible="false">
				<effect type="fade" start="100" end="0" time="130" tween="sine" easing="inout" />
			</animation>
		</definition>
	</include>
	<!-- Movie Overview opens on Resume or Play (the grouplist remembers its last child, so focus it explicitly). -->
	<include name="Bald_InfoMovieOnLoad">
		<onload condition="ListItem.IsResumable">SetFocus(5001)</onload>
		<onload condition="!ListItem.IsResumable">SetFocus(5003)</onload>
	</include>
	<!-- Down to Cast & details: focus cast, or Details (5050) if cast is empty. Also the TV episode row's Down. -->
	<include name="Bald_InfoActionToCast">
		<ondown>SetProperty(Bald.InfoSec,1,home)</ondown>
		<include content="Bald_UnfollowContainerOnDown"><param name="window">movieinformation</param></include>
		<ondown condition="$EXP[Bald_InfoHasCast]">SetFocus(50)</ondown>
		<ondown condition="!$EXP[Bald_InfoHasCast]">SetFocus(5050)</ondown>
	</include>
	<!-- Up to Overview restores the actions; TV returns to the lowest filled row (episodes, then seasons).
	     Movies have no 5301/5302, so those conditions are false there. -->
	<include name="Bald_InfoToOverview">
		<include content="Bald_UnfollowContainerOnUp"><param name="window">movieinformation</param></include>
		<onup>SetProperty(Bald.InfoSec,0,home)</onup>
		<onup condition="$EXP[Bald_InfoTVHasEpisodes]">SetFocus(5302)</onup>
		<onup condition="!$EXP[Bald_InfoTVHasEpisodes] + $EXP[Bald_InfoTVHasSeasons]">SetFocus(5301)</onup>
		<onup condition="!$EXP[Bald_InfoTVHasEpisodes] + !$EXP[Bald_InfoTVHasSeasons]">SetFocus(5000)</onup>
	</include>
	<include name="Bald_InfoToMore">
		<ondown>SetProperty(Bald.InfoSec,2,home)</ondown>
		<include content="Bald_FollowContainerOnDown"><param name="id">5100</param><param name="window">movieinformation</param></include>
		<ondown condition="$EXP[Bald_HasRecommendations]">SetFocus(5100)</ondown>
		<ondown condition="!$EXP[Bald_HasRecommendations]">SetFocus(5150)</ondown>
	</include>
	<include name="Bald_InfoBackToCast">
		<include content="Bald_UnfollowContainerOnUp"><param name="window">movieinformation</param></include>
		<onup>SetProperty(Bald.InfoSec,1,home)</onup>
		<onup condition="$EXP[Bald_InfoHasCast]">SetFocus(50)</onup>
		<onup condition="!$EXP[Bald_InfoHasCast]">SetFocus(5050)</onup>
	</include>

	<!-- ============ Controls ============ -->
	<!-- A centered dot occupies the entire 20 px separator between the two directives. -->
	<include name="Bald_InfoHintPair">
		<param name="first" /><param name="second" />
		<param name="width">384</param><param name="third" /><param name="third_visible">false</param>
		<definition>
			<control type="grouplist">
				<width>$PARAM[width]</width><height>24</height><orientation>horizontal</orientation><align>right</align><itemgap>0</itemgap>
				<control type="label"><width>auto</width><height>24</height><aligny>center</aligny><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$PARAM[first]</label></control>
				<control type="label"><width>20</width><height>24</height><align>center</align><aligny>center</aligny><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>·</label></control>
				<control type="label"><width>auto</width><height>24</height><aligny>center</aligny><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$PARAM[second]</label></control>
				<control type="label"><width>20</width><height>24</height><align>center</align><aligny>center</aligny><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>·</label><visible>$PARAM[third_visible]</visible></control>
				<control type="label"><width>auto</width><height>24</height><aligny>center</aligny><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$PARAM[third]</label><visible>$PARAM[third_visible]</visible></control>
			</control>
		</definition>
	</include>
	<!-- Action pill: 54 px tall, 28 px side padding. Focused: filled ink, label in field, pop to 1.04 (260). -->
	<include name="Bald_InfoAction">
		<param name="id" />
		<param name="label" />
		<param name="onclick" />
		<!-- Optional: a Bald Helper request sent in place of onclick while helper_if holds. -->
		<param name="helper">noop</param>
		<param name="helper_if">false</param>
		<param name="visible">true</param>
		<!-- Include holding the Down route: Cast & details for movies, the season tabs for TV. -->
		<param name="down">Bald_InfoActionToCast</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>auto</width>
				<height>54</height>
				<label>$PARAM[label]</label>
				<font>Bald_Section</font>
				<textoffsetx>28</textoffsetx>
				<aligny>center</aligny>
				<textcolor>bald_ink</textcolor>
				<focusedcolor>bald_field</focusedcolor>
				<texturenofocus border="27" colordiffuse="bald_ink45">bald/pill_outline.png</texturenofocus>
				<texturefocus border="27" colordiffuse="bald_ink">bald/pill.png</texturefocus>
				<onclick condition="![$PARAM[helper_if]]">$PARAM[onclick]</onclick>
				<onclick condition="$PARAM[helper_if]">$PARAM[helper]</onclick>
				<!-- Navigation belongs to the focused button, not its grouplist. -->
				<include>$PARAM[down]</include>
				<onup>noop</onup>
				<onfocus>SetProperty(Bald.InfoSec,0,home)</onfocus>
				<include content="Bald_UnfollowContainerOnFocus"><param name="window">movieinformation</param></include>
				<visible>$PARAM[visible]</visible>
				<animation type="Focus" condition="$EXP[Bald_FullMotion]">
					<effect type="zoom" start="100" end="104" center="auto" time="260" tween="back" easing="out" />
				</animation>
				<animation type="Unfocus" condition="$EXP[Bald_FullMotion]">
					<effect type="zoom" start="104" end="100" center="auto" time="220" tween="cubic" easing="out" />
				</animation>
			</control>
		</definition>
	</include>
	<!-- Cast member: 240 px slot: 112 px circle, two-line name and role. Focused: 3 px ink ring, pop to 1.06. -->
	<include name="Bald_CastItem">
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<animation type="Focus" condition="$EXP[Bald_FullMotion]">
					<effect type="zoom" start="100" end="106" center="120,68" time="280" tween="back" easing="out" />
				</animation>
				<control type="image">
					<left>64</left>
					<top>12</top>
					<width>112</width>
					<height>112</height>
					<texture colordiffuse="bald_ink10">bald/circle_112.png</texture>
				</control>
				<control type="image">
					<left>64</left>
					<top>12</top>
					<width>112</width>
					<height>112</height>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<texture diffuse="bald/circle_112.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
				</control>
				<control type="image">
					<left>61</left>
					<top>9</top>
					<width>118</width>
					<height>118</height>
					<texture colordiffuse="bald_ink">bald/ring_118.png</texture>
					<visible>$PARAM[focused]</visible>
				</control>
			</control>
			<control type="label">
				<left>10</left>
				<top>138</top>
				<width>220</width>
				<height>44</height>
				<wrapmultiline>true</wrapmultiline><aligny>top</aligny>
				<align>center</align>
				<font>Bald_CastName</font>
				<textcolor>bald_ink</textcolor>
				<label>$INFO[ListItem.Label]</label>
			</control>
			<control type="label">
				<left>10</left>
				<top>188</top>
				<width>220</width>
				<height>44</height>
				<wrapmultiline>true</wrapmultiline><aligny>top</aligny>
				<align>center</align>
				<font>Bald_CastRole</font>
				<textcolor>bald_ink60</textcolor>
				<label>$INFO[ListItem.Label2]</label>
			</control>
		</definition>
	</include>
	<!-- Detail cell: 380 px wide; label 17 px at 58%, two-line value 21 px medium, or Kodi's "Not available" in the
	     same style while the value is empty (<id> names the value label so the fallback can read it; ids in 1080i/IDs). -->
	<include name="Bald_Detail">
		<param name="id" />
		<param name="x" />
		<param name="y" />
