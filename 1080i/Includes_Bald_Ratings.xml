	<!-- ============ One rating ============
	     A quiet pill: the source mark in the accent, the value in ink, on a 10% ink fill with no outline, so it never
	     reads as a media flag chip (outlined). Two buttons, with and without the vote count; a disabled button sizes to
	     its label (width auto), as the flag chips do. -->
	<include name="Bald_RatingItem">
		<param name="mark" />
		<param name="value" />
		<param name="visible">true</param>
		<!-- The vote count's infolabel and whether it has one; sources without votes leave has_votes false (the default
		     infolabel only keeps the unused votes button's label valid). -->
		<param name="votes">ListItem.Votes</param>
		<param name="has_votes">false</param>
		<param name="top">0</param>
		<param name="height">26</param>
		<param name="font">Bald_Flag</param>
		<definition>
			<include content="Bald_RatingPill">
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
				<param name="label">[COLOR bald_accent]$PARAM[mark][/COLOR] $PARAM[value]</param>
				<param name="visible">[$PARAM[visible]] + ![$EXP[Bald_RatingVotes] + [$PARAM[has_votes]]]</param>
			</include>
			<include content="Bald_RatingPill">
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
				<param name="label">[COLOR bald_accent]$PARAM[mark][/COLOR] $PARAM[value][COLOR bald_ink60] · $INFO[$PARAM[votes]][/COLOR]</param>
				<param name="visible">[$PARAM[visible]] + $EXP[Bald_RatingVotes] + [$PARAM[has_votes]]</param>
			</include>
		</definition>
	</include>
	<include name="Bald_RatingPill">
		<param name="label" />
		<param name="visible" />
		<param name="top">0</param>
		<param name="height" />
		<param name="font" />
		<definition>
			<control type="button">
				<top>$PARAM[top]</top>
				<width>auto</width>
				<height>$PARAM[height]</height>
				<label>$PARAM[label]</label>
				<font>$PARAM[font]</font>
				<textoffsetx>10</textoffsetx>
				<aligny>center</aligny>
				<textcolor>bald_ink</textcolor>
				<disabledcolor>bald_ink</disabledcolor>
				<texturenofocus border="6" colordiffuse="bald_ink10">bald/chip_fill.png</texturenofocus>
				<texturefocus border="6" colordiffuse="bald_ink10">bald/chip_fill.png</texturefocus>
				<enable>false</enable>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- ============ A list item's ratings ============
	     The items for one library or plugin item, as children of the caller's horizontal grouplist (hidden items take no
	     space), in a fixed order: IMDb, TMDb, Rotten Tomatoes critics and audience, Metacritic, Trakt, TVDb, the user's
	     own, then Kodi's default rating when none of the named sources has one.
	     fallback: true fills Rotten Tomatoes, Metacritic and Trakt from TMDb Helper's ListItem monitor when the library
	     has no value. Only the info dialog passes it: the monitor follows one item, the dialog's, while Home and the
	     library draw a caption per row and parity and would show the previous item's scores for a moment. -->
	<include name="Bald_Ratings">
		<param name="container" />
		<param name="fallback">false</param>
		<!-- A further condition on every item, for callers that place the items in their own grouplist. -->
		<param name="visible">true</param>
		<param name="top">0</param>
		<param name="height">26</param>
		<param name="font">Bald_Flag</param>
		<definition>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31303]</param>
				<param name="value">$INFO[$PARAM[container]ListItem.Rating(imdb)]</param>
				<param name="visible">[$PARAM[visible]] + $EXP[Bald_RatingIMDb] + !String.IsEmpty($PARAM[container]ListItem.Rating(imdb))</param>
				<param name="votes">$PARAM[container]ListItem.Votes(imdb)</param>
				<param name="has_votes">!String.IsEqual($PARAM[container]ListItem.Votes(imdb),0)</param>
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31304]</param>
				<param name="value">$MAP[Bald_RatingPercent, $PARAM[container]ListItem.Rating(themoviedb)]%</param>
				<param name="visible">[$PARAM[visible]] + $EXP[Bald_RatingTMDb] + !String.IsEmpty($PARAM[container]ListItem.Rating(themoviedb))</param>
				<param name="votes">$PARAM[container]ListItem.Votes(themoviedb)</param>
				<param name="has_votes">!String.IsEqual($PARAM[container]ListItem.Votes(themoviedb),0)</param>
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<!-- The TV scraper names TMDb "tmdb"; shown only when there is no "themoviedb". -->
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31304]</param>
				<param name="value">$MAP[Bald_RatingPercent, $PARAM[container]ListItem.Rating(tmdb)]%</param>
				<param name="visible">[$PARAM[visible]] + $EXP[Bald_RatingTMDb] + String.IsEmpty($PARAM[container]ListItem.Rating(themoviedb)) + !String.IsEmpty($PARAM[container]ListItem.Rating(tmdb))</param>
				<param name="votes">$PARAM[container]ListItem.Votes(tmdb)</param>
				<param name="has_votes">!String.IsEqual($PARAM[container]ListItem.Votes(tmdb),0)</param>
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31305]</param>
				<param name="value">$MAP[Bald_RatingPercent, $PARAM[container]ListItem.Rating(tomatometerallcritics)]%</param>
				<param name="visible">[$PARAM[visible]] + $EXP[Bald_RatingRTCritics] + !String.IsEmpty($PARAM[container]ListItem.Rating(tomatometerallcritics))</param>
				<param name="votes">$PARAM[container]ListItem.Votes(tomatometerallcritics)</param>
				<param name="has_votes">!String.IsEqual($PARAM[container]ListItem.Votes(tomatometerallcritics),0)</param>
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31305]</param>
				<param name="value">$INFO[Window(Home).Property(TMDbHelper.ListItem.rottentomatoes_rating)]%</param>
				<param name="visible">[$PARAM[visible]] + [$PARAM[fallback]] + $EXP[Bald_HasTMDbHelper] + $EXP[Bald_RatingRTCritics] + String.IsEmpty($PARAM[container]ListItem.Rating(tomatometerallcritics)) + !String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.rottentomatoes_rating))</param>
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31306]</param>
				<param name="value">$MAP[Bald_RatingPercent, $PARAM[container]ListItem.Rating(tomatometerallaudience)]%</param>
				<param name="visible">[$PARAM[visible]] + $EXP[Bald_RatingRTAudience] + !String.IsEmpty($PARAM[container]ListItem.Rating(tomatometerallaudience))</param>
				<param name="votes">$PARAM[container]ListItem.Votes(tomatometerallaudience)</param>
				<param name="has_votes">!String.IsEqual($PARAM[container]ListItem.Votes(tomatometerallaudience),0)</param>
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31306]</param>
				<param name="value">$INFO[Window(Home).Property(TMDbHelper.ListItem.rottentomatoes_usermeter)]%</param>
				<param name="visible">[$PARAM[visible]] + [$PARAM[fallback]] + $EXP[Bald_HasTMDbHelper] + $EXP[Bald_RatingRTAudience] + String.IsEmpty($PARAM[container]ListItem.Rating(tomatometerallaudience)) + !String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.rottentomatoes_usermeter))</param>
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31307]</param>
				<param name="value">$MAP[Bald_RatingPercent, $PARAM[container]ListItem.Rating(metacritic)]</param>
				<param name="visible">[$PARAM[visible]] + $EXP[Bald_RatingMetacritic] + !String.IsEmpty($PARAM[container]ListItem.Rating(metacritic))</param>
				<param name="votes">$PARAM[container]ListItem.Votes(metacritic)</param>
				<param name="has_votes">!String.IsEqual($PARAM[container]ListItem.Votes(metacritic),0)</param>
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31307]</param>
				<param name="value">$INFO[Window(Home).Property(TMDbHelper.ListItem.metacritic_rating)]</param>
				<param name="visible">[$PARAM[visible]] + [$PARAM[fallback]] + $EXP[Bald_HasTMDbHelper] + $EXP[Bald_RatingMetacritic] + String.IsEmpty($PARAM[container]ListItem.Rating(metacritic)) + !String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.metacritic_rating))</param>
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31308]</param>
				<param name="value">$MAP[Bald_RatingPercent, $PARAM[container]ListItem.Rating(trakt)]%</param>
				<param name="visible">[$PARAM[visible]] + $EXP[Bald_RatingTrakt] + !String.IsEmpty($PARAM[container]ListItem.Rating(trakt))</param>
				<param name="votes">$PARAM[container]ListItem.Votes(trakt)</param>
				<param name="has_votes">!String.IsEqual($PARAM[container]ListItem.Votes(trakt),0)</param>
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31308]</param>
				<param name="value">$MAP[Bald_RatingPercent, Window(Home).Property(TMDbHelper.ListItem.trakt_rating)]%</param>
				<param name="visible">[$PARAM[visible]] + [$PARAM[fallback]] + $EXP[Bald_HasTMDbHelper] + $EXP[Bald_RatingTrakt] + String.IsEmpty($PARAM[container]ListItem.Rating(trakt)) + !String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.trakt_rating))</param>
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31309]</param>
				<param name="value">$INFO[$PARAM[container]ListItem.Rating(tvdb)]</param>
				<param name="visible">[$PARAM[visible]] + $EXP[Bald_RatingTVDb] + !String.IsEmpty($PARAM[container]ListItem.Rating(tvdb))</param>
				<param name="votes">$PARAM[container]ListItem.Votes(tvdb)</param>
				<param name="has_votes">!String.IsEqual($PARAM[container]ListItem.Votes(tvdb),0)</param>
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31310]</param>
				<param name="value">$INFO[$PARAM[container]ListItem.UserRating]</param>
				<param name="visible">[$PARAM[visible]] + $EXP[Bald_RatingUser] + !String.IsEmpty($PARAM[container]ListItem.UserRating)</param>
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<!-- Kodi's default rating, only when no name above has a value: an NFO <rating> without a name, a single
			     <rating> tag, or a source Bald does not name (Letterboxd, for example). -->
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[563]</param>
				<param name="value">$INFO[$PARAM[container]ListItem.Rating]</param>
				<param name="visible">[$PARAM[visible]] + $EXP[Bald_RatingDefault] + !String.IsEmpty($PARAM[container]ListItem.Rating) + String.IsEmpty($PARAM[container]ListItem.Rating(imdb)) + String.IsEmpty($PARAM[container]ListItem.Rating(themoviedb)) + String.IsEmpty($PARAM[container]ListItem.Rating(tmdb)) + String.IsEmpty($PARAM[container]ListItem.Rating(tomatometerallcritics)) + String.IsEmpty($PARAM[container]ListItem.Rating(tomatometerallaudience)) + String.IsEmpty($PARAM[container]ListItem.Rating(metacritic)) + String.IsEmpty($PARAM[container]ListItem.Rating(trakt)) + String.IsEmpty($PARAM[container]ListItem.Rating(tvdb))</param>
				<param name="votes">$PARAM[container]ListItem.Votes</param>
				<param name="has_votes">!String.IsEqual($PARAM[container]ListItem.Votes,0)</param>
				<param name="top">$PARAM[top]</param><param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
		</definition>
	</include>

	<!-- ============ A rating row ============
	     A horizontal grouplist of Bald_Ratings, shown on a surface (`visible`, one of the Bald_Ratings<surface>
	     expressions) when the item has at least one rating to show, and hidden otherwise so a vertical caption closes
	     up. Animations and any further <visible> go in as nested content. -->
	<include name="Bald_RatingsRow">
		<param name="container" />
		<param name="visible">$EXP[Bald_RatingsOn]</param>
		<param name="fallback">false</param>
		<param name="left">0</param>
		<param name="top">0</param>
		<param name="width">528</param>
		<param name="height">26</param>
		<param name="font">Bald_Flag</param>
		<param name="align">left</param>
		<definition>
			<control type="grouplist">
				<left>$PARAM[left]</left>
				<top>$PARAM[top]</top>
				<width>$PARAM[width]</width>
				<height>$PARAM[height]</height>
				<orientation>horizontal</orientation>
				<align>$PARAM[align]</align>
				<itemgap>8</itemgap>
				<visible>[$PARAM[visible]] + [[$EXP[Bald_RatingIMDb] + !String.IsEmpty($PARAM[container]ListItem.Rating(imdb))] | [$EXP[Bald_RatingTMDb] + [!String.IsEmpty($PARAM[container]ListItem.Rating(themoviedb)) | !String.IsEmpty($PARAM[container]ListItem.Rating(tmdb))]] | [$EXP[Bald_RatingRTCritics] + [!String.IsEmpty($PARAM[container]ListItem.Rating(tomatometerallcritics)) | [[$PARAM[fallback]] + $EXP[Bald_HasTMDbHelper] + !String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.rottentomatoes_rating))]]] | [$EXP[Bald_RatingRTAudience] + [!String.IsEmpty($PARAM[container]ListItem.Rating(tomatometerallaudience)) | [[$PARAM[fallback]] + $EXP[Bald_HasTMDbHelper] + !String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.rottentomatoes_usermeter))]]] | [$EXP[Bald_RatingMetacritic] + [!String.IsEmpty($PARAM[container]ListItem.Rating(metacritic)) | [[$PARAM[fallback]] + $EXP[Bald_HasTMDbHelper] + !String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.metacritic_rating))]]] | [$EXP[Bald_RatingTrakt] + [!String.IsEmpty($PARAM[container]ListItem.Rating(trakt)) | [[$PARAM[fallback]] + $EXP[Bald_HasTMDbHelper] + !String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.trakt_rating))]]] | [$EXP[Bald_RatingTVDb] + !String.IsEmpty($PARAM[container]ListItem.Rating(tvdb))] | [$EXP[Bald_RatingUser] + !String.IsEmpty($PARAM[container]ListItem.UserRating)] | [$EXP[Bald_RatingDefault] + !String.IsEmpty($PARAM[container]ListItem.Rating)]]</visible>
				<nested />
				<include content="Bald_Ratings">
					<param name="container">$PARAM[container]</param>
					<param name="fallback">$PARAM[fallback]</param>
					<param name="height">$PARAM[height]</param>
					<param name="font">$PARAM[font]</param>
				</include>
			</control>
		</definition>
	</include>

	<!-- ============ The playing video's ratings (video OSD info overlay and details on the controls) ============
	     Kodi's player has no named ratings (VideoPlayer.Rating ignores a name), so the named sources come from TMDb
	     Helper's player monitor when it is installed and its online ratings are on; the player's own default rating
	     shows when TMDb Helper has none, and the user's rating always. Children of the caller's grouplist. -->
	<include name="Bald_RatingsPlayer">
		<param name="height">26</param>
		<param name="font">Bald_Flag</param>
		<definition>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31303]</param>
				<param name="value">$INFO[Window(Home).Property(TMDbHelper.Player.imdb_rating)]</param>
				<param name="visible">$EXP[Bald_RatingsOSD] + $EXP[Bald_HasTMDbHelper] + $EXP[Bald_RatingIMDb] + !String.IsEmpty(Window(Home).Property(TMDbHelper.Player.imdb_rating))</param>
				<param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31304]</param>
				<param name="value">$MAP[Bald_RatingPercent, Window(Home).Property(TMDbHelper.Player.tmdb_rating)]%</param>
				<param name="visible">$EXP[Bald_RatingsOSD] + $EXP[Bald_HasTMDbHelper] + $EXP[Bald_RatingTMDb] + !String.IsEmpty(Window(Home).Property(TMDbHelper.Player.tmdb_rating))</param>
				<param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31305]</param>
				<param name="value">$INFO[Window(Home).Property(TMDbHelper.Player.rottentomatoes_rating)]%</param>
				<param name="visible">$EXP[Bald_RatingsOSD] + $EXP[Bald_HasTMDbHelper] + $EXP[Bald_RatingRTCritics] + !String.IsEmpty(Window(Home).Property(TMDbHelper.Player.rottentomatoes_rating))</param>
				<param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31306]</param>
				<param name="value">$INFO[Window(Home).Property(TMDbHelper.Player.rottentomatoes_usermeter)]%</param>
				<param name="visible">$EXP[Bald_RatingsOSD] + $EXP[Bald_HasTMDbHelper] + $EXP[Bald_RatingRTAudience] + !String.IsEmpty(Window(Home).Property(TMDbHelper.Player.rottentomatoes_usermeter))</param>
				<param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31307]</param>
				<param name="value">$INFO[Window(Home).Property(TMDbHelper.Player.metacritic_rating)]</param>
				<param name="visible">$EXP[Bald_RatingsOSD] + $EXP[Bald_HasTMDbHelper] + $EXP[Bald_RatingMetacritic] + !String.IsEmpty(Window(Home).Property(TMDbHelper.Player.metacritic_rating))</param>
				<param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31308]</param>
				<param name="value">$MAP[Bald_RatingPercent, Window(Home).Property(TMDbHelper.Player.trakt_rating)]%</param>
				<param name="visible">$EXP[Bald_RatingsOSD] + $EXP[Bald_HasTMDbHelper] + $EXP[Bald_RatingTrakt] + !String.IsEmpty(Window(Home).Property(TMDbHelper.Player.trakt_rating))</param>
				<param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[31310]</param>
				<param name="value">$INFO[VideoPlayer.UserRating]</param>
				<param name="visible">$EXP[Bald_RatingsOSD] + $EXP[Bald_RatingUser] + !String.IsEmpty(VideoPlayer.UserRating)</param>
				<param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
			<include content="Bald_RatingItem">
				<param name="mark">$LOCALIZE[563]</param>
				<param name="value">$INFO[VideoPlayer.Rating]</param>
				<param name="visible">$EXP[Bald_RatingsOSD] + $EXP[Bald_RatingDefault] + !String.IsEmpty(VideoPlayer.Rating) + String.IsEmpty(Window(Home).Property(TMDbHelper.Player.imdb_rating)) + String.IsEmpty(Window(Home).Property(TMDbHelper.Player.tmdb_rating)) + String.IsEmpty(Window(Home).Property(TMDbHelper.Player.rottentomatoes_rating)) + String.IsEmpty(Window(Home).Property(TMDbHelper.Player.rottentomatoes_usermeter)) + String.IsEmpty(Window(Home).Property(TMDbHelper.Player.metacritic_rating)) + String.IsEmpty(Window(Home).Property(TMDbHelper.Player.trakt_rating))</param>
				<param name="votes">VideoPlayer.Votes</param>
				<param name="has_votes">!String.IsEqual(VideoPlayer.Votes,0)</param>
				<param name="height">$PARAM[height]</param><param name="font">$PARAM[font]</param>
			</include>
		</definition>
	</include>
</includes>
