<?xml version="1.0" encoding="UTF-8"?>
<!-- Ratings: the scores the video library already holds (NFO <ratings> or a scraper), one quiet item per source.

     Kodi 22 facts this file rests on (xbmc master, docs/NOTES.md "Ratings in media views"):
     - ListItem.Rating(name) is the named rating, "" when the item has none; without a name it is the item's default
       rating. Kodi stores every rating on a 0-10 scale (an NFO max="100" is divided on import) and prints it with one
       decimal in the system locale ("7.8", or "7,8"). ListItem.Votes(name) prints "0" when there are no votes.
       ListItem.UserRating is the user's own 1-10. There is no ListItem.DefaultRating.
     - VideoPlayer.Rating takes no name (Kodi drops the parameter), so the player only has the default and user
       ratings; with TMDb Helper its player monitor fills the named sources (TMDbHelper.Player.*).
     - $MAP[map, info] looks the value up and returns it unchanged when there is no entry (Kodi 22 skin maps).
     Names read: imdb; themoviedb (movie scraper, Radarr) or tmdb (TV scraper); tomatometerallcritics,
     tomatometerallaudience and metacritic (NFO editors, Radarr, tinyMediaManager via OMDb); trakt; tvdb.

     Item prefix: `container` is the text before ListItem, as for Bald_MediaFlags (Includes_Bald_Common.xml). -->
<includes>
	<!-- ============ Settings (Appearance > Ratings, Custom_1118_BaldAppearance.xml) ============
	     Named so that unset is the default: everything on, vote counts off. -->
	<expression name="Bald_RatingsOn">[!Skin.HasSetting(Bald.Ratings.Hide)]</expression>
	<expression name="Bald_RatingsInfo">[$EXP[Bald_RatingsOn] + !Skin.HasSetting(Bald.Ratings.NoInfo)]</expression>
	<expression name="Bald_RatingsHome">[$EXP[Bald_RatingsOn] + !Skin.HasSetting(Bald.Ratings.NoHome)]</expression>
	<expression name="Bald_RatingsLibrary">[$EXP[Bald_RatingsOn] + !Skin.HasSetting(Bald.Ratings.NoLibrary)]</expression>
	<expression name="Bald_RatingsOSD">[$EXP[Bald_RatingsOn] + !Skin.HasSetting(Bald.Ratings.NoOSD)]</expression>
	<expression name="Bald_RatingIMDb">[!Skin.HasSetting(Bald.Ratings.NoIMDb)]</expression>
	<expression name="Bald_RatingTMDb">[!Skin.HasSetting(Bald.Ratings.NoTMDb)]</expression>
	<expression name="Bald_RatingRTCritics">[!Skin.HasSetting(Bald.Ratings.NoRTCritics)]</expression>
	<expression name="Bald_RatingRTAudience">[!Skin.HasSetting(Bald.Ratings.NoRTAudience)]</expression>
	<expression name="Bald_RatingMetacritic">[!Skin.HasSetting(Bald.Ratings.NoMetacritic)]</expression>
	<expression name="Bald_RatingTrakt">[!Skin.HasSetting(Bald.Ratings.NoTrakt)]</expression>
	<expression name="Bald_RatingTVDb">[!Skin.HasSetting(Bald.Ratings.NoTVDb)]</expression>
	<expression name="Bald_RatingUser">[!Skin.HasSetting(Bald.Ratings.NoUser)]</expression>
	<expression name="Bald_RatingDefault">[!Skin.HasSetting(Bald.Ratings.NoDefault)]</expression>
	<expression name="Bald_RatingVotes">[Skin.HasSetting(Bald.Ratings.ShowVotes)]</expression>
	<!-- One Appearance > Ratings row (category item 6) for a negative bool: on (accent dot) while <setting> is unset.
	     The rows under the master switch grey out while ratings are off. -->
	<include name="Bald_RatingsSettingRow">
		<param name="id" />
		<param name="label" />
		<param name="setting" />
		<param name="enable">!Skin.HasSetting(Bald.Ratings.Hide)</param>
		<definition>
			<control type="radiobutton" id="$PARAM[id]">
				<include content="Bald_SettingRow"><param name="list">9500</param><param name="item">6</param></include>
				<label>$PARAM[label]</label>
				<selected>!Skin.HasSetting($PARAM[setting])</selected>
				<onclick>Skin.ToggleSetting($PARAM[setting])</onclick>
				<enable>$PARAM[enable]</enable>
			</control>
		</definition>
	</include>

