<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald settings scaffold, shared by Bald Settings (1115 and SkinSettings), the widget editor (1116), Home Screens (1117)
     and Appearance (1118). Two panes over the field and blurred backdrop: a 590 px sidebar with the title and a category
     list drawn as the Home menu (accent dot, Bald_MenuItem, unfocused at 34%), and a detail pane at x 686 with the
     focused category's heading, a Bald_MenuNote description and its rows. Hints sit on the info dialog's y 954 line,
     right-aligned to the 1824 safe edge. Control IDs stay in the windows; these includes supply layout and styling. -->
<includes>
	<!-- Field, backdrop, sidebar and title. -->
	<include name="Bald_SettingsFrame">
		<param name="title" />
		<!-- Kodi's settings windows fill their heading label by id (SettingsCategory: 2). -->
		<param name="title_id">0</param>
		<definition>
			<control type="image">
				<width>1920</width>
				<height>1080</height>
				<texture colordiffuse="bald_field">bald/white.png</texture>
			</control>
			<include>Bald_Backdrop</include>
			<control type="image">
				<width>590</width>
				<height>1080</height>
				<texture colordiffuse="bald_field60">bald/white.png</texture>
			</control>
			<control type="label" id="$PARAM[title_id]">
				<left>Bald_SafeLeft</left>
				<top>96</top>
				<width>494</width>
				<height>48</height>
				<aligny>center</aligny>
				<font>Bald_CaptionTitle</font>
				<textcolor>bald_ink</textcolor>
				<label>$PARAM[title]</label>
			</control>
		</definition>
	</include>

	<!-- Body of a sidebar category list: <control type="list" id="..."> + this + <content>. Rows are 62 px, the Home
	     menu's pitch. The selected category keeps its dot and dims while focus is in the detail pane. -->
	<include name="Bald_SettingsCategories">
		<param name="id" />
		<param name="right" />
		<param name="font">Bald_MenuItem</param>
		<definition>
			<left>Bald_SafeLeft</left>
			<top>192</top>
			<width>494</width>
			<height>682</height>
			<orientation>vertical</orientation>
			<scrolltime tween="cubic" easing="out">320</scrolltime>
			<onright>$PARAM[right]</onright>
			<itemlayout height="62">
				<control type="label">
					<left>20</left>
					<width>454</width>
					<height>62</height>
					<aligny>center</aligny>
					<font>$PARAM[font]</font>
					<textcolor>bald_ink34</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout height="62">
				<control type="group">
					<animation type="Conditional" condition="!Control.HasFocus($PARAM[id])">
						<effect type="fade" start="100" end="55" time="240" tween="sine" easing="inout" />
					</animation>
					<control type="image">
						<top>26</top>
						<width>10</width>
						<height>10</height>
						<texture colordiffuse="bald_accent">bald/dot.png</texture>
					</control>
					<control type="label">
						<left>26</left>
						<width>448</width>
						<height>62</height>
						<aligny>center</aligny>
						<font>$PARAM[font]</font>
						<textcolor>bald_ink</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<animation type="Focus">
							<effect type="fade" start="34" end="100" time="240" tween="sine" easing="inout" />
							<effect type="slide" start="-6,0" end="0,0" time="320" tween="cubic" easing="out" />
						</animation>
					</control>
				</control>
			</focusedlayout>
		</definition>
	</include>

	<!-- Detail pane: heading and note for the focused category; the window's rows go in as nested content. -->
	<include name="Bald_SettingsDetail">
		<param name="heading" />
		<param name="note" />
		<definition>
			<control type="group">
				<left>686</left>
				<top>192</top>
				<width>1138</width>
				<height>736</height>
				<control type="label">
					<width>1138</width>
					<height>62</height>
					<aligny>center</aligny>
					<font>Bald_CaptionTitle</font>
					<textcolor>bald_ink</textcolor>
					<label>$PARAM[heading]</label>
				</control>
				<include content="Bald_MenuNote">
					<param name="text">$PARAM[note]</param>
					<param name="x">0</param>
					<param name="y">78</param>
					<param name="width">720</param>
				</include>
				<nested />
			</control>
		</definition>
	</include>

	<!-- Body of a detail-pane row list: <control type="grouplist" id="..."> + this + rows. Eight 56 px rows with 6 px
	     gaps fit above the hint line; longer lists scroll. 6 px wider than the rows, which slide 6 px on focus. -->
	<include name="Bald_SettingsRows">
		<param name="left" />
		<definition>
			<top>216</top>
			<width>726</width>
			<height>520</height>
			<orientation>vertical</orientation>
			<itemgap>6</itemgap>
			<scrolltime tween="cubic" easing="out">320</scrolltime>
			<usecontrolcoords>true</usecontrolcoords>
			<onleft>$PARAM[left]</onleft>
		</definition>
	</include>

	<!-- One settings row (button or radiobutton), in the Home menu's focus language: unfocused at 50%, focused full ink
	     with the accent dot, sliding 6 px right. A radiobutton's state is a dot at the right: accent on, dim off. -->
	<include name="Bald_ConfigureButton">
		<param name="width">720</param>
		<definition>
			<include content="Bald_SettingsRowStyle"><param name="width">$PARAM[width]</param></include>
			<radiowidth>12</radiowidth>
			<radioheight>12</radioheight>
			<textureradioonfocus colordiffuse="bald_accent">bald/dot.png</textureradioonfocus>
			<textureradioonnofocus colordiffuse="bald_accent">bald/dot.png</textureradioonnofocus>
			<textureradioofffocus colordiffuse="bald_ink34">bald/dot.png</textureradioofffocus>
			<textureradiooffnofocus colordiffuse="bald_ink28">bald/dot.png</textureradiooffnofocus>
			<textureradioondisabled colordiffuse="bald_ink28">bald/dot.png</textureradioondisabled>
			<textureradiooffdisabled colordiffuse="bald_ink10">bald/dot.png</textureradiooffdisabled>
		</definition>
	</include>

	<!-- The row look alone, without the radio state dots: for a radiobutton whose state means nothing (the settings
	     level button), which then sets its radio textures empty itself. -->
	<include name="Bald_SettingsRowStyle">
		<param name="width">720</param>
		<definition>
			<width>$PARAM[width]</width>
			<height>56</height>
			<font>Bald_Section</font>
			<textoffsetx>26</textoffsetx>
			<aligny>center</aligny>
			<textcolor>bald_ink45</textcolor>
			<focusedcolor>bald_ink</focusedcolor>
			<disabledcolor>bald_ink28</disabledcolor>
			<!-- menu_dot.png is 440 x 56 with the dot in its first 10 px: the left border keeps it round at any width. -->
			<texturefocus border="12,0,0,0" colordiffuse="bald_accent">bald/menu_dot.png</texturefocus>
			<texturenofocus />
			<animation type="Focus">
				<effect type="fade" start="50" end="100" time="240" tween="sine" easing="inout" />
				<effect type="slide" start="0,0" end="6,0" time="320" tween="cubic" easing="out" />
			</animation>
			<animation type="Unfocus">
				<effect type="slide" start="6,0" end="0,0" time="320" tween="cubic" easing="out" />
			</animation>
		</definition>
	</include>

	<!-- A row that belongs to one category: shown while category item <item> of list <list> is selected. Rows are
	     matched by the static item's id, never its label, so translated labels keep working. A further <visible>
	     on the control is ANDed with this one. -->
	<include name="Bald_SettingRow">
		<param name="list" />
		<param name="item" />
		<param name="width">720</param>
		<definition>
			<include content="Bald_ConfigureButton"><param name="width">$PARAM[width]</param></include>
			<visible>Container($PARAM[list]).HasFocus($PARAM[item])</visible>
		</definition>
	</include>

	<!-- Estuary's image-pack picker actions for an Appearance button: run script.image.resource.select for skin string
	     <property> and resource type <type>, enabling or installing the script first when needed. -->
	<include name="Bald_ImageResourceActions">
		<param name="property" />
		<param name="type" />
		<definition>
			<onclick condition="System.AddonIsEnabled(script.image.resource.select)">RunScript(script.image.resource.select,property=$PARAM[property]&amp;type=$PARAM[type])</onclick>
			<onclick condition="System.HasAddon(script.image.resource.select) + !System.AddonIsEnabled(script.image.resource.select)">EnableAddon(script.image.resource.select)</onclick>
			<onclick condition="!System.HasAddon(script.image.resource.select)">InstallAddon(script.image.resource.select)</onclick>
		</definition>
	</include>

	<!-- Footer hints, sentence case, on the y 954 line and right-aligned to x 1824 (1224 + 600). -->
	<include name="Bald_SettingsHints">
		<param name="first" />
		<param name="second" />
		<definition>
			<control type="group">
				<left>1224</left>
				<top>Bald_HintTop</top>
				<include content="Bald_InfoHintPair">
					<param name="first">$PARAM[first]</param>
					<param name="second">$PARAM[second]</param>
					<param name="width">600</param>
				</include>
			</control>
		</definition>
	</include>

	<!-- The detail pane's Open button, for pages whose categories are actions: Select sends a click to list <list>. -->
	<include name="Bald_SettingsOpen">
		<param name="list" />
		<param name="id">9001</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<include>Bald_ConfigureButton</include>
				<top>216</top>
				<label>$LOCALIZE[502]</label>
				<onleft>$PARAM[list]</onleft>
				<onclick>SendClick($PARAM[list])</onclick>
			</control>
		</definition>
	</include>

	<!-- ============ Kodi's own settings windows ============
	     SettingsCategory.xml (every core settings page), SettingsSystemInfo.xml and SettingsProfile.xml draw the same
	     frame and sidebar. Kodi builds their category and setting rows by cloning template controls, so the styling
	     lives on the templates below; ids and actions stay in the windows. -->

	<!-- Body of a sidebar category button (SettingsCategory template 10, System info sections 94-101): a category row in
	     the scaffold's list language, Bald_MenuItem at 34%, full ink with the accent dot on focus. 56 px buttons with a
	     6 px gap keep the list's 62 px pitch. While focus is in the settings, Kodi keeps the current category button
	     focused at half alpha (CGUIDialogSettingsBase::DoProcess), which is the scaffold's dimmed dot. There is no slide:
	     Kodi re-focuses that button every time focus leaves it, and a slide would jump back and forth. -->
	<include name="Bald_SettingsCategoryButton">
		<definition>
			<left>0</left>
			<width>494</width>
			<height>56</height>
			<font>Bald_MenuItem</font>
			<textoffsetx>26</textoffsetx>
			<aligny>center</aligny>
			<textcolor>bald_ink34</textcolor>
			<focusedcolor>bald_ink</focusedcolor>
			<disabledcolor>bald_ink10</disabledcolor>
			<texturefocus border="12,0,0,0" colordiffuse="bald_accent">bald/menu_dot.png</texturefocus>
			<texturenofocus />
			<animation type="Focus">
				<effect type="fade" start="34" end="100" time="240" tween="sine" easing="inout" />
			</animation>
		</definition>
	</include>

	<!-- Body of the sidebar grouplist that holds category buttons (SettingsCategory 3, System info 9000). -->
	<include name="Bald_SettingsCategoryGroup">
		<param name="height">682</param>
		<definition>
			<left>Bald_SafeLeft</left>
			<top>192</top>
			<width>494</width>
			<height>$PARAM[height]</height>
			<orientation>vertical</orientation>
			<itemgap>6</itemgap>
			<scrolltime tween="cubic" easing="out">320</scrolltime>
		</definition>
	</include>

	<!-- Body of a setting template: the scaffold's row (Bald_ConfigureButton) at the settings pane's width. Kodi gives
	     every clone the grouplist's width, and its value (label2, a spinner's or slider's value) sits right-aligned
	     26 px in from the row's end. An invalid value is drawn in the accent. -->
	<include name="Bald_SettingsTemplate">
		<definition>
			<include content="Bald_ConfigureButton"><param name="width">1106</param></include>
			<invalidcolor>bald_accent</invalidcolor>
		</definition>
	</include>

	<!-- Spinner (template 9): chevrons either side of the value, dim until the row is focused. Kodi draws the "down"
	     texture on the left and "up" on the right; the left chevron is the right one flipped. -->
	<include name="Bald_SettingsSpinner">
		<definition>
			<include>Bald_SettingsTemplate</include>
			<spinwidth>16</spinwidth>
			<spinheight>16</spinheight>
			<textureup colordiffuse="bald_ink28">bald/chevron.png</textureup>
			<textureupfocus colordiffuse="bald_ink">bald/chevron.png</textureupfocus>
			<textureupdisabled colordiffuse="bald_ink10">bald/chevron.png</textureupdisabled>
			<texturedown flipx="true" colordiffuse="bald_ink28">bald/chevron.png</texturedown>
			<texturedownfocus flipx="true" colordiffuse="bald_ink">bald/chevron.png</texturedownfocus>
			<texturedowndisabled flipx="true" colordiffuse="bald_ink10">bald/chevron.png</texturedowndisabled>
		</definition>
	</include>

	<!-- Slider (template 13): a 4 px track with a 16 px nib, 240 px wide at the row's end, the value to its left. The
	     track texture is 16 px tall so Kodi draws the nib at its own size (it scales the nib by the control height over
	     the track texture's height). -->
	<include name="Bald_SettingsSlider">
		<definition>
			<include>Bald_SettingsTemplate</include>
			<sliderwidth>240</sliderwidth>
			<sliderheight>16</sliderheight>
			<texturesliderbar border="8,0,8,0" colordiffuse="bald_ink28">bald/slider_bar.png</texturesliderbar>
			<texturesliderbardisabled border="8,0,8,0" colordiffuse="bald_ink10">bald/slider_bar.png</texturesliderbardisabled>
			<textureslidernib colordiffuse="bald_ink60">bald/slider_nib.png</textureslidernib>
			<textureslidernibfocus colordiffuse="bald_accent">bald/slider_nib.png</textureslidernibfocus>
			<textureslidernibdisabled colordiffuse="bald_ink28">bald/slider_nib.png</textureslidernibdisabled>
		</definition>
	</include>

	<!-- Colour button (template 15): the chosen colour as a 20 px dot at the row's end. -->
	<include name="Bald_SettingsColorButton">
		<definition>
			<include>Bald_SettingsTemplate</include>
			<colorwidth>20</colorwidth>
			<colorheight>20</colorheight>
			<texturecolormask>bald/dot.png</texturecolormask>
			<texturecolordisabledmask colordiffuse="bald_ink28">bald/dot.png</texturecolordisabledmask>
		</definition>
	</include>

	<!-- Group title (template 14): a small section label over its group's rows, aligned with the row text. -->
	<include name="Bald_SettingsGroupTitle">
		<definition>
			<width>1106</width>
			<height>56</height>
			<textoffsetx>26</textoffsetx>
			<align>left</align>
			<aligny>bottom</aligny>
			<font>Bald_RowLabel</font>
			<textcolor>bald_ink60</textcolor>
			<label />
		</definition>
	</include>

	<!-- Separator (template 11): a hairline between groups. -->
	<include name="Bald_SettingsSeparator">
		<definition>
			<height>1</height>
			<texture colordiffuse="bald_ink10">bald/white.png</texture>
		</definition>
	</include>

	<!-- Thin page indicator for a settings grouplist (its pagecontrol), on the right safe edge. Not a focus target. -->
	<include name="Bald_SettingsScrollbar">
		<param name="height">628</param>
		<definition>
			<left>1820</left>
			<top>192</top>
			<width>4</width>
			<height>$PARAM[height]</height>
			<orientation>vertical</orientation>
			<showonepage>false</showonepage>
			<texturesliderbackground colordiffuse="bald_ink10">bald/white.png</texturesliderbackground>
			<texturesliderbar colordiffuse="bald_ink34">bald/white.png</texturesliderbar>
			<texturesliderbarfocus colordiffuse="bald_ink">bald/white.png</texturesliderbarfocus>
			<textureslidernib />
			<textureslidernibfocus />
			<animation type="Visible">
				<effect type="fade" start="0" end="100" time="240" tween="sine" easing="inout" />
			</animation>
			<animation type="Hidden">
				<effect type="fade" start="100" end="0" time="240" tween="sine" easing="inout" />
			</animation>
		</definition>
	</include>

	<!-- Help text for the focused category or setting (SettingsCategory 6), under the rows and above the hint line. -->
	<include name="Bald_SettingsHelp">
		<definition>
			<left>686</left>
			<top>846</top>
			<width>900</width>
			<height>84</height>
			<font>Bald_MenuNote</font>
			<textcolor>bald_ink60</textcolor>
			<autoscroll time="3000" delay="5000" repeat="5000">true</autoscroll>
		</definition>
	</include>

	<!-- One row of Kodi's profile list (SettingsProfile 2): round avatar, name and last login, and a check on the profile
	     in use (Kodi marks it selected). The last item is Kodi's "Add profile...", which has no avatar or date. Unfocused
	     rows use <color> (45%); the focused row is full ink with the accent dot and fades in like a scaffold row. -->
	<include name="Bald_SettingsProfileItem">
		<param name="color">bald_ink45</param>
		<param name="focused">false</param>
		<definition>
			<control type="group">
				<animation type="Conditional" condition="$PARAM[focused] + !Control.HasFocus(2)">
					<effect type="fade" start="100" end="55" time="240" tween="sine" easing="inout" />
				</animation>
				<control type="image">
					<top>31</top>
					<width>10</width>
					<height>10</height>
					<texture colordiffuse="bald_accent">bald/dot.png</texture>
					<visible>$PARAM[focused]</visible>
				</control>
				<control type="group">
					<animation type="Focus" condition="$PARAM[focused]">
						<effect type="fade" start="50" end="100" time="240" tween="sine" easing="inout" />
						<effect type="slide" start="-6,0" end="0,0" time="320" tween="cubic" easing="out" />
					</animation>
					<control type="image">
						<left>26</left>
						<top>12</top>
						<width>48</width>
						<height>48</height>
						<aspectratio>scale</aspectratio>
						<texture diffuse="bald/circle_112.png" fallback="DefaultUser.png">$INFO[ListItem.Icon]</texture>
						<visible>!String.IsEqual(ListItem.Label,$LOCALIZE[20058])</visible>
					</control>
					<control type="label">
						<left>90</left>
						<top>10</top>
						<width>560</width>
						<height>30</height>
						<aligny>center</aligny>
						<font>Bald_Section</font>
						<textcolor>$PARAM[color]</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>!String.IsEqual(ListItem.Label,$LOCALIZE[20058])</visible>
					</control>
					<control type="label">
						<left>26</left>
						<width>624</width>
						<height>72</height>
						<aligny>center</aligny>
						<font>Bald_Section</font>
						<textcolor>$PARAM[color]</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<visible>String.IsEqual(ListItem.Label,$LOCALIZE[20058])</visible>
					</control>
					<control type="label">
						<left>90</left>
						<top>40</top>
						<width>560</width>
						<height>24</height>
						<aligny>center</aligny>
						<font>Bald_MenuNote</font>
						<textcolor>bald_ink45</textcolor>
						<label>$LOCALIZE[31029]: $INFO[ListItem.Label2]</label>
						<visible>!String.IsEmpty(ListItem.Label2)</visible>
					</control>
					<control type="label">
						<left>90</left>
						<top>40</top>
						<width>560</width>
						<height>24</height>
						<aligny>center</aligny>
						<font>Bald_MenuNote</font>
						<textcolor>bald_ink45</textcolor>
						<label>$LOCALIZE[31029]: $LOCALIZE[13170]</label>
						<visible>String.IsEmpty(ListItem.Label2) + !String.IsEqual(ListItem.Label,$LOCALIZE[20058])</visible>
					</control>
					<control type="image">
						<left>668</left>
						<top>24</top>
						<width>24</width>
						<height>24</height>
						<texture colordiffuse="bald_accent">bald/check.png</texture>
						<visible>ListItem.IsSelected</visible>
					</control>
				</control>
			</control>
		</definition>
	</include>

	<!-- Bald Settings home, shared by window 1115 and Kodi's "Configure skin..." (SkinSettings.xml), so both open the
	     same page with no redirect. -->
	<include name="Bald_SettingsHome">
		<include content="Bald_SettingsFrame"><param name="title">$LOCALIZE[31730]</param></include>
		<control type="list" id="9000">
			<include content="Bald_SettingsCategories"><param name="id">9000</param><param name="right">9001</param></include>
			<content>
				<item>
					<label>$LOCALIZE[31731]</label>
					<label2>$LOCALIZE[31732]</label2>
					<onclick>ActivateWindow(1117)</onclick>
				</item>
				<item>
					<label>$LOCALIZE[480]</label>
					<label2>$LOCALIZE[31733]</label2>
					<onclick>ActivateWindow(1118)</onclick>
				</item>
				<item>
					<label>CoreELEC</label>
					<label2>$LOCALIZE[31734]</label2>
					<onclick>RunAddon(service.coreelec.settings)</onclick>
					<visible>System.AddonIsEnabled(service.coreelec.settings)</visible>
				</item>
				<item>
					<label>LibreELEC</label>
					<label2>$LOCALIZE[31735]</label2>
					<onclick>RunAddon(service.libreelec.settings)</onclick>
					<visible>System.AddonIsEnabled(service.libreelec.settings)</visible>
				</item>
				<item>
					<label>$LOCALIZE[31736]</label>
					<label2>$LOCALIZE[31737]</label2>
					<onclick>ActivateWindow(addonbrowser)</onclick>
				</item>
			</content>
		</control>
		<include content="Bald_SettingsDetail">
			<param name="heading">$INFO[Container(9000).ListItem.Label]</param>
			<param name="note">$INFO[Container(9000).ListItem.Label2]</param>
			<include content="Bald_SettingsOpen"><param name="list">9000</param></include>
		</include>
		<include content="Bald_SettingsHints"><param name="first">$LOCALIZE[31738]</param><param name="second">$LOCALIZE[31739]</param></include>
	</include>
</includes>
