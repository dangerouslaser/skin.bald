<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald paged info: Overview, Cast & details, More like this. Home still owns the opening frame zoom.
     Shows, seasons and episodes get the TV Overview (Includes_Bald_InfoTV.xml); include conditions on the item's
     DBType choose it, and Kodi reloads this window when they change. -->
<window>
	<defaultcontrol always="true">5000</defaultcontrol>
	<onload>SetProperty(Bald.InfoSec,0,home)</onload>
	<onload>SetProperty(Bald.Identity,$INFO[ListItem.DBType]:$INFO[ListItem.DBID],movieinformation)</onload>
	<onload>ClearProperty(Bald.MorePath,movieinformation)</onload>
	<onload>ClearProperty(Bald.MoreFor,movieinformation)</onload>
	<onload>ClearProperty(Bald.InfoSwitch,home)</onload>
	<onload>ClearProperty(TMDbHelper.WidgetContainer,movieinformation)</onload>
	<include>Bald_InfoTVClear</include>
	<onload condition="System.HasAddon(plugin.video.themoviedb.helper)">Skin.SetBool(TMDbHelper.UseLocalWidgetContainer)</onload>
	<onload>RunScript(skin.bald,recommendations,$INFO[ListItem.DBType],$INFO[ListItem.DBID])</onload>
	<include condition="!$EXP[Bald_InfoTVItem]">Bald_InfoMovieOnLoad</include>
	<include condition="$EXP[Bald_InfoTVItem]">Bald_InfoTVOnLoad</include>
	<onunload>ClearProperty(Bald.InfoSec,home)</onunload>
	<onunload>ClearProperty(Bald.Identity,movieinformation)</onunload>
	<onunload>ClearProperty(Bald.MorePath,movieinformation)</onunload>
	<onunload>ClearProperty(Bald.MoreFor,movieinformation)</onunload>
	<onunload>ClearProperty(TMDbHelper.WidgetContainer,movieinformation)</onunload>
	<controls>
		<!-- Opaque sharp fallback for library/add-on entry points. -->
		<control type="group">
			<visible>$EXP[Bald_InfoOwnBackdrop]</visible>
			<animation effect="fade" start="0" end="100" time="380" tween="sine" easing="inout">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="130" tween="sine" easing="inout">WindowClose</animation>
			<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field">bald/white.png</texture></control>
			<control type="image"><width>1920</width><height>1080</height><aspectratio>scale</aspectratio><texture background="true">$VAR[Bald_ItemFanart]</texture></control>
		</control>
		<!-- Native playback contracts, unchanged. -->
		<control type="button" id="8"><include>HiddenObject</include></control>
		<control type="button" id="9"><include>HiddenObject</include></control>
		<control type="button" id="11"><include>HiddenObject</include></control>
		<control type="group">
			<animation effect="fade" start="0" end="100" time="360" delay="260" tween="sine" easing="inout">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="130" tween="sine" easing="inout">WindowClose</animation>
			<!-- Only Overview needs the hero's directional scrims. -->
			<control type="group">
				<visible>String.IsEqual(Window(home).Property(Bald.InfoSec),0)</visible>
				<animation effect="fade" start="0" end="100" time="460" tween="sine" easing="inout">Visible</animation>
				<animation effect="fade" start="100" end="0" time="460" tween="sine" easing="inout">Hidden</animation>
				<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field">bald/scrim_info_h.png</texture></control>
				<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field">bald/scrim_info_b.png</texture></control>
			</control>
			<include condition="$EXP[Bald_InfoTVItem]">Bald_InfoTVDim</include>
			<!-- Crossfade to the SAME cached blur, field and multiplier used by Home.
			     TMDb Helper follows the native item until the recommendation page sets its local container. -->
			<control type="group" id="5200">
				<visible>!String.IsEqual(Window(home).Property(Bald.InfoSec),0)</visible>
				<animation effect="fade" start="0" end="100" time="460" tween="sine" easing="inout">Visible</animation>
				<animation effect="fade" start="100" end="0" time="460" tween="sine" easing="inout">Hidden</animation>
				<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field">bald/white.png</texture></control>
				<include>Bald_BackdropImage</include>
			</control>
			<include condition="!$EXP[Bald_InfoTVItem]">Bald_InfoOverview</include>
			<include condition="$EXP[Bald_InfoTVItem]">Bald_InfoTVOverview</include>
			<include>Bald_InfoCastPage</include>
			<include>Bald_InfoRecommendationsPage</include>
			<control type="group">
				<!-- The TV Overview runs to y964, so it has no page trail. -->
				<control type="label">
					<left>96</left><top>954</top><width>1100</width><height>28</height>
					<font>Bald_Hint</font><textcolor>bald_ink58</textcolor><label>$VAR[Bald_InfoPageTrail]</label>
					<visible>!String.IsEqual(Window(home).Property(Bald.InfoSec),2) + ![$EXP[Bald_InfoIsTV] + String.IsEqual(Window(home).Property(Bald.InfoSec),0)]</visible>
				</control>
				<control type="label">
					<left>1440</left><top>954</top><width>384</width><height>24</height><align>right</align><aligny>center</aligny>
					<font>Bald_Hint</font><textcolor>bald_ink60</textcolor>
					<label>Down for cast &amp; details</label><visible>String.IsEqual(Window(home).Property(Bald.InfoSec),0) + !$EXP[Bald_InfoIsTV]</visible>
				</control>
				<include condition="$EXP[Bald_InfoTVItem]">Bald_InfoTVHints</include>
				<control type="group">
					<left>1440</left><top>954</top>
					<visible>String.IsEqual(Window(home).Property(Bald.InfoSec),1)</visible>
					<include content="Bald_InfoHintPair"><param name="first">Up for overview</param><param name="second">Down for more like this</param></include>
				</control>
				<!-- Page hints switch immediately; they are not children of the animated page content. -->
				<control type="group">
					<left>1440</left><top>954</top>
					<visible>String.IsEqual(Window(home).Property(Bald.InfoSec),2)</visible>
					<include content="Bald_InfoHintPair"><param name="first">Up for cast &amp; details</param><param name="second">Select to open</param></include>
				</control>
			</control>
		</control>
	</controls>
</window>
