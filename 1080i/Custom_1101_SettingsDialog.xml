<?xml version="1.0" encoding="utf-8"?>
<!-- Bald OSD settings drawer (docs/SPEC.md 5, "Playback (proposed)"): the OSD's Settings, Streams and 3D buttons, the
     music OSD's Settings and the game OSD's menu open this window with its content in the Home window properties
     settingsdialog_content and settingsdialog_header. It is a right-hand drawer over the dimmed player, rows in the
     settings scaffold's language (Includes_SettingsDialog.xml). Started from Kodi 22 Estuary's
     Custom_1101_SettingsDialog.xml (GPL-2.0-or-later, see LICENSE-Estuary.txt). Skin ids: 1 heading, 11000 row group
     (default focus), 11100 row list, 22101-22110 rows. -->
<window type="dialog" id="1101">
	<defaultcontrol always="true">11000</defaultcontrol>
	<depth>DepthDialog</depth>
	<onunload>ClearProperty(settingsdialog_header,Home)</onunload>
	<onunload>ClearProperty(settingsdialog_content,Home)</onunload>
	<controls>
		<include>SettingsDialogLayout</include>
	</controls>
</window>
