<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi's power menu (shutdownmenu), opened from Home's Power entry. Its entries are the Skin Variables menu "power",
     edited in Customization > Power > Power menu (shown, order, names, the user's own commands) and generated into
     Bald_PowerMenuItems (shortcuts/generator/power.xml; Includes_Bald_HomeDefaults.xml holds the shipped list until
     the first build). An entry Kodi cannot do on this device (Suspend, Hibernate, ...) does not show.
     Bald's look: drawn as Bald's context menu in the Home menu's column (1430, 392), five 56 px items in view. Over
     Home it stands in for the menu, which fades out while it is open (Bald_PowerMenuOpen), as a submenu would; Back
     returns to the menu on Power. Elsewhere a dark scrim sits behind it. -->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<controls>
		<control type="group">
			<visible>!Window.IsVisible(home)</visible>
			<include>Bald_MenuScrim</include>
		</control>
		<!-- Clicking outside the menu closes it (mouse). -->
		<control type="button">
			<width>1920</width>
			<height>1080</height>
			<texturefocus />
			<texturenofocus />
			<onclick>Action(close)</onclick>
		</control>
		<control type="group">
			<include>Bald_MenuMotion</include>
			<control type="list" id="9000">
				<left>1434</left>
				<top>392</top>
				<width>446</width>
				<!-- Five 56 px items plus four 6 px gaps. -->
				<height>304</height>
				<orientation>vertical</orientation>
				<scrolltime tween="cubic" easing="out">240</scrolltime>
				<onleft>Action(close)</onleft>
				<onright>noop</onright>
				<include>Bald_MenuListLayouts</include>
				<content>
					<include>Bald_PowerMenuItems</include>
				</content>
			</control>
		</control>
	</controls>
</window>
