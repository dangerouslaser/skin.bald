<?xml version="1.0" encoding="UTF-8"?>
<!-- Started from Kodi 22's bundled Estuary (skin.estuary, GPL-2.0-or-later; see LICENSE-Estuary.txt).
     Bald: the compact list (SPEC 5.8 geometry: 48 px rows at the safe margin, accent dot and full ink on the focused
     row) with the shared right-hand preview (Bald_BrowsePreview). View ids, viewtype labels, visibility, page control
     50600 and the redirects of TV levels to the Bald TV views are Estuary's. -->
<includes>
	<include name="View_50_List">
		<control type="group">
			<visible>Control.IsVisible(50)</visible>
			<include>Bald_BrowseViewIn</include>
			<include content="ListContainer">
				<param name="list_id" value="50" />
				<param name="viewtype_label" value="$LOCALIZE[535]" />
			</include>
			<control type="scrollbar" id="50600">
				<left>1252</left>
				<top>Bald_ContentTop</top>
				<width>4</width>
				<height>624</height>
				<onleft>50</onleft>
				<onright>50</onright>
				<include content="Bald_BrowseScrollbarStyle" />
			</control>
			<include>RightListPanel</include>
		</control>
	</include>
	<!-- The right-hand column of the list views: the shared preview, or now playing for the music playlist view. -->
	<include name="RightListPanel">
		<include content="Bald_BrowsePreview">
			<param name="visible">!Container.Content(songs) + !Control.IsVisible(503)</param>
		</include>
		<control type="group">
			<visible>Control.IsVisible(503) + Window.IsActive(musicplaylist) + !$EXP[Bald_BrowseMenuOpen]</visible>
			<include>Bald_BrowseFade</include>
			<control type="group">
				<left>Bald_PreviewLeft</left>
				<top>Bald_ContentTop</top>
				<control type="image"><width>528</width><height>297</height><texture colordiffuse="bald_placeholder">bald/white.png</texture></control>
				<control type="image">
					<left>24</left><top>24</top><width>480</width><height>249</height><aspectratio>keep</aspectratio><fadetime>400</fadetime>
					<texture fallback="DefaultAudio.png" background="true">$INFO[Player.Icon]</texture>
				</control>
			</control>
			<control type="label">
				<left>Bald_PreviewLeft</left><top>548</top><width>528</width><height>52</height>
				<font>Bald_Hint</font><textcolor>bald_accent</textcolor>
				<label>$LOCALIZE[31000]$INFO[MusicPlayer.Playlistposition, · ,]$INFO[MusicPlayer.Playlistlength, / ,]</label>
			</control>
			<control type="textbox" id="15599">
				<left>Bald_PreviewLeft</left><top>584</top><width>528</width><height>300</height>
				<font>Bald_CaptionPlot</font><textcolor>bald_ink80</textcolor>
				<autoscroll time="3000" delay="7000" repeat="5000">!System.HasModalDialog + Skin.HasSetting(Bald.ScrollPlots)</autoscroll>
				<label>$INFO[MusicPlayer.Title,[COLOR bald_ink],[/COLOR][CR]]$INFO[MusicPlayer.Artist,,[CR]]$INFO[MusicPlayer.Album]</label>
				<visible>Player.HasAudio</visible>
			</control>
			<control type="label">
				<left>Bald_PreviewLeft</left><top>584</top><width>528</width><height>28</height>
				<font>Bald_CaptionMeta</font><textcolor>bald_ink60</textcolor>
				<label>$LOCALIZE[36623]</label>
				<visible>!Player.HasAudio</visible>
			</control>
		</control>
	</include>
	<!-- The list container of views 50, 502 and 503: 13 rows of 48 at the safe margin. -->
	<include name="ListContainer">
		<param name="left">Bald_SafeLeft</param>
		<param name="width">1140</param>
		<param name="label_width">820</param>
		<param name="label2_left">860</param>
		<param name="state_left">1020</param>
		<definition>
			<control type="list" id="$PARAM[list_id]">
				<onfocus condition="Container.Content(tvshows)">Container.SetViewMode(520)</onfocus><onfocus condition="Container.Content(seasons)">Container.SetViewMode(530)</onfocus><onfocus condition="Container.Content(episodes)">Container.SetViewMode(540)</onfocus>
				<left>$PARAM[left]</left>
				<top>Bald_ContentTop</top>
				<width>$PARAM[width]</width>
				<height>624</height>
				<scrolltime tween="cubic" easing="out">440</scrolltime>
				<orientation>vertical</orientation>
				<preloaditems>2</preloaditems>
				<pagecontrol>$PARAM[list_id]600</pagecontrol>
				<onleft>9000</onleft>
				<onright>$PARAM[list_id]600</onright>
				<onup>$PARAM[list_id]</onup>
				<ondown>$PARAM[list_id]</ondown>
				<viewtype label="$PARAM[viewtype_label]">list</viewtype>
				<visible>Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(games) | Window.IsActive(videoplaylist) | Window.IsActive(musicplaylist) | $EXP[videoasset_true]</visible>
				<include>Bald_BrowseDim</include>
				<itemlayout height="48" width="$PARAM[width]">
					<include content="Bald_BrowseTextRow"><param name="label_width">$PARAM[label_width]</param><param name="label2_left">$PARAM[label2_left]</param><param name="state_left">$PARAM[state_left]</param></include>
				</itemlayout>
				<focusedlayout height="48" width="$PARAM[width]">
					<include content="Bald_BrowseRowDot"><param name="visible">Control.HasFocus($PARAM[list_id])</param></include>
					<include content="Bald_BrowseTextRow"><param name="label_width">$PARAM[label_width]</param><param name="label2_left">$PARAM[label2_left]</param><param name="state_left">$PARAM[state_left]</param><param name="ink">bald_ink</param><param name="scroll">true</param></include>
				</focusedlayout>
			</control>
		</definition>
	</include>
	<!-- The preview column for the views whose window supplies it (55, 504, and 54 in the video and music windows). -->
	<include name="ListThumbInfoPanel">
		<param name="fallback_image"></param>
		<param name="flip_bg">false</param>
		<param name="visible">true</param>
		<definition>
			<include content="Bald_BrowsePreview">
				<param name="visible">$PARAM[visible]</param>
				<param name="fallback_image">$PARAM[fallback_image]</param>
			</include>
		</definition>
	</include>
</includes>
