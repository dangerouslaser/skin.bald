<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald channel switcher over live video (pvrosdchannels). Started from Kodi 22 Estuary's DialogPVRChannelsOSD.xml
     (Team Kodi, GPL-2.0-or-later). Kodi binds list 11 (CGUIDialogPVRItemsViewBase) and handles Select, number entry
     and the channel-group actions itself; scrollbar 60 is the list's page control. -->
<window>
	<!-- The video OSD's auto-close waits while this panel is browsed (Includes_Bald_OSD.xml). -->
	<include content="Bald_OSDSuspendAutoClose"><param name="name">channels</param></include>
	<defaultcontrol always="true">11</defaultcontrol>
	<depth>DepthOSD</depth>
	<include>Bald_PVRAnimOverlay</include>
	<controls>
		<control type="group">
			<include>Bald_PVRInfoDim</include>
			<!-- The Live TV panel's Channels tab (Includes_Bald_PVR.xml, "In-player Live TV panel"): the pane on the right
			     shows the focused channel's programme on now and what is next, as you scroll. -->
			<include>Bald_PVRPanelBase</include>
			<include content="Bald_PVRTabs">
				<param name="active">channels</param>
				<param name="section">$VAR[Bald_PVRPlayingArea]$INFO[VideoPlayer.ChannelGroup, · ]</param>
			</include>
			<!-- Header label as Estuary numbers it; Kodi does not write to it. -->
			<control type="label" id="2"><font></font><include>HiddenObject</include></control>
			<control type="fixedlist" id="11">
				<left>Bald_SafeLeft</left><top>Bald_ContentTop</top><width>780</width><height>672</height>
				<onleft>PreviousChannelGroup</onleft><onright>NextChannelGroup</onright><onup>11</onup><ondown>11</ondown>
				<movement>3</movement><focusposition>3</focusposition>
				<pagecontrol>60</pagecontrol><scrolltime tween="cubic" easing="out">440</scrolltime>
				<itemlayout width="780" height="84" infoupdate="5000"><include content="Bald_PVRChannelRow"><param name="list_id">11</param><param name="text_width">500</param><param name="status_left">736</param></include></itemlayout>
				<focusedlayout width="780" height="84" infoupdate="5000"><include content="Bald_PVRChannelRow"><param name="list_id">11</param><param name="text_width">500</param><param name="status_left">736</param><param name="focused">true</param><param name="c1">bald_ink</param><param name="c2">bald_ink70</param></include></focusedlayout>
			</control>
			<include content="Bald_PVRScrollbar"><param name="id">60</param><param name="list_id">11</param><param name="left">892</param></include>
			<include content="Bald_PVRDetailPane"><param name="item">Container(11).ListItem.</param><param name="next">true</param></include>
			<include content="Bald_PVRHints">
				<param name="first">$LOCALIZE[31667]</param>
				<param name="second">$LOCALIZE[31662]</param>
			</include>
		</control>
		<include>Bald_PVRChannelNumberInput</include>
	</controls>
</window>
