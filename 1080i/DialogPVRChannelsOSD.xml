<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald channel switcher over live video (pvrosdchannels). Started from Kodi 22 Estuary's DialogPVRChannelsOSD.xml
     (Team Kodi, GPL-2.0-or-later). Kodi binds list 11 (CGUIDialogPVRItemsViewBase) and handles Select, number entry
     and the channel-group actions itself; scrollbar 60 is the list's page control. -->
<window>
	<!-- The video OSD's auto-close stops while the channels are browsed. -->
	<onload>CancelAlarm(bald_osd_close,true)</onload>
	<defaultcontrol always="true">11</defaultcontrol>
	<depth>DepthOSD</depth>
	<include>Bald_PVRAnimOverlay</include>
	<controls>
		<control type="group">
			<include>Bald_PVRInfoDim</include>
			<include>Bald_PVRScrims</include>
			<include content="Bald_PVRHeader">
				<param name="title">$LOCALIZE[19019]</param>
				<param name="section">$VAR[Bald_PVRPlayingArea]$INFO[VideoPlayer.ChannelGroup, · ]</param>
				<param name="clock">false</param>
				<param name="width">860</param>
			</include>
			<!-- Header label as Estuary numbers it; Kodi does not write to it. -->
			<control type="label" id="2"><font></font><include>HiddenObject</include></control>
			<control type="fixedlist" id="11">
				<left>Bald_SafeLeft</left><top>Bald_ContentTop</top><width>860</width><height>672</height>
				<onleft>PreviousChannelGroup</onleft><onright>NextChannelGroup</onright><onup>11</onup><ondown>11</ondown>
				<movement>3</movement><focusposition>3</focusposition>
				<pagecontrol>60</pagecontrol><scrolltime tween="cubic" easing="out">440</scrolltime>
				<itemlayout width="860" height="84" infoupdate="5000"><include content="Bald_PVRChannelRow"><param name="list_id">11</param><param name="text_width">592</param><param name="status_left">816</param></include></itemlayout>
				<focusedlayout width="860" height="84" infoupdate="5000"><include content="Bald_PVRChannelRow"><param name="list_id">11</param><param name="text_width">592</param><param name="status_left">816</param><param name="focused">true</param><param name="c1">bald_ink</param><param name="c2">bald_ink70</param></include></focusedlayout>
			</control>
			<include content="Bald_PVRScrollbar"><param name="id">60</param><param name="list_id">11</param><param name="left">972</param></include>
			<include content="Bald_PVRHints">
				<param name="first">$LOCALIZE[31667]</param>
				<param name="second">$LOCALIZE[31662]</param>
				<param name="left">Bald_SafeLeft</param>
				<param name="width">880</param>
			</include>
		</control>
		<include>Bald_PVRChannelNumberInput</include>
	</controls>
</window>
