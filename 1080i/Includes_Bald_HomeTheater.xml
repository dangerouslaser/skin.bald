<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATED by tools/home_theater.py; edit that and re-run. Bald's home theater: the LG TV, Denon and Sonos
     add-ons (service.webostv, service.denonavr, service.sonos). Which are in use is chosen in Bald Settings,
     Playback, Home theater; the skin settings keep Estuary YBLOD's names, which service.webostv reads. -->
<includes>
	<!-- ============ Setup ============ -->
	<!-- The device is chosen and its add-on is enabled. -->
	<expression name="Bald_SetupLG">[Skin.HasSetting(setup_tv_lg) + System.AddonIsEnabled(service.webostv)]</expression>
	<expression name="Bald_SetupDenon">[Skin.HasSetting(setup_receiver_denon) + System.AddonIsEnabled(service.denonavr)]</expression>
	<expression name="Bald_SetupSonos">[Skin.HasSetting(setup_receiver_sonos) + System.AddonIsEnabled(service.sonos)]</expression>
	<expression name="Bald_SetupReceiver">[$EXP[Bald_SetupDenon] | $EXP[Bald_SetupSonos]]</expression>
	<!-- The choices' values (Custom_1119_BaldPlayback.xml), noting an add-on that is not installed. -->
	<variable name="Bald_SetupTVLabel">
		<value condition="Skin.HasSetting(setup_tv_lg) + !System.HasAddon(service.webostv)">$LOCALIZE[31556] · $LOCALIZE[31557]</value>
		<value condition="Skin.HasSetting(setup_tv_lg)">$LOCALIZE[31556]</value>
		<value>$LOCALIZE[16018]</value>
	</variable>
	<variable name="Bald_SetupReceiverLabel">
		<value condition="Skin.HasSetting(setup_receiver_denon) + !System.HasAddon(service.denonavr)">$LOCALIZE[31501] · $LOCALIZE[31557]</value>
		<value condition="Skin.HasSetting(setup_receiver_denon)">$LOCALIZE[31501]</value>
		<value condition="Skin.HasSetting(setup_receiver_sonos) + !System.HasAddon(service.sonos)">$LOCALIZE[31502] · $LOCALIZE[31557]</value>
		<value condition="Skin.HasSetting(setup_receiver_sonos)">$LOCALIZE[31502]</value>
		<value>$LOCALIZE[16018]</value>
	</variable>

	<!-- ============ Settings pages (1132 LG TV, 1133 Denon, 1134 Sonos) ============ -->
	<!-- The rows: Kodi's settings pages' grouplist (SettingsCategory.xml 5), Left back to the categories. -->
	<include name="Bald_HomeTheaterRows">
		<include>Bald_AnimSettingsWindow</include>
		<left>686</left>
		<top>192</top>
		<width>1106</width>
		<height>628</height>
		<orientation>vertical</orientation>
		<itemgap>6</itemgap>
		<scrolltime tween="cubic" easing="out">320</scrolltime>
		<usecontrolcoords>true</usecontrolcoords>
		<pagecontrol>60</pagecontrol>
		<onleft>9700</onleft>
		<onright>noop</onright>
		<onup>9800</onup>
		<ondown>9800</ondown>
	</include>
	<!-- A note over a category's rows (older webOS's picture presets), aligned with the row text. -->
