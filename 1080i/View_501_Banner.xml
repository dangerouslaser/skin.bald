<?xml version="1.0" encoding="UTF-8"?>
<!-- Started from Kodi 22's bundled Estuary (skin.estuary, GPL-2.0-or-later; see LICENSE-Estuary.txt).
     Bald: TV banners in three full-width columns with the Bald ring and pop. MyVideoNav sends TV shows to the Bald
     series view on focus, so this shows only where another window lists TV shows. Id, viewtype, visibility, page
     control 531 and navigation are Estuary's. -->
<includes>
	<include name="View_501_Banner">
		<control type="group">
			<visible>Control.IsVisible(501)</visible>
			<include>Bald_BrowseViewIn</include>
			<control type="panel" id="501">
				<onfocus condition="Container.Content(tvshows)">Container.SetViewMode(520)</onfocus><onfocus condition="Container.Content(seasons)">Container.SetViewMode(530)</onfocus><onfocus condition="Container.Content(episodes)">Container.SetViewMode(540)</onfocus>
				<left>Bald_BrowseWallLeft</left>
				<top>Bald_BrowseWallTop</top>
				<width>1728</width>
				<height>624</height>
				<orientation>vertical</orientation>
				<onleft>9000</onleft>
				<onright>531</onright>
				<onup>501</onup>
				<ondown>501</ondown>
				<viewtype label="20020">wide</viewtype>
				<preloaditems>2</preloaditems>
				<pagecontrol>531</pagecontrol>
				<scrolltime tween="cubic" easing="out">440</scrolltime>
				<visible>Container.Content(tvshows)</visible>
				<include>Bald_BrowseDim</include>
				<itemlayout width="576" height="156">
					<include content="Bald_BrowseTile">
						<param name="art">$VAR[BannerArtVar]</param>
						<param name="width">552</param><param name="height">102</param><param name="ring_width">558</param><param name="ring_height">108</param><param name="center">288,63</param>
						<param name="label_visible">true</param><param name="label_top">120</param><param name="label_width">552</param>
					</include>
				</itemlayout>
				<focusedlayout width="576" height="156">
					<include content="Bald_BrowseTile">
						<param name="art">$VAR[BannerArtVar]</param>
						<param name="width">552</param><param name="height">102</param><param name="ring_width">558</param><param name="ring_height">108</param><param name="center">288,63</param>
						<param name="label_visible">true</param><param name="label_top">120</param><param name="label_width">552</param>
						<param name="diffuse">bald_ink</param><param name="ink">bald_ink</param><param name="focused">Control.HasFocus(501)</param>
					</include>
				</focusedlayout>
			</control>
		</control>
	</include>
</includes>
