<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- From Kodi 22 Estuary's MyWeather.xml (GPL-2.0-or-later, see LICENSE-Estuary.txt), restyled for Bald
	     (docs/NOTES.md, "Media windows restyle"). CGUIWindowWeather's ids (2, 3, 11, 223-228, 31-35) were never in
	     Estuary: the page reads Weather.* infolabels and switches location with Weather.LocationNext. 2000 is the
	     page grouplist, 20 the current conditions (Select: next location), 15100 / 15200 the daily and hourly
	     forecasts, 70010-70059 the maps; 20000 / 20001 bump the page at its ends and 10000 (Menu) opens the weather
	     settings. -->
	<defaultcontrol always="true">15100</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<menucontrol>10000</menucontrol>
	<controls>
		<control type="button" id="20000">
			<include>HiddenObject</include>
			<animation effect="fade" time="300" start="100" end="0">Focus</animation>
			<onfocus>SetFocus(2000)</onfocus>
			<onclick>noop</onclick>
			<visible allowhiddenfocus="true">Control.HasFocus(20000)</visible>
		</control>
		<control type="button" id="20001">
			<include>HiddenObject</include>
			<animation effect="fade" time="300" start="100" end="0">Focus</animation>
			<onfocus>SetFocus(2000)</onfocus>
			<onclick>noop</onclick>
			<visible allowhiddenfocus="true">Control.HasFocus(20001)</visible>
		</control>
		<control type="button" id="10000">
			<include>HiddenObject</include>
			<onfocus>ActivateWindow(servicesettings,weather)</onfocus>
			<onclick>noop</onclick>
		</control>
		<control type="videowindow">
			<depth>DepthBackground</depth>
			<include>FullScreenDimensions</include>
			<visible>Player.HasVideo</visible>
		</control>
		<control type="visualisation">
			<include>FullScreenDimensions</include>
			<visible>Player.HasAudio</visible>
		</control>
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="bald_field">bald/white.png</texture>
			<animation effect="fade" start="100" end="bg_alpha" time="0" condition="Player.HasMedia">Conditional</animation>
			<animation effect="fade" start="0" end="100" time="380" tween="sine" easing="inout" condition="Window.Previous(fullscreenvideo) | Window.Previous(FullscreenGame) | Window.Previous(startup)">WindowOpen</animation>
		</control>
		<control type="multiimage">
			<depth>DepthBackground</depth>
			<include>FullScreenDimensions</include>
			<aspectratio>scale</aspectratio>
			<fadetime>800</fadetime>
			<include>Bald_MediaOpenClose</include>
			<animation effect="fade" time="800" tween="sine" easing="inout">VisibleChange</animation>
			<imagepath background="true" colordiffuse="bald_backdrop">$VAR[WeatherFanartVar]</imagepath>
			<visible>!Player.HasMedia</visible>
		</control>
		<control type="grouplist" id="2000">
			<orientation>vertical</orientation>
			<top>0</top>
			<height>100%</height>
			<left>0</left>
			<ondown>20001</ondown>
			<usecontrolcoords>true</usecontrolcoords>
			<animation type="Conditional" condition="Control.IsVisible(20000)" reversible="false">
				<effect type="slide" end="0,14" time="110" tween="cubic" easing="out" />
				<effect type="slide" end="0,-14" time="110" tween="cubic" easing="out" delay="110" />
			</animation>
			<animation type="Conditional" condition="Control.IsVisible(20001)" reversible="false">
				<effect type="slide" end="0,-14" time="110" tween="cubic" easing="out" />
				<effect type="slide" end="0,14" time="110" tween="cubic" easing="out" delay="110" />
			</animation>
			<scrolltime tween="cubic" easing="out">440</scrolltime>
			<include>Bald_MediaOpenClose</include>
			<itemgap>0</itemgap>
			<control type="group" id="567">
				<description>Weather info</description>
				<height>560</height>
				<include content="Bald_MediaPageTitle">
					<param name="label">$LOCALIZE[8]$INFO[Weather.Data(Current.Location), · ,]</param>
					<param name="width">1728</param>
				</include>
				<!-- Select switches to the next location; focus shows a quiet tile behind the block. -->
				<control type="button" id="20">
					<left>72</left>
					<top>190</top>
					<width>1776</width>
					<height>330</height>
					<texturefocus border="8" colordiffuse="bald_ink10">bald/tile_256.png</texturefocus>
					<texturenofocus />
					<onup>20000</onup>
					<ondown>15100</ondown>
					<onclick>Weather.LocationNext</onclick>
					<label></label>
				</control>
				<control type="label">
					<left>Bald_SafeLeft</left>
					<top>210</top>
					<width>560</width>
					<height>150</height>
					<aligny>center</aligny>
					<font>Bald_Clock</font>
					<textcolor>bald_ink</textcolor>
					<label>$INFO[Weather.Data(Current.Temperature)]</label>
				</control>
				<control type="label">
					<left>680</left>
					<top>238</top>
					<width>1140</width>
					<height>40</height>
					<aligny>center</aligny>
					<font>Bald_InfoTagline</font>
					<textcolor>bald_ink</textcolor>
					<label>$INFO[Weather.Data(Current.Condition)]</label>
				</control>
				<control type="label">
					<left>680</left>
					<top>286</top>
					<width>1140</width>
					<height>32</height>
					<aligny>center</aligny>
					<font>Bald_InfoMeta</font>
					<textcolor>bald_ink70</textcolor>
					<label>$INFO[Weather.Data(Current.FeelsLike),$LOCALIZE[402] ]</label>
				</control>
				<control type="grouplist">
					<left>Bald_SafeLeft</left>
					<top>400</top>
					<width>1728</width>
					<height>56</height>
					<orientation>horizontal</orientation>
					<itemgap>24</itemgap>
					<include content="Bald_WeatherStat">
						<param name="info">Weather.Data(Current.Wind)</param>
						<param name="texture">icons/weather/wind.png</param>
						<param name="header">$LOCALIZE[404]</param>
					</include>
					<include content="Bald_WeatherStat">
						<param name="info">Weather.Data(Current.Humidity)</param>
						<param name="texture">icons/weather/humidity.png</param>
						<param name="header">$LOCALIZE[406]</param>
					</include>
					<include content="Bald_WeatherStat">
						<param name="info">Weather.Data(Current.Precipitation)</param>
						<param name="texture">icons/weather/rain.png</param>
						<param name="header">$LOCALIZE[33021]</param>
					</include>
					<include content="Bald_WeatherStat">
						<param name="info">Weather.Data(Today.Sunrise)</param>
						<param name="texture">icons/weather/sunrise.png</param>
						<param name="header">$LOCALIZE[405]</param>
					</include>
					<include content="Bald_WeatherStat">
						<param name="info">Weather.Data(Today.Sunset)</param>
						<param name="texture">icons/weather/sunset.png</param>
						<param name="header">$LOCALIZE[403]</param>
					</include>
				</control>
				<control type="label">
					<left>Bald_SafeLeft</left>
					<top>474</top>
					<width>1728</width>
					<height>24</height>
					<aligny>center</aligny>
					<font>Bald_Hint</font>
					<textcolor>bald_ink60</textcolor>
					<label>$LOCALIZE[31154]$INFO[Weather.LastUpdated, · $LOCALIZE[12014]: ,]</label>
					<visible>Control.HasFocus(20)</visible>
					<animation effect="fade" time="380" tween="sine" easing="inout">VisibleChange</animation>
				</control>
			</control>
			<include content="WeatherWidget">
				<param name="content_include" value="DailyItems" />
				<param name="list_id" value="15100" />
				<param name="widget_header" value="$LOCALIZE[31019]"/>
				<param name="visible" value="!String.IsEmpty(Weather.Data(Daily.IsFetched))" />
				<param name="width" value="258" />
			</include>
			<include content="WeatherWidget">
				<param name="content_include" value="HourlyItems" />
				<param name="list_id" value="15200" />
				<param name="widget_header" value="$LOCALIZE[33036]"/>
				<param name="visible" value="!String.IsEmpty(Weather.Data(Hourly.IsFetched))" />
				<param name="width" value="258" />
			</include>
			<include content="WeatherMapItem">
				<param name="item_id" value="1" />
				<param name="onup_id" value="15200" />
				<param name="ondown_id" value="70020" />
			</include>
			<include content="WeatherMapItem">
				<param name="item_id" value="2" />
				<param name="onup_id" value="70010" />
				<param name="ondown_id" value="70030" />
			</include>
			<include content="WeatherMapItem">
				<param name="item_id" value="3" />
				<param name="onup_id" value="70020" />
				<param name="ondown_id" value="70040" />
			</include>
			<include content="WeatherMapItem">
				<param name="item_id" value="4" />
				<param name="onup_id" value="70030" />
				<param name="ondown_id" value="70050" />
			</include>
			<include content="WeatherMapItem">
				<param name="item_id" value="5" />
				<param name="onup_id" value="70040" />
				<param name="ondown_id" value="20001" />
			</include>
		</control>
		<!-- Footer: the provider, and the page's hints. -->
		<include content="Bald_MediaFooter">
			<param name="label">$INFO[Weather.Data(WeatherProvider)]</param>
			<param name="width">1200</param>
		</include>
		<control type="group">
			<left>Bald_RightColumn</left>
			<top>Bald_HintTop</top>
			<include content="Bald_InfoHintPair">
				<param name="first">$LOCALIZE[31966]</param>
				<param name="second">$LOCALIZE[31984]</param>
			</include>
		</control>
		<!-- Updating: the page dims under the field and an accent dot breathes at the centre. -->
		<control type="group">
			<visible>Weather.IsUpdating</visible>
			<animation effect="fade" time="380" tween="sine" easing="inout">VisibleChange</animation>
			<control type="image">
				<width>1920</width>
				<height>1080</height>
				<texture colordiffuse="bald_field60">bald/white.png</texture>
			</control>
			<control type="image">
				<depth>DepthMax</depth>
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>24</width>
				<height>24</height>
				<texture colordiffuse="bald_accent">bald/dot.png</texture>
				<animation effect="fade" start="100" end="28" time="700" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
			</control>
		</control>
	</controls>
</window>
