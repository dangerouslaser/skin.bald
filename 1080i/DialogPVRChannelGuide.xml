<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald mini guide for one channel (pvrchannelguide), usually over live video. Started from Kodi 22 Estuary's
     DialogPVRChannelGuide.xml (Team Kodi, GPL-2.0-or-later). Kodi binds list 11 (CGUIDialogPVRItemsViewBase), fills
     it with the channel's programmes, selects the one on now and opens information on Select; scrollbar 60 is the
     list's page control. -->
<window>
	<!-- The video OSD's auto-close stops while the guide is browsed. -->
	<onload>CancelAlarm(bald_osd_close,true)</onload>
	<defaultcontrol always="true">11</defaultcontrol>
	<depth>DepthOSD</depth>
	<include>Bald_PVRAnimOverlay</include>
	<controls>
		<control type="group">
			<include>Bald_PVRInfoDim</include>
			<!-- Opened from a Live TV window rather than over video: quiet the window behind it. -->
			<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field60">bald/white.png</texture><visible>!Window.IsActive(fullscreenvideo)</visible></control>
			<include>Bald_PVRScrims</include>
			<include content="Bald_PVRHeader">
				<param name="title">$INFO[Container(11).ListItem.ChannelName]</param>
				<param name="section">$LOCALIZE[19069]$INFO[Container(11).ListItem.StartDate, · ]</param>
				<param name="clock">false</param>
				<param name="width">780</param>
			</include>
			<!-- Header label as Estuary numbers it; Kodi does not write to it. -->
			<control type="label" id="2"><font></font><include>HiddenObject</include></control>
			<control type="fixedlist" id="11">
				<left>Bald_SafeLeft</left><top>Bald_ContentTop</top><width>780</width><height>512</height>
				<onleft>11</onleft><onright>11</onright><onup>11</onup>
				<!-- Opened from the video OSD's down chain (Includes_Bald_OSD.xml): Right, or Down past the last programme,
				     opens the next panel of the chain, the channel list. Otherwise Down wraps as before. -->
				<onright condition="Window.IsVisible(videoosd) + $EXP[Bald_OSDChainChannels]">ActivateWindow(pvrosdchannels)</onright>
				<ondown condition="![Window.IsVisible(videoosd) + $EXP[Bald_OSDChainChannels]]">11</ondown>
				<ondown condition="Window.IsVisible(videoosd) + $EXP[Bald_OSDChainChannels]">ActivateWindow(pvrosdchannels)</ondown>
				<movement>3</movement><focusposition>3</focusposition>
				<pagecontrol>60</pagecontrol><scrolltime tween="cubic" easing="out">440</scrolltime>
				<itemlayout width="780" height="64"><include>Bald_PVREpgRow</include></itemlayout>
				<focusedlayout width="780" height="64"><include content="Bald_PVREpgRow"><param name="focused">true</param><param name="c1">bald_ink</param><param name="c2">bald_ink70</param></include></focusedlayout>
			</control>
			<include content="Bald_PVRScrollbar"><param name="id">60</param><param name="list_id">11</param><param name="left">892</param><param name="height">512</param></include>
			<!-- The focused programme: when, the accent line and the start of its plot. -->
			<control type="grouplist">
				<left>Bald_SafeLeft</left><top>760</top><width>780</width><height>170</height><orientation>vertical</orientation><itemgap>6</itemgap>
				<control type="label"><width>780</width><height>28</height><font>Bald_CaptionMeta</font><textcolor>bald_ink70</textcolor><label>$INFO[Container(11).ListItem.StartTime]$INFO[Container(11).ListItem.EndTime,–]$INFO[Container(11).ListItem.Duration, · ]$INFO[Container(11).ListItem.Genre, · ]</label></control>
				<control type="textbox"><width>780</width><height>120</height><font>Bald_CaptionPlot</font><textcolor>bald_ink80</textcolor><label>$INFO[Container(11).ListItem.Plot]</label></control>
			</control>
			<include content="Bald_PVRHints">
				<param name="first">$LOCALIZE[31668]</param>
				<param name="second">$LOCALIZE[31669]</param>
				<param name="left">Bald_SafeLeft</param>
				<param name="width">800</param>
			</include>
		</control>
	</controls>
</window>
