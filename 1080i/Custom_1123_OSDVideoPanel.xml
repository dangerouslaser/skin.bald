<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald video OSD, video: the codec flags on a player-process-info row and the play speed (tempo, or the rewind
     and fast forward scale). Up from the video button enters the panel.
     A companion panel of the video OSD (docs/SPEC.md 5.16, "Video OSD"; Includes_Bald_OSD.xml): VideoOSD opens it when
     its button (70062) takes focus. The row is repeated with that button real and the others as stand-ins that
     close this panel and focus the OSD's own button, so Left and Right keep moving along the row. -->
<window type="dialog" id="1123">
	<defaultcontrol always="true">70062</defaultcontrol>
	<zorder>1</zorder>
	<depth>DepthOSD</depth>
	<controls>
		<include>Bald_OSDVideoPanel</include>
		<include content="Bald_OSDRow">
			<param name="owner">1123</param>
			<param name="play">Fake</param>
			<param name="back">Fake</param>
			<param name="forward">Fake</param>
			<param name="stop">Fake</param>
			<param name="menu">Fake</param>
			<param name="teletext">Fake</param>
			<param name="stereo">Fake</param>
			<param name="info">Fake</param>
			<param name="audio">Fake</param>
			<param name="subtitles">Fake</param>
			<param name="video">Panel</param>
		</include>
		<include>Bald_OSDHints</include>
	</controls>
</window>
