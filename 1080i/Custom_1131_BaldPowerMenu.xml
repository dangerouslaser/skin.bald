<?xml version="1.0" encoding="UTF-8"?>
<!-- Customization > Power > Power menu: the entries of Kodi's power menu (DialogButtonMenu.xml), the Skin Variables menu "power"
     (shortcuts/skinvariables-shortcut-power.json in its addon_data). Every change goes through Skin Variables' plugin
     actions on the focused entry (do_toggle, do_edit, do_move, do_delete, do_new, do_refresh), which write the list and
     refresh 9100; closing the window after one stamps Bald.WidgetsStamp (Bald_StampWidgetsOnUnload), so Home rebuilds
     the generated menu (Bald_PowerMenuItems) on its next load.
     An entry with a "kind" is one of Kodi's own (Power off, Suspend, ...): it can be shown or hidden, renamed and moved,
     and shows only where the device can do it. One without is the user's own command, which can also be changed and
     removed. -->
<window type="window" id="1131">
	<include>Bald_CurtainHandoff</include>
	<defaultcontrol always="true">9100</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<include>Bald_StampWidgetsOnUnload</include>
	<controls>
		<include content="Bald_SettingsFrame"><param name="title">$LOCALIZE[31170]</param></include>
		<control type="list" id="9100">
			<include content="Bald_SettingsCategories"><param name="id">9100</param><param name="right">9200</param></include>
			<ondown>9090</ondown>
			<content>plugin://script.skinvariables/?info=get_shortcuts_node&amp;edit=true&amp;skin=skin.bald&amp;menu=power&amp;mode=submenu$INFO[Window(Home).Property(SkinVariables.ShortcutsNode.Reload),&amp;reload=,]</content>
		</control>
		<include content="Bald_SettingsLevelButton"><param name="list">9100</param><param name="right">9200</param></include>
		<include content="Bald_SettingsDetail">
			<param name="heading">$INFO[Container(9100).ListItem.Label]</param>
			<param name="note">$VAR[Bald_PowerEntryNote]</param>
			<control type="grouplist" id="9200">
				<include content="Bald_SettingsRows"><param name="left">9100</param></include>
				<control type="radiobutton" id="9201"><include content="Bald_ConfigureRow"><param name="level">basic</param></include><label>$LOCALIZE[31172]</label>
					<selected>String.IsEmpty(Container(9100).ListItem.Property(disabled))</selected>
					<visible>String.IsEmpty(Container(9100).ListItem.Property(blank))</visible>
					<onclick>SetProperty(Bald.WidgetsDirty,1,home)</onclick><onclick>RunPlugin($INFO[Container(9100).ListItem.Property(url)]&amp;func=do_toggle&amp;&amp;disabled)</onclick>
				</control>
				<control type="button" id="9202"><include content="Bald_ConfigureRow"><param name="level">basic</param></include><label>$LOCALIZE[118]</label>
					<visible>String.IsEmpty(Container(9100).ListItem.Property(blank))</visible>
					<onclick>SetProperty(Bald.WidgetsDirty,1,home)</onclick><onclick>RunPlugin($INFO[Container(9100).ListItem.Property(url)]&amp;func=do_edit&amp;&amp;label)</onclick>
				</control>
				<!-- The command, for the user's own entries only (Kodi's own keep theirs). -->
				<control type="button" id="9203"><include content="Bald_ConfigureRow"><param name="level">basic</param></include><label>$LOCALIZE[31173]</label><label2>$INFO[Container(9100).ListItem.Property(path)]</label2>
					<visible>String.IsEmpty(Container(9100).ListItem.Property(blank)) + String.IsEmpty(Container(9100).ListItem.Property(kind))</visible>
					<onclick>SetProperty(Bald.WidgetsDirty,1,home)</onclick><onclick>RunPlugin($INFO[Container(9100).ListItem.Property(url)]&amp;func=do_edit&amp;&amp;path)</onclick>
				</control>
				<!-- Move: Skin Variables selects the moved entry in the list (refocus::9100), which also focuses the list; the
				     skin script puts focus back on a Move button (scripts/focus.py). -->
				<control type="button" id="9204"><include content="Bald_ConfigureRow"><param name="level">basic</param></include><label>$LOCALIZE[13332]</label>
					<visible>String.IsEmpty(Container(9100).ListItem.Property(blank))</visible>
					<onclick>SetProperty(Bald.WidgetsDirty,1,home)</onclick><onclick>RunPlugin($INFO[Container(9100).ListItem.Property(url)]&amp;func=do_move&amp;&amp;-1&amp;&amp;refocus::9100)</onclick><onclick>RunScript(skin.bald,keepfocus,9100|9204|9205)</onclick>
				</control>
				<control type="button" id="9205"><include content="Bald_ConfigureRow"><param name="level">basic</param></include><label>$LOCALIZE[13333]</label>
					<visible>String.IsEmpty(Container(9100).ListItem.Property(blank))</visible>
					<onclick>SetProperty(Bald.WidgetsDirty,1,home)</onclick><onclick>RunPlugin($INFO[Container(9100).ListItem.Property(url)]&amp;func=do_move&amp;&amp;1&amp;&amp;refocus::9100)</onclick><onclick>RunScript(skin.bald,keepfocus,9100|9205|9204)</onclick>
				</control>
				<!-- Add a command after the focused entry: a Kodi command, a program add-on (RunScript) or the user's own
				     (grouping://bald/power/ in skinvariables-shortcut-config.json). -->
				<control type="button" id="9206"><include content="Bald_ConfigureRow"><param name="level">basic</param></include><label>$LOCALIZE[31174]</label>
					<visible>Integer.IsLess(Container(9100).NumItems,20)</visible>
					<onclick>SetProperty(Bald.WidgetsDirty,1,home)</onclick><onclick>RunPlugin($INFO[Container(9100).ListItem.Property(url)]&amp;func=do_new&amp;&amp;grouping::grouping://bald/power/&amp;&amp;refocus::9100)</onclick>
				</control>
				<control type="button" id="9207"><include content="Bald_ConfigureRow"><param name="level">basic</param></include><label>$LOCALIZE[1210]</label>
					<visible>String.IsEmpty(Container(9100).ListItem.Property(blank)) + String.IsEmpty(Container(9100).ListItem.Property(kind))</visible>
					<onclick>SetProperty(Bald.WidgetsDirty,1,home)</onclick><onclick>RunPlugin($INFO[Container(9100).ListItem.Property(url)]&amp;func=do_delete)</onclick>
				</control>
				<!-- Back to the shipped list (Skin Variables asks first and rebuilds). -->
				<control type="button" id="9208"><include content="Bald_ConfigureRow"><param name="level">standard</param></include><label>$LOCALIZE[31175]</label>
					<onclick>SetProperty(Bald.WidgetsDirty,1,home)</onclick><onclick>RunPlugin($INFO[Container(9100).ListItem.Property(url)]&amp;func=do_refresh&amp;&amp;True)</onclick>
				</control>
			</control>
		</include>
		<include content="Bald_SettingsHints"><param name="first">$VAR[Bald_KeyLeft]$LOCALIZE[31170]</param><param name="second">$VAR[Bald_KeyBack]$LOCALIZE[31753]</param></include>
	</controls>
</window>
