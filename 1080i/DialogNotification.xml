<?xml version="1.0" encoding="UTF-8"?>
<!-- Toast notifications. Started from Kodi 22 Estuary's DialogNotification.xml (GPL-2.0-or-later, see
     LICENSE-Estuary.txt). Kodi (CGUIDialogKaiToast) binds image 400 (the toast's icon: an add-on's art or Kodi's
     DefaultIconInfo/Warning/Error), label 401 (caption) and fadelabel 402 (message; Kodi keeps the toast up until a
     fadelabel has scrolled through, so 402 stays a fadelabel).
     Bald: a 560 x 104 field card on the right safe edge at the safe top, icon at 64 px (not tinted: it is usually an
     add-on's own artwork), caption in the section face at full ink, message at 60%. Fades in with a 24 px slide from the
     right. -->
<window>
	<zorder>3</zorder>
	<controls>
		<control type="group">
			<depth>DepthMax</depth>
			<top>Bald_ToastTop</top>
			<left>1264</left>
			<width>560</width>
			<height>104</height>
			<include content="Bald_OverlayOpenClose">
				<param name="offset" value="24,0" />
			</include>
			<visible>String.IsEmpty(Window(Home).Property(script.cinemavision.running))</visible>
			<include content="Bald_OverlaySurface">
				<param name="width" value="560" />
				<param name="height" value="104" />
			</include>
			<control type="image" id="400">
				<description>avatar</description>
				<left>20</left>
				<top>20</top>
				<width>64</width>
				<height>64</height>
				<aspectratio>keep</aspectratio>
			</control>
			<control type="fadelabel" id="401">
				<description>Line 1 Label</description>
				<left>104</left>
				<top>20</top>
				<width>432</width>
				<height>32</height>
				<font>Bald_Section</font>
				<textcolor>bald_ink</textcolor>
				<aligny>center</aligny>
				<scrollout>false</scrollout>
				<pauseatend>2000</pauseatend>
			</control>
			<control type="fadelabel" id="402">
				<description>Line 2 Label</description>
				<left>104</left>
				<top>54</top>
				<width>432</width>
				<height>30</height>
				<font>Bald_CaptionMeta</font>
				<textcolor>bald_ink60</textcolor>
				<aligny>center</aligny>
				<scrollout>false</scrollout>
				<pauseatend>2000</pauseatend>
			</control>
		</control>
	</controls>
</window>
