	<!-- A player's row in the agents list: the driver's controller name, then the ports its controller uses. -->
	<include name="AgentControllerList">
		<param name="ink">bald_ink70</param>
		<definition>
			<control type="label">
				<description>Controller name as reported by the driver</description>
				<left>20</left>
				<width>460</width>
				<height>96</height>
				<aligny>center</aligny>
				<font>Bald_Section</font>
				<textcolor>$PARAM[ink]</textcolor>
				<label>$INFO[ListItem.Label]</label>
			</control>
			<control type="gamecontrollerlist">
				<description>Controller list which indicates the port a player's controller is connected to. Length should fit 13 listitems (12 controller items and one "input disabled" item).</description>
				<right>0</right>
				<width>1248</width>
				<orientation>horizontal</orientation>
				<align>right</align>
				<enable>false</enable>
				<itemlayout width="96" height="96">
					<include content="Bald_GameController">
						<peripherallocation>$INFO[ListItem.FilenameAndPath]</peripherallocation>
					</include>
				</itemlayout>
				<focusedlayout width="96" height="96">
					<include content="Bald_GameController">
						<peripherallocation>$INFO[ListItem.FilenameAndPath]</peripherallocation>
					</include>
				</focusedlayout>
			</control>
		</definition>
	</include>
	<include name="GameDialogDiscManager">
		<control type="group">
			<animation effect="fade" time="200" tween="sine" easing="inout">VisibleChange</animation>
			<centertop>50%</centertop>
			<centerleft>50%</centerleft>
			<width>1480</width>
			<height>630</height>
			<include content="DialogBackgroundCommons">
				<param name="width" value="1480" />
				<param name="height" value="630" />
				<param name="header_label" value="$LOCALIZE[35272]" />
			</include>
			<control type="group">
				<description>Content area</description>
				<top>100</top>
				<bottom>30</bottom>
				<left>40</left>
				<right>40</right>
				<control type="group">
					<description>Visibility group for main menu</description>
					<visible>String.IsEqual(Window.Property(GameDiscManager.ShowMenu),true)</visible>
					<control type="list" id="3">
						<description>Disc manager menu. The content is a template from which the menu items are generated.</description>
						<width>1400</width>
						<height>500</height>
						<scrolltime tween="cubic" easing="out">200</scrolltime>
						<orientation>vertical</orientation>
						<itemlayout width="1400" height="100">
							<include content="GameDiscManagerMenuItem" />
						</itemlayout>
						<focusedlayout width="1400" height="100">
							<control type="image">
								<texture colordiffuse="bald_ink10">bald/white.png</texture>
								<visible>Control.HasFocus(3)</visible>
							</control>
							<include content="GameDiscManagerMenuItem">
								<param name="ink">bald_ink</param>
							</include>
						</focusedlayout>
						<content>
							<item id="108323">
								<description>"Selected disc" item. Label2 is the inserted disc's label (or "No disc" if no disc is inserted).</description>
								<label>$LOCALIZE[35273]</label>
								<label2>$LOCALIZE[35274]</label2>
								<icon>DefaultSets.png</icon>
								<property name="EnableOnEject">true</property>
							</item>
							<item id="108324">
								<description>"Eject"/"Insert" item. Label2 is the tray status (only "Tray open" is shown).</description>
								<label>$LOCALIZE[35275]</label>
								<icon>icons/eject_256.png</icon>
							</item>
							<item id="108325">
								<description>"Add" item for adding another disc to the disc playlist</description>
								<label>$LOCALIZE[15019]</label>
								<icon>DefaultAddSource.png</icon>
								<property name="EnableOnEject">true</property>
							</item>
							<item id="108326">
								<description>"Delete" item for deleting a disc from the disc playlist</description>
								<label>$LOCALIZE[117]</label>
								<icon>DefaultAddonNone.png</icon>
								<property name="EnableOnEject">true</property>
							</item>
							<item id="108327">
								<description>"Resume game" item for resuming the game</description>
								<label>$LOCALIZE[35277]</label>
								<icon>osd/fullscreen/buttons/play.png</icon>
							</item>
						</content>
					</control>
				</control>
				<control type="group">
					<description>Visibility group for disc list</description>
					<visible>String.IsEqual(Window.Property(GameDiscManager.ShowDiscList),true)</visible>
					<control type="list" id="108321">
						<description>Disc list</description>
						<width>1400</width>
						<height>500</height>
						<onup>108321</onup>
						<ondown>108321</ondown>
						<pagecontrol>108322</pagecontrol>
						<scrolltime tween="cubic" easing="out">200</scrolltime>
						<orientation>vertical</orientation>
						<itemlayout width="1400" height="100">
							<include content="GameDiscManagerDiscItem" />
						</itemlayout>
						<focusedlayout width="1400" height="100">
							<control type="image">
								<texture colordiffuse="bald_ink10">bald/white.png</texture>
								<visible>Control.HasFocus(108321)</visible>
							</control>
							<include content="GameDiscManagerDiscItem">
								<param name="ink">bald_ink</param>
							</include>
						</focusedlayout>
					</control>
					<control type="scrollbar" id="108322">
						<description>Disc list scroll bar</description>
						<left>1412</left>
						<height>500</height>
						<include>Bald_MediaScrollbarLook</include>
					</control>
				</control>
			</control>
		</control>
	</include>
	<!-- A disc manager menu row. Items marked EnableOnEject dim to 34% while the tray is closed (Estuary's 38%). -->
	<include name="GameDiscManagerMenuItem">
		<param name="ink">bald_ink70</param>
		<definition>
			<control type="group">
				<visible>!String.IsEqual(ListItem.Property(EnableOnEject),true) | RetroPlayer.DiscEjected</visible>
				<include content="Bald_GameDiscRow">
					<param name="ink">$PARAM[ink]</param>
				</include>
			</control>
			<control type="group">
				<visible>String.IsEqual(ListItem.Property(EnableOnEject),true) + !RetroPlayer.DiscEjected</visible>
				<include content="Bald_GameDiscRow">
					<param name="ink">bald_ink34</param>
				</include>
			</control>
		</definition>
	</include>
	<include name="GameDiscManagerDiscItem">
		<param name="ink">bald_ink70</param>
		<definition>
			<control type="label">
				<left>26</left>
				<right>26</right>
				<height>100</height>
				<aligny>center</aligny>
				<font>Bald_Section</font>
				<textcolor>$PARAM[ink]</textcolor>
				<label>$INFO[ListItem.Label]</label>
			</control>
		</definition>
	</include>
</includes>
