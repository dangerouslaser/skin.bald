<?xml version="1.0" encoding="UTF-8"?>
<!-- Started from Kodi 22's bundled Estuary (skin.estuary, GPL-2.0-or-later; see LICENSE-Estuary.txt).
     Bald: the main browse list for add-ons, plugins, files, playlists and favourites. Eleven 56 px rows at the safe
     margin (icons for add-ons, plugin folders, playlists and favourites; text rows for videos and songs) beside the
     preview column, which the window supplies (ListThumbInfoPanel). Id, viewtype, page control 531 and navigation
     are Estuary's. -->
<includes>
	<include name="View_55_WideList">
		<param name="bottom_offset">list_bottom_offset</param>
		<definition>
			<control type="group">
				<visible>Control.IsVisible(55)</visible>
				<include>Bald_BrowseViewIn</include>
				<control type="list" id="55">
					<onfocus condition="Container.Content(tvshows)">Container.SetViewMode(520)</onfocus><onfocus condition="Container.Content(seasons)">Container.SetViewMode(530)</onfocus><onfocus condition="Container.Content(episodes)">Container.SetViewMode(540)</onfocus>
					<left>Bald_SafeLeft</left>
					<top>Bald_ContentTop</top>
					<width>1140</width>
					<height>616</height>
					<scrolltime tween="cubic" easing="out">440</scrolltime>
					<orientation>vertical</orientation>
					<preloaditems>2</preloaditems>
					<pagecontrol>531</pagecontrol>
					<onleft>9000</onleft>
					<onright>531</onright>
					<onup>55</onup>
					<ondown>55</ondown>
					<viewtype label="$LOCALIZE[31107]">list</viewtype>
					<include>Bald_BrowseDim</include>
					<!-- Videos and playlists: text rows with the watched state. -->
					<itemlayout height="56" condition="Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes) | Container.Content(movies) | Container.Content(musicvideos) | Container.Content(videos) | Container.Content(games) | Window.IsActive(videoplaylist) | Window.IsActive(musicplaylist)">
						<include content="Bald_BrowseTextRow"><param name="height">56</param></include>
					</itemlayout>
					<focusedlayout height="56" condition="Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes) | Container.Content(movies) | Container.Content(musicvideos) | Container.Content(videos) | Container.Content(games) | Window.IsActive(videoplaylist) | Window.IsActive(musicplaylist)">
						<include content="Bald_BrowseRowDot"><param name="top">24</param><param name="visible">Control.HasFocus(55)</param></include>
						<include content="Bald_BrowseTextRow"><param name="height">56</param><param name="ink">bald_ink</param><param name="scroll">true</param></include>
					</focusedlayout>
					<!-- Other library content (genres, years, actors, sources...): text rows. -->
					<itemlayout height="56" condition="!Container.Content(songs) + !Container.Content(addons) + !Container.Content(playlists) + !Container.Content() + !Container.Content(tvshows) + !Container.Content(seasons) + !Container.Content(episodes) + !Container.Content(movies) + !Container.Content(musicvideos) + !Container.Content(videos) + !Container.Content(favourites) + !Container.Content(recordings)">
						<include content="Bald_BrowseTextRow"><param name="height">56</param><param name="label">$INFO[ListItem.Label]</param></include>
					</itemlayout>
					<focusedlayout height="56" condition="!Container.Content(songs) + !Container.Content(addons) + !Container.Content(playlists) + !Container.Content() + !Container.Content(tvshows) + !Container.Content(seasons) + !Container.Content(episodes) + !Container.Content(movies) + !Container.Content(musicvideos) + !Container.Content(videos) + !Container.Content(favourites) + !Container.Content(recordings)">
						<include content="Bald_BrowseRowDot"><param name="top">24</param><param name="visible">Control.HasFocus(55)</param></include>
						<include content="Bald_BrowseTextRow"><param name="height">56</param><param name="label">$INFO[ListItem.Label]</param><param name="ink">bald_ink</param><param name="scroll">true</param></include>
					</focusedlayout>
					<!-- Playlists, favourites and plain folders (plugins, files, sources): icon rows. -->
					<itemlayout height="56" condition="Container.Content(playlists) | Container.Content(favourites) | Container.Content()">
						<include content="Bald_BrowseIconRow" />
					</itemlayout>
					<focusedlayout height="56" condition="Container.Content(playlists) | Container.Content(favourites) | Container.Content()">
						<include content="Bald_BrowseRowDot"><param name="top">24</param><param name="visible">Control.HasFocus(55)</param></include>
						<include content="Bald_BrowseIconRow"><param name="ink">bald_ink</param><param name="icon_diffuse">bald_ink</param><param name="scroll">true</param></include>
					</focusedlayout>
					<include condition="Window.IsActive(music)">SongsListLayout</include>
					<include>AddonsListLayout</include>
				</control>
			</control>
		</definition>
	</include>
	<include name="SongsListLayout">
		<itemlayout height="56" condition="Container.Content(songs)">
			<include content="Bald_BrowseTextRow"><param name="height">56</param></include>
		</itemlayout>
		<focusedlayout height="56" condition="Container.Content(songs)">
			<include content="Bald_BrowseRowDot"><param name="top">24</param><param name="visible">Control.HasFocus(55)</param></include>
			<include content="Bald_BrowseTextRow"><param name="height">56</param><param name="ink">bald_ink</param><param name="scroll">true</param></include>
		</focusedlayout>
	</include>
	<include name="AddonsListLayout">
		<itemlayout height="56" condition="Container.Content(addons)">
			<include content="Bald_BrowseAddonRow" />
		</itemlayout>
		<focusedlayout height="56" condition="Container.Content(addons)">
			<include content="Bald_BrowseRowDot"><param name="top">24</param><param name="visible">Control.HasFocus(55)</param></include>
			<include content="Bald_BrowseAddonRow"><param name="ink">bald_ink</param><param name="icon_diffuse">bald_ink</param><param name="scroll">true</param></include>
		</focusedlayout>
	</include>
</includes>
