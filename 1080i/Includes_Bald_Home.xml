<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald Home: variables, animations and repeated control groups (docs/SPEC.md sections 4 and 5.1).

     Animation model. Kodi animations are state-driven: Visible/Hidden animations fire on edges of a visibility
     condition, Conditional animations expect their condition to hold. So every item-change transition is keyed to a
     state that flips on each move and then holds: whether the current row's item position is odd or even
     (Integer.IsOdd(Container(c).CurrentItem)). Each animated piece exists twice, an Odd and an Even instance:
       - the incoming instance becomes visible and plays its Visible animation (fade, stagger, rise, zoom);
       - the outgoing one hides. Images keep their old texture while a Hidden animation plays
         (CGUIImage::UpdateInfo), so fanart and clearlogos fade out with the old picture. Labels cannot freeze,
         so text has no Hidden animation and disappears at once.
     Row swaps and the menu use Visible/Hidden on groups keyed to the Bald.Row and Bald.Menu properties.
     Do not use Container.OnNext (true for one frame; a reversible="false" Conditional is reset when its condition
     drops), skin timers (they run every 500 ms) or Container.Scrolling (briefly true at the end of every scroll).

     State lives in Home window properties:
       Bald.Row      id of the current row (9101 to 9103); art and caption follow it, not the focused control
       Bald.Menu     set while the menu is open
       Bald.NudgeL/R flips between a and b to replay the row edge nudge -->
<includes>
	<!-- Curves (docs/SPEC.md section 4): move = cubic out, fade = sine inout, pop = back out. -->

	<!-- ============ Info handoff (docs/SPEC.md 4 and 5.2) ============ -->
	<!-- Info opens as a dialog over Home. Home does the handoff: the art frame zooms to full screen (translate -96,-120
	     and scale 1.53846 in the prototype, i.e. zoom about 274,343), 640 move after 40, and back 540 after 160 when
	     it closes; Home chrome goes out 200 and returns 380 / 480 after 440. Paired non-reversible Conditionals keep
	     open and close timings separate; Kodi applies a Conditional's end state silently at window load. -->
	<expression name="Bald_InfoOpen">Window.IsVisible(movieinformation) | !String.IsEmpty(Window(home).Property(Bald.InfoSwitch))</expression>
	<!-- Keep the outgoing art during exchanges; don't show a previous dialog's property on initial open. -->
	<expression name="Bald_InfoArtReady">!String.IsEmpty(Window(home).Property(Bald.InfoSwitch)) | [!String.IsEmpty(Window(movieinformation).Property(Bald.Identity)) + String.IsEqual(Window(movieinformation).Property(Bald.ArtIdentity),Window(movieinformation).Property(Bald.Identity))]</expression>
	<!-- A modal dialog is over Home. <visible> and animation conditions are evaluated without a window context, so
	     under a modal dialog any Container(...) in them resolves against the dialog; Home guards on this. -->
	<expression name="Bald_DialogOver">System.HasActiveModalDialog | $EXP[Bald_InfoOpen] | Window.IsVisible(contextmenu)</expression>
	<include name="Bald_AnimInfoFrame">
		<animation type="Conditional" condition="$EXP[Bald_InfoOpen]" reversible="false">
			<effect type="zoom" start="100" end="153.846" center="274,343" time="640" delay="40" tween="cubic" easing="out" />
		</animation>
		<animation type="Conditional" condition="!$EXP[Bald_InfoOpen]" reversible="false">
			<effect type="zoom" start="153.846" end="100" center="274,343" time="540" delay="30" tween="cubic" easing="out" />
		</animation>
	</include>
	<include name="Bald_AnimInfoChrome">
		<animation type="Conditional" condition="$EXP[Bald_InfoOpen]" reversible="false">
			<effect type="fade" start="100" end="0" time="200" tween="sine" easing="inout" />
			<effect type="slide" start="0,0" end="24,0" time="220" tween="cubic" easing="out" />
		</animation>
		<animation type="Conditional" condition="!$EXP[Bald_InfoOpen]" reversible="false">
			<effect type="fade" start="0" end="100" time="380" delay="440" tween="sine" easing="inout" />
			<effect type="slide" start="24,0" end="0,0" time="480" delay="440" tween="cubic" easing="out" />
		</animation>
	</include>
	<!-- The logo scrim and clearlogo on the art leave with the chrome and come back once the frame has settled. -->
	<include name="Bald_AnimInfoArtOverlay">
		<animation type="Conditional" condition="$EXP[Bald_InfoOpen]" reversible="false">
			<effect type="fade" start="100" end="0" time="200" tween="sine" easing="inout" />
		</animation>
		<animation type="Conditional" condition="!$EXP[Bald_InfoOpen]" reversible="false">
			<effect type="fade" start="0" end="100" time="500" delay="600" tween="sine" easing="inout" />
		</animation>
	</include>
	<!-- The frame masks would cover the zoomed art: gone at once, back after the frame is home again. -->
	<include name="Bald_AnimInfoMasks">
		<animation type="Conditional" condition="$EXP[Bald_InfoOpen]" reversible="false">
			<effect type="fade" start="100" end="0" time="60" tween="sine" easing="inout" />
		</animation>
		<animation type="Conditional" condition="!$EXP[Bald_InfoOpen]" reversible="false">
			<effect type="fade" start="0" end="100" time="80" delay="620" tween="sine" easing="inout" />
		</animation>
	</include>

	<!-- ============ Background ============ -->
	<!-- The current row item's fanart, blurred by TMDb Helper (Gaussian radius 40 on a 480 px copy, cached), darkened
	     for the OLED with colordiffuse. <fadetime> crossfades between titles and waits until the new image has loaded. -->
	<include name="Bald_BackdropImage">
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<aspectratio>scale</aspectratio>
			<fadetime>800</fadetime>
			<texture background="true">$INFO[Window(home).Property(TMDbHelper.ListItem.BlurImage)]</texture>
			<!-- Optional enhancement: the field underneath is the supported no-helper fallback. -->
			<visible>System.HasAddon(plugin.video.themoviedb.helper) + !String.IsEmpty(Window(home).Property(TMDbHelper.ListItem.BlurImage))</visible>
			<colordiffuse>bald_backdrop</colordiffuse>
		</control>
	</include>
	<include name="Bald_Backdrop">
		<include>Bald_BackdropImage</include>
	</include>
	<!-- Shared note position and typography for the five-row Home and context menus. -->
	<include name="Bald_MenuNote">
		<param name="id">0</param>
		<param name="text" />
		<definition>
			<control type="label" id="$PARAM[id]">
				<left>1466</left>
				<top>714</top>
				<width>394</width>
				<height>120</height>
				<wrapmultiline>true</wrapmultiline>
				<aligny>top</aligny>
				<font>Bald_MenuNote</font>
				<textcolor>bald_ink60</textcolor>
				<label>$PARAM[text]</label>
			</control>
		</definition>
	</include>
	<!-- A window onto the background at x,y w x h: a grouplist clips to its bounds, and the full-screen image inside is
	     offset back to 0,0, so it lines up exactly with the background. Used to mask the art frame's zoom overflow. -->
	<include name="Bald_BackdropWindow">
		<param name="x" />
		<param name="y" />
		<param name="w" />
		<param name="h" />
		<definition>
			<control type="grouplist">
				<left>$PARAM[x]</left>
				<top>$PARAM[y]</top>
				<width>$PARAM[w]</width>
				<height>$PARAM[h]</height>
				<usecontrolcoords>true</usecontrolcoords>
				<control type="group">
					<left>-$PARAM[x]</left>
					<top>-$PARAM[y]</top>
					<width>1920</width>
					<height>1080</height>
					<control type="image">
						<width>1920</width>
						<height>1080</height>
						<texture colordiffuse="bald_field">bald/white.png</texture>
					</control>
					<include>Bald_BackdropImage</include>
				</control>
			</control>
		</definition>
	</include>

	<!-- ============ Current-row variables (art frame) ============ -->
	<variable name="Bald_Fanart">
		<value condition="String.IsEqual(Window(home).Property(Bald.Row),9102) + !String.IsEmpty(Container(9102).ListItem.Art(fanart))">$INFO[Container(9102).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(home).Property(Bald.Row),9102) + !String.IsEmpty(Container(9102).ListItem.Art(tvshow.fanart))">$INFO[Container(9102).ListItem.Art(tvshow.fanart)]</value>
		<value condition="String.IsEqual(Window(home).Property(Bald.Row),9102)">$INFO[Container(9102).ListItem.Art(thumb)]</value>
		<value condition="String.IsEqual(Window(home).Property(Bald.Row),9103) + !String.IsEmpty(Container(9103).ListItem.Art(fanart))">$INFO[Container(9103).ListItem.Art(fanart)]</value>
		<value condition="String.IsEqual(Window(home).Property(Bald.Row),9103) + !String.IsEmpty(Container(9103).ListItem.Art(tvshow.fanart))">$INFO[Container(9103).ListItem.Art(tvshow.fanart)]</value>
		<value condition="String.IsEqual(Window(home).Property(Bald.Row),9103)">$INFO[Container(9103).ListItem.Art(thumb)]</value>
		<value condition="!String.IsEmpty(Container(9101).ListItem.Art(fanart))">$INFO[Container(9101).ListItem.Art(fanart)]</value>
		<value>$INFO[Container(9101).ListItem.Art(thumb)]</value>
	</variable>
	<expression name="Bald_HasLogo">[String.IsEqual(Window(home).Property(Bald.Row),9102) + [!String.IsEmpty(Container(9102).ListItem.Art(clearlogo)) | !String.IsEmpty(Container(9102).ListItem.Art(tvshow.clearlogo))]] | [String.IsEqual(Window(home).Property(Bald.Row),9103) + [!String.IsEmpty(Container(9103).ListItem.Art(clearlogo)) | !String.IsEmpty(Container(9103).ListItem.Art(tvshow.clearlogo))]] | [!String.IsEqual(Window(home).Property(Bald.Row),9102) + !String.IsEqual(Window(home).Property(Bald.Row),9103) + !String.IsEmpty(Container(9101).ListItem.Art(clearlogo))]</expression>
	<!-- The current row's item position is odd. Flips on every one-step move and holds until the next. -->
	<expression name="Bald_ItemOdd">[String.IsEqual(Window(home).Property(Bald.Row),9101) + Integer.IsOdd(Container(9101).CurrentItem)] | [String.IsEqual(Window(home).Property(Bald.Row),9102) + Integer.IsOdd(Container(9102).CurrentItem)] | [String.IsEqual(Window(home).Property(Bald.Row),9103) + Integer.IsOdd(Container(9103).CurrentItem)]</expression>
	<expression name="Bald_MenuOpen">!String.IsEmpty(Window(home).Property(Bald.Menu))</expression>
	<!-- The main menu or the context menu (restyled as the same menu over Home) is open: the caption slides out,
	     the section line hides, the rows dim. -->
	<expression name="Bald_OverlayOpen">!String.IsEmpty(Window(home).Property(Bald.Menu)) | Window.IsVisible(contextmenu)</expression>
	<!-- Menu open with a screen other than Home focused: its (placeholder) rows preview instead of Home's. -->
	<expression name="Bald_PreviewOther">!String.IsEmpty(Window(home).Property(Bald.Menu)) + !String.IsEqual(Container(9000).ListItem.Property(id),home)</expression>
	<expression name="Bald_Idle">System.IdleTime(60) + Window.IsActive(home)</expression>

	<variable name="Bald_NudgeLNext">
		<value condition="String.IsEqual(Window(home).Property(Bald.NudgeL),a)">b</value>
		<value>a</value>
	</variable>
	<variable name="Bald_NudgeRNext">
		<value condition="String.IsEqual(Window(home).Property(Bald.NudgeR),a)">b</value>
		<value>a</value>
	</variable>

	<!-- ============ Animations ============ -->
	<!-- Caption element in: fade 380 and move 540 from 14 px left after a delay (180 settle plus the stagger).
	     Visible plays when this Odd/Even instance takes over (an item change); the Conditional plays when the row
	     becomes current (a row swap), since the element's own visibility does not change then. -->
	<include name="Bald_AnimCaptionIn">
		<param name="c" />
		<param name="delay" />
		<definition>
			<animation type="Conditional" condition="String.IsEqual(Window(home).Property(Bald.Row),$PARAM[c])" reversible="false">
				<effect type="fade" start="0" end="100" time="380" delay="$PARAM[delay]" tween="sine" easing="inout" />
				<effect type="slide" start="-14,0" end="0,0" time="540" delay="$PARAM[delay]" tween="cubic" easing="out" />
			</animation>
			<animation type="Visible">
				<effect type="fade" start="0" end="100" time="380" delay="$PARAM[delay]" tween="sine" easing="inout" />
				<effect type="slide" start="-14,0" end="0,0" time="540" delay="$PARAM[delay]" tween="cubic" easing="out" />
			</animation>
		</definition>
	</include>
	<!-- Row swap: out 140 fade and drop 18 px, then (after 170, as in the prototype) in 360 fade and 440 rise. -->
	<include name="Bald_AnimRowSwap">
		<animation type="Visible">
			<effect type="fade" start="0" end="100" time="360" delay="170" tween="sine" easing="inout" />
			<effect type="slide" start="0,18" end="0,0" time="440" delay="170" tween="cubic" easing="out" />
		</animation>
		<animation type="Hidden">
			<effect type="fade" start="100" end="0" time="140" tween="sine" easing="inout" />
			<effect type="slide" start="0,0" end="0,18" time="140" tween="sine" easing="inout" />
		</animation>
	</include>
	<!-- Row edge nudge: 14 px over 110, then back. -->
	<include name="Bald_AnimNudge">
		<param name="prop" />
		<param name="x" />
		<param name="back" />
		<definition>
			<animation type="Conditional" condition="String.IsEqual(Window(home).Property($PARAM[prop]),a)" reversible="false">
				<effect type="slide" start="0,0" end="$PARAM[x],0" time="110" tween="cubic" easing="out" />
				<effect type="slide" start="0,0" end="$PARAM[back],0" time="110" delay="110" tween="cubic" easing="out" />
			</animation>
			<animation type="Conditional" condition="String.IsEqual(Window(home).Property($PARAM[prop]),b)" reversible="false">
				<effect type="slide" start="0,0" end="$PARAM[x],0" time="110" tween="cubic" easing="out" />
				<effect type="slide" start="0,0" end="$PARAM[back],0" time="110" delay="110" tween="cubic" easing="out" />
			</animation>
		</definition>
	</include>
	<!-- Things that hide while the menu is open: out 160, back 360 after 120. -->
	<include name="Bald_AnimMenuHides">
		<animation type="Conditional" condition="$EXP[Bald_OverlayOpen]">
			<effect type="fade" start="100" end="0" time="160" tween="sine" easing="inout" />
		</animation>
	</include>

	<include name="Bald_AnimMenuShows">
		<animation type="Visible">
			<effect type="fade" start="0" end="100" time="380" delay="120" tween="sine" easing="inout" />
			<effect type="slide" start="40,0" end="0,0" time="480" delay="120" tween="cubic" easing="out" />
		</animation>
		<animation type="Hidden">
			<effect type="fade" start="100" end="0" time="160" tween="sine" easing="inout" />
			<effect type="slide" start="0,0" end="40,0" time="180" tween="cubic" easing="out" />
		</animation>
	</include>

	<include name="Bald_AnimLogoIn">
		<param name="c" />
		<definition>
			<animation type="Visible">
				<effect type="fade" start="0" end="100" time="520" delay="380" tween="sine" easing="inout" />
				<effect type="slide" start="0,10" end="0,0" time="760" delay="380" tween="cubic" easing="out" />
			</animation>
			<animation type="Hidden">
				<effect type="fade" start="100" end="0" time="150" tween="sine" easing="inout" />
			</animation>
		</definition>
	</include>
	<!-- The current row item's clearlogo (clearlogo, else the show's). -->
	<variable name="Bald_Logo">
		<value condition="String.IsEqual(Window(home).Property(Bald.Row),9102) + !String.IsEmpty(Container(9102).ListItem.Art(clearlogo))">$INFO[Container(9102).ListItem.Art(clearlogo)]</value>
		<value condition="String.IsEqual(Window(home).Property(Bald.Row),9102)">$INFO[Container(9102).ListItem.Art(tvshow.clearlogo)]</value>
		<value condition="String.IsEqual(Window(home).Property(Bald.Row),9103) + !String.IsEmpty(Container(9103).ListItem.Art(clearlogo))">$INFO[Container(9103).ListItem.Art(clearlogo)]</value>
		<value condition="String.IsEqual(Window(home).Property(Bald.Row),9103)">$INFO[Container(9103).ListItem.Art(tvshow.clearlogo)]</value>
		<value>$INFO[Container(9101).ListItem.Art(clearlogo)]</value>
	</variable>
	<!-- Fanart layer for one parity. The incoming layer fades in (700) while settling from 1.05 (1500); the outgoing
	     layer fades out (700) still showing the old art. A row swap that keeps the parity changes the visible
	     layer's texture instead, which <fadetime> crossfades (it waits until the new image has loaded). -->
	<include name="Bald_ArtLayer">
		<param name="visible" />
		<definition>
			<control type="image">
				<width>1248</width>
				<height>702</height>
				<aspectratio>scale</aspectratio>
				<fadetime>700</fadetime>
				<texture background="true">$VAR[Bald_Fanart]</texture>
				<visible>$PARAM[visible]</visible>
				<animation type="Visible">
					<effect type="fade" start="0" end="100" time="700" tween="sine" easing="inout" />
					<effect type="zoom" start="105" end="100" center="624,351" time="1500" tween="cubic" easing="out" />
				</animation>
				<animation type="Hidden">
					<effect type="fade" start="100" end="0" time="700" tween="sine" easing="inout" />
				</animation>
			</control>
		</definition>
	</include>

	<!-- Clearlogo on the art for one row and parity: fade 520 and rise 10 px over 760, 380 after the art starts;
	     the outgoing logo fades out (150) still showing the old picture. -->
	<include name="Bald_ArtLogo">
		<param name="c" />
		<param name="p" />
		<definition>
			<control type="image">
				<left>52</left>
				<top>486</top>
				<width>560</width>
				<height>170</height>
				<aspectratio align="left" aligny="bottom">keep</aspectratio>
				<texture background="true">$INFO[Container($PARAM[c]).ListItem.Art(clearlogo)]</texture>
				<visible>String.IsEqual(Window(home).Property(Bald.Row),$PARAM[c]) + Integer.Is$PARAM[p](Container($PARAM[c]).CurrentItem) + !String.IsEmpty(Container($PARAM[c]).ListItem.Art(clearlogo))</visible>
				<include content="Bald_AnimLogoIn"><param name="c">$PARAM[c]</param></include>
			</control>
			<control type="image">
				<left>52</left>
				<top>486</top>
				<width>560</width>
				<height>170</height>
				<aspectratio align="left" aligny="bottom">keep</aspectratio>
				<texture background="true">$INFO[Container($PARAM[c]).ListItem.Art(tvshow.clearlogo)]</texture>
				<visible>String.IsEqual(Window(home).Property(Bald.Row),$PARAM[c]) + Integer.Is$PARAM[p](Container($PARAM[c]).CurrentItem) + String.IsEmpty(Container($PARAM[c]).ListItem.Art(clearlogo)) + !String.IsEmpty(Container($PARAM[c]).ListItem.Art(tvshow.clearlogo))</visible>
				<include content="Bald_AnimLogoIn"><param name="c">$PARAM[c]</param></include>
			</control>
		</definition>
	</include>

	<!-- ============ Caption (per row and parity, bound to that row's container) ============ -->
	<include name="Bald_Caption">
		<param name="c" />
		<param name="p" />
		<definition>
			<control type="group">
				<visible>String.IsEqual(Window(home).Property(Bald.Row),$PARAM[c])</visible>
				<animation type="Hidden">
					<effect type="fade" start="100" end="0" time="130" tween="sine" easing="inout" />
					<effect type="slide" start="0,0" end="-14,0" time="130" tween="sine" easing="inout" />
				</animation>
				<!-- Title: wraps up to 3 lines (44 px each) and grows upward. The textbox sizes to its text and this
				     grouplist bottom-aligns it (align right = end of a vertical grouplist), so the last line always
				     ends at 464, where a one-line title ends, and the rest of the caption never moves. -->
				<control type="grouplist">
					<left>1420</left>
					<top>332</top>
					<width>440</width>
					<height>132</height>
					<orientation>vertical</orientation>
					<align>right</align>
					<usecontrolcoords>true</usecontrolcoords>
					<control type="textbox">
						<left>20</left>
						<width>384</width>
						<height max="132">auto</height>
						<font>Bald_CaptionTitle</font>
						<textcolor>bald_ink</textcolor>
						<label>$INFO[Container($PARAM[c]).ListItem.TVShowTitle]</label>
						<visible>Container($PARAM[c]).ListItem.IsEpisode + Integer.Is$PARAM[p](Container($PARAM[c]).CurrentItem)</visible>
						<include content="Bald_AnimCaptionIn"><param name="c">$PARAM[c]</param><param name="delay">180</param></include>
					</control>
					<control type="textbox">
						<left>20</left>
						<width>384</width>
						<height max="132">auto</height>
						<font>Bald_CaptionTitle</font>
						<textcolor>bald_ink</textcolor>
						<label>$INFO[Container($PARAM[c]).ListItem.Title]</label>
						<visible>!Container($PARAM[c]).ListItem.IsEpisode + Integer.Is$PARAM[p](Container($PARAM[c]).CurrentItem)</visible>
						<include content="Bald_AnimCaptionIn"><param name="c">$PARAM[c]</param><param name="delay">180</param></include>
					</control>
				</control>
				<control type="grouplist">
					<!-- Starts 20 px left of the caption so the 14 px slide-in is not clipped (grouplists clip). -->
					<left>1420</left>
					<top>464</top>
					<width>440</width>
					<height>396</height>
					<orientation>vertical</orientation>
					<itemgap>0</itemgap>
					<usecontrolcoords>true</usecontrolcoords>
					<!-- Meta: one label per item type -->
					<include content="Bald_CaptionMeta">
						<param name="c">$PARAM[c]</param>
						<param name="p">$PARAM[p]</param>
						<param name="label">S$INFO[Container($PARAM[c]).ListItem.Season] E$INFO[Container($PARAM[c]).ListItem.Episode]$INFO[Container($PARAM[c]).ListItem.Title,$COMMA ,]</param>
						<param name="visible">Container($PARAM[c]).ListItem.IsEpisode</param>
					</include>
					<include content="Bald_CaptionMeta">
						<param name="c">$PARAM[c]</param>
						<param name="p">$PARAM[p]</param>
						<param name="label">$INFO[Container($PARAM[c]).ListItem.Year,,$COMMA ]1 season</param>
						<param name="visible">String.IsEqual(Container($PARAM[c]).ListItem.DBType,tvshow) + String.IsEqual(Container($PARAM[c]).ListItem.Property(TotalSeasons),1)</param>
					</include>
					<include content="Bald_CaptionMeta">
						<param name="c">$PARAM[c]</param>
						<param name="p">$PARAM[p]</param>
						<param name="label">$INFO[Container($PARAM[c]).ListItem.Year]$INFO[Container($PARAM[c]).ListItem.Property(TotalSeasons),$COMMA , seasons]</param>
						<param name="visible">String.IsEqual(Container($PARAM[c]).ListItem.DBType,tvshow) + !String.IsEqual(Container($PARAM[c]).ListItem.Property(TotalSeasons),1)</param>
					</include>
					<include content="Bald_CaptionMeta">
						<param name="c">$PARAM[c]</param>
						<param name="p">$PARAM[p]</param>
						<param name="label">$INFO[Container($PARAM[c]).ListItem.Year,,$COMMA ]$INFO[Container($PARAM[c]).ListItem.Duration(h),,h ]$INFO[Container($PARAM[c]).ListItem.Duration(mm),,m]</param>
						<param name="visible">String.IsEqual(Container($PARAM[c]).ListItem.DBType,movie) + Integer.IsGreaterOrEqual(Container($PARAM[c]).ListItem.Duration(mins),60)</param>
					</include>
					<include content="Bald_CaptionMeta">
						<param name="c">$PARAM[c]</param>
						<param name="p">$PARAM[p]</param>
						<param name="label">$INFO[Container($PARAM[c]).ListItem.Year]$INFO[Container($PARAM[c]).ListItem.Duration(mins),$COMMA , min]</param>
						<param name="visible">String.IsEqual(Container($PARAM[c]).ListItem.DBType,movie) + !Integer.IsGreaterOrEqual(Container($PARAM[c]).ListItem.Duration(mins),60)</param>
					</include>
					<!-- Media flags: movies only -->
					<control type="grouplist">
						<top>10</top>
						<left>20</left>
						<width>384</width>
						<height>26</height>
						<orientation>horizontal</orientation>
						<itemgap>8</itemgap>
						<visible>Integer.Is$PARAM[p](Container($PARAM[c]).CurrentItem) + String.IsEqual(Container($PARAM[c]).ListItem.DBType,movie) + [String.IsEqual(Container($PARAM[c]).ListItem.VideoResolution,4K) | String.IsEqual(Container($PARAM[c]).ListItem.VideoResolution,1080) | !String.IsEmpty(Container($PARAM[c]).ListItem.HdrType) | String.IsEqual(Container($PARAM[c]).ListItem.AudioChannels,6) | String.IsEqual(Container($PARAM[c]).ListItem.AudioChannels,8)]</visible>
						<include content="Bald_AnimCaptionIn"><param name="c">$PARAM[c]</param><param name="delay">275</param></include>
						<include content="Bald_Flag"><param name="label">4K</param><param name="visible">String.IsEqual(Container($PARAM[c]).ListItem.VideoResolution,4K)</param></include>
						<include content="Bald_Flag"><param name="label">1080p</param><param name="visible">String.IsEqual(Container($PARAM[c]).ListItem.VideoResolution,1080)</param></include>
						<include content="Bald_Flag"><param name="label">Dolby Vision</param><param name="visible">String.IsEqual(Container($PARAM[c]).ListItem.HdrType,dolbyvision)</param></include>
						<include content="Bald_Flag"><param name="label">HDR10</param><param name="visible">String.IsEqual(Container($PARAM[c]).ListItem.HdrType,hdr10)</param></include>
						<include content="Bald_Flag"><param name="label">HDR10+</param><param name="visible">String.StartsWith(Container($PARAM[c]).ListItem.HdrType,hdr10) + !String.IsEqual(Container($PARAM[c]).ListItem.HdrType,hdr10)</param></include>
						<include content="Bald_Flag"><param name="label">HLG</param><param name="visible">String.IsEqual(Container($PARAM[c]).ListItem.HdrType,hlg)</param></include>
						<include content="Bald_Flag"><param name="label">Dolby Atmos</param><param name="visible">String.Contains(Container($PARAM[c]).ListItem.AudioCodec,atmos)</param></include>
						<include content="Bald_Flag"><param name="label">7.1</param><param name="visible">String.IsEqual(Container($PARAM[c]).ListItem.AudioChannels,8)</param></include>
						<include content="Bald_Flag"><param name="label">5.1</param><param name="visible">String.IsEqual(Container($PARAM[c]).ListItem.AudioChannels,6)</param></include>
					</control>
					<!-- Accent line -->
					<control type="label">
						<top>8</top>
						<left>20</left>
						<width>384</width>
						<height>24</height>
						<font>Bald_Accent</font>
						<textcolor>bald_accent</textcolor>
						<label>$INFO[Container($PARAM[c]).ListItem.Genre]</label>
						<visible>Integer.Is$PARAM[p](Container($PARAM[c]).CurrentItem)</visible>
						<include content="Bald_AnimCaptionIn"><param name="c">$PARAM[c]</param><param name="delay">300</param></include>
					</control>
					<!-- Plot: Kodi draws ceil(height / line height) lines, so 116 / 30 gives 4. No ellipsis is possible, see docs/NOTES.md. -->
					<control type="label">
						<top>18</top>
						<left>20</left>
						<width>384</width>
						<height>116</height>
						<wrapmultiline>true</wrapmultiline>
						<aligny>top</aligny>
						<font>Bald_CaptionPlot</font>
						<textcolor>bald_ink76</textcolor>
						<label>$INFO[Container($PARAM[c]).ListItem.Plot]</label>
						<visible>Integer.Is$PARAM[p](Container($PARAM[c]).CurrentItem)</visible>
						<include content="Bald_AnimCaptionIn"><param name="c">$PARAM[c]</param><param name="delay">350</param></include>
					</control>
				</control>
			</control>
		</definition>
	</include>
	<include name="Bald_CaptionMeta">
		<param name="c" />
		<param name="p" />
		<param name="label" />
		<param name="visible" />
		<definition>
			<control type="label">
				<left>20</left>
				<top>14</top>
				<width>384</width>
				<height>26</height>
				<font>Bald_CaptionMeta</font>
				<textcolor>bald_ink80</textcolor>
				<label>$PARAM[label]</label>
				<visible>$PARAM[visible] + Integer.Is$PARAM[p](Container($PARAM[c]).CurrentItem)</visible>
				<include content="Bald_AnimCaptionIn"><param name="c">$PARAM[c]</param><param name="delay">250</param></include>
			</control>
		</definition>
	</include>

	<!-- One outlined media flag chip. -->
	<include name="Bald_Flag">
		<param name="label" />
		<param name="visible">true</param>
		<definition>
			<control type="button">
				<width>auto</width>
				<height>26</height>
				<label>$PARAM[label]</label>
				<font>Bald_Flag</font>
				<textoffsetx>10</textoffsetx>
				<aligny>center</aligny>
				<textcolor>bald_ink</textcolor>
				<disabledcolor>bald_ink</disabledcolor>
				<texturenofocus border="6" colordiffuse="bald_ink50">bald/chip.png</texturenofocus>
				<texturefocus border="6" colordiffuse="bald_ink50">bald/chip.png</texturefocus>
				<enable>false</enable>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- ============ Rows ============ -->
	<variable name="Bald_TileArt">
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<variable name="Bald_TileLogo">
		<value condition="!String.IsEmpty(ListItem.Art(clearlogo))">$INFO[ListItem.Art(clearlogo)]</value>
		<value>$INFO[ListItem.Art(tvshow.clearlogo)]</value>
	</variable>
	<!-- A landscape tile: 176 x 99, 3 px corners, drawn 10 px inside its 192 px slot so the pop and ring are not clipped. -->
	<include name="Bald_LandscapeTile">
		<param name="diffuse">bald_tile_dim</param>
		<param name="ring">false</param>
		<definition>
			<control type="image">
				<left>10</left>
				<top>10</top>
				<width>176</width>
				<height>99</height>
				<texture colordiffuse="bald_tile_placeholder">bald/tile.png</texture>
			</control>
			<control type="image">
				<left>10</left>
				<top>10</top>
				<width>176</width>
				<height>99</height>
				<aspectratio scalediffuse="false">scale</aspectratio>
				<texture diffuse="bald/tile.png" colordiffuse="$PARAM[diffuse]" background="true">$VAR[Bald_TileArt]</texture>
			</control>
			<control type="image">
				<left>7</left>
				<top>7</top>
				<width>182</width>
				<height>105</height>
				<texture border="8" colordiffuse="bald_ink">bald/focus_ring.png</texture>
				<visible>$PARAM[ring]</visible>
			</control>
			<!-- Invisible clearlogo: loads each visible tile's logo into Kodi's texture cache before it is focused,
			     so the art-frame logo is ready when its fade-in starts (a fadetime on the logo ghosted old logos). -->
			<control type="image">
				<left>10</left>
				<top>10</top>
				<width>56</width>
				<height>17</height>
				<aspectratio>keep</aspectratio>
				<texture colordiffuse="00FFFFFF" background="true">$VAR[Bald_TileLogo]</texture>
			</control>
		</definition>
	</include>

	<!-- A home row: label line plus fixedlist. Pass <content> elements as children.
	     Focus travels to slot 2, then the row scrolls (440 move). Only the current row is visible;
	     the others keep focus reachable with allowhiddenfocus. -->
	<include name="Bald_Row">
		<param name="id" />
		<param name="label" />
		<param name="index" />
		<param name="up" />
		<param name="down">noop</param>
		<definition>
			<control type="group">
				<visible>String.IsEqual(Window(home).Property(Bald.Row),$PARAM[id]) + !$EXP[Bald_PreviewOther]</visible>
				<include>Bald_AnimRowSwap</include>
				<include>Bald_AnimInfoChrome</include>
				<animation type="Conditional" condition="$EXP[Bald_OverlayOpen]">
					<effect type="fade" start="100" end="60" time="360" tween="sine" easing="inout" />
				</animation>
				<animation type="Conditional" condition="$EXP[Bald_Idle]">
					<effect type="fade" start="100" end="40" time="900" tween="sine" easing="inout" />
				</animation>
				<!-- Row label line: label, row dots, count -->
				<control type="grouplist">
					<left>96</left>
					<top>856</top>
					<width>1248</width>
					<height>26</height>
					<orientation>horizontal</orientation>
					<itemgap>14</itemgap>
					<!-- Labels are top-aligned and offset so their baselines match (Instrument Sans ascender = font size). -->
					<usecontrolcoords>true</usecontrolcoords>
					<control type="label">
						<width>auto</width>
						<height>26</height>
						<aligny>top</aligny>
						<font>Bald_RowLabel</font>
						<textcolor>bald_ink</textcolor>
						<label>$PARAM[label]</label>
					</control>
					<control type="group">
						<width>30</width>
						<animation type="Conditional" condition="$EXP[Bald_Idle]">
							<effect type="fade" start="100" end="0" time="600" tween="sine" easing="inout" />
						</animation>
						<control type="image">
							<top>10</top>
							<width>6</width>
							<height>6</height>
							<texture colordiffuse="bald_ink28">bald/dot.png</texture>
							<visible>!String.IsEqual($PARAM[index],1)</visible>
						</control>
						<control type="image">
							<top>10</top>
							<width>6</width>
							<height>6</height>
							<texture colordiffuse="bald_ink95">bald/dot.png</texture>
							<visible>String.IsEqual($PARAM[index],1)</visible>
						</control>
						<control type="image">
							<left>12</left>
							<top>10</top>
							<width>6</width>
							<height>6</height>
							<texture colordiffuse="bald_ink28">bald/dot.png</texture>
							<visible>!String.IsEqual($PARAM[index],2)</visible>
						</control>
						<control type="image">
							<left>12</left>
							<top>10</top>
							<width>6</width>
							<height>6</height>
							<texture colordiffuse="bald_ink95">bald/dot.png</texture>
							<visible>String.IsEqual($PARAM[index],2)</visible>
						</control>
						<control type="image">
							<left>24</left>
							<top>10</top>
							<width>6</width>
							<height>6</height>
							<texture colordiffuse="bald_ink28">bald/dot.png</texture>
							<visible>!String.IsEqual($PARAM[index],3)</visible>
						</control>
						<control type="image">
							<left>24</left>
							<top>10</top>
							<width>6</width>
							<height>6</height>
							<texture colordiffuse="bald_ink95">bald/dot.png</texture>
							<visible>String.IsEqual($PARAM[index],3)</visible>
						</control>
					</control>
					<control type="label">
						<top>3</top>
						<width>auto</width>
						<height>26</height>
						<aligny>top</aligny>
						<font>Bald_Hint</font>
						<textcolor>bald_ink55</textcolor>
						<label>$INFO[Container($PARAM[id]).CurrentItem]$INFO[Container($PARAM[id]).NumItems, of ,]</label>
						<animation type="Conditional" condition="$EXP[Bald_Idle]">
							<effect type="fade" start="100" end="0" time="600" tween="sine" easing="inout" />
						</animation>
					</control>
				</control>
			</control>
			<control type="fixedlist" id="$PARAM[id]">
				<left>86</left>
				<top>884</top>
				<width>1258</width>
				<height>119</height>
				<!-- Kodi does not process hidden lists, so a row also counts as visible until its items load;
				     that lets it load (and the row-start timer fix its selection) before it is first shown. Not while a
				     dialog is up: <visible> has no window context then, and NumItems would read empty for every row. -->
				<visible allowhiddenfocus="true">[String.IsEqual(Window(home).Property(Bald.Row),$PARAM[id]) + !$EXP[Bald_PreviewOther]] | [!Integer.IsGreater(Container($PARAM[id]).NumItems,0) + !$EXP[Bald_DialogOver]]</visible>
				<include>Bald_AnimRowSwap</include>
				<include>Bald_AnimInfoChrome</include>
				<animation type="Conditional" condition="$EXP[Bald_OverlayOpen]">
					<effect type="fade" start="100" end="60" time="360" tween="sine" easing="inout" />
				</animation>
				<animation type="Conditional" condition="$EXP[Bald_Idle]">
					<effect type="fade" start="100" end="40" time="900" tween="sine" easing="inout" />
				</animation>
				<include content="Bald_AnimNudge"><param name="prop">Bald.NudgeL</param><param name="x">14</param><param name="back">-14</param></include>
				<include content="Bald_AnimNudge"><param name="prop">Bald.NudgeR</param><param name="x">-14</param><param name="back">14</param></include>
				<orientation>horizontal</orientation>
				<focusposition>2</focusposition>
				<movement>2</movement>
				<scrolltime tween="cubic" easing="out">440</scrolltime>
				<onfocus>SetProperty(Bald.Row,$PARAM[id],home)</onfocus>
				<onfocus>SetProperty(TMDbHelper.WidgetContainer,$PARAM[id],home)</onfocus>
				<onup>$PARAM[up]</onup>
				<ondown>$PARAM[down]</ondown>
				<onleft>SetProperty(Bald.NudgeL,$VAR[Bald_NudgeLNext],home)</onleft>
				<onright>SetProperty(Bald.NudgeR,$VAR[Bald_NudgeRNext],home)</onright>
				<onback>SetFocus(9000,0,absolute)</onback>
				<onclick>Action(Info)</onclick>
				<itemlayout width="192" height="119">
					<include content="Bald_LandscapeTile" />
				</itemlayout>
				<focusedlayout width="192" height="119">
					<control type="group">
						<!-- Tile focus pop: 280 pop to 1.05. While the menu is open the tile settles back and dims. -->
						<animation type="Focus">
							<effect type="zoom" start="100" end="105" center="98,59" time="280" tween="back" easing="out" />
							<effect type="fade" start="55" end="100" time="300" tween="sine" easing="inout" />
						</animation>
						<animation type="Conditional" condition="$EXP[Bald_OverlayOpen]">
							<effect type="zoom" start="100" end="95.2" center="98,59" time="300" tween="cubic" easing="out" />
							<effect type="fade" start="100" end="66" time="300" tween="sine" easing="inout" />
						</animation>
						<include content="Bald_LandscapeTile">
							<param name="diffuse">FFFFFFFF</param>
							<param name="ring">!$EXP[Bald_OverlayOpen]</param>
						</include>
					</control>
				</focusedlayout>
				<nested />
			</control>
		</definition>
	</include>

	<!-- ============ Menu ============ -->
	<!-- Accent dot beside the current screen (always Home until other screens have rows). -->
	<include name="Bald_MenuItem">
		<control type="image">
			<top>23</top>
			<width>10</width>
			<height>10</height>
			<texture colordiffuse="bald_accent">bald/dot.png</texture>
			<visible>String.IsEqual(ListItem.Property(id),home)</visible>
		</control>
	</include>
</includes>
