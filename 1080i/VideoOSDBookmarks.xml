<?xml version="1.0" encoding="utf-8"?>
<!-- Bald bookmarks sheet (docs/SPEC.md 5, "Playback (proposed)"): over the bottom scrim, the pill actions at the
     safe margin and a row of rounded 16:9 thumbnails, dimmed until focused, with the tile focus ring. Started from
     Kodi 22 Estuary's VideoOSDBookmarks.xml (GPL-2.0-or-later, see LICENSE-Estuary.txt).
     Kodi (CGUIDialogVideoBookmarks) binds 2 (create bookmark), 3 (clear bookmarks), 4 (set episode bookmark, enabled
     by Kodi) and 11 (the bookmark list); 9001 is the button row. -->
<window>
	<defaultcontrol always="true">2</defaultcontrol>
	<include>Bald_PlaybackAnimWindow</include>
	<depth>DepthDialog</depth>
	<controls>
		<control type="button">
			<description>background close area</description>
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>560</height>
			<texturefocus />
			<texturenofocus />
			<onclick>Action(close)</onclick>
		</control>
		<!-- The OSD and seek bar stay open underneath: dim them, then the bottom scrim. -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="bald_field60">bald/white.png</texture>
		</control>
		<include>Bald_PlaybackScrim</include>
		<control type="label">
			<left>Bald_SafeLeft</left>
			<top>560</top>
			<width>1100</width>
			<height>48</height>
			<aligny>center</aligny>
			<font>Bald_CaptionTitle</font>
			<textcolor>bald_ink</textcolor>
			<label>$LOCALIZE[298]</label>
		</control>
		<control type="grouplist" id="9001">
			<left>Bald_SafeLeft</left>
			<top>632</top>
			<width>1728</width>
			<height>72</height>
			<orientation>horizontal</orientation>
			<itemgap>8</itemgap>
			<onup>11</onup>
			<ondown>11</ondown>
			<include content="DefaultDialogButton">
				<param name="id" value="2" />
				<param name="label" value="$LOCALIZE[294]" />
				<param name="width" value="320" />
			</include>
			<include content="DefaultDialogButton">
				<param name="id" value="3" />
				<param name="label" value="$LOCALIZE[296]" />
				<param name="width" value="320" />
			</include>
			<include content="DefaultDialogButton">
				<param name="id" value="4" />
				<param name="label" value="$LOCALIZE[20406]" />
				<param name="width" value="320" />
				<param name="visible" value="Control.IsEnabled(4)" />
			</include>
		</control>
		<control type="label">
			<left>Bald_SafeLeft</left>
			<top>760</top>
			<width>1728</width>
			<height>40</height>
			<aligny>center</aligny>
			<font>Bald_InfoTagline</font>
			<textcolor>bald_ink60</textcolor>
			<label>$LOCALIZE[31155]</label>
			<visible>Integer.IsEqual(Container(11).NumItems,0)</visible>
		</control>
		<control type="panel" id="11">
			<left>84</left>
			<top>724</top>
			<width>1752</width>
			<height>250</height>
			<onup>9001</onup>
			<ondown>9001</ondown>
			<preloaditems>2</preloaditems>
			<scrolltime tween="cubic" easing="out">440</scrolltime>
			<orientation>horizontal</orientation>
			<itemlayout width="312" height="250">
				<control type="image">
					<left>12</left>
					<top>12</top>
					<width>288</width>
					<height>162</height>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<texture diffuse="bald/tile.png" colordiffuse="bald_poster_dim" fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
				</control>
				<control type="label">
					<left>12</left>
					<top>186</top>
					<width>288</width>
					<height>26</height>
					<aligny>center</aligny>
					<font>Bald_CaptionMeta</font>
					<textcolor>bald_ink70</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>12</left>
					<top>214</top>
					<width>288</width>
					<height>24</height>
					<aligny>center</aligny>
					<font>Bald_Hint</font>
					<textcolor>bald_ink45</textcolor>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</itemlayout>
			<focusedlayout width="312" height="250">
				<control type="image">
					<left>12</left>
					<top>12</top>
					<width>288</width>
					<height>162</height>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<texture diffuse="bald/tile.png" fallback="DefaultVideo.png">$INFO[ListItem.Art(thumb)]</texture>
				</control>
				<control type="image">
					<left>6</left>
					<top>6</top>
					<width>300</width>
					<height>174</height>
					<texture border="8" colordiffuse="bald_ink">bald/focus_ring.png</texture>
					<visible>Control.HasFocus(11)</visible>
				</control>
				<control type="label">
					<left>12</left>
					<top>186</top>
					<width>288</width>
					<height>26</height>
					<aligny>center</aligny>
					<font>Bald_CaptionMeta</font>
					<textcolor>bald_ink</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
				<control type="label">
					<left>12</left>
					<top>214</top>
					<width>288</width>
					<height>24</height>
					<aligny>center</aligny>
					<font>Bald_Hint</font>
					<textcolor>bald_ink60</textcolor>
					<label>$INFO[ListItem.Label2]</label>
				</control>
			</focusedlayout>
		</control>
	</controls>
</window>
