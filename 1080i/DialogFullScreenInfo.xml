<?xml version="1.0" encoding="UTF-8"?>
<!-- Full-screen info (Info while a video plays). It draws nothing itself: the info overlay is window 1127
     (Custom_1127_OSDInfoOverlay.xml), which shows while this window is active, over the seek layer's gradient and clock
     (DialogSeekBar.xml). The invisible full-screen button 999 keeps Estuary's actions: Left and Right step, Up and Down
     skip chapters or big steps, Select opens the OSD. Started from Kodi 22 Estuary's DialogFullScreenInfo.xml
     (GPL-2.0-or-later, see LICENSE-Estuary.txt), unchanged apart from this note. -->
<window>
	<defaultcontrol always="true">999</defaultcontrol>
	<controls>
		<control type="button" id="999">
			<left>0</left>
			<top>0</top>
			<width>100%</width>
			<height>100%</height>
			<texturefocus />
			<texturenofocus />
			<onright>StepForward</onright>
			<onleft>StepBack</onleft>
			<onup>ChapterOrBigStepForward</onup>
			<ondown>ChapterOrBigStepBack</ondown>
			<onclick>OSD</onclick>
		</control>
	</controls>
</window>
