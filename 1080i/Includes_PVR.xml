<?xml version="1.0" encoding="utf-8"?>
<includes>
	<!-- Estuary PVR parts still used by Estuary windows (PVRProgress: DialogSeekBar, TopBarOverlay; PVRChannelNumberInput: DialogSeekBar, MyPVRGuide) and the Bald TV guide (Bald_EpgGrid, Bald_PVRGuideTools). The other Live TV windows use Includes_Bald_PVR.xml. -->
	<expression name="listitem_has_episode_info">!String.IsEmpty(ListItem.Episode) | !String.IsEmpty(ListItem.EpisodeName) | !String.IsEmpty(ListItem.Season)</expression>
	<include name="PVRProgress">
		<control type="group">
			<animation effect="fade" time="400">VisibleChange</animation>
			<visible>!Player.ChannelPreviewActive</visible>
			<control type="group">
				<visible>Player.SeekEnabled | VideoPlayer.HasEPG</visible>
				<visible>Player.ShowInfo | Window.IsActive(fullscreeninfo) | Player.ShowTime | Window.IsActive(videoosd) | Window.IsActive(musicosd) | Window.IsActive(playerprocessinfo) | !String.IsEmpty(Player.SeekNumeric) | Window.IsActive(pvrosdchannels) | Window.IsActive(pvrchannelguide) | !String.IsEmpty(PVR.ChannelNumberInput)</visible>
				<control type="label">
					<top>22</top>
					<right>20</right>
					<width>400</width>
					<height>50</height>
					<align>right</align>
					<aligny>center</aligny>
					<font>font13</font>
					<label>$INFO[PVR.TimeshiftProgressEndTime]</label>
				</control>
				<control type="label">
					<top>22</top>
					<left>20</left>
					<width>400</width>
					<height>50</height>
					<align>left</align>
					<aligny>center</aligny>
					<font>font13</font>
					<label>$INFO[PVR.TimeshiftProgressStartTime]</label>
				</control>
				<control type="label">
					<top>22</top>
					<left>20</left>
					<right>20</right>
					<height>50</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>font13</font>
					<label>[B]$LOCALIZE[31026][/B] $INFO[PVR.TimeshiftCur] (-$INFO[PVR.TimeshiftOffset])</label>
					<visible>PVR.IsTimeShift</visible>
				</control>
			</control>
			<control type="group">
				<visible>VideoPlayer.HasEPG</visible>
				<control type="progress">
					<left>0</left>
					<top>$PARAM[epg_bar_top]</top>
					<width>100%</width>
					<height>$PARAM[epg_bar_height]</height>
					<info2>PVR.TimeshiftProgressEpgStart</info2>
					<info>PVR.TimeshiftProgressPlayPos</info>
					<texturebg border="3" colordiffuse="60FFFFFF">colors/white50.png</texturebg>
					<midtexture colordiffuse="button_focus">colors/white.png</midtexture>
				</control>
				<control type="progress">
					<left>0</left>
					<top>$PARAM[epg_bar_top]</top>
					<width>100%</width>
					<height>$PARAM[epg_bar_height]</height>
					<info2>PVR.TimeshiftProgressPlayPos</info2>
					<info>PVR.TimeshiftProgressEpgEnd</info>
					<texturebg border="3" colordiffuse="00FFFFFF">colors/white50.png</texturebg>
					<midtexture>colors/white50.png</midtexture>
				</control>
			</control>
			<control type="progress">
				<left>0</left>
				<top>$PARAM[ts_bar_top]</top>
				<width>100%</width>
				<height>$PARAM[ts_bar_height]</height>
				<info2>PVR.TimeshiftProgressBufferStart</info2>
				<info>PVR.TimeshiftProgressBufferEnd</info>
				<texturebg border="3" colordiffuse="60FFFFFF">colors/white50.png</texturebg>
				<midtexture>colors/white70.png</midtexture>
				<visible>Player.SeekEnabled</visible>
			</control>
		</control>
		<control type="group">
			<animation effect="fade" time="400">VisibleChange</animation>
			<visible>Player.ChannelPreviewActive</visible>
			<control type="label">
				<top>22</top>
				<right>20</right>
				<width>400</width>
				<height>50</height>
				<align>right</align>
				<aligny>center</aligny>
				<font>font13</font>
				<label>$INFO[VideoPlayer.EndTime]</label>
			</control>
			<control type="label">
				<top>22</top>
				<left>20</left>
				<width>400</width>
				<height>50</height>
				<align>left</align>
				<aligny>center</aligny>
				<font>font13</font>
				<label>$INFO[VideoPlayer.StartTime]</label>
			</control>
			<control type="progress">
				<left>0</left>
				<top>70</top>
				<width>100%</width>
				<height>16</height>
				<info>PVR.EpgEventProgress</info>
				<texturebg border="3" colordiffuse="60FFFFFF">colors/white50.png</texturebg>
				<midtexture colordiffuse="button_focus">colors/white.png</midtexture>
			</control>
		</control>
	</include>
	<include name="PVRChannelNumberInput">
		<control type="label">
			<left>0</left>
			<top>0</top>
			<width>100%</width>
			<height>100%</height>
			<label>$INFO[PVR.ChannelNumberInput]</label>
			<shadowcolor>black</shadowcolor>
			<align>center</align>
			<font>WeatherTemp</font>
			<aligny>center</aligny>
			<visible>!String.IsEmpty(PVR.ChannelNumberInput)</visible>
		</control>
	</include>
	<include name="Bald_EpgGrid">
		<definition>
			<control type="epggrid" id="$PARAM[control_id]">
				<!-- 40 px ruler + exactly seven 68 px channel rows. Partial rows do not
				     reliably publish their selected programme to Kodi's ListItem labels. -->
				<left>96</left><top>420</top><right>96</right><bottom>144</bottom>
				<orientation>vertical</orientation><pagecontrol>60</pagecontrol>
				<scrolltime tween="cubic" easing="out">200</scrolltime><timeblocks>180</timeblocks><minspertimeblock>1</minspertimeblock><rulerunit>6</rulerunit>
				<onleft>9000</onleft><onright>50</onright><onup>50</onup><ondown>50</ondown><onback>9000</onback><viewtype label="19298">list</viewtype>
				<progresstexture border="0,0,1,0" colordiffuse="809FB0C6">bald/epg_now.png</progresstexture>
				<!-- 180 one-minute blocks across a 1428 px timeline; rulerunit 6 is 30 minutes,
				     therefore each ruler cell is 238 px. -->
				<rulerlayout height="40" width="1428"><control type="label"><width>238</width><height>40</height><font>Bald_Hint</font><label>$INFO[ListItem.Label]</label><textoffsetx>12</textoffsetx><textcolor>bald_ink60</textcolor></control></rulerlayout>
				<channellayout height="68" width="300"><control type="label"><width>54</width><height>68</height><align>right</align><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink45</textcolor><label>$INFO[ListItem.ChannelNumberLabel]</label></control><control type="image"><left>72</left><top>10</top><width>72</width><height>48</height><aspectratio>keep</aspectratio><texture>$INFO[ListItem.ChannelLogo]</texture></control><control type="label" id="1"><left>158</left><width>134</width><height>68</height><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink70</textcolor><label>$INFO[ListItem.ChannelName]</label></control></channellayout>
				<focusedchannellayout height="68" width="300"><control type="image"><top>30</top><width>8</width><height>8</height><texture colordiffuse="bald_accent">bald/dot.png</texture></control><control type="label"><width>54</width><height>68</height><align>right</align><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink</textcolor><label>$INFO[ListItem.ChannelNumberLabel]</label></control><control type="image"><left>72</left><top>10</top><width>72</width><height>48</height><aspectratio>keep</aspectratio><texture>$INFO[ListItem.ChannelLogo]</texture></control><control type="label" id="1"><left>158</left><width>134</width><height>68</height><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink</textcolor><scroll>true</scroll><label>$INFO[ListItem.ChannelName]</label></control></focusedchannellayout>
				<itemlayout height="68" width="60"><control type="label" id="1"><left>12</left><right>12</right><height>68</height><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink70</textcolor><label>$INFO[ListItem.Label]</label></control><control type="image"><left>10</left><bottom>8</bottom><width>8</width><height>8</height><texture colordiffuse="bald_accent">bald/dot.png</texture><visible>ListItem.HasTimer | ListItem.IsRecording</visible></control></itemlayout>
				<focusedlayout height="68" width="60"><control type="image"><left>2</left><top>2</top><right>2</right><bottom>2</bottom><texture colordiffuse="bald_ink10">bald/white.png</texture><visible>Control.HasFocus($PARAM[control_id])</visible></control><control type="image"><left>2</left><top>8</top><width>4</width><height>52</height><texture colordiffuse="bald_accent">bald/white.png</texture><visible>Control.HasFocus($PARAM[control_id])</visible></control><control type="image" id="2"><left>2</left><top>2</top><right>2</right><bottom>2</bottom><texture colordiffuse="bald_ink28">bald/white.png</texture><visible>!Control.HasFocus($PARAM[control_id])</visible></control><control type="label" id="1"><left>12</left><right>12</right><height>68</height><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink</textcolor><scroll>true</scroll><label>$INFO[ListItem.Label]</label></control></focusedlayout>
			</control>
			<control type="scrollbar" id="60"><right>72</right><top>460</top><width>8</width><bottom>144</bottom><orientation>vertical</orientation><onleft>50</onleft><onright>50</onright><ondown>50</ondown><onup>50</onup><texturesliderbackground colordiffuse="bald_ink10">bald/white.png</texturesliderbackground><textureslidernib colordiffuse="bald_accent">bald/white.png</textureslidernib><textureslidernibfocus colordiffuse="bald_accent">bald/white.png</textureslidernibfocus></control>
		</definition>
	</include>
	<include name="Bald_PVRGuideToolButton">
		<param name="id" />
		<param name="label" />
		<param name="label2" />
		<param name="action" />
		<param name="restore_focus">true</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>420</width><height>56</height><font>Bald_RowLabel</font><font2>Bald_Hint</font2>
				<textcolor>bald_ink34</textcolor><focusedcolor>bald_ink</focusedcolor><textcolor2>bald_ink60</textcolor2><focusedcolor2>bald_ink70</focusedcolor2>
				<aligny>center</aligny><align2>right</align2><textoffsetx>20</textoffsetx><textoffsetx2>400</textoffsetx2>
				<texturefocus border="8" colordiffuse="bald_ink10">bald/white.png</texturefocus><texturenofocus />
				<label>$PARAM[label]</label><label2>$PARAM[label2]</label2>
				<onleft>9000</onleft><onright>50</onright><onback>50</onback>
				<onclick>$PARAM[action]</onclick><onclick condition="$PARAM[restore_focus]">SetFocus(50)</onclick>
			</control>
		</definition>
	</include>
	<include name="Bald_PVRGuideTools">
		<definition>
			<!-- The drawer rests just beyond the right edge. Focusing menucontrol 9000 slides it in,
			     matching Home's 480 px menu footprint and keeping the grid visible for context. -->
			<control type="group">
				<left>1920</left><width>480</width><height>1080</height>
				<animation type="Conditional" condition="$EXP[sidebar_visible]" reversible="true"><effect type="slide" start="0,0" end="-480,0" time="480" tween="cubic" easing="out" /><effect type="fade" start="0" end="100" time="380" tween="sine" easing="inout" /></animation>
				<control type="image"><width>480</width><height>1080</height><texture colordiffuse="F20B0C10">bald/white.png</texture></control>
				<control type="label"><left>56</left><top>104</top><width>368</width><height>34</height><font>Bald_RowLabel</font><textcolor>bald_ink60</textcolor><label>$LOCALIZE[31870]</label></control>
				<control type="label"><left>56</left><top>150</top><width>368</width><height>52</height><font>Bald_CaptionTitle</font><textcolor>bald_ink</textcolor><label>$INFO[Control.GetLabel(30)]</label><scroll>true</scroll></control>
				<control type="grouplist" id="9000"><left>30</left><top>264</top><width>420</width><height>392</height><orientation>vertical</orientation><itemgap>6</itemgap><onleft>9000</onleft><onright>50</onright><onback>50</onback>
					<include content="Bald_PVRGuideToolButton"><param name="id">9009</param><param name="label">$LOCALIZE[31872]</param><param name="action">SetFocus(50)</param></include>
					<include content="Bald_PVRGuideToolButton"><param name="id">9010</param><param name="label">$LOCALIZE[31873]</param><param name="action">PVR.EpgGridControl(CurrentProgramme)</param></include>
					<include content="Bald_PVRGuideToolButton"><param name="id">9011</param><param name="label">$LOCALIZE[31874]</param><param name="label2">$INFO[Control.GetLabel(30)]</param><param name="action">PVR.EpgGridControl(SelectGroup)</param></include>
					<include content="Bald_PVRGuideToolButton"><param name="id">9014</param><param name="label">$LOCALIZE[31875]</param><param name="action">PVR.EpgGridControl(SelectDate)</param></include>
					<include content="Bald_PVRGuideToolButton"><param name="id">9015</param><param name="label">$LOCALIZE[19142]</param><param name="action">ActivateWindow(TVSearch)</param></include>
					<include content="Bald_PVRGuideToolButton"><param name="id">9016</param><param name="label">$LOCALIZE[31876]</param><param name="action">PreviousMenu</param><param name="restore_focus">false</param></include>
				</control>
				<control type="label"><left>56</left><top>714</top><width>368</width><height>120</height><wrapmultiline>true</wrapmultiline><font>Bald_MenuNote</font><textcolor>bald_ink60</textcolor><label>$LOCALIZE[31871]</label></control>
			</control>
			<control type="button" id="28"><include>HiddenObject</include></control>
		</definition>
	</include>
</includes>
