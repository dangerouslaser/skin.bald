<?xml version="1.0" encoding="utf-8"?>
<includes>
	<!-- Started from Kodi 22 Estuary's Includes_PVR.xml (GPL-2.0-or-later, see LICENSE-Estuary.txt). Now the Bald TV
	     guide's grid and tools drawer (Bald_EpgGrid, Bald_PVRGuideTools). Estuary's PVRProgress and
	     PVRChannelNumberInput were removed once no window called them: the guide and the Live TV windows use
	     Bald_PVRChannelNumberInput, and the playback windows draw their own. The other Live TV windows use
	     Includes_Bald_PVR.xml. -->
	<expression name="listitem_has_episode_info">!String.IsEmpty(ListItem.Episode) | !String.IsEmpty(ListItem.EpisodeName) | !String.IsEmpty(ListItem.Season)</expression>
	<!-- A programme's look in the guide: what is on now on a 10% ink cell in full ink, what is still to come on a 6% one
	     at 80%, what has ended with no cell at 45%; title over start time. -->
	<expression name="Bald_EpgNow">[Integer.IsGreater(ListItem.Progress,0) + Integer.IsLess(ListItem.Progress,100)]</expression>
	<expression name="Bald_EpgPast">[Integer.IsGreaterOrEqual(ListItem.Progress,100)]</expression>
	<variable name="Bald_EpgTitle">
		<value condition="$EXP[Bald_EpgNow]">$INFO[ListItem.Label]</value>
		<value condition="$EXP[Bald_EpgPast]">[COLOR bald_ink45]$INFO[ListItem.Label][/COLOR]</value>
		<value>[COLOR bald_ink80]$INFO[ListItem.Label][/COLOR]</value>
	</variable>
	<!-- A stretch with no programme (a channel without guide data) shows nothing. -->
	<variable name="Bald_EpgTime">
		<value condition="String.IsEmpty(ListItem.Label)"></value>
		<value condition="$EXP[Bald_EpgPast]">[COLOR bald_ink34]$INFO[ListItem.StartTime][/COLOR]</value>
		<value>$INFO[ListItem.StartTime]</value>
	</variable>
	<!-- The ruler: times, and first the day, which Kodi writes as the long regional date ("Wednesday, September 30, 2026")
	     and the 178 px corner cut off. That item stays blank; the corner shows the focused programme's short date instead
	     (Bald_EpgGrid). -->
	<variable name="Bald_EpgRulerLabel">
		<value condition="!ListItem.Property(DateLabel)">$INFO[ListItem.Label]</value>
	</variable>
	<include name="Bald_EpgGrid">
		<definition>
			<control type="epggrid" id="$PARAM[control_id]">
				<!-- 40 px ruler + exactly seven 72 px channel rows (y 380 to 924). Partial rows do not reliably publish
				     their selected programme to Kodi's ListItem labels. -->
				<left>96</left><top>380</top><right>96</right><bottom>156</bottom>
				<orientation>vertical</orientation><pagecontrol>60</pagecontrol>
				<!-- Three hours in 5 minute blocks (36 a row): Kodi walks every block of every row as the grid moves, and
				     the old 180 one-minute blocks made it lag on CoreELEC boxes. rulerunit 6 is 30 minutes. -->
				<scrolltime tween="cubic" easing="out">200</scrolltime><timeblocks>36</timeblocks><minspertimeblock>5</minspertimeblock><rulerunit>6</rulerunit>
				<onleft>9000</onleft><onright>50</onright><onup>50</onup><ondown>50</ondown><onback>9000</onback><viewtype label="19298">list</viewtype>
				<!-- The now line: only the texture's 2 px right edge shows (tools/textures.py, guide_textures). -->
				<progresstexture border="0,0,2,0" colordiffuse="bald_accent">bald/epg_nowline.png</progresstexture>
				<!-- The timeline is 1538 px (1728 less the 190 px channel column): 256 px a half hour. The first ruler item
				     is the day, over the channel column, so the labels stop at 178 px to stay inside it. -->
				<rulerlayout height="40" width="1538">
					<!-- 2 px: a 1 px tick is under a pixel wide once Kodi scales the GUI (a window narrower than 1920), and it
					     rounded to nothing at some of the positions the ruler scrolls through. -->
					<control type="image"><left>0</left><top>12</top><width>2</width><height>16</height><texture colordiffuse="bald_ink20">bald/white.png</texture></control>
					<control type="label"><width>178</width><height>40</height><font>Bald_Hint</font><label>$VAR[Bald_EpgRulerLabel]</label><textoffsetx>12</textoffsetx><textcolor>bald_ink60</textcolor></control>
				</rulerlayout>
				<!-- Channel: number and logo; the name only for a channel without a logo (providers' names are long and
				     alike, "MA | Boston ..."). No scrolling text anywhere in the grid: a scrolling label redraws every frame. -->
				<channellayout height="72" width="190">
					<control type="label"><width>56</width><height>72</height><align>right</align><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink45</textcolor><label>$INFO[ListItem.ChannelNumberLabel]</label></control>
					<control type="image"><left>72</left><top>12</top><width>104</width><height>48</height><aspectratio>keep</aspectratio><texture>$INFO[ListItem.ChannelLogo]</texture></control>
					<control type="label" id="1"><left>72</left><width>112</width><height>72</height><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink70</textcolor><label>$INFO[ListItem.ChannelName]</label><visible>String.IsEmpty(ListItem.ChannelLogo)</visible></control>
				</channellayout>
				<focusedchannellayout height="72" width="190">
					<control type="image"><top>32</top><width>8</width><height>8</height><texture colordiffuse="bald_accent">bald/dot.png</texture></control>
					<control type="label"><width>56</width><height>72</height><align>right</align><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink</textcolor><label>$INFO[ListItem.ChannelNumberLabel]</label></control>
					<control type="image"><left>72</left><top>12</top><width>104</width><height>48</height><aspectratio>keep</aspectratio><texture>$INFO[ListItem.ChannelLogo]</texture></control>
					<control type="label" id="1"><left>72</left><width>112</width><height>72</height><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink</textcolor><label>$INFO[ListItem.ChannelName]</label><visible>String.IsEmpty(ListItem.ChannelLogo)</visible></control>
				</focusedchannellayout>
				<!-- Programme: a rounded cell with 3 px either side and 4 px above and below, so neighbours never run
				     together; the title over the start time; the record dot at the top left for a timer or recording.
				     Kodi widens only a layout's controls with an id from 1 to 14 to the programme's width (and hides a
				     label with id 1 once it is under 10 px), so the cells are id 2 and the labels id 1. -->
				<itemlayout height="72" width="60">
					<control type="image" id="2"><left>3</left><top>4</top><right>3</right><bottom>4</bottom><texture border="8" colordiffuse="bald_ink10">bald/epg_cell.png</texture><visible>$EXP[Bald_EpgNow] + !String.IsEmpty(ListItem.Label)</visible></control>
					<control type="image" id="2"><left>3</left><top>4</top><right>3</right><bottom>4</bottom><texture border="8" colordiffuse="bald_ink06">bald/epg_cell.png</texture><visible>!$EXP[Bald_EpgNow] + !$EXP[Bald_EpgPast] + !String.IsEmpty(ListItem.Label)</visible></control>
					<control type="label" id="1"><left>16</left><right>14</right><top>11</top><height>28</height><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink</textcolor><label>$VAR[Bald_EpgTitle]</label></control>
					<control type="label" id="1"><left>16</left><right>14</right><top>38</top><height>22</height><aligny>center</aligny><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$VAR[Bald_EpgTime]</label></control>
					<control type="image"><left>10</left><top>10</top><width>8</width><height>8</height><texture colordiffuse="bald_record">bald/dot.png</texture><visible>ListItem.HasTimer | ListItem.IsRecording</visible></control>
				</itemlayout>
				<!-- Focus: the cell filled with ink and its text in field, as a focused pill; 28% ink while the tools
				     drawer has focus. -->
				<focusedlayout height="72" width="60">
					<control type="image" id="2"><left>3</left><top>4</top><right>3</right><bottom>4</bottom><texture border="8" colordiffuse="bald_ink">bald/epg_cell.png</texture><visible>Control.HasFocus($PARAM[control_id])</visible></control>
					<control type="image" id="2"><left>3</left><top>4</top><right>3</right><bottom>4</bottom><texture border="8" colordiffuse="bald_ink28">bald/epg_cell.png</texture><visible>!Control.HasFocus($PARAM[control_id])</visible></control>
					<control type="label" id="1"><left>16</left><right>14</right><top>11</top><height>28</height><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_field</textcolor><label>$INFO[ListItem.Label]</label><visible>Control.HasFocus($PARAM[control_id])</visible></control>
					<control type="label" id="1"><left>16</left><right>14</right><top>11</top><height>28</height><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink</textcolor><label>$INFO[ListItem.Label]</label><visible>!Control.HasFocus($PARAM[control_id])</visible></control>
					<control type="label" id="1"><left>16</left><right>14</right><top>38</top><height>22</height><aligny>center</aligny><font>Bald_Hint</font><textcolor>bald_field85</textcolor><label>$INFO[ListItem.StartTime]$INFO[ListItem.EndTime, – ]</label><visible>Control.HasFocus($PARAM[control_id])</visible></control>
					<control type="label" id="1"><left>16</left><right>14</right><top>38</top><height>22</height><aligny>center</aligny><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$INFO[ListItem.StartTime]$INFO[ListItem.EndTime, – ]</label><visible>!Control.HasFocus($PARAM[control_id])</visible></control>
					<control type="image"><left>10</left><top>10</top><width>8</width><height>8</height><texture colordiffuse="bald_record">bald/dot.png</texture><visible>ListItem.HasTimer | ListItem.IsRecording</visible></control>
				</focusedlayout>
			</control>
			<!-- The day, over the channel column in the ruler's corner: the focused programme's short date ("9/30/2026"),
			     from scripts/guidedate.py (Kodi's date labels are the long form, or the short one with the time). -->
			<control type="label"><left>96</left><top>380</top><width>178</width><height>40</height><font>Bald_Hint</font><textoffsetx>12</textoffsetx><textcolor>bald_ink60</textcolor><label>$INFO[Window(home).Property(Bald.GuideDate)]</label></control>
			<control type="scrollbar" id="60"><right>72</right><top>420</top><width>8</width><bottom>156</bottom><orientation>vertical</orientation><onleft>50</onleft><onright>50</onright><ondown>50</ondown><onup>50</onup><texturesliderbackground colordiffuse="bald_ink10">bald/white.png</texturesliderbackground><texturesliderbar colordiffuse="bald_ink34">bald/white.png</texturesliderbar><texturesliderbarfocus colordiffuse="bald_ink">bald/white.png</texturesliderbarfocus><textureslidernib colordiffuse="bald_accent">bald/white.png</textureslidernib><textureslidernibfocus colordiffuse="bald_accent">bald/white.png</textureslidernibfocus></control>
		</definition>
	</include>
	<include name="Bald_PVRGuideToolButton">
		<param name="id" />
		<param name="label" />
		<param name="label2" />
		<param name="action">noop</param>
		<param name="restore_focus">true</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>420</width><height>56</height><font>Bald_RowLabel</font><font2>Bald_Hint</font2>
				<textcolor>bald_ink34</textcolor><focusedcolor>bald_ink</focusedcolor><textcolor2>bald_ink60</textcolor2><focusedcolor2>bald_ink70</focusedcolor2>
				<aligny>center</aligny><align2>right</align2><textoffsetx>20</textoffsetx><textoffsetx2>400</textoffsetx2>
				<texturefocus border="8" colordiffuse="bald_ink10">bald/white.png</texturefocus><texturenofocus />
				<label>$PARAM[label]</label><label2>$PARAM[label2]</label2>
				<onleft>9000</onleft><onright>50</onright><onback>50</onback>
				<onclick>$PARAM[action]</onclick><onclick condition="$PARAM[restore_focus]">SetFocus(50)</onclick>
				<nested />
			</control>
		</definition>
	</include>
	<!-- A drawer row that opens another Live TV window, TV or radio as the guide is (Kodi sets IsRadio on radio windows). -->
	<include name="Bald_PVRGuideAreaButton">
		<param name="id" />
		<param name="area" />
		<param name="label" />
		<definition>
			<include content="Bald_PVRGuideToolButton"><param name="id">$PARAM[id]</param><param name="label">$PARAM[label]</param><param name="restore_focus">false</param>
				<onclick condition="String.IsEmpty(Window.Property(IsRadio))">ActivateWindow(TV$PARAM[area])</onclick>
				<onclick condition="!String.IsEmpty(Window.Property(IsRadio))">ActivateWindow(Radio$PARAM[area])</onclick>
			</include>
		</definition>
	</include>
	<include name="Bald_PVRGuideTools">
		<definition>
			<!-- The drawer rests just beyond the right edge. Focusing menucontrol 9000 slides it in,
			     matching Home's 480 px menu footprint and keeping the grid visible for context. -->
			<control type="group">
				<left>1920</left><width>480</width><height>1080</height>
				<animation type="Conditional" condition="[$EXP[sidebar_visible]] + $EXP[Bald_FullMotion]" reversible="true"><effect type="slide" start="0,0" end="-480,0" time="480" tween="cubic" easing="out" /><effect type="fade" start="0" end="100" time="380" tween="sine" easing="inout" /></animation>
				<animation type="Conditional" condition="[$EXP[sidebar_visible]] + $EXP[Bald_ReduceMotion]" reversible="true"><effect type="slide" start="0,0" end="-480,0" time="0" tween="cubic" easing="out" /><effect type="fade" start="0" end="100" time="380" tween="sine" easing="inout" /></animation>
				<control type="image"><width>480</width><height>1080</height><texture colordiffuse="F20B0C10">bald/white.png</texture></control>
				<control type="label"><left>56</left><top>104</top><width>368</width><height>34</height><font>Bald_RowLabel</font><textcolor>bald_ink60</textcolor><label>$LOCALIZE[31870]</label></control>
				<control type="label"><left>56</left><top>150</top><width>368</width><height>52</height><font>Bald_CaptionTitle</font><textcolor>bald_ink</textcolor><label>$INFO[Control.GetLabel(30)]</label><scroll>true</scroll></control>
				<control type="grouplist" id="9000"><left>30</left><top>264</top><width>420</width><height>428</height><orientation>vertical</orientation><itemgap>6</itemgap><onleft>9000</onleft><onright>50</onright><onback>50</onback>
					<include content="Bald_PVRGuideToolButton"><param name="id">9009</param><param name="label">$LOCALIZE[31872]</param><param name="action">SetFocus(50)</param></include>
					<include content="Bald_PVRGuideToolButton"><param name="id">9010</param><param name="label">$LOCALIZE[31873]</param><param name="action">PVR.EpgGridControl(CurrentProgramme)</param></include>
					<include content="Bald_PVRGuideToolButton"><param name="id">9011</param><param name="label">$LOCALIZE[31874]</param><param name="label2">$INFO[Control.GetLabel(30)]</param><param name="action">PVR.EpgGridControl(SelectGroup)</param></include>
					<include content="Bald_PVRGuideToolButton"><param name="id">9014</param><param name="label">$LOCALIZE[31875]</param><param name="action">PVR.EpgGridControl(SelectDate)</param></include>
					<!-- The other Live TV windows (the options column's Bald_PVRAreaOptions), TV or radio as the guide is. -->
					<include content="Bald_PVRGuideAreaButton"><param name="id">9017</param><param name="area">Channels</param><param name="label">$LOCALIZE[19019]</param></include>
					<include content="Bald_PVRGuideAreaButton"><param name="id">9018</param><param name="area">Recordings</param><param name="label">$LOCALIZE[19017]</param></include>
					<include content="Bald_PVRGuideAreaButton"><param name="id">9019</param><param name="area">Timers</param><param name="label">$LOCALIZE[19040]</param></include>
					<include content="Bald_PVRGuideAreaButton"><param name="id">9020</param><param name="area">TimerRules</param><param name="label">$LOCALIZE[19138]</param></include>
					<include content="Bald_PVRGuideAreaButton"><param name="id">9015</param><param name="area">Search</param><param name="label">$LOCALIZE[19142]</param></include>
					<include content="Bald_PVRGuideToolButton"><param name="id">9016</param><param name="label">$LOCALIZE[31876]</param><param name="action">PreviousMenu</param><param name="restore_focus">false</param></include>
				</control>
				<control type="label"><left>56</left><top>714</top><width>368</width><height>120</height><wrapmultiline>true</wrapmultiline><font>Bald_MenuNote</font><textcolor>bald_ink60</textcolor><label>$LOCALIZE[31871]</label></control>
			</control>
			<control type="button" id="28"><include>HiddenObject</include></control>
		</definition>
	</include>
</includes>
