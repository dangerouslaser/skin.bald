<?xml version="1.0" encoding="utf-8"?>
<!-- Bald full-screen video window (docs/SPEC.md 5.16, "Other playback windows"). Started from Kodi 22 Estuary's
     VideoFullScreen.xml (GPL-2.0-or-later, see LICENSE-Estuary.txt).
     Kodi (CGUIWindowFullScreen) shows or hides group 0 and writes the three view-mode lines 10, 11 and 12 (zoom,
     pixel ratio and so on after a view-mode change): they sit top left over the top scrim. Group 1 is the
     buffering indicator: a field disc with Estuary's cache-level ring in the accent and the percentage. -->
<window>
	<defaultcontrol></defaultcontrol>
	<controls>
		<control type="group" id="0">
			<include>Bald_PlaybackScrimTop</include>
			<control type="label" id="10">
				<left>Bald_SafeLeft</left>
				<top>96</top>
				<width>1728</width>
				<height>30</height>
				<aligny>center</aligny>
				<label></label>
				<font>Bald_CaptionMeta</font>
				<textcolor>bald_ink</textcolor>
			</control>
			<control type="label" id="11">
				<left>Bald_SafeLeft</left>
				<top>130</top>
				<width>1728</width>
				<height>30</height>
				<aligny>center</aligny>
				<label></label>
				<font>Bald_CaptionMeta</font>
				<textcolor>bald_ink80</textcolor>
			</control>
			<control type="label" id="12">
				<left>Bald_SafeLeft</left>
				<top>164</top>
				<width>1728</width>
				<height>30</height>
				<aligny>center</aligny>
				<label></label>
				<font>Bald_CaptionMeta</font>
				<textcolor>bald_ink80</textcolor>
			</control>
		</control>
		<control type="group" id="1">
			<depth>DepthOSD+</depth>
			<visible>Player.Caching + Integer.IsGreater(Player.CacheLevel,0)</visible>
			<animation type="Visible">
				<effect type="fade" start="0" end="100" delay="300" time="200" tween="sine" easing="inout" />
			</animation>
			<animation type="Hidden">
				<effect type="fade" start="100" end="0" delay="200" time="150" tween="sine" easing="inout" />
			</animation>
			<centerleft>50%</centerleft>
			<width>110</width>
			<centertop>50%</centertop>
			<height>110</height>
			<control type="image" id="1">
				<left>0</left>
				<top>0</top>
				<width>110</width>
				<height>110</height>
				<texture colordiffuse="bald_field60">bald/dot.png</texture>
			</control>
			<control type="image" id="1">
				<left>9</left>
				<top>9</top>
				<width>92</width>
				<height>92</height>
				<texture colordiffuse="bald_ink10">dialogs/extendedprogress/loading-back.png</texture>
			</control>
			<control type="image" id="1">
				<left>9</left>
				<top>9</top>
				<width>92</width>
				<height>92</height>
				<texture colordiffuse="bald_accent">$INFO[Player.CacheLevel,dialogs/volume/progress/p,.png]</texture>
			</control>
			<control type="label" id="1">
				<description>buffering value</description>
				<label>$INFO[Player.CacheLevel]</label>
				<left>0</left>
				<top>0</top>
				<width>110</width>
				<height>110</height>
				<aligny>center</aligny>
				<align>center</align>
				<font>Bald_Section</font>
				<textcolor>bald_ink</textcolor>
			</control>
		</control>
	</controls>
</window>
