<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="Bald_WallPoster">
		<param name="diffuse">bald_ink70</param><param name="focused">false</param>
		<definition>
			<include content="Bald_LibraryPosterItem">
				<param name="width">192</param><param name="height">288</param><param name="ring_width">198</param><param name="ring_height">294</param><param name="center">108,156</param><param name="show_label">false</param><param name="diffuse">$PARAM[diffuse]</param><param name="focused">$PARAM[focused]</param>
			</include>
		</definition>
	</include>
	<include name="Bald_WallHeader">
		<param name="p" />
		<definition>
			<control type="group">
				<visible>Integer.Is$PARAM[p](Container(511).CurrentItem)</visible>
				<include content="Bald_AnimCaptionIn"><param name="c">511</param><param name="delay">180</param></include>
				<control type="label"><left>96</left><top>108</top><width>1100</width><height>52</height><font>Bald_CaptionTitle</font><textcolor>bald_ink</textcolor><label>$INFO[Container(511).ListItem.Title]</label></control>
				<control type="label"><left>96</left><top>168</top><width>1100</width><height>28</height><font>Bald_CaptionMeta</font><textcolor>bald_ink70</textcolor><label>$INFO[Container(511).ListItem.Year]$INFO[Container(511).ListItem.Duration(mins), · , min]$INFO[Container(511).ListItem.Genre, · ,]</label></control>
				<control type="grouplist"><left>1296</left><top>168</top><width>528</width><height>26</height><orientation>horizontal</orientation><align>right</align><itemgap>8</itemgap><include content="Bald_MediaFlagItems"><param name="c">511</param></include></control>
			</control>
		</definition>
	</include>
	<include name="Bald_WallFooter">
		<param name="c" />
		<definition>
			<control type="label"><left>96</left><top>954</top><width>600</width><height>24</height><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$INFO[Container($PARAM[c]).CurrentItem] / $INFO[Container($PARAM[c]).NumItems]</label></control>
			<control type="group"><left>700</left><top>954</top><visible>!$EXP[Bald_LibraryMenuOpen] + !$EXP[Bald_LibraryLettersOpen]</visible><include content="Bald_InfoHintPair"><param name="width">1124</param><param name="first">Right edge for letters</param><param name="second">Info for details</param><param name="third">Menu for options</param><param name="third_visible">true</param></include></control>
			<control type="group"><left>800</left><top>954</top><visible>$EXP[Bald_LibraryLettersOpen]</visible><include content="Bald_InfoHintPair"><param name="width">1024</param><param name="first">Left / Right to jump letters</param><param name="second">Up / Select / Back to browse</param></include></control>
			<control type="group"><left>1296</left><top>954</top><visible>$EXP[Bald_LibraryMenuOpen]</visible><include content="Bald_InfoHintPair"><param name="width">528</param><param name="first">Left / Back to browse</param><param name="second">Select to change</param></include></control>
		</definition>
	</include>
	<include name="View_511_Bald_Wall">
		<control type="group">
			<visible>Control.IsVisible(511)</visible>
			<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field">bald/white.png</texture></control>
			<include>Bald_BackdropImage</include>
			<include content="Bald_WallHeader"><param name="p">Odd</param></include>
			<include content="Bald_WallHeader"><param name="p">Even</param></include>
			<control type="label"><left>1296</left><top>120</top><width>528</width><height>28</height><align>right</align><font>Bald_CaptionMeta</font><textcolor>bald_ink60</textcolor><label>$INFO[Container.SortMethod] · $INFO[Container.SortOrder]</label></control>
			<control type="panel" id="511">
				<left>84</left><top>210</top><width>1728</width><height>624</height><orientation>vertical</orientation>
				<viewtype label="Bald poster wall">icon</viewtype><visible>Container.Content(movies)</visible><preloaditems>2</preloaditems><scrolltime tween="cubic" easing="out">440</scrolltime>
				<onfocus>SetProperty(Bald.LibraryContainer,511,videos)</onfocus><onfocus>SetProperty(TMDbHelper.WidgetContainer,511,videos)</onfocus><onunfocus>ClearProperty(TMDbHelper.WidgetContainer,videos)</onunfocus>
				<onup>9150</onup><onleft>9150</onleft><onright>SetFocus(9160)</onright><onright>RunScript(skin.bald,letters)</onright><ondown>SetFocus(9160)</ondown><ondown>RunScript(skin.bald,letters)</ondown>
				<animation effect="fade" start="100" end="35" time="180" tween="sine" easing="inout" condition="$EXP[Bald_LibraryMenuOpen]">Conditional</animation>
				<itemlayout width="216" height="312"><include>Bald_WallPoster</include></itemlayout>
				<focusedlayout width="216" height="312"><include content="Bald_WallPoster"><param name="diffuse">bald_ink</param><param name="focused">Control.HasFocus(511) | $EXP[Bald_LibraryLettersOpen]</param></include></focusedlayout>
			</control>
			<!-- Opaque screen-space backdrop keeps the right-side menu legible without fading compound masks. -->
			<control type="group"><visible>$EXP[Bald_LibraryMenuOpen]</visible><include content="Bald_BackdropWindow"><param name="x">1164</param><param name="y">210</param><param name="w">696</param><param name="h">640</param></include></control>
			<include content="Bald_WallFooter"><param name="c">511</param></include>
		</control>
	</include>
</includes>
