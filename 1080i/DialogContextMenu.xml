<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald context menu: drawn as the Home menu (docs/SPEC.md 5.1 "Menu (open)"): 1440, 392, width 420, 46 px items,
     6 px gap, unfocused items at 34% and 6 px left, in fade 380 and slide 40 px over 480 after 120, out 160.
     Over Home the caption slides out as for the main menu (Bald_OverlayOpen); elsewhere a dark scrim sits behind it.
     Kodi (CGUIDialogContextMenu) fills grouplist 996 with copies of button 1000, and centres the dialog on the focused
     control using background image 999's size, clamped to the screen. 999 is invisible and taller than the screen by
     the list's maximum height (1080 + 592): Kodi shrinks it by the list's unused height, and it must stay at least
     screen-sized so the clamp always lands the dialog at 0,0 and these coordinates are absolute. -->
<window>
	<defaultcontrol>996</defaultcontrol>
	<coordinates>
		<left>0</left>
		<top>0</top>
	</coordinates>
	<controls>
		<control type="image" id="999">
			<width>1920</width>
			<height>1672</height>
			<texture colordiffuse="00FFFFFF">bald/white.png</texture>
		</control>
		<!-- Scrim when not over Home (library windows still use Estuary's layouts). -->
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="D90B0C10">bald/white.png</texture>
			<visible>!Window.IsVisible(home)</visible>
			<animation effect="fade" start="0" end="100" time="300" tween="sine" easing="inout">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="160" tween="sine" easing="inout">WindowClose</animation>
		</control>
		<!-- Clicking outside the menu closes it (mouse). -->
		<control type="button">
			<width>1920</width>
			<height>1080</height>
			<texturefocus />
			<texturenofocus />
			<onclick>Action(close)</onclick>
		</control>
		<control type="group">
			<animation type="WindowOpen">
				<effect type="fade" start="0" end="100" time="380" delay="120" tween="sine" easing="inout" />
				<effect type="slide" start="40,0" end="0,0" time="480" delay="120" tween="cubic" easing="out" />
			</animation>
			<animation type="WindowClose">
				<effect type="fade" start="100" end="0" time="160" tween="sine" easing="inout" />
				<effect type="slide" start="0,0" end="40,0" time="180" tween="cubic" easing="out" />
			</animation>
			<!-- Starts 10 px left of the menu column (1430) because grouplists clip, and the focus dot sits at 1440. -->
			<control type="grouplist" id="996">
				<left>1430</left>
				<top>392</top>
				<width>450</width>
				<!-- Up to 592 px (to the bottom safe margin); longer menus scroll. Auto height keeps 999 full-screen. -->
				<height max="592">auto</height>
				<orientation>vertical</orientation>
				<itemgap>6</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
			</control>
		</control>
		<!-- Button template: 46 px menu item. Unfocused 34%; focused full ink, sliding 6 px right (320), with the accent dot. -->
		<control type="button" id="1000">
			<!-- At 1434 (list at 1430 plus 4) so that after the 6 px focus slide the dot sits at 1440, like the Home menu's;
			     text lands at 1460 unfocused and 1466 focused, also as in the Home menu. -->
			<left>4</left>
			<width>446</width>
			<height>56</height>
			<font>Bald_MenuItem</font>
			<textoffsetx>26</textoffsetx>
			<aligny>center</aligny>
			<textcolor>bald_ink34</textcolor>
			<focusedcolor>bald_ink</focusedcolor>
			<!-- Focused item: the Home menu's accent dot at x 1440, marking the highlighted entry. -->
			<texturefocus colordiffuse="bald_accent">bald/menu_dot.png</texturefocus>
			<texturenofocus />
			<animation type="Focus">
				<effect type="fade" start="34" end="100" time="240" tween="sine" easing="inout" />
				<effect type="slide" start="0,0" end="6,0" time="320" tween="cubic" easing="out" />
			</animation>
			<animation type="Unfocus">
				<effect type="slide" start="6,0" end="0,0" time="320" tween="cubic" easing="out" />
			</animation>
		</control>
	</controls>
</window>
