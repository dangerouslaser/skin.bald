<?xml version="1.0" encoding="UTF-8"?>
<!-- Fixed info pages, matching the approved detail-pages prototype. Coordinates are 1920 × 1080. -->
<includes>
	<include name="Bald_InfoOverview">
		<!-- Overview retains the original identity, actions and window-open choreography. -->
		<control type="group">
			<left>96</left>
			<top>150</top>
			<include content="Bald_InfoPage"><param name="page">0</param></include>
			<control type="grouplist">
				<width>1728</width>
				<height>720</height>
				<orientation>vertical</orientation>
				<itemgap>0</itemgap>
				<usecontrolcoords>true</usecontrolcoords>
				<!-- Logo box 170 tall: clearlogo bottom-left, or a 76 px title. -->
				<control type="group">
					<height>170</height>
					<include content="Bald_AnimInfoIn"><param name="delay">380</param></include>
					<control type="image">
						<width>700</width>
						<height>170</height>
						<aspectratio align="left" aligny="bottom">keep</aspectratio>
						<texture background="true">$VAR[Bald_InfoLogo]</texture>
					</control>
					<control type="label">
						<top>80</top>
						<width>1400</width>
						<height>90</height>
						<font>Bald_InfoTitle</font>
						<textcolor>bald_ink</textcolor>
						<label>$VAR[Bald_InfoTitle]</label>
						<visible>String.IsEmpty(ListItem.Art(clearlogo)) + String.IsEmpty(ListItem.Art(tvshow.clearlogo))</visible>
					</control>
				</control>
				<control type="label">
					<top>26</top>
					<width>1400</width>
					<height>30</height>
					<font>Bald_InfoMeta</font>
					<textcolor>bald_ink</textcolor>
					<label>$VAR[Bald_InfoMeta]</label>
					<include content="Bald_AnimInfoIn"><param name="delay">440</param></include>
				</control>
				<control type="label">
					<top>8</top>
					<width>1400</width>
					<height>26</height>
					<font>Bald_InfoGenre</font>
					<textcolor>bald_accent</textcolor>
					<label>$INFO[ListItem.Genre]</label>
					<include content="Bald_AnimInfoIn"><param name="delay">480</param></include>
				</control>
				<control type="grouplist">
					<top>16</top>
					<width>1400</width>
					<height>30</height>
					<orientation>horizontal</orientation>
					<itemgap>8</itemgap>
					<visible>String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,episode)</visible>
					<include content="Bald_AnimInfoIn"><param name="delay">520</param></include>
					<include content="Bald_InfoFlag"><param name="label">4K</param><param name="visible">String.IsEqual(ListItem.VideoResolution,4K)</param></include>
					<include content="Bald_InfoFlag"><param name="label">1080p</param><param name="visible">String.IsEqual(ListItem.VideoResolution,1080)</param></include>
					<include content="Bald_InfoFlag"><param name="label">Dolby Vision</param><param name="visible">String.IsEqual(ListItem.HdrType,dolbyvision)</param></include>
					<include content="Bald_InfoFlag"><param name="label">HDR10</param><param name="visible">String.IsEqual(ListItem.HdrType,hdr10)</param></include>
					<include content="Bald_InfoFlag"><param name="label">HDR10+</param><param name="visible">String.StartsWith(ListItem.HdrType,hdr10) + !String.IsEqual(ListItem.HdrType,hdr10)</param></include>
					<include content="Bald_InfoFlag"><param name="label">HLG</param><param name="visible">String.IsEqual(ListItem.HdrType,hlg)</param></include>
					<include content="Bald_InfoFlag"><param name="label">Dolby Atmos</param><param name="visible">String.Contains(ListItem.AudioCodec,atmos)</param></include>
					<include content="Bald_InfoFlag"><param name="label">7.1</param><param name="visible">String.IsEqual(ListItem.AudioChannels,8)</param></include>
					<include content="Bald_InfoFlag"><param name="label">5.1</param><param name="visible">String.IsEqual(ListItem.AudioChannels,6)</param></include>
				</control>
				<control type="label">
					<top>28</top>
					<width>1400</width>
					<height>38</height>
					<font>Bald_InfoTagline</font>
					<textcolor>bald_ink</textcolor>
					<label>$INFO[ListItem.Tagline]</label>
					<visible>!String.IsEmpty(ListItem.Tagline)</visible>
					<include content="Bald_AnimInfoIn"><param name="delay">560</param></include>
				</control>
				<!-- Plot: 4 lines of 34 px (Kodi draws ceil(height / line height) lines). -->
				<control type="label">
					<top>14</top>
					<width>780</width>
					<height>134</height>
					<wrapmultiline>true</wrapmultiline>
					<aligny>top</aligny>
					<font>Bald_InfoPlot</font>
					<textcolor>bald_ink84</textcolor>
					<label>$INFO[ListItem.Plot]</label>
					<include content="Bald_AnimInfoIn"><param name="delay">600</param></include>
				</control>
				<!-- Actions -->
				<control type="grouplist" id="5000">
					<top>34</top>
					<width>1400</width>
					<height>70</height>
					<orientation>horizontal</orientation>
					<itemgap>14</itemgap>
					<include content="Bald_AnimInfoIn"><param name="delay">650</param></include>
					<include content="Bald_InfoAction">
						<param name="id">5001</param>
						<param name="label">Resume</param>
						<param name="onclick">SendClick(9)</param>
						<param name="visible">ListItem.IsResumable</param>
					</include>
					<include content="Bald_InfoAction">
						<param name="id">5002</param>
						<param name="label">Start over</param>
						<param name="onclick">SendClick(8)</param>
						<param name="visible">ListItem.IsResumable</param>
					</include>
					<include content="Bald_InfoAction">
						<param name="id">5003</param>
						<param name="label">Play</param>
						<param name="onclick">SendClick(8)</param>
						<param name="visible">!ListItem.IsResumable</param>
					</include>
					<include content="Bald_InfoAction">
						<param name="id">5004</param>
						<param name="label">Trailer</param>
						<param name="onclick">SendClick(11)</param>
						<param name="visible">!String.IsEmpty(ListItem.Trailer)</param>
					</include>
				</control>
				<!-- Progress (in progress only) -->
				<control type="group">
					<top>18</top>
					<height>24</height>
					<visible>ListItem.IsResumable</visible>
					<include content="Bald_AnimInfoIn"><param name="delay">690</param></include>
					<control type="image">
						<top>10</top>
						<width>240</width>
						<height>4</height>
						<texture border="2" colordiffuse="bald_ink28">bald/bar.png</texture>
					</control>
					<control type="progress">
						<top>10</top>
						<width>240</width>
						<height>4</height>
						<texturebg />
						<lefttexture />
						<midtexture border="2" colordiffuse="bald_ink">bald/bar.png</midtexture>
						<righttexture />
						<info>ListItem.PercentPlayed</info>
					</control>
					<control type="label">
						<left>254</left>
						<width>400</width>
						<height>24</height>
						<aligny>center</aligny>
						<font>Bald_Progress</font>
						<textcolor>bald_ink70</textcolor>
						<label>$INFO[ListItem.PercentPlayed,,% watched]</label>
					</control>
				</control>
			</control>
		</control>

	</include>
	<include name="Bald_InfoCastPage">
		<control type="group" id="5201">
			<include content="Bald_InfoPage"><param name="page">1</param></include>
			<control type="image">
				<left>96</left><top>156</top><width>432</width><height>648</height>
				<texture colordiffuse="bald_placeholder">bald/white.png</texture>
			</control>
			<control type="image" id="5204">
				<left>96</left><top>156</top><width>432</width><height>648</height>
				<aspectratio>keep</aspectratio><texture background="true">$VAR[Bald_InfoPoster]</texture>
			</control>
			<control type="grouplist">
				<left>624</left><top>156</top><width>1200</width><height>174</height>
				<orientation>vertical</orientation><itemgap>10</itemgap>
				<control type="label"><height>26</height><font>Bald_InfoGenre</font><textcolor>bald_accent</textcolor><label>Cast &amp; details</label></control>
				<control type="textbox"><height max="88">auto</height><font>Bald_CaptionTitle</font><textcolor>bald_ink</textcolor><label>$VAR[Bald_InfoTitle]</label></control>
				<control type="label"><height>28</height><font>Bald_CaptionMeta</font><textcolor>bald_ink70</textcolor><label>$VAR[Bald_InfoMeta]$INFO[ListItem.Genre, · ,]</label></control>
			</control>
			<control type="label"><left>624</left><top>340</top><width>1000</width><height>28</height><font>Bald_Section</font><textcolor>bald_ink</textcolor><label>Cast</label></control>
			<control type="label"><left>1624</left><top>340</top><width>200</width><height>28</height><align>right</align><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$INFO[Container(50).CurrentItem] / $INFO[Container(50).NumItems]</label><visible>Integer.IsGreater(Container(50).NumItems,0)</visible></control>
			<control type="list" id="50">
				<left>624</left><top>378</top><width>1200</width><height>234</height>
				<orientation>horizontal</orientation><scrolltime tween="cubic" easing="out">440</scrolltime>
				<onfocus>SetProperty(Bald.InfoSec,1,home)</onfocus>
				<onfocus>ClearProperty(TMDbHelper.WidgetContainer,movieinformation)</onfocus>
				<include>Bald_InfoToOverview</include><include>Bald_InfoToMore</include>
				<onleft>noop</onleft><onright>noop</onright>
				<itemlayout width="240" height="234"><include>Bald_CastItem</include></itemlayout>
				<focusedlayout width="240" height="234"><include content="Bald_CastItem"><param name="focused">Control.HasFocus(50)</param></include></focusedlayout>
			</control>
			<control type="label">
				<left>624</left><top>400</top><width>1200</width><height>42</height>
				<font>Bald_DetailValue</font><textcolor>bald_ink60</textcolor><label>No cast information available.</label>
				<visible>!Integer.IsGreater(Container(50).NumItems,0)</visible>
			</control>
			<control type="button" id="5050">
				<left>624</left><top>650</top><width>180</width><height>28</height>
				<font>Bald_Section</font><textcolor>bald_ink</textcolor><focusedcolor>bald_accent</focusedcolor>
				<textoffsetx>0</textoffsetx><texturefocus /><texturenofocus /><label>Details</label>
				<onfocus>SetProperty(Bald.InfoSec,1,home)</onfocus><onfocus>ClearProperty(TMDbHelper.WidgetContainer,movieinformation)</onfocus>
				<include>Bald_InfoToOverview</include><include>Bald_InfoToMore</include>
				<onleft>noop</onleft><onright>noop</onright><onclick>noop</onclick>
			</control>
			<control type="group">
				<left>624</left><top>696</top>
				<include content="Bald_Detail"><param name="x">0</param><param name="y">0</param><param name="vy">26</param><param name="label">Directed by</param><param name="value">$INFO[ListItem.Director]</param></include>
				<include content="Bald_Detail"><param name="x">410</param><param name="y">0</param><param name="vy">26</param><param name="label">Written by</param><param name="value">$INFO[ListItem.Writer]</param></include>
				<include content="Bald_Detail"><param name="x">820</param><param name="y">0</param><param name="vy">26</param><param name="label">Genres</param><param name="value">$INFO[ListItem.Genre]</param></include>
				<include content="Bald_Detail"><param name="x">0</param><param name="y">100</param><param name="vy">126</param><param name="label">Video</param><param name="value">$VAR[Bald_InfoVideo]</param></include>
				<include content="Bald_Detail"><param name="x">410</param><param name="y">100</param><param name="vy">126</param><param name="label">Audio</param><param name="value">$VAR[Bald_InfoAudio]</param></include>
				<include content="Bald_Detail"><param name="x">820</param><param name="y">100</param><param name="vy">126</param><param name="label">Subtitles</param><param name="value">$INFO[ListItem.SubtitleLanguage]</param></include>
			</control>
		</control>
	</include>
	<include name="Bald_InfoRecommendationsPage">
		<control type="group" id="5202">
			<include content="Bald_InfoPage"><param name="page">2</param></include>
			<control type="image"><left>96</left><top>120</top><width>1248</width><height>702</height><texture colordiffuse="bald_placeholder">bald/white.png</texture></control>
			<control type="image" id="5205">
				<left>96</left><top>120</top><width>1248</width><height>702</height><aspectratio>scale</aspectratio>
				<fadetime>700</fadetime><texture background="true">$VAR[Bald_MorePreviewArt]</texture><visible>$EXP[Bald_HasRecommendations]</visible>
			</control>
			<control type="label"><left>1440</left><top>120</top><width>384</width><height>28</height><font>Bald_Section</font><textcolor>bald_ink</textcolor><label>More like this</label></control>
			<control type="label"><left>1440</left><top>166</top><width>384</width><height>84</height><wrapmultiline>true</wrapmultiline><aligny>top</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink60</textcolor><label>$INFO[ListItem.Title,For ,]</label></control>
			<!-- All preview labels explicitly belong to the recommendation container, never the dialog item. -->
			<control type="grouplist">
				<left>1440</left><top>380</top><width>384</width><height>448</height><orientation>vertical</orientation>
				<itemgap>0</itemgap><usecontrolcoords>true</usecontrolcoords><visible>$EXP[Bald_HasRecommendations]</visible>
				<control type="textbox" id="5210"><height max="132">auto</height><font>Bald_CaptionTitle</font><textcolor>bald_ink</textcolor><label>$INFO[Container(5100).ListItem.Title]</label></control>
				<control type="label" id="5211"><top>16</top><height>28</height><font>Bald_CaptionMeta</font><textcolor>bald_ink80</textcolor><label>$VAR[Bald_MoreMeta]</label></control>
				<control type="label"><top>10</top><height>50</height><wrapmultiline>true</wrapmultiline><aligny>top</aligny><font>Bald_Accent</font><textcolor>bald_accent</textcolor><label>$INFO[Container(5100).ListItem.Genre]</label></control>
				<control type="label" id="5212"><top>12</top><height>146</height><wrapmultiline>true</wrapmultiline><aligny>top</aligny><font>Bald_CaptionPlot</font><textcolor>bald_ink76</textcolor><label>$INFO[Container(5100).ListItem.Plot]</label></control>
			</control>
			<control type="label"><left>96</left><top>856</top><width>850</width><height>26</height><font>Bald_RowLabel</font><textcolor>bald_ink</textcolor><label>More like this</label></control>
			<control type="label"><left>1144</left><top>856</top><width>200</width><height>26</height><align>right</align><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$INFO[Container(5100).CurrentItem] / $INFO[Container(5100).NumItems]</label><visible>$EXP[Bald_HasRecommendations]</visible></control>
			<control type="list" id="5100">
				<left>86</left><top>884</top><width>1268</width><height>119</height><orientation>horizontal</orientation>
				<scrolltime tween="cubic" easing="out">440</scrolltime>
				<visible allowhiddenfocus="true">!String.IsEmpty(Window(movieinformation).Property(Bald.MorePath))</visible>
				<onfocus>SetProperty(Bald.InfoSec,2,home)</onfocus>
				<onfocus>SetProperty(TMDbHelper.WidgetContainer,5100,movieinformation)</onfocus>
				<include>Bald_InfoBackToCast</include>
				<ondown>noop</ondown><onleft>noop</onleft><onright>noop</onright>
				<onclick>RunScript(skin.bald,open,$INFO[Container(5100).ListItem.DBType],$INFO[Container(5100).ListItem.DBID])</onclick>
				<itemlayout width="192" height="119"><include>Bald_LandscapeTile</include></itemlayout>
				<focusedlayout width="192" height="119"><include content="Bald_LandscapeTile"><param name="diffuse">bald_ink</param><param name="ring">Control.HasFocus(5100)</param></include></focusedlayout>
				<content target="videos" sortby="rating" sortorder="descending" limit="12" browse="never">$INFO[Window(movieinformation).Property(Bald.MorePath)]</content>
			</control>
			<!-- A real focus target keeps the page escapable while empty or loading. The ready timer yields to 5100. -->
			<control type="button" id="5150">
				<left>96</left><top>460</top><width>1248</width><height>60</height><font>Bald_Section</font>
				<align>center</align><textcolor>bald_ink60</textcolor><focusedcolor>bald_ink</focusedcolor>
				<texturefocus /><texturenofocus /><label>$VAR[Bald_MoreStatus]</label>
				<visible allowhiddenfocus="true">!$EXP[Bald_HasRecommendations]</visible>
				<onfocus>SetProperty(Bald.InfoSec,2,home)</onfocus><include>Bald_InfoBackToCast</include>
				<ondown>noop</ondown><onleft>noop</onleft><onright>noop</onright><onclick>noop</onclick>
			</control>
			<control type="label"><left>1440</left><top>926</top><width>384</width><height>28</height><font>Bald_Section</font><textcolor>bald_accent</textcolor><label>• More like this</label></control>
			<control type="label"><left>1440</left><top>962</top><width>384</width><height>24</height><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>Up for cast &amp; details · Select to open</label></control>
		</control>
	</include>
</includes>
