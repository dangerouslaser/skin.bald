<?xml version="1.0" encoding="utf-8"?>
<!-- Kodi's profile settings (window profiles), drawn in Bald's settings scaffold (Includes_Bald_Configure.xml).
     Started from Kodi 22 Estuary's SettingsProfile.xml (GPL-2.0-or-later, see LICENSE-Estuary.txt).
     Kodi (CGUIWindowSettingsProfile) binds: 2 profile list (it fills the items and handles clicks), 4 login screen
     toggle, 5 automatic login button. Sidebar items 1 and 2 pick the pane, as in Estuary. -->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<controls>
		<include content="Bald_SettingsFrame"><param name="title">$LOCALIZE[13200]</param></include>
		<control type="list" id="9000">
			<include content="Bald_SettingsCategories"><param name="id">9000</param><param name="right">9100</param></include>
			<content>
				<item id="1">
					<label>$LOCALIZE[128]</label>
					<property name="note">$LOCALIZE[31945]</property>
					<onclick>noop</onclick>
				</item>
				<item id="2">
					<label>$LOCALIZE[13200]</label>
					<property name="note">$LOCALIZE[31946]</property>
					<onclick>noop</onclick>
				</item>
			</content>
		</control>
		<include content="Bald_SettingsDetail">
			<param name="heading">$INFO[Container(9000).ListItem.Label]</param>
			<param name="note">$INFO[Container(9000).ListItem.Property(note)]</param>
			<control type="group" id="9100">
				<control type="grouplist" id="9001">
					<include content="Bald_SettingsRows"><param name="left">9000</param></include>
					<visible>Container(9000).HasFocus(1)</visible>
					<control type="radiobutton" id="4">
						<include>Bald_ConfigureButton</include>
						<label>$LOCALIZE[31057]</label>
					</control>
					<control type="button" id="5">
						<include>Bald_ConfigureButton</include>
						<label>$LOCALIZE[31058]</label>
						<label2>$INFO[System.ProfileAutoLogin]</label2>
						<enable>!Window.IsVisible(ProfileSettings) + !System.HasLoginScreen</enable>
					</control>
				</control>
				<control type="list" id="2">
					<top>216</top>
					<width>726</width>
					<height>520</height>
					<orientation>vertical</orientation>
					<scrolltime tween="cubic" easing="out">320</scrolltime>
					<onleft>9000</onleft>
					<visible>Container(9000).HasFocus(2)</visible>
					<itemlayout height="78">
						<include content="Bald_SettingsProfileItem" />
					</itemlayout>
					<focusedlayout height="78">
						<include content="Bald_SettingsProfileItem">
							<param name="color">bald_ink</param>
							<param name="focused">true</param>
						</include>
					</focusedlayout>
				</control>
			</control>
		</include>
		<include content="Bald_SettingsHints"><param name="first">$LOCALIZE[31738]</param><param name="second">$LOCALIZE[31747]</param></include>
	</controls>
</window>
