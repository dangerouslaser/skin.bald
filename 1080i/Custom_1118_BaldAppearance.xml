<?xml version="1.0" encoding="UTF-8"?>
<window type="window" id="1118">
	<defaultcontrol always="true">9500</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<controls>
		<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field">bald/white.png</texture></control>
		<include content="Bald_Backdrop" />
		<control type="image"><width>590</width><height>1080</height><texture colordiffuse="E0121518">bald/white.png</texture></control>
		<control type="label"><left>96</left><top>72</top><width>398</width><height>60</height><label>Appearance</label><font>font37</font><textcolor>white</textcolor></control>
		<control type="list" id="9500">
			<left>96</left><top>190</top><width>398</width><height>500</height><orientation>vertical</orientation><onright>9600</onright><onback>PreviousMenu</onback>
			<itemlayout height="84"><control type="label"><left>20</left><width>358</width><height>76</height><label>$INFO[ListItem.Label]</label><font>font27</font><textcolor>80FFFFFF</textcolor><aligny>center</aligny></control></itemlayout>
			<focusedlayout height="84"><control type="image"><width>398</width><height>76</height><texture colordiffuse="30FFFFFF">bald/white.png</texture></control><control type="label"><left>20</left><width>358</width><height>76</height><label>$INFO[ListItem.Label]</label><font>font27</font><textcolor>white</textcolor><aligny>center</aligny></control></focusedlayout>
			<content>
				<item><label>Artwork</label><property name="note">Choose how artwork and its background treatment appear throughout Bald.</property></item>
				<item><label>Information</label><property name="note">Choose which technical details are displayed with movies and episodes.</property></item>
				<item><label>Behavior</label><property name="note">Configure idle motion and persistent navigation help.</property></item>
			</content>
		</control>
		<control type="group"><left>686</left><top>214</top><width>1050</width><height>650</height>
			<control type="label"><width>1050</width><height>70</height><label>$INFO[Container(9500).ListItem.Label]</label><font>font37</font><textcolor>white</textcolor></control>
			<control type="textbox"><top>76</top><width>900</width><height>100</height><label>$INFO[Container(9500).ListItem.Property(note)]</label><font>font27</font><textcolor>B0FFFFFF</textcolor></control>
			<control type="grouplist" id="9600"><top>210</top><width>620</width><height>390</height><orientation>vertical</orientation><itemgap>12</itemgap><onleft>9500</onleft><onback>PreviousMenu</onback>
				<control type="radiobutton" id="9601"><include content="Bald_ConfigureButton"><param name="width">620</param></include><label>Clearlogos on artwork</label><selected>!Skin.HasSetting(Bald.HideClearlogo)</selected><onclick>Skin.ToggleSetting(Bald.HideClearlogo)</onclick><visible>String.IsEqual(Container(9500).ListItem.Label,Artwork)</visible></control>
				<control type="radiobutton" id="9602"><include content="Bald_ConfigureButton"><param name="width">620</param></include><label>Blurred fanart backgrounds</label><selected>!Skin.HasSetting(Bald.DisableBlur)</selected><onclick>Skin.ToggleSetting(Bald.DisableBlur)</onclick><visible>String.IsEqual(Container(9500).ListItem.Label,Artwork)</visible></control>
				<control type="radiobutton" id="9611"><include content="Bald_ConfigureButton"><param name="width">620</param></include><label>Media flags</label><selected>!Skin.HasSetting(Bald.HideMediaFlags)</selected><onclick>Skin.ToggleSetting(Bald.HideMediaFlags)</onclick><visible>String.IsEqual(Container(9500).ListItem.Label,Information)</visible></control>
				<control type="radiobutton" id="9621"><include content="Bald_ConfigureButton"><param name="width">620</param></include><label>Ambient movement when idle</label><selected>!Skin.HasSetting(Bald.AmbientOff)</selected><onclick>Skin.ToggleSetting(Bald.AmbientOff)</onclick><visible>String.IsEqual(Container(9500).ListItem.Label,Behavior)</visible></control>
				<control type="radiobutton" id="9622"><include content="Bald_ConfigureButton"><param name="width">620</param></include><label>Always show navigation hints</label><selected>!Skin.HasSetting(Bald.AutoHideMenuHint)</selected><onclick>Skin.ToggleSetting(Bald.AutoHideMenuHint)</onclick><visible>String.IsEqual(Container(9500).ListItem.Label,Behavior)</visible></control>
				<control type="button" id="9623"><include content="Bald_ConfigureButton"><param name="width">620</param></include><label>Reset navigation hint</label><onclick>Skin.Reset(Bald.MenuOpens)</onclick><visible>String.IsEqual(Container(9500).ListItem.Label,Behavior) + Skin.HasSetting(Bald.AutoHideMenuHint)</visible></control>
			</control>
		</control>
		<control type="label"><right>96</right><bottom>62</bottom><width>1050</width><height>40</height><label>BACK  •  BALD SETTINGS    SELECT  •  CHANGE</label><font>font20</font><textcolor>80FFFFFF</textcolor><align>right</align></control>
	</controls>
</window>
