<?xml version="1.0" encoding="UTF-8"?>
<!-- Appearance. Rows belong to a category by the category item's id (Bald_SettingRow), not its label.
     Estuary windows keeps the Estuary skin settings that windows Bald has not redesigned yet still read; the rest of
     Estuary's "Configure skin..." page (main menu items, home widgets, on-click actions) had no effect in Bald. -->
<window type="window" id="1118">
	<defaultcontrol always="true">9500</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<!-- Estuary's default pattern; its cycle below steps from a set value. -->
	<onload condition="String.IsEmpty(Skin.String(background_overlay))">Skin.SetString(background_overlay,1)</onload>
	<controls>
		<include content="Bald_SettingsFrame"><param name="title">$LOCALIZE[480]</param></include>
		<control type="list" id="9500">
			<include content="Bald_SettingsCategories"><param name="id">9500</param><param name="right">9600</param></include>
			<content>
				<item id="1"><label>$LOCALIZE[39123]</label><property name="note">$LOCALIZE[31755]</property></item>
				<item id="2"><label>$LOCALIZE[19033]</label><property name="note">$LOCALIZE[31756]</property></item>
				<item id="3"><label>$LOCALIZE[31757]</label><property name="note">$LOCALIZE[31758]</property></item>
				<item id="4"><label>$LOCALIZE[31759]</label><property name="note">$LOCALIZE[31760]</property></item>
			</content>
		</control>
		<include content="Bald_SettingsDetail">
			<param name="heading">$INFO[Container(9500).ListItem.Label]</param>
			<param name="note">$INFO[Container(9500).ListItem.Property(note)]</param>
			<control type="grouplist" id="9600">
				<include content="Bald_SettingsRows"><param name="left">9500</param></include>
				<!-- Artwork -->
				<control type="radiobutton" id="9601"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">1</param></include><label>$LOCALIZE[31761]</label><selected>!Skin.HasSetting(Bald.HideClearlogo)</selected><onclick>Skin.ToggleSetting(Bald.HideClearlogo)</onclick></control>
				<control type="radiobutton" id="9602"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">1</param></include><label>$LOCALIZE[31762]</label><selected>!Skin.HasSetting(Bald.DisableBlur)</selected><onclick>Skin.ToggleSetting(Bald.DisableBlur)</onclick></control>
				<!-- Information -->
				<control type="radiobutton" id="9611"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">2</param></include><label>$LOCALIZE[31763]</label><selected>!Skin.HasSetting(Bald.HideMediaFlags)</selected><onclick>Skin.ToggleSetting(Bald.HideMediaFlags)</onclick></control>
				<control type="radiobutton" id="9612"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">2</param></include><label>$LOCALIZE[31769]</label><selected>Skin.HasSetting(Bald.ShowRowCount)</selected><onclick>Skin.ToggleSetting(Bald.ShowRowCount)</onclick></control>
				<!-- Behavior -->
				<control type="radiobutton" id="9621"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">3</param></include><label>$LOCALIZE[31764]</label><selected>!Skin.HasSetting(Bald.AmbientOff)</selected><onclick>Skin.ToggleSetting(Bald.AmbientOff)</onclick></control>
				<control type="radiobutton" id="9622"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">3</param></include><label>$LOCALIZE[31765]</label><selected>!Skin.HasSetting(Bald.AutoHideMenuHint)</selected><onclick>Skin.ToggleSetting(Bald.AutoHideMenuHint)</onclick></control>
				<control type="button" id="9623"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">3</param></include><label>$LOCALIZE[31766]</label><onclick>Skin.Reset(Bald.MenuOpens)</onclick><visible>Skin.HasSetting(Bald.AutoHideMenuHint)</visible></control>
				<!-- Estuary windows: Estuary's own settings, labels and control IDs. -->
				<control type="radiobutton" id="701"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31095]</label><selected>!Skin.HasSetting(no_slide_animations)</selected><onclick>Skin.ToggleSetting(no_slide_animations)</onclick></control>
				<control type="radiobutton" id="702"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[20189]</label><selected>Skin.HasSetting(autoscroll)</selected><onclick>Skin.ToggleSetting(autoscroll)</onclick></control>
				<control type="radiobutton" id="703"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31158]</label><selected>Skin.HasSetting(touchmode)</selected><onclick>Skin.ToggleSetting(touchmode)</onclick></control>
				<control type="radiobutton" id="704"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31093]</label><selected>Skin.HasSetting(show_weatherinfo) + !String.IsEmpty(Weather.Plugin)</selected><onclick condition="!String.IsEmpty(Weather.Plugin)">Skin.ToggleSetting(show_weatherinfo)</onclick><onclick condition="String.IsEmpty(Weather.Plugin)">ActivateWindow(servicesettings,weather)</onclick></control>
				<control type="radiobutton" id="705"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31160]</label><selected>!Skin.HasSetting(hide_mediaflags)</selected><onclick>Skin.ToggleSetting(hide_mediaflags)</onclick></control>
				<control type="button" id="707"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31164]</label><label2>$VAR[ProfileIdentificationLabel2Var]</label2><onclick>Skin.SelectBool(31164, 31165|show_profilename, 31166|show_profileavatar, 16018|show_none)</onclick></control>
				<control type="button" id="708"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31047]</label><label2>$VAR[OriginalTitleSetting]</label2><onclick>Skin.SelectBool(31047, 571|OriginalTitleFormat_Default, 31049|OriginalTitleFormat_Only, 31050|OriginalTitleFormat_1st, 31051|OriginalTitleFormat_2nd)</onclick></control>
				<control type="radiobutton" id="6067"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31168]</label><selected>Skin.HasSetting(show_musicvideoposter)</selected><onclick>Skin.ToggleSetting(show_musicvideoposter)</onclick></control>
				<control type="radiobutton" id="623"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31172]</label><selected>Skin.HasSetting(OSDAutoClose)</selected><onclick>Skin.ToggleSetting(OSDAutoClose)</onclick></control>
				<control type="button" id="624"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31173]</label><label2>$VAR[SkinSettingOSDAutoCloseTime]</label2><onclick>Skin.SetNumeric(OSDAutoCloseTime)</onclick><enable>Skin.HasSetting(OSDAutoClose)</enable></control>
				<control type="radiobutton" id="605"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31002]</label><selected>!Skin.HasSetting(no_fanart)</selected><onclick>Skin.ToggleSetting(no_fanart)</onclick></control>
				<control type="button" id="607"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31156]</label><label2>$VAR[BackgroundOverlayTypeVar]</label2>
					<onclick condition="String.IsEqual(Skin.String(background_overlay),7)">Skin.SetString(background_overlay,0)</onclick>
					<onclick condition="String.IsEqual(Skin.String(background_overlay),6)">Skin.SetString(background_overlay,7)</onclick>
					<onclick condition="String.IsEqual(Skin.String(background_overlay),5)">Skin.SetString(background_overlay,6)</onclick>
					<onclick condition="String.IsEqual(Skin.String(background_overlay),4)">Skin.SetString(background_overlay,5)</onclick>
					<onclick condition="String.IsEqual(Skin.String(background_overlay),3)">Skin.SetString(background_overlay,4)</onclick>
					<onclick condition="String.IsEqual(Skin.String(background_overlay),2)">Skin.SetString(background_overlay,3)</onclick>
					<onclick condition="String.IsEqual(Skin.String(background_overlay),1)">Skin.SetString(background_overlay,2)</onclick>
					<onclick condition="String.IsEqual(Skin.String(background_overlay),0)">Skin.SetString(background_overlay,1)</onclick>
				</control>
				<control type="button" id="608"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31131]</label><label2>$INFO[Skin.String(HomeFanart.name)]</label2><enable>!Skin.HasSetting(no_fanart)</enable>
					<include content="Bald_ImageResourceActions"><param name="property">HomeFanart</param><param name="type">resource.images.skinbackgrounds</param></include>
				</control>
				<control type="button" id="609"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31062]</label><label2>$INFO[Skin.String(WeatherFanart.name)]</label2><enable>!Skin.HasSetting(no_fanart)</enable>
					<include content="Bald_ImageResourceActions"><param name="property">WeatherFanart</param><param name="type">resource.images.weatherfanart</param></include>
				</control>
				<control type="button" id="6066"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31149]</label><label2>$INFO[Skin.String(MovieGenreFanart.Name)]</label2>
					<include content="Bald_ImageResourceActions"><param name="property">MovieGenreFanart</param><param name="type">resource.images.moviegenrefanart</param></include>
				</control>
				<control type="button" id="6068"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31177]</label><label2>$INFO[Skin.String(WeatherOutlookIcon.name)]</label2>
					<include content="Bald_ImageResourceActions"><param name="property">WeatherOutlookIcon</param><param name="type">resource.images.weathericons</param></include>
				</control>
			</control>
		</include>
		<include content="Bald_SettingsHints"><param name="first">$LOCALIZE[31746]</param><param name="second">$LOCALIZE[31747]</param></include>
	</controls>
</window>
