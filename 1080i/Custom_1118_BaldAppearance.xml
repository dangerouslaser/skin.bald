<?xml version="1.0" encoding="UTF-8"?>
<!-- Appearance. Rows belong to a category by the category item's id (Bald_SettingRow), not its label. -->
<window type="window" id="1118">
	<defaultcontrol always="true">9500</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<controls>
		<include content="Bald_SettingsFrame"><param name="title">Appearance</param></include>
		<control type="list" id="9500">
			<include content="Bald_SettingsCategories"><param name="id">9500</param><param name="right">9600</param></include>
			<content>
				<item id="1"><label>Artwork</label><property name="note">Choose how artwork and its background treatment appear throughout Bald.</property></item>
				<item id="2"><label>Information</label><property name="note">Choose which technical details are displayed with movies and episodes.</property></item>
				<item id="3"><label>Behavior</label><property name="note">Configure idle motion and persistent navigation help.</property></item>
			</content>
		</control>
		<include content="Bald_SettingsDetail">
			<param name="heading">$INFO[Container(9500).ListItem.Label]</param>
			<param name="note">$INFO[Container(9500).ListItem.Property(note)]</param>
			<control type="grouplist" id="9600">
				<include content="Bald_SettingsRows"><param name="left">9500</param></include>
				<!-- Artwork -->
				<control type="radiobutton" id="9601"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">1</param></include><label>Clearlogos on artwork</label><selected>!Skin.HasSetting(Bald.HideClearlogo)</selected><onclick>Skin.ToggleSetting(Bald.HideClearlogo)</onclick></control>
				<control type="radiobutton" id="9602"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">1</param></include><label>Blurred fanart backgrounds</label><selected>!Skin.HasSetting(Bald.DisableBlur)</selected><onclick>Skin.ToggleSetting(Bald.DisableBlur)</onclick></control>
				<!-- Information -->
				<control type="radiobutton" id="9611"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">2</param></include><label>Media flags</label><selected>!Skin.HasSetting(Bald.HideMediaFlags)</selected><onclick>Skin.ToggleSetting(Bald.HideMediaFlags)</onclick></control>
				<!-- Behavior -->
				<control type="radiobutton" id="9621"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">3</param></include><label>Ambient movement when idle</label><selected>!Skin.HasSetting(Bald.AmbientOff)</selected><onclick>Skin.ToggleSetting(Bald.AmbientOff)</onclick></control>
				<control type="radiobutton" id="9622"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">3</param></include><label>Always show navigation hints</label><selected>!Skin.HasSetting(Bald.AutoHideMenuHint)</selected><onclick>Skin.ToggleSetting(Bald.AutoHideMenuHint)</onclick></control>
				<control type="button" id="9623"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">3</param></include><label>Reset navigation hint</label><onclick>Skin.Reset(Bald.MenuOpens)</onclick><visible>Skin.HasSetting(Bald.AutoHideMenuHint)</visible></control>
			</control>
		</include>
		<include content="Bald_SettingsHints"><param name="first">Back for Bald settings</param><param name="second">Select to change</param></include>
	</controls>
</window>
