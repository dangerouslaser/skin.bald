<?xml version="1.0" encoding="UTF-8"?>
<!-- Appearance. Rows belong to a category by the category item's id (Bald_SettingRow), not its label.
     Estuary windows keeps the Estuary skin settings that windows Bald has not redesigned yet still read; the rest of
     Estuary's "Configure skin..." page (main menu items, home widgets, on-click actions) had no effect in Bald. -->
<window type="window" id="1118">
	<defaultcontrol always="true">9500</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<controls>
		<include content="Bald_SettingsFrame"><param name="title">$LOCALIZE[480]</param></include>
		<control type="list" id="9500">
			<include content="Bald_SettingsCategories"><param name="id">9500</param><param name="right">9600</param></include>
			<content>
				<item id="1"><label>$LOCALIZE[39123]</label><property name="note">$LOCALIZE[31755]</property></item>
				<item id="2"><label>$LOCALIZE[19033]</label><property name="note">$LOCALIZE[31756]</property></item>
				<item id="3"><label>$LOCALIZE[31757]</label><property name="note">$LOCALIZE[31758]</property></item>
				<item id="5"><label>$LOCALIZE[31942]</label><property name="note">$LOCALIZE[31943]</property></item>
				<item id="4"><label>$LOCALIZE[31759]</label><property name="note">$LOCALIZE[31760]</property></item>
			</content>
		</control>
		<include content="Bald_SettingsDetail">
			<param name="heading">$INFO[Container(9500).ListItem.Label]</param>
			<param name="note">$INFO[Container(9500).ListItem.Property(note)]</param>
			<control type="grouplist" id="9600">
				<include content="Bald_SettingsRows"><param name="left">9500</param></include>
				<!-- Artwork -->
				<control type="radiobutton" id="9601"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">1</param></include><label>$LOCALIZE[31761]</label><selected>!Skin.HasSetting(Bald.HideClearlogo)</selected><onclick>Skin.ToggleSetting(Bald.HideClearlogo)</onclick></control>
				<control type="radiobutton" id="9602"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">1</param></include><label>$LOCALIZE[31762]</label><selected>!Skin.HasSetting(Bald.DisableBlur)</selected><onclick>Skin.ToggleSetting(Bald.DisableBlur)</onclick></control>
				<!-- Library pages outside the Bald views: the focused item's fanart behind the page (DefaultBackground). -->
				<control type="radiobutton" id="9603"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">1</param></include><label>$LOCALIZE[31985]</label><selected>!Skin.HasSetting(Bald.HideBrowseFanart)</selected><onclick>Skin.ToggleSetting(Bald.HideBrowseFanart)</onclick></control>
				<!-- Music videos as posters rather than 16:9 thumbs in walls 500 and 54. -->
				<control type="radiobutton" id="9604"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">1</param></include><label>$LOCALIZE[31986]</label><selected>Skin.HasSetting(Bald.MusicVideoPosters)</selected><onclick>Skin.ToggleSetting(Bald.MusicVideoPosters)</onclick></control>
				<!-- Image packs, picked with script.image.resource.select (it writes <property>.name, .path and .ext). -->
				<control type="button" id="9605"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">1</param></include><label>$LOCALIZE[31987]</label><label2>$VAR[Bald_GenreFanartName]</label2><enable>!Skin.HasSetting(Bald.HideBrowseFanart)</enable>
					<include content="Bald_ImageResourceActions"><param name="property">Bald.GenreFanart</param><param name="type">resource.images.moviegenrefanart</param></include>
				</control>
				<control type="button" id="9606"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">1</param></include><label>$LOCALIZE[31988]</label><label2>$VAR[Bald_WeatherFanartName]</label2>
					<include content="Bald_ImageResourceActions"><param name="property">Bald.WeatherFanart</param><param name="type">resource.images.weatherfanart</param></include>
				</control>
				<control type="button" id="9607"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">1</param></include><label>$LOCALIZE[31989]</label><label2>$VAR[Bald_WeatherIconsName]</label2>
					<include content="Bald_ImageResourceActions"><param name="property">Bald.WeatherIcons</param><param name="type">resource.images.weathericons</param></include>
				</control>
				<!-- Information -->
				<control type="radiobutton" id="9611"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">2</param></include><label>$LOCALIZE[31763]</label><selected>!Skin.HasSetting(Bald.HideMediaFlags)</selected><onclick>Skin.ToggleSetting(Bald.HideMediaFlags)</onclick></control>
				<control type="radiobutton" id="9612"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">2</param></include><label>$LOCALIZE[31769]</label><selected>Skin.HasSetting(Bald.ShowRowCount)</selected><onclick>Skin.ToggleSetting(Bald.ShowRowCount)</onclick></control>
				<!-- Behavior -->
				<control type="radiobutton" id="9621"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">3</param></include><label>$LOCALIZE[31764]</label><selected>!Skin.HasSetting(Bald.AmbientOff)</selected><onclick>Skin.ToggleSetting(Bald.AmbientOff)</onclick></control>
				<control type="radiobutton" id="9622"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">3</param></include><label>$LOCALIZE[31765]</label><selected>!Skin.HasSetting(Bald.AutoHideMenuHint)</selected><onclick>Skin.ToggleSetting(Bald.AutoHideMenuHint)</onclick></control>
				<control type="button" id="9623"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">3</param></include><label>$LOCALIZE[31766]</label><onclick>Skin.Reset(Bald.MenuOpens)</onclick><visible>Skin.HasSetting(Bald.AutoHideMenuHint)</visible></control>
				<!-- Typography: switches Kodi's fontset (lookandfeel.font) between the two Font.xml typefaces; Kodi then
				     reloads the skin. Any other fontset (Arial for non-Latin languages) switches to DM Sans. -->
				<control type="button" id="9631"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">5</param></include><label>$LOCALIZE[31944]</label><label2>$VAR[Bald_FontName]</label2>
					<onclick condition="String.IsEqual(Skin.Font,DMSans)">RunScript(skin.bald,font,Default)</onclick>
					<onclick condition="!String.IsEqual(Skin.Font,DMSans)">RunScript(skin.bald,font,DMSans)</onclick>
				</control>
				<!-- On by default: Startup.xml sets Bald.Preload and Home holds a splash until every row has loaded (docs/NOTES.md, Startup splash). -->
				<control type="radiobutton" id="9624"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">3</param></include><label>$LOCALIZE[31726]</label><selected>!Skin.HasSetting(Bald.DisablePreload)</selected><onclick>Skin.ToggleSetting(Bald.DisablePreload)</onclick></control>
				<!-- Estuary windows: Estuary's own settings, labels and control IDs. -->
				<control type="radiobutton" id="702"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[20189]</label><selected>Skin.HasSetting(autoscroll)</selected><onclick>Skin.ToggleSetting(autoscroll)</onclick></control>
				<control type="radiobutton" id="704"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31093]</label><selected>Skin.HasSetting(show_weatherinfo) + !String.IsEmpty(Weather.Plugin)</selected><onclick condition="!String.IsEmpty(Weather.Plugin)">Skin.ToggleSetting(show_weatherinfo)</onclick><onclick condition="String.IsEmpty(Weather.Plugin)">ActivateWindow(servicesettings,weather)</onclick></control>
				<control type="button" id="707"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31164]</label><label2>$VAR[ProfileIdentificationLabel2Var]</label2><onclick>Skin.SelectBool(31164, 31165|show_profilename, 31166|show_profileavatar, 16018|show_none)</onclick></control>
				<control type="button" id="708"><include content="Bald_SettingRow"><param name="list">9500</param><param name="item">4</param></include><label>$LOCALIZE[31047]</label><label2>$VAR[OriginalTitleSetting]</label2><onclick>Skin.SelectBool(31047, 571|OriginalTitleFormat_Default, 31049|OriginalTitleFormat_Only, 31050|OriginalTitleFormat_1st, 31051|OriginalTitleFormat_2nd)</onclick></control>
			</control>
		</include>
		<include content="Bald_SettingsHints"><param name="first">$LOCALIZE[31746]</param><param name="second">$LOCALIZE[31747]</param></include>
	</controls>
</window>
