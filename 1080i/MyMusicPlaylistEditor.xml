			</include>
		</control>
		<control type="group">
			<include>OpenClose_Left</include>
			<include content="ContentPanel">
				<param name="width" value="360" />
			</include>
			<control type="grouplist" id="9000">
				<left>40</left>
				<top>170</top>
				<onright>50</onright>
				<onleft>100</onleft>
