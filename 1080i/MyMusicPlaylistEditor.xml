	     file panels, bars and background are Estuary's shared includes and stay theirs. Kodi binds 6 (load), 7 (save),
	     8 (clear), 50 (files) and 100 (playlist). -->
	<defaultcontrol always="true">6</defaultcontrol>
	<views>50</views>
	<menucontrol>9000</menucontrol>
	<controls>
		<include>DefaultBackground</include>
		<control type="group">
			<include>OpenClose_Left</include>
			<left>302</left>
