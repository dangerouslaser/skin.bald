<?xml version="1.0" encoding="utf-8"?>
<!-- Bald music OSD (docs/SPEC.md 5, "Playback (proposed)"): the video OSD's button row and seek row over the
     visualisation; DialogSeekBar.xml draws the title, time and track. Started from Kodi 22 Estuary's MusicOSD.xml
     (GPL-2.0-or-later, see LICENSE-Estuary.txt). CGUIDialogMusicOSD binds 500 (visualisation) and 501 (lock), which
     Estuary does not draw either. Every button keeps Estuary's id, navigation and actions (200-202 rows, 600-608
     transport, 70040-70055 and 70048 tools, 87 seek button, 799 touch back). -->
<window>
	<onload condition="!Player.PauseEnabled">SetFocus(603)</onload>
	<defaultcontrol always="true">602</defaultcontrol>
	<depth>DepthOSD</depth>
	<controls>
		<control type="button">
			<description>background close area</description>
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>540</height>
			<texturefocus />
			<texturenofocus />
			<onclick>Action(close)</onclick>
		</control>
		<include condition="Skin.HasSetting(touchmode)">Bald_PlaybackTouchBack</include>
		<control type="group" id="200">
			<include>Bald_PlaybackAnimWindow</include>
			<visible>!Window.IsActive(osdaudiosettings) + !Window.IsActive(osdvideosettings) + !Window.IsActive(playerprocessinfo)</visible>
			<include>Bald_PlaybackAnimVisible</include>
			<include>Bald_PlaybackHints</include>
			<control type="grouplist" id="201">
				<left>Bald_SafeLeft</left>
				<width>1000</width>
				<include>Bald_PlaybackButtonRow</include>
				<onup>87</onup>
				<ondown>noop</ondown>
				<onleft>70048</onleft>
				<onright>70040</onright>
				<control type="radiobutton" id="600">
					<include content="Bald_PlaybackButton"><param name="icon">osd/fullscreen/buttons/previous.png</param></include>
					<onclick>PlayerControl(Previous)</onclick>
					<visible>Player.ChapterCount | MusicPlayer.HasPrevious | [Player.SeekEnabled + MusicPlayer.Content(livetv)]</visible>
				</control>
				<control type="radiobutton" id="601">
					<include content="Bald_PlaybackButton"><param name="icon">osd/fullscreen/buttons/rewind.png</param></include>
					<onclick condition="Player.Paused">PlayerControl(Play)</onclick>
					<onclick condition="!Player.Paused">PlayerControl(Rewind)</onclick>
					<visible>Player.SeekEnabled + !MusicPlayer.Content(livetv)</visible>
				</control>
				<!-- A direct child of the row that hides itself: a control hidden only through a parent group can still
				     take focus (CGUIControl::CanFocus ignores parents), which stranded the remote on Live TV. -->
				<control type="radiobutton" id="602">
					<include content="Bald_PlaybackButton"><param name="icon">$VAR[PlayerControlsPlayImageVar]</param></include>
					<onleft>601</onleft>
					<onright>603</onright>
					<onup>87</onup>
					<ondown>noop</ondown>
					<onclick>PlayerControl(Play)</onclick>
					<visible>Player.PauseEnabled</visible>
				</control>
				<control type="radiobutton" id="603">
					<include content="Bald_PlaybackButton"><param name="icon">osd/fullscreen/buttons/stop.png</param></include>
					<onclick>PlayerControl(Stop)</onclick>
				</control>
				<control type="radiobutton" id="606">
					<include content="Bald_PlaybackButton"><param name="icon">osd/fullscreen/buttons/forward.png</param></include>
					<onclick condition="Player.Paused">PlayerControl(Play)</onclick>
					<onclick condition="!Player.Paused">PlayerControl(Forward)</onclick>
					<visible>Player.SeekEnabled + !MusicPlayer.Content(livetv)</visible>
				</control>
				<control type="radiobutton" id="607">
					<include content="Bald_PlaybackButton"><param name="icon">osd/fullscreen/buttons/next.png</param></include>
					<onclick>PlayerControl(Next)</onclick>
					<visible>Player.ChapterCount | MusicPlayer.HasNext | PVR.IsTimeShift</visible>
				</control>
				<!-- Record: the icon turns accent while the channel is recording (not selected). -->
				<control type="radiobutton" id="608">
					<include content="Bald_PlaybackToggle">
						<param name="icon">osd/fullscreen/buttons/record-white.png</param>
						<param name="on">osd/fullscreen/buttons/record-white.png</param>
						<param name="off_color">bald_accent</param>
					</include>
					<selected>!PVR.IsRecordingPlayingChannel</selected>
					<onclick>PVR.ToggleRecordPlayingChannel</onclick>
					<visible>PVR.CanRecordPlayingChannel</visible>
					<visible>MusicPlayer.Content(livetv)</visible>
				</control>
			</control>
			<control type="grouplist" id="202">
				<left>824</left>
				<width>1000</width>
				<align>right</align>
				<include>Bald_PlaybackButtonRow</include>
				<onup>87</onup>
				<ondown>noop</ondown>
				<onleft>608</onleft>
				<onright>600</onright>
				<control type="radiobutton" id="70040">
					<include content="Bald_PlaybackButton"><param name="icon">osd/fullscreen/buttons/channels.png</param></include>
					<onclick>Dialog.Close(MusicOSD)</onclick>
					<onclick>ActivateWindow(PVROSDChannels)</onclick>
					<visible>MusicPlayer.Content(LiveTV)</visible>
				</control>
				<control type="radiobutton" id="70041">
					<include content="Bald_PlaybackButton"><param name="icon">osd/fullscreen/buttons/guide.png</param></include>
					<onclick>Dialog.Close(MusicOSD)</onclick>
					<onclick>ActivateWindow(PVRChannelGuide)</onclick>
					<visible>MusicPlayer.Content(LiveTV) + VideoPlayer.HasEPG</visible>
				</control>
				<control type="radiobutton" id="70050">
					<include content="Bald_PlaybackButton"><param name="icon">osd/fullscreen/buttons/rds.png</param></include>
					<onclick>Dialog.Close(MusicOSD)</onclick>
					<onclick>ActivateWindow(PVRRadioRDSInfo)</onclick>
					<visible>MusicPlayer.Content(LiveTV) + RDS.HasRadiotext</visible>
				</control>
				<control type="radiobutton" id="70051">
					<include content="Bald_PlaybackButton"><param name="icon">osd/fullscreen/buttons/playlist.png</param></include>
					<onclick>Dialog.Close(all, true)</onclick>
					<onclick>ActivateWindow(musicplaylist)</onclick>
					<visible>Integer.IsGreater(Playlist.Length(music),0)</visible>
				</control>
				<control type="radiobutton" id="70052">
					<include content="Bald_PlaybackButton"><param name="icon">osd/fullscreen/buttons/rating.png</param></include>
					<onclick>SetRating</onclick>
				</control>
				<!-- A direct child of the row that hides itself: a control hidden only through a parent group can still
				     take focus (CGUIControl::CanFocus ignores parents), which stranded the remote on Live TV. -->
				<control type="radiobutton" id="70053">
					<include content="Bald_PlaybackButton"><param name="icon">$VAR[PlayerControlsRepeatImageVar]</param></include>
					<onleft>70052</onleft>
					<onright>70054</onright>
					<onup>87</onup>
					<ondown>noop</ondown>
					<onclick>PlayerControl(Repeat)</onclick>
					<visible>![MusicPlayer.Content(LiveTV) | MusicPartyMode.Enabled]</visible>
				</control>
				<control type="radiobutton" id="70054">
					<include content="Bald_PlaybackToggle">
						<param name="icon">osd/fullscreen/buttons/random-off.png</param>
						<param name="on">osd/fullscreen/buttons/random-on.png</param>
					</include>
					<selected>Playlist.IsRandom</selected>
					<visible>![MusicPlayer.Content(LiveTV) | MusicPartyMode.Enabled]</visible>
					<onclick>PlayerControl(Random)</onclick>
				</control>
				<control type="radiobutton" id="70055">
					<include content="Bald_PlaybackButton"><param name="icon">osd/fullscreen/buttons/settings-subtitle.png</param></include>
					<onclick>Close</onclick>
					<onclick condition="!String.IsEmpty(Skin.String(LyricScript_Path))">RunScript($INFO[Skin.String(LyricScript_Path)])</onclick>
					<onclick condition="String.IsEmpty(Skin.String(LyricScript_Path))">Skin.SetAddon(LyricScript_Path,xbmc.python.lyrics)</onclick>
					<onclick condition="String.IsEmpty(Skin.String(LyricScript_Path))">Close</onclick>
					<onclick condition="String.IsEmpty(Skin.String(LyricScript_Path))">RunScript($INFO[Skin.String(LyricScript_Path)])</onclick>
				</control>
				<control type="radiobutton" id="70048">
					<include content="Bald_PlaybackButton"><param name="icon">osd/fullscreen/buttons/settings.png</param></include>
					<onclick>SetProperty(settingsdialog_content,musicsettings,home)</onclick>
					<onclick>SetProperty(settingsdialog_header,$LOCALIZE[5],home)</onclick>
					<onclick>ActivateWindow(1101)</onclick>
				</control>
			</control>
		</control>
		<!-- Seek row: the hidden button 87 takes Up from the buttons; the sliders are mouse seek targets over the seek
		     dialog's track (Estuary's duplicated navigation tags are kept as they were). -->
		<control type="group">
			<include>Bald_PlaybackAnimWindow</include>
			<control type="button" id="87">
				<include>HiddenObject</include>
				<onup>200</onup>
				<ondown>200</ondown>
				<onleft>StepBack</onleft>
				<onright>StepForward</onright>
			</control>
			<include>Bald_PlaybackSeekFocus</include>
			<control type="slider">
				<include>Bald_PlaybackSeekArea</include>
				<onup>8010</onup>
				<ondown>650</ondown>
				<info>Player.Progress</info>
				<onup>201</onup>
				<ondown>200</ondown>
				<visible>Player.SeekEnabled + !MusicPlayer.Content(LiveTV)</visible>
				<action>seek</action>
			</control>
			<control type="slider">
				<include>Bald_PlaybackSeekArea</include>
				<onup>8010</onup>
				<ondown>650</ondown>
				<info>PVR.TimeshiftProgressPlayPos</info>
				<onup>201</onup>
				<ondown>200</ondown>
				<action>pvr.seek</action>
				<visible>Player.SeekEnabled + MusicPlayer.Content(LiveTV)</visible>
			</control>
		</control>
	</controls>
</window>
