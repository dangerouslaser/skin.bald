<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald Live TV Providers (TVProviders, RadioProviders). Started from Kodi 22 Estuary's MyPVRProviders.xml
     (Team Kodi, GPL-2.0-or-later); Kodi's ids are kept: view 50, channel groups 28, sort 3 and 4, header labels
     29 and 30, menucontrol 9000. -->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<views>50</views>
	<menucontrol>9000</menucontrol>
	<include>Bald_PVRAnimWindow</include>
	<controls>
		<include>Bald_PVRBackground</include>
		<control type="group">
			<include>Bald_PVRInfoDim</include>
			<include content="Bald_PVRWindowChrome">
				<param name="title">$LOCALIZE[19334]</param>
				<param name="section">$VAR[Bald_PVRArea]$INFO[Control.GetLabel(29), · ]</param>
				<param name="hint">$LOCALIZE[31666]</param>
			</include>
			<include content="Bald_PVRList">
				<include>Bald_PVRItemLayouts</include>
			</include>
			<include content="Bald_PVROptions">
				<include>Bald_PVRSortOptions</include>
				<include>Bald_PVRAreaOptions</include>
			</include>
		</control>
		<include>Bald_PVRNativeLabels</include>
	</controls>
</window>
