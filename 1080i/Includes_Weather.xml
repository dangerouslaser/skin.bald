	<include name="WeatherMapItem">
		<control type="group" id="700$PARAM[item_id]">
			<height>1110</height>
			<visible>Weather.IsFetched + !String.IsEmpty(Weather.Data(Map.$PARAM[item_id].Area)) + !String.IsEmpty(Weather.Data(Map.IsFetched))</visible>
			<centerleft>50%</centerleft>
			<width>1920</width>
			<control type="button" id="700$PARAM[item_id]0">
				<left>50</left>
				<top>100</top>
				<width>1820</width>
				<height>920</height>
				<onup>$PARAM[onup_id]</onup>
				<ondown>$PARAM[ondown_id]</ondown>
			</control>
			<control type="image" id="700$PARAM[item_id]1">
				<left>50</left>
				<top>100</top>
				<width>1820</width>
				<height>920</height>
				<texture>dialogs/dialog-bg-nobo.png</texture>
