<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- Weather includes for MyWeather.xml, from Kodi 22 Estuary's Includes_Home.xml (GPL-2.0-or-later, see
	     LICENSE-Estuary.txt). Estuary's Home widget includes that shared the file were removed with Estuary's Home.
	     Restyled for Bald (docs/NOTES.md, "Media windows restyle"): forecast rows are captioned Bald rows of
	     forecast cards, and the maps sit on the safe margin. Item content and ids are Estuary's. -->
	<!-- Row caption, shown while its panel has items (or is still loading). -->
	<include name="CategoryLabel">
		<param name="visible">true</param>
		<param name="item_treshold">0</param>
		<definition>
			<control type="label" id="$PARAM[list_id]666">
				<left>Bald_SafeLeft</left>
				<top>0</top>
				<width>1200</width>
				<height>32</height>
				<aligny>center</aligny>
				<font>Bald_RowLabel</font>
				<textcolor>bald_ink60</textcolor>
				<label>$PARAM[label]</label>
				<visible>$PARAM[visible]</visible>
				<visible>Integer.IsGreater(Container($PARAM[list_id]).NumItems,$PARAM[item_treshold]) | [Container($PARAM[list_id]).IsUpdating + Integer.IsEqual(Container($PARAM[list_id]).NumItems,0)]</visible>
			</control>
		</definition>
	</include>
	<!-- One forecast row: caption and a horizontal panel of cards (Bald_WeatherCard), 400 px in the page. -->
	<include name="WeatherWidget">
		<param name="width">266</param>
		<definition>
			<control type="group">
				<height>400</height>
				<visible>$PARAM[visible]</visible>
				<include content="CategoryLabel">
					<param name="label">$PARAM[widget_header]</param>
					<param name="list_id" value="$PARAM[list_id]"/>
				</include>
				<control type="panel" id="$PARAM[list_id]">
					<left>76</left>
					<top>44</top>
					<right>76</right>
					<height>340</height>
					<include content="WidgetListCommon">
						<param name="list_id" value="$PARAM[list_id]"/>
					</include>
					<itemlayout width="$PARAM[width]" height="340">
						<include content="Bald_WeatherCard" />
					</itemlayout>
					<focusedlayout width="$PARAM[width]" height="340">
						<include content="Bald_WeatherCard">
							<param name="focused">true</param>
						</include>
					</focusedlayout>
					<include>$PARAM[content_include]</include>
				</control>
			</control>
		</definition>
	</include>
