			<control type="scrollbar" id="$PARAM[id]">
				<left>$PARAM[left]</left><top>$PARAM[top]</top><width>6</width><height>$PARAM[height]</height>
				<orientation>vertical</orientation><showonepage>false</showonepage>
				<texturesliderbackground colordiffuse="bald_ink10">bald/white.png</texturesliderbackground>
				<texturesliderbar colordiffuse="bald_ink34">bald/white.png</texturesliderbar>
				<texturesliderbarfocus colordiffuse="bald_accent">bald/white.png</texturesliderbarfocus>
				<textureslidernib /><textureslidernibfocus />
				<onleft>$PARAM[onleft]</onleft><onright>$PARAM[onright]</onright><onup>$PARAM[id]</onup><ondown>$PARAM[id]</ondown>
			</control>
		</definition>
	</include>
	<!-- A settings row inside a manager (Bald Settings' row at the manager's column width). -->
	<include name="Bald_PVRManagerRow">
		<param name="width">700</param>
		<definition>
			<include content="Bald_ConfigureButton"><param name="width">$PARAM[width]</param></include>
			<alttexturefocus border="12,0,0,0" colordiffuse="bald_accent">bald/menu_dot.png</alttexturefocus>
			<alttexturenofocus />
		</definition>
	</include>
	<!-- The channel manager's EPG source spinner: the row with Bald Settings' chevrons. -->
	<include name="Bald_PVRManagerSpinner">
		<param name="width">700</param>
		<definition>
			<include content="Bald_ConfigureButton"><param name="width">$PARAM[width]</param></include>
			<spinwidth>16</spinwidth><spinheight>16</spinheight>
			<textureup colordiffuse="bald_ink28">bald/chevron.png</textureup>
			<textureupfocus colordiffuse="bald_ink">bald/chevron.png</textureupfocus>
			<textureupdisabled colordiffuse="bald_ink10">bald/chevron.png</textureupdisabled>
			<texturedown flipx="true" colordiffuse="bald_ink28">bald/chevron.png</texturedown>
			<texturedownfocus flipx="true" colordiffuse="bald_ink">bald/chevron.png</texturedownfocus>
			<texturedowndisabled flipx="true" colordiffuse="bald_ink10">bald/chevron.png</texturedowndisabled>
		</definition>
	</include>
	<!-- A group heading inside a manager column. -->
	<include name="Bald_PVRManagerHeading">
		<param name="id" />
		<param name="label" />
		<param name="width">700</param>
		<definition>
			<control type="label" id="$PARAM[id]"><width>$PARAM[width]</width><height>44</height><textoffsetx>26</textoffsetx><aligny>center</aligny><font>Bald_Section</font><textcolor>bald_ink60</textcolor><label>$PARAM[label]</label></control>
		</definition>
	</include>
</includes>
