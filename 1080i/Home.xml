<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald Home (milestones 2 and 3). Layout from docs/SPEC.md section 5.1, motion from section 4.
     State and variables are documented in Includes_Bald_Home.xml; timers in Timers.xml. -->
<window>
	<defaultcontrol always="true">9101</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<!-- Build the Home rows (Skin Variables, shortcuts/skinvariables-generator.json). It hashes these arguments, its
	     config (with the generator's build version) and the current output, and returns at once when none changed;
	     after writing it reloads the skin. So it builds on first run, after a skin update that changed the generator,
	     and after the widget editor or Home Screens closes (Custom_1116 and 1117 stamp Bald.WidgetsStamp).
	     Not before the hubs migration has run (docs/NOTES.md, Home hubs): until Bald.HubsMigrated is set, Home starts
	     it instead (unless Startup.xml already has, Bald.HubsMigrating), and the script builds when it has written the
	     hubs list. Startup does not run on a live skin update or ReloadSkin, so Home must be able to start it too. -->
	<!-- Startup does not run on a skin switch or ReloadSkin, so Home also turns mouse input off. -->
	<onload condition="System.GetBool(input.enablemouse)">RunScript(skin.bald,mouse)</onload>
	<onload condition="String.IsEmpty(Skin.String(Bald.HubsMigrated)) + String.IsEmpty(Window(home).Property(Bald.HubsMigrating))">SetProperty(Bald.HubsMigrating,1,home)</onload>
	<onload condition="String.IsEmpty(Skin.String(Bald.HubsMigrated)) + String.IsEmpty(Window(home).Property(Bald.HubsMigrating))">RunScript(skin.bald,hubs)</onload>
	<onload condition="!String.IsEmpty(Skin.String(Bald.HubsMigrated))">RunScript(script.skinvariables,action=buildtemplate,lastbuildtime=$INFO[Skin.String(Bald.WidgetsStamp)])</onload>
	<!-- Window properties survive ReloadSkin and returning from other windows; start clean every load, except when
	     returning to the menu entry Home was left from (Bald_ReturningToMenu), which keeps the state it was left in.
	     Focus always starts on row 1 (defaultcontrol always), unless an onload below moves it. -->
	<onload condition="!$EXP[Bald_ReturningToMenu]">SetProperty(Bald.Row,9101,home)</onload>
	<onload condition="!$EXP[Bald_ReturningToMenu]">SetProperty(Bald.Row.home,9101,home)</onload>
	<onload condition="!$EXP[Bald_ReturningToMenu]">SetProperty(Bald.Row.livetv,9051,home)</onload>
	<onload condition="!$EXP[Bald_ReturningToMenu]">SetProperty(Bald.Row.hub1,9201,home)</onload>
	<onload condition="!$EXP[Bald_ReturningToMenu]">SetProperty(Bald.Row.hub2,9301,home)</onload>
	<onload condition="!$EXP[Bald_ReturningToMenu]">SetProperty(Bald.Row.hub3,9401,home)</onload>
	<onload condition="!$EXP[Bald_ReturningToMenu]">SetProperty(Bald.Row.hub4,9501,home)</onload>
	<onload condition="!$EXP[Bald_ReturningToMenu]">SetProperty(Bald.Row.hub5,9601,home)</onload>
	<onload condition="!$EXP[Bald_ReturningToMenu]">SetProperty(Bald.Row.hub6,9701,home)</onload>
	<onload condition="!$EXP[Bald_ReturningToMenu]">SetProperty(Bald.Row.hub7,9801,home)</onload>
	<onload condition="!$EXP[Bald_ReturningToMenu]">SetProperty(Bald.Row.hub8,9901,home)</onload>
	<onload condition="!$EXP[Bald_ReturningToMenu]">SetProperty(Bald.Screen,home,home)</onload>
	<!-- The art frame's shape follows the displayed row's style (Bald_PosterRow). -->
	<onload condition="!$EXP[Bald_ReturningToMenu]">SetProperty(Bald.RowStyle,$VAR[Bald_RowStyle_home],home)</onload>
	<!-- Background: TMDb Helper's blurred fanart of the current row item (its image service only; no TMDB lookups),
	     watching the current row (TMDbHelper.WidgetContainer). The earlier color tint is switched off. -->
	<onload condition="Skin.HasSetting(TMDbHelper.EnableColors)">Skin.Reset(TMDbHelper.EnableColors)</onload>
	<onload condition="$EXP[Bald_HasTMDbHelper] + !Skin.HasSetting(TMDbHelper.EnableBlur)">Skin.SetBool(TMDbHelper.EnableBlur)</onload>
	<onload condition="$EXP[Bald_HasTMDbHelper]">Skin.SetBool(TMDbHelper.UseLocalWidgetContainer)</onload>
	<!-- Online ratings (Appearance > Ratings): TMDb Helper's ListItem monitor, which publishes the followed item's
	     ratings, runs only while the skin sets TMDbHelper.Service. On with the setting, off without it
	     (Includes_Bald_Ratings.xml, Bald_RatingsOnline). -->
	<onload condition="$EXP[Bald_RatingsOnline] + !Skin.HasSetting(TMDbHelper.Service)">Skin.SetBool(TMDbHelper.Service)</onload>
	<onload condition="!$EXP[Bald_RatingsOnline] + Skin.HasSetting(TMDbHelper.Service)">Skin.Reset(TMDbHelper.Service)</onload>
	<onload>SetProperty(TMDbHelper.Blur.SourceImage,Art(fanart)|Art(tvshow.fanart)|Art(thumb),home)</onload>
	<onload condition="!$EXP[Bald_ReturningToMenu]">SetProperty(TMDbHelper.WidgetContainer,9101,home)</onload>
	<onload condition="!$EXP[Bald_ReturningToMenu]">ClearProperty(Bald.Menu,home)</onload>
	<!-- No Home rows (the widget editor keeps one, but a row list can be emptied by hand): no current row, and focus
	     goes to the menu's Home entry, which opens the menu. Search's return below still takes precedence. -->
	<onload condition="!$EXP[Bald_HasRows_home]">ClearProperty(Bald.Row,home)</onload>
	<onload condition="!$EXP[Bald_HasRows_home]">SetFocus(9001)</onload>
	<onload condition="!String.IsEmpty(Window(home).Property(Bald.ReturnSearch))">SetProperty(Bald.Menu,1,home)</onload>
	<onload condition="!String.IsEmpty(Window(home).Property(Bald.ReturnSearch))">SetFocus(9005)</onload>
	<onload>ClearProperty(Bald.ReturnSearch,home)</onload>
	<include>Bald_ReturnToMenu</include>
	<!-- Startup splash (Bald_Splash). No current row until it lifts, so the first row, its art, clearlogo and caption
	     come in with their usual motion as it fades; until then keys go to 9198, which ignores them. -->
	<onload condition="$EXP[Bald_Preloading]">ClearProperty(Bald.Row,home)</onload>
	<onload condition="$EXP[Bald_Preloading]">SetFocus(9198)</onload>
	<include>Bald_RowStartReset</include>
	<onload>ClearProperty(Bald.InfoSwitch,home)</onload>
	<controls>
		<!-- Background: neutral field, with the darkened blurred fanart over it (see Bald_Backdrop). -->
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="bald_field">bald/white.png</texture>
		</control>
		<include content="Bald_Backdrop" />

		<!-- Everything drifts 2 px on a slow cycle while idle (burn-in guard). -->
		<control type="group">
			<!-- Home is the root: it is always returned to (in from the left) and always left deeper (out to the left). -->
			<include content="Bald_AnimWindowDepth"><param name="back_in">true</param></include>
			<animation type="Conditional" condition="$EXP[Bald_Idle]" pulse="true">
				<effect type="slide" start="0,0" end="2,0" time="23000" tween="sine" easing="inout" />
			</animation>
			<animation type="Conditional" condition="$EXP[Bald_Idle]" pulse="true">
				<effect type="slide" start="0,0" end="0,2" time="31000" tween="sine" easing="inout" />
			</animation>

			<!-- Art frame -->
			<control type="group">
				<include>Bald_AnimInfoFrame</include>
				<!-- Poster rows: up 63 px so the crop stays centred in the 576 px frame; undone while info is open. -->
				<include>Bald_AnimPosterArt</include>
				<left>Bald_SafeLeft</left>
				<top>120</top>
				<width>1248</width>
				<height>702</height>
				<control type="image">
					<texture colordiffuse="bald_placeholder">bald/white.png</texture>
				</control>
				<!-- Fanart: two parity layers (see Bald_ArtLayer). -->
				<include content="Bald_ArtLayer"><param name="visible">$EXP[Bald_EffectiveItemOdd]</param></include>
				<include content="Bald_ArtLayer"><param name="visible">!$EXP[Bald_EffectiveItemOdd]</param></include>
				<!-- Dialog art. Kodi evaluates <visible> and animation conditions without a window context
				     (CGUIControl::UpdateVisibility), so with a modal dialog over Home, Container(9101..9103) in them
				     resolves against the dialog and the parity layers above flip or blank. Textures and variables are
				     evaluated with the control's window (CGUIImage::UpdateInfo, CSkinVariableString::GetValue), so this
				     image, whose texture is the live $VAR[Bald_Fanart] and whose visibility needs no container, shows the
				     right art for as long as a dialog is up, and lingers while the layers settle after it closes. -->
				<control type="image">
					<width>1248</width>
					<height>702</height>
					<aspectratio>scale</aspectratio>
					<texture background="true">$VAR[Bald_Fanart]</texture>
					<visible>$EXP[Bald_DialogOver]</visible>
					<animation type="Hidden">
						<effect type="fade" start="100" end="0" time="250" delay="900" tween="sine" easing="inout" />
					</animation>
				</control>
				<!-- The current info item can change independently of the originating Home tile.
				     Keep its artwork inside this zoomed frame; fade it back to the tile on final close. -->
				<control type="group">
					<visible>$EXP[Bald_InfoOpen] + $EXP[Bald_InfoArtReady]</visible>
					<animation effect="fade" start="100" end="0" time="130" tween="sine" easing="inout">Hidden</animation>
					<control type="image">
						<width>1248</width>
						<height>702</height>
						<texture colordiffuse="bald_field">bald/white.png</texture>
					</control>
					<control type="image">
						<width>1248</width>
						<height>702</height>
						<aspectratio>scale</aspectratio>
						<fadetime>700</fadetime>
						<texture background="true">$INFO[Window(movieinformation).Property(Bald.Fanart)]</texture>
					</control>
				</control>
			</control>
			<!-- Scrim and clearlogo (not zoomed; inside the frame, so the masks never touch them). -->
			<control type="group">
				<include>Bald_AnimInfoFrame</include>
				<include>Bald_AnimInfoArtOverlay</include>
				<!-- Poster rows: up 126 px with the frame's bottom edge. -->
				<include>Bald_AnimPosterEdge</include>
				<left>Bald_SafeLeft</left>
				<top>120</top>
				<width>1248</width>
				<height>702</height>
				<control type="image">
					<texture>bald/scrim_logo.png</texture>
					<visible>$EXP[Bald_ShowClearlogo] + $EXP[Bald_EffectiveHasLogo]</visible>
					<animation type="Visible">
						<effect type="fade" start="0" end="100" time="500" tween="sine" easing="inout" />
					</animation>
					<animation type="Hidden">
						<effect type="fade" start="100" end="0" time="150" tween="sine" easing="inout" />
					</animation>
				</control>
				<!-- Clearlogo, per row and parity (see Bald_ArtLogo). -->
				<include>Bald_ConfiguredArtLogos</include>
				<!-- Dialog logo and scrim (e.g. under the context menu), for the same reason as the dialog art. The logo
				     texture is the live variable; the scrim cannot test for a logo without a container, so it always shows. -->
				<control type="group">
					<visible>$EXP[Bald_DialogOver] + !$EXP[Bald_InfoOpen]</visible>
					<animation type="Hidden">
						<effect type="fade" start="100" end="0" time="250" delay="900" tween="sine" easing="inout" />
					</animation>
					<control type="image">
						<texture>bald/scrim_logo.png</texture>
					</control>
					<control type="image">
						<left>52</left>
						<top>486</top>
						<width>560</width>
						<height>170</height>
						<aspectratio align="left" aligny="bottom">keep</aspectratio>
						<texture background="true">$VAR[Bald_Logo]</texture>
						<visible>$EXP[Bald_ShowClearlogo]</visible>
					</control>
				</control>
			</control>

			<!-- Frame masks: Kodi does not clip a zoom-animated texture, so bars cover the up-to-5% settle-zoom
			     overflow around the art frame (96,120 1248x702, or 1248x576 on a poster row). Each bar is a clipped window
			     onto the same background (grouplists clip ordinary textures), so the bars are invisible against it. -->
			<control type="group">
				<include>Bald_AnimInfoMasks</include>
				<include>Bald_HomeFrameMasks</include>
			</control>

			<!-- Clock and date -->
			<control type="group">
				<include>Bald_AnimInfoChrome</include>
				<left>Bald_RightColumn</left>
				<top>104</top>
				<width>384</width>
				<control type="label">
					<height>132</height>
					<font>Bald_Clock</font>
					<textcolor>bald_ink</textcolor>
					<label>$INFO[System.Time(hh:mm)]</label>
				</control>
				<control type="label">
					<top>144</top>
					<height>30</height>
					<font>Bald_Date</font>
					<textcolor>bald_ink70</textcolor>
					<label>$INFO[System.Date(DDDD)], $INFO[System.Date(MMMM D)]</label>
				</control>
			</control>

			<!-- Caption: out 180 and slide 40 px right as the menu or context menu opens; back 380 / 480 after 140 as it closes. -->
			<control type="group">
				<include>Bald_AnimInfoChrome</include>
				<visible>!$EXP[Bald_OverlayOpen]</visible>
				<animation type="Hidden">
					<effect type="fade" start="100" end="0" time="180" tween="sine" easing="inout" />
					<effect type="slide" start="0,0" end="40,0" time="200" tween="cubic" easing="out" />
				</animation>
				<animation type="Visible">
					<effect type="fade" start="0" end="100" time="380" delay="140" tween="sine" easing="inout" />
					<effect type="slide" start="40,0" end="0,0" time="480" delay="140" tween="cubic" easing="out" />
				</animation>
				<include>Bald_ConfiguredCaptions</include>
			</control>

			<!-- Menu: in fade 380 and slide 40 px over 480 after 120; out 160. -->
			<control type="group">
				<visible>$EXP[Bald_MenuOpen]</visible>
				<include>Bald_AnimMenuShows</include>
				<include content="Bald_MenuNote"><param name="text">$VAR[Bald_MenuPreviewNote]</param></include>
			</control>
			<control type="grouplist" id="9000">
				<left>Bald_RightColumn</left>
				<top>392</top>
				<width>420</width>
				<height>310</height>
				<orientation>vertical</orientation>
				<itemgap>0</itemgap>
				<scrolltime tween="cubic" easing="out">320</scrolltime>
				<!-- The ends do not wrap (with no onup/ondown the grouplist would join the last entry to the first). -->
				<onup>noop</onup>
				<ondown>noop</ondown>
				<visible allowhiddenfocus="true">$EXP[Bald_MenuOpen]</visible>
				<include>Bald_AnimMenuShows</include>
				<include content="Bald_HomeMenuButton"><param name="id">9001</param><param name="label">$LOCALIZE[10000]</param><param name="preview">home</param>
					<include content="Bald_HomeMenuScreen"><param name="screen">home</param></include>
				</include>
				<!-- The user's hubs, in their Home Screens order (Movies and TV shows by default); empty slots are hidden. -->
				<include content="Bald_HomeMenuHub"><param name="n">1</param></include>
				<include content="Bald_HomeMenuHub"><param name="n">2</param></include>
				<include content="Bald_HomeMenuHub"><param name="n">3</param></include>
				<include content="Bald_HomeMenuHub"><param name="n">4</param></include>
				<include content="Bald_HomeMenuHub"><param name="n">5</param></include>
				<include content="Bald_HomeMenuHub"><param name="n">6</param></include>
				<include content="Bald_HomeMenuHub"><param name="n">7</param></include>
				<include content="Bald_HomeMenuHub"><param name="n">8</param></include>
				<include>Bald_HomeMenuLiveTV</include>
				<include content="Bald_HomeMenuButton"><param name="id">9005</param><param name="label">$LOCALIZE[137]</param><param name="preview">search</param>
					<onclick>SetProperty(Bald.SearchOrigin,home,home)</onclick>
					<onclick condition="System.AddonIsEnabled(script.globalsearch)">RunScript(script.globalsearch)</onclick>
					<onclick condition="System.HasAddon(script.globalsearch) + !System.AddonIsEnabled(script.globalsearch)">EnableAddon(script.globalsearch)</onclick>
					<onclick condition="!System.HasAddon(script.globalsearch)">InstallAddon(script.globalsearch)</onclick>
				</include>
				<include content="Bald_HomeMenuButton"><param name="id">9006</param><param name="label">$LOCALIZE[5]</param><param name="preview">settings</param>
					<onclick>SetProperty(Bald.ReturnMenu,9006,home)</onclick>
					<onclick>ActivateWindow(settings)</onclick>
				</include>
			</control>

			<!-- Section line: accent dot, screen name, "Back for menu" hint. -->
			<control type="grouplist">
				<include>Bald_AnimInfoChrome</include>
				<left>Bald_RightColumn</left>
				<top>966</top>
				<width>480</width>
				<height>26</height>
				<orientation>horizontal</orientation>
				<itemgap>14</itemgap>
				<!-- Labels are top-aligned and offset so their baselines match (Instrument Sans ascender = font size). -->
				<usecontrolcoords>true</usecontrolcoords>
				<include>Bald_AnimMenuHides</include>
				<animation type="Conditional" condition="$EXP[Bald_Idle]">
					<effect type="fade" start="100" end="45" time="600" tween="sine" easing="inout" />
				</animation>
				<control type="group">
					<width>8</width>
					<control type="image">
						<top>10</top>
						<width>8</width>
						<height>8</height>
						<texture colordiffuse="bald_accent">bald/dot.png</texture>
					</control>
				</control>
				<control type="label">
					<width>auto</width>
					<height>26</height>
					<aligny>top</aligny>
					<font>Bald_Section</font>
					<textcolor>bald_ink</textcolor>
					<label>$VAR[Bald_ScreenLabel]</label>
				</control>
				<control type="label">
					<top>5</top>
					<width>auto</width>
					<height>26</height>
					<aligny>top</aligny>
					<font>Bald_Hint</font>
					<textcolor>bald_ink60</textcolor>
					<label>$LOCALIZE[31702]</label>
					<visible>!Skin.HasSetting(Bald.AutoHideMenuHint) | !String.IsEqual(Skin.String(Bald.MenuOpens),3)</visible>
					<animation type="Conditional" condition="$EXP[Bald_Idle]">
						<effect type="fade" start="100" end="0" time="600" tween="sine" easing="inout" />
					</animation>
				</control>
			</control>

			<!-- Configured rows of Home, Live TV and every hub (Bald_GeneratedRows). -->
			<include>Bald_GeneratedRows</include>

			<!-- Menu preview for screens without rows yet -->
			<control type="group">
				<include>Bald_AnimInfoChrome</include>
				<visible>$EXP[Bald_PreviewOther]</visible>
				<include>Bald_AnimRowSwap</include>
				<control type="label">
					<left>Bald_SafeLeft</left>
					<top>856</top>
					<width>1248</width>
					<height>26</height>
					<aligny>center</aligny>
					<font>Bald_RowLabel</font>
					<textcolor>bald_ink</textcolor>
					<label>$VAR[Bald_MenuPreviewLabel]</label>
				</control>
				<control type="label">
					<left>Bald_SafeLeft</left>
					<top>898</top>
					<width>1248</width>
					<height>30</height>
					<font>Bald_Date</font>
					<textcolor>bald_ink70</textcolor>
					<label>$VAR[Bald_MenuPreviewNote]</label>
				</control>
			</control>
		</control>

		<!-- Idle wake: the idle timer parks focus here so the first key press only wakes. -->
		<control type="button" id="9199">
			<width>1</width>
			<height>1</height>
			<texturefocus />
			<texturenofocus />
			<!-- The idle timer closed the menu, so the current row is displayed again. -->
			<onfocus>SetProperty(Bald.RowStyle,$VAR[Bald_ScreenRowStyle],home)</onfocus>
			<onup>SetFocus($VAR[Bald_RowFocus])</onup>
			<ondown>SetFocus($VAR[Bald_RowFocus])</ondown>
			<onleft>SetFocus($VAR[Bald_RowFocus])</onleft>
			<onright>SetFocus($VAR[Bald_RowFocus])</onright>
			<onclick>SetFocus($VAR[Bald_RowFocus])</onclick>
			<onback>SetFocus($VAR[Bald_RowFocus])</onback>
		</control>
		<!-- Startup splash. 9198 holds focus while it shows and swallows keys (Arctic Fuse 3's splash has no skip either);
		     if it somehow still has focus afterwards, any key goes on to 9195. The bald_preload timer lifts the splash
		     by focusing 9195, which moves on to Home's usual first focus. 9194 is the timer's "all rows loaded" marker
		     (Timers.xml cannot use $EXP). -->
		<control type="group" id="9194">
			<visible>$EXP[Bald_RowsLoaded]</visible>
		</control>
		<control type="button" id="9198">
			<width>1</width>
			<height>1</height>
			<texturefocus />
			<texturenofocus />
			<onup condition="!$EXP[Bald_Preloading]">SetFocus(9195)</onup>
			<ondown condition="!$EXP[Bald_Preloading]">SetFocus(9195)</ondown>
			<onleft condition="!$EXP[Bald_Preloading]">SetFocus(9195)</onleft>
			<onright condition="!$EXP[Bald_Preloading]">SetFocus(9195)</onright>
			<onclick condition="!$EXP[Bald_Preloading]">SetFocus(9195)</onclick>
			<onback condition="!$EXP[Bald_Preloading]">SetFocus(9195)</onback>
			<onback>noop</onback>
		</control>
		<control type="button" id="9195">
			<width>1</width>
			<height>1</height>
			<texturefocus />
			<texturenofocus />
			<onfocus>ClearProperty(Bald.Preload,home)</onfocus>
			<onfocus>CancelAlarm(bald_preload,silent)</onfocus>
			<!-- Home's default: row 1 (its onfocus makes it the current row), or the menu with no Home rows. -->
			<onfocus condition="$EXP[Bald_HasRows_home]">SetFocus(9101)</onfocus>
			<onfocus condition="!$EXP[Bald_HasRows_home]">SetFocus(9001)</onfocus>
		</control>
		<!-- Directional navigation accepts a control target more reliably than an ActivateWindow
		     built-in on Kodi's list edge. These invisible bridges own the secondary routes: each hub's open target
		     (9021-9028) and Live TV's guide (9029). -->
		<include content="Bald_HubBridge"><param name="n">1</param></include>
		<include content="Bald_HubBridge"><param name="n">2</param></include>
		<include content="Bald_HubBridge"><param name="n">3</param></include>
		<include content="Bald_HubBridge"><param name="n">4</param></include>
		<include content="Bald_HubBridge"><param name="n">5</param></include>
		<include content="Bald_HubBridge"><param name="n">6</param></include>
		<include content="Bald_HubBridge"><param name="n">7</param></include>
		<include content="Bald_HubBridge"><param name="n">8</param></include>
		<control type="button" id="9029">
			<width>1</width><height>1</height><texturefocus /><texturenofocus />
			<onfocus>SetProperty(Bald.ReturnMenu,9004,home)</onfocus>
			<onfocus>ActivateWindow(TVGuide)</onfocus>
		</control>
		<!-- Startup splash: the top layer while Bald.Preload is set; fades out 600 as it lifts. -->
		<include>Bald_Splash</include>
	</controls>
</window>
