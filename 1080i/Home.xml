<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald Home (milestones 2 and 3). Layout from docs/SPEC.md section 5.1, motion from section 4.
     State and variables are documented in Includes_Bald_Home.xml; timers in Timers.xml. -->
<window>
	<defaultcontrol always="true">9101</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<!-- Window properties survive ReloadSkin and returning from other windows; start clean every load.
	     Focus always starts on row 1 (defaultcontrol always). -->
	<onload>SetProperty(Bald.Row,9101,home)</onload>
	<!-- Fanart tint (docs/SPEC.md section 3) from TMDb Helper's image service: colors only (no TMDB lookups),
	     lightness forced to 7% and saturation to 35% for the field, watching the current row (TMDbHelper.WidgetContainer). -->
	<onload condition="!Skin.HasSetting(TMDbHelper.EnableColors)">Skin.SetBool(TMDbHelper.EnableColors)</onload>
	<onload condition="!String.IsEqual(Skin.String(TMDbHelper.Colors.Luminance),0.07)">Skin.SetString(TMDbHelper.Colors.Luminance,0.07)</onload>
	<onload condition="!String.IsEqual(Skin.String(TMDbHelper.Colors.Saturation),0.35)">Skin.SetString(TMDbHelper.Colors.Saturation,0.35)</onload>
	<onload>SetProperty(TMDbHelper.Colors.SourceImage,Art(fanart)|Art(tvshow.fanart)|Art(thumb),home)</onload>
	<onload>SetProperty(TMDbHelper.WidgetContainer,9101,home)</onload>
	<onload>ClearProperty(Bald.Menu,home)</onload>
	<onload>ClearProperty(Bald.Start9101,home)</onload>
	<onload>ClearProperty(Bald.Start9102,home)</onload>
	<onload>ClearProperty(Bald.Start9103,home)</onload>
	<controls>
		<!-- Background: neutral field, with the fanart-tinted field crossfading over it (two layers, see Bald_FieldLayer). -->
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="bald_field">bald/white.png</texture>
		</control>
		<include content="Bald_FieldLayer"><param name="slot">a</param></include>
		<include content="Bald_FieldLayer"><param name="slot">b</param></include>

		<!-- Everything drifts 2 px on a slow cycle while idle (burn-in guard). -->
		<control type="group">
			<animation type="Conditional" condition="$EXP[Bald_Idle]" pulse="true">
				<effect type="slide" start="0,0" end="2,0" time="23000" tween="sine" easing="inout" />
			</animation>
			<animation type="Conditional" condition="$EXP[Bald_Idle]" pulse="true">
				<effect type="slide" start="0,0" end="0,2" time="31000" tween="sine" easing="inout" />
			</animation>

			<!-- Art frame -->
			<control type="group">
				<left>96</left>
				<top>120</top>
				<width>1248</width>
				<height>702</height>
				<control type="image">
					<texture colordiffuse="bald_placeholder">bald/white.png</texture>
				</control>
				<!-- Fanart: two parity layers (see Bald_ArtLayer). -->
				<include content="Bald_ArtLayer"><param name="visible">$EXP[Bald_ItemOdd]</param></include>
				<include content="Bald_ArtLayer"><param name="visible">!$EXP[Bald_ItemOdd]</param></include>
			</control>
			<!-- Scrim and clearlogo (not zoomed; inside the frame, so the masks never touch them). -->
			<control type="group">
				<left>96</left>
				<top>120</top>
				<width>1248</width>
				<height>702</height>
				<control type="image">
					<texture>bald/scrim_logo.png</texture>
					<visible>$EXP[Bald_HasLogo]</visible>
					<animation type="Visible">
						<effect type="fade" start="0" end="100" time="500" tween="sine" easing="inout" />
					</animation>
					<animation type="Hidden">
						<effect type="fade" start="100" end="0" time="150" tween="sine" easing="inout" />
					</animation>
				</control>
				<!-- Clearlogo, per row and parity (see Bald_ArtLogo). -->
				<include content="Bald_ArtLogo"><param name="c">9101</param><param name="p">Odd</param></include>
				<include content="Bald_ArtLogo"><param name="c">9101</param><param name="p">Even</param></include>
				<include content="Bald_ArtLogo"><param name="c">9102</param><param name="p">Odd</param></include>
				<include content="Bald_ArtLogo"><param name="c">9102</param><param name="p">Even</param></include>
				<include content="Bald_ArtLogo"><param name="c">9103</param><param name="p">Odd</param></include>
				<include content="Bald_ArtLogo"><param name="c">9103</param><param name="p">Even</param></include>
			</control>

			<!-- Frame masks: Kodi does not clip a zoom-animated texture (a grouplist did not help), so field-colored
			     bars cover the up-to-5% settle-zoom overflow around the art frame (96,120 1248x702). They crossfade
			     with the background so they always match it. -->
			<include content="Bald_FieldMasks"><param name="color">bald_field</param></include>
			<include content="Bald_FieldMasks"><param name="color">$VAR[Bald_Fielda]</param><param name="visible">String.IsEqual(Window(home).Property(Bald.FieldSlot),a)</param></include>
			<include content="Bald_FieldMasks"><param name="color">$VAR[Bald_Fieldb]</param><param name="visible">String.IsEqual(Window(home).Property(Bald.FieldSlot),b)</param></include>

			<!-- Clock and date -->
			<control type="group">
				<left>1440</left>
				<top>104</top>
				<width>384</width>
				<control type="label">
					<height>132</height>
					<font>Bald_Clock</font>
					<textcolor>bald_ink</textcolor>
					<label>$INFO[System.Time(hh:mm)]</label>
				</control>
				<control type="label">
					<top>144</top>
					<height>30</height>
					<font>Bald_Date</font>
					<textcolor>bald_ink66</textcolor>
					<label>$INFO[System.Date(DDDD)], $INFO[System.Date(MMMM D)]</label>
				</control>
			</control>

			<!-- Caption: out 180 and slide 40 px right as the menu opens; back 380 / 480 after 140 as it closes. -->
			<control type="group">
				<visible>!$EXP[Bald_MenuOpen]</visible>
				<animation type="Hidden">
					<effect type="fade" start="100" end="0" time="180" tween="sine" easing="inout" />
					<effect type="slide" start="0,0" end="40,0" time="200" tween="cubic" easing="out" />
				</animation>
				<animation type="Visible">
					<effect type="fade" start="0" end="100" time="380" delay="140" tween="sine" easing="inout" />
					<effect type="slide" start="40,0" end="0,0" time="480" delay="140" tween="cubic" easing="out" />
				</animation>
				<include content="Bald_Caption"><param name="c">9101</param><param name="p">Odd</param></include>
				<include content="Bald_Caption"><param name="c">9101</param><param name="p">Even</param></include>
				<include content="Bald_Caption"><param name="c">9102</param><param name="p">Odd</param></include>
				<include content="Bald_Caption"><param name="c">9102</param><param name="p">Even</param></include>
				<include content="Bald_Caption"><param name="c">9103</param><param name="p">Odd</param></include>
				<include content="Bald_Caption"><param name="c">9103</param><param name="p">Even</param></include>
			</control>

			<!-- Menu: in fade 380 and slide 40 px over 480 after 120; out 160. -->
			<control type="group">
				<visible>$EXP[Bald_MenuOpen]</visible>
				<include>Bald_AnimMenuShows</include>
				<control type="label">
					<left>1466</left>
					<top>714</top>
					<width>394</width>
					<height>120</height>
					<wrapmultiline>true</wrapmultiline>
					<aligny>top</aligny>
					<font>Bald_MenuNote</font>
					<textcolor>bald_ink60</textcolor>
					<label>$INFO[Container(9000).ListItem.Property(note)]</label>
				</control>
			</control>
			<control type="list" id="9000">
				<left>1440</left>
				<top>392</top>
				<width>420</width>
				<height>310</height>
				<orientation>vertical</orientation>
				<scrolltime>0</scrolltime>
				<visible allowhiddenfocus="true">$EXP[Bald_MenuOpen]</visible>
				<include>Bald_AnimMenuShows</include>
				<!-- Opening: set state and count opens (the hint hides after three). Checked high to low so one open adds one. -->
				<onfocus>SetProperty(Bald.Menu,1,home)</onfocus>
				<onfocus condition="String.IsEqual(Skin.String(Bald.MenuOpens),2)">Skin.SetString(Bald.MenuOpens,3)</onfocus>
				<onfocus condition="String.IsEqual(Skin.String(Bald.MenuOpens),1)">Skin.SetString(Bald.MenuOpens,2)</onfocus>
				<onfocus condition="String.IsEmpty(Skin.String(Bald.MenuOpens))">Skin.SetString(Bald.MenuOpens,1)</onfocus>
				<!-- Left or Select enters a screen; screens without rows stay in the menu. Back closes without switching. -->
				<onleft condition="String.IsEqual(Container(9000).ListItem.Property(id),home)">ClearProperty(Bald.Menu,home)</onleft>
				<onleft condition="String.IsEqual(Container(9000).ListItem.Property(id),home)">SetFocus($INFO[Window(home).Property(Bald.Row)])</onleft>
				<onback>ClearProperty(Bald.Menu,home)</onback>
				<onback>SetFocus($INFO[Window(home).Property(Bald.Row)])</onback>
				<onright>noop</onright>
				<!-- No wrapping at either end. -->
				<onup>noop</onup>
				<ondown>noop</ondown>
				<itemlayout width="420" height="62">
					<include>Bald_MenuItem</include>
					<control type="label">
						<left>20</left>
						<width>400</width>
						<height>56</height>
						<aligny>center</aligny>
						<font>Bald_MenuItem</font>
						<textcolor>bald_ink34</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout width="420" height="62">
					<include>Bald_MenuItem</include>
					<control type="label">
						<left>26</left>
						<width>394</width>
						<height>56</height>
						<aligny>center</aligny>
						<font>Bald_MenuItem</font>
						<textcolor>bald_ink</textcolor>
						<label>$INFO[ListItem.Label]</label>
						<animation type="Focus">
							<effect type="fade" start="34" end="100" time="240" tween="sine" easing="inout" />
							<effect type="slide" start="-6,0" end="0,0" time="320" tween="cubic" easing="out" />
						</animation>
					</control>
				</focusedlayout>
				<content>
					<item>
						<label>Home</label>
						<property name="id">home</property>
						<property name="note">Recently added movies, Continue watching, Next up</property>
						<onclick>ClearProperty(Bald.Menu,home)</onclick>
						<onclick>SetFocus($INFO[Window(home).Property(Bald.Row)])</onclick>
					</item>
					<item>
						<label>Movies</label>
						<property name="id">movies</property>
						<property name="note">Rows for this screen arrive in a later build.</property>
						<onclick>noop</onclick>
					</item>
					<item>
						<label>TV shows</label>
						<property name="id">tvshows</property>
						<property name="note">Rows for this screen arrive in a later build.</property>
						<onclick>noop</onclick>
					</item>
					<item>
						<label>Live TV</label>
						<property name="id">livetv</property>
						<property name="note">Select to open the guide.</property>
						<onclick>noop</onclick>
					</item>
					<item>
						<label>Search</label>
						<property name="id">search</property>
						<property name="note">Select to search your library.</property>
						<onclick>noop</onclick>
					</item>
				</content>
			</control>

			<!-- Section line: accent dot, screen name, "Back for menu" hint (hidden after three menu opens). -->
			<control type="grouplist">
				<left>1440</left>
				<top>966</top>
				<width>480</width>
				<height>26</height>
				<orientation>horizontal</orientation>
				<itemgap>14</itemgap>
				<!-- Labels are top-aligned and offset so their baselines match (Instrument Sans ascender = font size). -->
				<usecontrolcoords>true</usecontrolcoords>
				<include>Bald_AnimMenuHides</include>
				<animation type="Conditional" condition="$EXP[Bald_Idle]">
					<effect type="fade" start="100" end="45" time="600" tween="sine" easing="inout" />
				</animation>
				<control type="group">
					<width>8</width>
					<control type="image">
						<top>10</top>
						<width>8</width>
						<height>8</height>
						<texture colordiffuse="bald_accent">bald/dot.png</texture>
					</control>
				</control>
				<control type="label">
					<width>auto</width>
					<height>26</height>
					<aligny>top</aligny>
					<font>Bald_Section</font>
					<textcolor>bald_ink</textcolor>
					<label>Home</label>
				</control>
				<control type="label">
					<top>5</top>
					<width>auto</width>
					<height>26</height>
					<aligny>top</aligny>
					<font>Bald_Hint</font>
					<textcolor>bald_ink55</textcolor>
					<label>Back for menu</label>
					<visible>!String.IsEqual(Skin.String(Bald.MenuOpens),3)</visible>
					<animation type="Conditional" condition="$EXP[Bald_Idle]">
						<effect type="fade" start="100" end="0" time="600" tween="sine" easing="inout" />
					</animation>
				</control>
			</control>

			<!-- Rows (default configuration, docs/SPEC.md section 6) -->
			<include content="Bald_Row">
				<param name="id">9101</param>
				<param name="label">Recently added movies</param>
				<param name="index">1</param>
				<param name="up">SetFocus(9000,0,absolute)</param>
				<param name="down">9102</param>
				<content target="videos" limit="25">videodb://recentlyaddedmovies/</content>
			</include>
			<include content="Bald_Row">
				<param name="id">9102</param>
				<param name="label">Continue watching</param>
				<param name="index">2</param>
				<param name="up">9101</param>
				<param name="down">9103</param>
				<content target="videos" limit="15">special://skin/playlists/inprogress_movies.xsp</content>
				<content target="videos" limit="15">special://skin/playlists/inprogress_episodes.xsp</content>
			</include>
			<include content="Bald_Row">
				<param name="id">9103</param>
				<param name="label">Next up</param>
				<param name="index">3</param>
				<param name="up">9102</param>
				<content target="videos" limit="25">videodb://inprogresstvshows/</content>
			</include>

			<!-- Menu preview for screens without rows yet -->
			<control type="group">
				<visible>$EXP[Bald_PreviewOther]</visible>
				<include>Bald_AnimRowSwap</include>
				<control type="label">
					<left>96</left>
					<top>856</top>
					<width>1248</width>
					<height>26</height>
					<aligny>center</aligny>
					<font>Bald_RowLabel</font>
					<textcolor>bald_ink</textcolor>
					<label>$INFO[Container(9000).ListItem.Label]</label>
				</control>
				<control type="label">
					<left>96</left>
					<top>898</top>
					<width>1248</width>
					<height>30</height>
					<font>Bald_Date</font>
					<textcolor>bald_ink70</textcolor>
					<label>$INFO[Container(9000).ListItem.Property(note)]</label>
				</control>
			</control>
		</control>

		<!-- Idle wake: the idle timer parks focus here so the first key press only wakes. -->
		<control type="button" id="9199">
			<width>1</width>
			<height>1</height>
			<texturefocus />
			<texturenofocus />
			<onup>SetFocus($INFO[Window(home).Property(Bald.Row)])</onup>
			<ondown>SetFocus($INFO[Window(home).Property(Bald.Row)])</ondown>
			<onleft>SetFocus($INFO[Window(home).Property(Bald.Row)])</onleft>
			<onright>SetFocus($INFO[Window(home).Property(Bald.Row)])</onright>
			<onclick>SetFocus($INFO[Window(home).Property(Bald.Row)])</onclick>
			<onback>SetFocus($INFO[Window(home).Property(Bald.Row)])</onback>
		</control>
	</controls>
</window>
