<?xml version="1.0" encoding="UTF-8"?>
<!-- Bald Home (milestones 2 and 3). Layout from docs/SPEC.md section 5.1, motion from section 4.
     State and variables are documented in Includes_Bald_Home.xml; timers in Timers.xml. -->
<window>
	<defaultcontrol always="true">9101</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<!-- Window properties survive ReloadSkin and returning from other windows; start clean every load.
	     Focus always starts on row 1 (defaultcontrol always). -->
	<onload>SetProperty(Bald.Row,9101,home)</onload>
	<onload>SetProperty(Bald.Row.home,9101,home)</onload>
	<onload>SetProperty(Bald.Row.movies,9201,home)</onload>
	<onload>SetProperty(Bald.Row.tvshows,9301,home)</onload>
	<onload>SetProperty(Bald.Screen,home,home)</onload>
	<!-- Background: TMDb Helper's blurred fanart of the current row item (its image service only; no TMDB lookups),
	     watching the current row (TMDbHelper.WidgetContainer). The earlier color tint is switched off. -->
	<onload condition="Skin.HasSetting(TMDbHelper.EnableColors)">Skin.Reset(TMDbHelper.EnableColors)</onload>
	<onload condition="System.HasAddon(plugin.video.themoviedb.helper) + !Skin.HasSetting(TMDbHelper.EnableBlur)">Skin.SetBool(TMDbHelper.EnableBlur)</onload>
	<onload condition="System.HasAddon(plugin.video.themoviedb.helper)">Skin.SetBool(TMDbHelper.UseLocalWidgetContainer)</onload>
	<onload>SetProperty(TMDbHelper.Blur.SourceImage,Art(fanart)|Art(tvshow.fanart)|Art(thumb),home)</onload>
	<onload>SetProperty(TMDbHelper.WidgetContainer,9101,home)</onload>
	<onload>ClearProperty(Bald.Menu,home)</onload>
	<onload condition="!String.IsEmpty(Window(home).Property(Bald.ReturnSearch))">SetProperty(Bald.Menu,1,home)</onload>
	<onload condition="!String.IsEmpty(Window(home).Property(Bald.ReturnSearch))">SetFocus(9005)</onload>
	<onload>ClearProperty(Bald.ReturnSearch,home)</onload>
	<onload>ClearProperty(Bald.Start9101,home)</onload>
	<onload>ClearProperty(Bald.Start9102,home)</onload>
	<onload>ClearProperty(Bald.Start9103,home)</onload>
	<onload>ClearProperty(Bald.InfoSwitch,home)</onload>
	<controls>
		<!-- Background: neutral field, with the darkened blurred fanart over it (see Bald_Backdrop). -->
		<control type="image">
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="bald_field">bald/white.png</texture>
		</control>
		<include content="Bald_Backdrop" />

		<!-- Everything drifts 2 px on a slow cycle while idle (burn-in guard). -->
		<control type="group">
			<animation type="Conditional" condition="$EXP[Bald_Idle]" pulse="true">
				<effect type="slide" start="0,0" end="2,0" time="23000" tween="sine" easing="inout" />
			</animation>
			<animation type="Conditional" condition="$EXP[Bald_Idle]" pulse="true">
				<effect type="slide" start="0,0" end="0,2" time="31000" tween="sine" easing="inout" />
			</animation>

			<!-- Art frame -->
			<control type="group">
				<include>Bald_AnimInfoFrame</include>
				<left>96</left>
				<top>120</top>
				<width>1248</width>
				<height>702</height>
				<control type="image">
					<texture colordiffuse="bald_placeholder">bald/white.png</texture>
				</control>
				<!-- Fanart: two parity layers (see Bald_ArtLayer). -->
				<include content="Bald_ArtLayer"><param name="visible">$EXP[Bald_EffectiveItemOdd]</param></include>
				<include content="Bald_ArtLayer"><param name="visible">!$EXP[Bald_EffectiveItemOdd]</param></include>
				<!-- Dialog art. Kodi evaluates <visible> and animation conditions without a window context
				     (CGUIControl::UpdateVisibility), so with a modal dialog over Home, Container(9101..9103) in them
				     resolves against the dialog and the parity layers above flip or blank. Textures and variables are
				     evaluated with the control's window (CGUIImage::UpdateInfo, CSkinVariableString::GetValue), so this
				     image, whose texture is the live $VAR[Bald_Fanart] and whose visibility needs no container, shows the
				     right art for as long as a dialog is up, and lingers while the layers settle after it closes. -->
				<control type="image">
					<width>1248</width>
					<height>702</height>
					<aspectratio>scale</aspectratio>
					<texture background="true">$VAR[Bald_Fanart]</texture>
					<visible>$EXP[Bald_DialogOver]</visible>
					<animation type="Hidden">
						<effect type="fade" start="100" end="0" time="250" delay="900" tween="sine" easing="inout" />
					</animation>
				</control>
				<!-- The current info item can change independently of the originating Home tile.
				     Keep its artwork inside this zoomed frame; fade it back to the tile on final close. -->
				<control type="group">
					<visible>$EXP[Bald_InfoOpen] + $EXP[Bald_InfoArtReady]</visible>
					<animation effect="fade" start="100" end="0" time="130" tween="sine" easing="inout">Hidden</animation>
					<control type="image">
						<width>1248</width>
						<height>702</height>
						<texture colordiffuse="bald_field">bald/white.png</texture>
					</control>
					<control type="image">
						<width>1248</width>
						<height>702</height>
						<aspectratio>scale</aspectratio>
						<fadetime>700</fadetime>
						<texture background="true">$INFO[Window(movieinformation).Property(Bald.Fanart)]</texture>
					</control>
				</control>
			</control>
			<!-- Scrim and clearlogo (not zoomed; inside the frame, so the masks never touch them). -->
			<control type="group">
				<include>Bald_AnimInfoFrame</include>
				<include>Bald_AnimInfoArtOverlay</include>
				<left>96</left>
				<top>120</top>
				<width>1248</width>
				<height>702</height>
				<control type="image">
					<texture>bald/scrim_logo.png</texture>
					<visible>!Skin.HasSetting(Bald.HideClearlogo) + $EXP[Bald_EffectiveHasLogo]</visible>
					<animation type="Visible">
						<effect type="fade" start="0" end="100" time="500" tween="sine" easing="inout" />
					</animation>
					<animation type="Hidden">
						<effect type="fade" start="100" end="0" time="150" tween="sine" easing="inout" />
					</animation>
				</control>
				<!-- Clearlogo, per row and parity (see Bald_ArtLogo). -->
				<include>Bald_ConfiguredArtLogos</include>
				<!-- Dialog logo and scrim (e.g. under the context menu), for the same reason as the dialog art. The logo
				     texture is the live variable; the scrim cannot test for a logo without a container, so it always shows. -->
				<control type="group">
					<visible>$EXP[Bald_DialogOver] + !$EXP[Bald_InfoOpen]</visible>
					<animation type="Hidden">
						<effect type="fade" start="100" end="0" time="250" delay="900" tween="sine" easing="inout" />
					</animation>
					<control type="image">
						<texture>bald/scrim_logo.png</texture>
					</control>
					<control type="image">
						<left>52</left>
						<top>486</top>
						<width>560</width>
						<height>170</height>
						<aspectratio align="left" aligny="bottom">keep</aspectratio>
						<texture background="true">$VAR[Bald_Logo]</texture>
					</control>
				</control>
			</control>

			<!-- Frame masks: Kodi does not clip a zoom-animated texture, so four bars cover the up-to-5% settle-zoom
			     overflow around the art frame (96,120 1248x702). Each bar is a clipped window onto the same background
			     (grouplists clip ordinary textures), so the bars are invisible against it. -->
<control type="group">
				<include>Bald_AnimInfoMasks</include>
				<include>Bald_ArtFrameMasks</include>
			</control>

			<!-- Clock and date -->
			<control type="group">
				<include>Bald_AnimInfoChrome</include>
				<left>1440</left>
				<top>104</top>
				<width>384</width>
				<control type="label">
					<height>132</height>
					<font>Bald_Clock</font>
					<textcolor>bald_ink</textcolor>
					<label>$INFO[System.Time(hh:mm)]</label>
				</control>
				<control type="label">
					<top>144</top>
					<height>30</height>
					<font>Bald_Date</font>
					<textcolor>bald_ink66</textcolor>
					<label>$INFO[System.Date(DDDD)], $INFO[System.Date(MMMM D)]</label>
				</control>
			</control>

			<!-- Caption: out 180 and slide 40 px right as the menu or context menu opens; back 380 / 480 after 140 as it closes. -->
			<control type="group">
				<include>Bald_AnimInfoChrome</include>
				<visible>!$EXP[Bald_OverlayOpen]</visible>
				<animation type="Hidden">
					<effect type="fade" start="100" end="0" time="180" tween="sine" easing="inout" />
					<effect type="slide" start="0,0" end="40,0" time="200" tween="cubic" easing="out" />
				</animation>
				<animation type="Visible">
					<effect type="fade" start="0" end="100" time="380" delay="140" tween="sine" easing="inout" />
					<effect type="slide" start="40,0" end="0,0" time="480" delay="140" tween="cubic" easing="out" />
				</animation>
				<include>Bald_ConfiguredCaptions</include>
			</control>

			<!-- Menu: in fade 380 and slide 40 px over 480 after 120; out 160. -->
			<control type="group">
				<visible>$EXP[Bald_MenuOpen]</visible>
				<include>Bald_AnimMenuShows</include>
				<include content="Bald_MenuNote"><param name="text">$VAR[Bald_MenuPreviewNote]</param></include>
			</control>
			<control type="grouplist" id="9000">
				<left>1440</left>
				<top>392</top>
				<width>420</width>
				<height>310</height>
				<orientation>vertical</orientation>
				<itemgap>0</itemgap>
				<scrolltime tween="cubic" easing="out">320</scrolltime>
				<visible allowhiddenfocus="true">$EXP[Bald_MenuOpen]</visible>
				<include>Bald_AnimMenuShows</include>
				<include content="Bald_HomeMenuButton"><param name="id">9001</param><param name="y">0</param><param name="label">Home</param><param name="preview">home</param><param name="widget">home</param><param name="enter1">SetProperty(Bald.Screen,home,home)</param><param name="enter2">SetProperty(Bald.Row,$INFO[Window(home).Property(Bald.Row.home)],home)</param><param name="enter3">ClearProperty(Bald.Menu,home)</param><param name="enter4">SetFocus($INFO[Window(home).Property(Bald.Row.home)])</param><param name="down1">9002</param><param name="down_preview1">movies</param><param name="down_widget1">movies</param><param name="down_condition1">Skin.HasSetting(Bald.Screen.Movies)</param><param name="down2">9003</param><param name="down_preview2">tvshows</param><param name="down_widget2">tvshows</param><param name="down_condition2">!Skin.HasSetting(Bald.Screen.Movies) + Skin.HasSetting(Bald.Screen.TVShows)</param><param name="down3">9004</param><param name="down_preview3">livetv</param><param name="down_condition3">!Skin.HasSetting(Bald.Screen.Movies) + !Skin.HasSetting(Bald.Screen.TVShows) + !Skin.HasSetting(Bald.Screen.HideLiveTV)</param><param name="down4">9005</param><param name="down_preview4">search</param><param name="down_condition4">!Skin.HasSetting(Bald.Screen.Movies) + !Skin.HasSetting(Bald.Screen.TVShows) + Skin.HasSetting(Bald.Screen.HideLiveTV)</param></include>
				<include content="Bald_HomeMenuButton"><param name="id">9002</param><param name="y">62</param><param name="label">Movies</param><param name="suffix">  ›</param><param name="preview">movies</param><param name="widget">movies</param><param name="visible">Skin.HasSetting(Bald.Screen.Movies)</param><param name="library">true</param><param name="enter1">SetProperty(Bald.Screen,movies,home)</param><param name="enter2">SetProperty(Bald.Row,$INFO[Window(home).Property(Bald.Row.movies)],home)</param><param name="enter3">ClearProperty(Bald.Menu,home)</param><param name="enter4">SetFocus($INFO[Window(home).Property(Bald.Row.movies)])</param><param name="right">9197</param><param name="up1">9001</param><param name="up_preview1">home</param><param name="up_widget1">home</param><param name="down1">9003</param><param name="down_preview1">tvshows</param><param name="down_widget1">tvshows</param><param name="down_condition1">Skin.HasSetting(Bald.Screen.TVShows)</param><param name="down2">9004</param><param name="down_preview2">livetv</param><param name="down_condition2">!Skin.HasSetting(Bald.Screen.TVShows) + !Skin.HasSetting(Bald.Screen.HideLiveTV)</param><param name="down3">9005</param><param name="down_preview3">search</param><param name="down_condition3">!Skin.HasSetting(Bald.Screen.TVShows) + Skin.HasSetting(Bald.Screen.HideLiveTV)</param></include>
				<include content="Bald_HomeMenuButton"><param name="id">9003</param><param name="y">124</param><param name="label">TV shows</param><param name="suffix">  ›</param><param name="preview">tvshows</param><param name="widget">tvshows</param><param name="visible">Skin.HasSetting(Bald.Screen.TVShows)</param><param name="library">true</param><param name="enter1">SetProperty(Bald.Screen,tvshows,home)</param><param name="enter2">SetProperty(Bald.Row,$INFO[Window(home).Property(Bald.Row.tvshows)],home)</param><param name="enter3">ClearProperty(Bald.Menu,home)</param><param name="enter4">SetFocus($INFO[Window(home).Property(Bald.Row.tvshows)])</param><param name="right">9196</param><param name="up1">9002</param><param name="up_preview1">movies</param><param name="up_widget1">movies</param><param name="up_condition1">Skin.HasSetting(Bald.Screen.Movies)</param><param name="up2">9001</param><param name="up_preview2">home</param><param name="up_widget2">home</param><param name="up_condition2">!Skin.HasSetting(Bald.Screen.Movies)</param><param name="down1">9004</param><param name="down_preview1">livetv</param><param name="down_condition1">!Skin.HasSetting(Bald.Screen.HideLiveTV)</param><param name="down2">9005</param><param name="down_preview2">search</param><param name="down_condition2">Skin.HasSetting(Bald.Screen.HideLiveTV)</param></include>
				<include content="Bald_HomeMenuButton"><param name="id">9004</param><param name="y">186</param><param name="label">Live TV</param><param name="preview">livetv</param><param name="visible">!Skin.HasSetting(Bald.Screen.HideLiveTV)</param><param name="enter1">ActivateWindow(TVGuide)</param><param name="up1">9003</param><param name="up_preview1">tvshows</param><param name="up_widget1">tvshows</param><param name="up_condition1">Skin.HasSetting(Bald.Screen.TVShows)</param><param name="up2">9002</param><param name="up_preview2">movies</param><param name="up_widget2">movies</param><param name="up_condition2">!Skin.HasSetting(Bald.Screen.TVShows) + Skin.HasSetting(Bald.Screen.Movies)</param><param name="up3">9001</param><param name="up_preview3">home</param><param name="up_widget3">home</param><param name="up_condition3">!Skin.HasSetting(Bald.Screen.TVShows) + !Skin.HasSetting(Bald.Screen.Movies)</param><param name="down1">9005</param><param name="down_preview1">search</param></include>
				<include content="Bald_HomeMenuButton"><param name="id">9005</param><param name="y">248</param><param name="label">Search</param><param name="preview">search</param><param name="enter1">SetProperty(Bald.SearchOrigin,home,home)</param><param name="enter2">RunScript(script.globalsearch)</param><param name="condition2">System.AddonIsEnabled(script.globalsearch)</param><param name="enter3">EnableAddon(script.globalsearch)</param><param name="condition3">System.HasAddon(script.globalsearch) + !System.AddonIsEnabled(script.globalsearch)</param><param name="enter4">InstallAddon(script.globalsearch)</param><param name="condition4">!System.HasAddon(script.globalsearch)</param><param name="up1">9004</param><param name="up_preview1">livetv</param><param name="up_condition1">!Skin.HasSetting(Bald.Screen.HideLiveTV)</param><param name="up2">9003</param><param name="up_preview2">tvshows</param><param name="up_widget2">tvshows</param><param name="up_condition2">Skin.HasSetting(Bald.Screen.HideLiveTV) + Skin.HasSetting(Bald.Screen.TVShows)</param><param name="up3">9002</param><param name="up_preview3">movies</param><param name="up_widget3">movies</param><param name="up_condition3">Skin.HasSetting(Bald.Screen.HideLiveTV) + !Skin.HasSetting(Bald.Screen.TVShows) + Skin.HasSetting(Bald.Screen.Movies)</param><param name="down1">9006</param><param name="down_preview1">settings</param></include>
				<include content="Bald_HomeMenuButton"><param name="id">9006</param><param name="y">310</param><param name="label">$LOCALIZE[5]</param><param name="preview">settings</param><param name="enter1">ActivateWindow(settings)</param><param name="up1">9005</param><param name="up_preview1">search</param></include>
			</control>

			<!-- Section line: accent dot, screen name, "Back for menu" hint. -->
			<control type="grouplist">
				<include>Bald_AnimInfoChrome</include>
				<left>1440</left>
				<top>966</top>
				<width>480</width>
				<height>26</height>
				<orientation>horizontal</orientation>
				<itemgap>14</itemgap>
				<!-- Labels are top-aligned and offset so their baselines match (Instrument Sans ascender = font size). -->
				<usecontrolcoords>true</usecontrolcoords>
				<include>Bald_AnimMenuHides</include>
				<animation type="Conditional" condition="$EXP[Bald_Idle]">
					<effect type="fade" start="100" end="45" time="600" tween="sine" easing="inout" />
				</animation>
				<control type="group">
					<width>8</width>
					<control type="image">
						<top>10</top>
						<width>8</width>
						<height>8</height>
						<texture colordiffuse="bald_accent">bald/dot.png</texture>
					</control>
				</control>
				<control type="label">
					<width>auto</width>
					<height>26</height>
					<aligny>top</aligny>
					<font>Bald_Section</font>
					<textcolor>bald_ink</textcolor>
					<label>$VAR[Bald_ScreenLabel]</label>
				</control>
				<control type="label">
					<top>5</top>
					<width>auto</width>
					<height>26</height>
					<aligny>top</aligny>
					<font>Bald_Hint</font>
					<textcolor>bald_ink55</textcolor>
					<label>Back for menu</label>
					<visible>!Skin.HasSetting(Bald.AutoHideMenuHint) | !String.IsEqual(Skin.String(Bald.MenuOpens),3)</visible>
					<animation type="Conditional" condition="$EXP[Bald_Idle]">
						<effect type="fade" start="100" end="0" time="600" tween="sine" easing="inout" />
					</animation>
				</control>
			</control>

			<!-- Configured rows. The shipped generated include reproduces the defaults exactly. -->
			<include>Bald_Generated_HomeWidgets</include>
			<include>Bald_Generated_MoviesWidgets</include>
			<include>Bald_Generated_TVShowsWidgets</include>

			<!-- Menu preview for screens without rows yet -->
			<control type="group">
				<include>Bald_AnimInfoChrome</include>
				<visible>$EXP[Bald_PreviewOther]</visible>
				<include>Bald_AnimRowSwap</include>
				<control type="label">
					<left>96</left>
					<top>856</top>
					<width>1248</width>
					<height>26</height>
					<aligny>center</aligny>
					<font>Bald_RowLabel</font>
					<textcolor>bald_ink</textcolor>
					<label>$VAR[Bald_MenuPreviewLabel]</label>
				</control>
				<control type="label">
					<left>96</left>
					<top>898</top>
					<width>1248</width>
					<height>30</height>
					<font>Bald_Date</font>
					<textcolor>bald_ink70</textcolor>
					<label>$VAR[Bald_MenuPreviewNote]</label>
				</control>
			</control>
		</control>

		<!-- Idle wake: the idle timer parks focus here so the first key press only wakes. -->
		<control type="button" id="9199">
			<width>1</width>
			<height>1</height>
			<texturefocus />
			<texturenofocus />
			<onup>SetFocus($INFO[Window(home).Property(Bald.Row)])</onup>
			<ondown>SetFocus($INFO[Window(home).Property(Bald.Row)])</ondown>
			<onleft>SetFocus($INFO[Window(home).Property(Bald.Row)])</onleft>
			<onright>SetFocus($INFO[Window(home).Property(Bald.Row)])</onright>
			<onclick>SetFocus($INFO[Window(home).Property(Bald.Row)])</onclick>
			<onback>SetFocus($INFO[Window(home).Property(Bald.Row)])</onback>
		</control>
		<!-- Directional navigation accepts a control target more reliably than an ActivateWindow
		     built-in on Kodi's list edge. These invisible bridges own the secondary library routes. -->
		<control type="button" id="9197">
			<width>1</width><height>1</height><texturefocus /><texturenofocus />
			<onfocus>ActivateWindow(Videos,videodb://movies/titles/,return)</onfocus>
		</control>
		<control type="button" id="9196">
			<width>1</width><height>1</height><texturefocus /><texturenofocus />
			<onfocus>ActivateWindow(Videos,videodb://tvshows/titles/,return)</onfocus>
		</control>
	</controls>
</window>
