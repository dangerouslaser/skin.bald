<?xml version="1.0" encoding="utf-8"?>
<!-- Bald pause and seek header (docs/SPEC.md 5, "Playback (proposed)"). While seeking or paused with no OSD, a quiet
     top: the player state and time at the left over a 1200 px track, and Home's clock at the right with the finish
     time under it. In the info states (OSD, info overlay) only the clock shows; the title and time are at the bottom
     (DialogSeekBar.xml). After 5 s paused everything leaves, as Estuary's top bar did. Started from Kodi 22 Estuary's
     Custom_1109_TopBarOverlay.xml (GPL-2.0-or-later, see LICENSE-Estuary.txt); window and group visibility is
     Estuary's. No control ids are bound. -->
<window type="dialog" id="1109">
	<onload>Skin.TimerStart(1109_topbaroverlay)</onload>
	<visible>Window.IsActive(fullscreenvideo) | Window.IsActive(visualisation)</visible>
	<visible>Window.IsActive(seekbar) | Window.IsActive(pvrosdchannels) | Window.IsActive(pvrchannelguide)</visible>
	<depth>DepthOSD</depth>
	<include content="Bald_PlaybackAnimWindow">
		<param name="y">-40</param>
	</include>
	<zorder>0</zorder>
	<controls>
		<!-- Scrim for the header and the clock. -->
		<control type="group">
			<visible>$EXP[Bald_PlaybackPauseHeader] | $EXP[Bald_PlaybackTopChrome]</visible>
			<include>Bald_PlaybackAnimFade</include>
			<animation type="Conditional" condition="$EXP[Bald_PlaybackPauseSettled] + !$EXP[Bald_PlaybackTopChrome]" reversible="false">
				<effect type="fade" start="100" end="0" time="480" tween="sine" easing="inout" />
			</animation>
			<animation type="Conditional" condition="$EXP[infodialog_active]">
				<effect type="fade" start="100" end="0" time="160" tween="sine" easing="inout" />
			</animation>
			<include>Bald_PlaybackScrimTop</include>
			<include>Bald_PlaybackClock</include>
		</control>
		<!-- Pause and seek header: state, time and chapter, and the track. -->
		<control type="group">
			<visible>$EXP[Bald_PlaybackPauseHeader]</visible>
			<include content="Bald_PlaybackAnimVisible">
				<param name="y">-40</param>
			</include>
			<animation type="Conditional" condition="$EXP[Bald_PlaybackPauseSettled]" reversible="false">
				<effect type="fade" start="100" end="0" time="480" tween="sine" easing="inout" />
			</animation>
			<control type="label">
				<left>Bald_SafeLeft</left>
				<top>108</top>
				<width>1200</width>
				<height>32</height>
				<aligny>center</aligny>
				<font>Bald_InfoMeta</font>
				<textcolor>bald_ink</textcolor>
				<label>$VAR[Bald_PlaybackState]</label>
			</control>
			<control type="label">
				<left>Bald_SafeLeft</left>
				<top>146</top>
				<width>1200</width>
				<height>28</height>
				<aligny>center</aligny>
				<font>Bald_CaptionMeta</font>
				<textcolor>bald_ink70</textcolor>
				<label>$VAR[Bald_PlaybackTime]$VAR[Bald_PlaybackChapter]</label>
				<visible>!Player.ChannelPreviewActive | VideoPlayer.HasEpg</visible>
			</control>
			<control type="group">
				<visible>!VideoPlayer.Content(LiveTV)</visible>
				<include content="Bald_PlaybackTrack">
					<param name="width">1200</param>
					<param name="top">206</param>
					<param name="fill_top">204</param>
				</include>
				<control type="slider">
					<left>Bald_SafeLeft</left>
					<top>200</top>
					<width>1200</width>
					<include>Bald_PlaybackNib</include>
					<info>Player.Seekbar</info>
					<visible>Player.Seeking | Player.HasPerformedSeek(3) | Player.Paused</visible>
				</control>
			</control>
			<control type="group">
				<visible>VideoPlayer.Content(LiveTV)</visible>
				<include content="Bald_PlaybackPVRTrack">
					<param name="width">1200</param>
					<param name="top">206</param>
					<param name="fill_top">204</param>
				</include>
				<control type="slider">
					<left>Bald_SafeLeft</left>
					<top>200</top>
					<width>1200</width>
					<include>Bald_PlaybackNib</include>
					<info>PVR.TimeShiftSeekbar</info>
					<visible>[Player.Seeking | Player.HasPerformedSeek(3) | Player.Paused] + !Player.ChannelPreviewActive</visible>
				</control>
			</control>
		</control>
	</controls>
</window>
