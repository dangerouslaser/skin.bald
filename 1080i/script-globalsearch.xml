<?xml version="1.0" encoding="UTF-8"?>
<!-- Active-skin override for script.globalsearch 9.x. The add-on owns all data/actions. -->
<window>
	<views>50</views>
	<onload condition="$EXP[Bald_HasTMDbHelper]">Skin.SetBool(TMDbHelper.EnableBlur)</onload>
	<onload condition="$EXP[Bald_HasTMDbHelper]">Skin.SetBool(TMDbHelper.UseLocalWidgetContainer)</onload>
	<onload condition="$EXP[Bald_HasTMDbHelper]">SetProperty(TMDbHelper.Blur.SourceImage,Art(fanart)|Art(tvshow.fanart)|Art(thumb))</onload>
	<onload condition="$EXP[Bald_HasTMDbHelper]">SetProperty(TMDbHelper.WidgetContainer,50)</onload>
	<onunload>ClearProperty(TMDbHelper.WidgetContainer)</onunload>
	<onunload>ClearProperty(TMDbHelper.Blur.SourceImage)</onunload>
	<onunload condition="String.IsEqual(Window(home).Property(Bald.SearchOrigin),home)">SetProperty(Bald.ReturnSearch,true,home)</onunload>
	<onunload>ClearProperty(Bald.SearchOrigin,home)</onunload>
	<animation type="WindowOpen"><effect type="fade" start="0" end="100" time="380" tween="sine" easing="inout" /></animation>
	<animation type="WindowClose"><effect type="fade" start="100" end="0" time="160" tween="sine" easing="inout" /></animation>
	<controls>
		<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field">bald/white.png</texture></control>
		<!-- Global Search is a script WindowXML, so TMDb Helper must watch its local
		     container and publish the cached blur on this window rather than Home. -->
		<control type="image">
			<width>1920</width><height>1080</height><aspectratio>scale</aspectratio><fadetime>800</fadetime>
			<texture background="true">$INFO[Window.Property(TMDbHelper.ListItem.BlurImage)]</texture>
			<visible>$EXP[Bald_HasTMDbHelper] + !String.IsEmpty(Window.Property(TMDbHelper.ListItem.BlurImage))</visible>
			<colordiffuse>bald_backdrop</colordiffuse>
		</control>
		<control type="image"><width>1920</width><height>1080</height><texture colordiffuse="bald_field60">bald/white.png</texture></control>
		<control type="label"><left>96</left><top>108</top><width>1100</width><height>52</height><font>Bald_CaptionTitle</font><textcolor>bald_ink</textcolor><label>Search</label></control>
		<control type="label"><left>1296</left><top>120</top><width>528</width><height>28</height><align>right</align><font>Bald_CaptionMeta</font><textcolor>bald_ink60</textcolor><label>$INFO[Window.Property(GlobalSearch.SearchString),Results for “,”]</label></control>
		<control type="label" id="991"><left>96</left><top>174</top><width>1140</width><height>28</height><font>Bald_Section</font><textcolor>bald_accent</textcolor><label></label></control>
		<control type="group"><left>96</left><top>180</top><visible>!Control.IsVisible(991)</visible>
			<control type="label"><left>26</left><width>702</width><height>28</height><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>Title</label></control>
			<control type="label"><left>752</left><width>80</width><height>28</height><align>right</align><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>Year</label></control>
			<control type="label"><left>856</left><width>260</width><height>28</height><align>right</align><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>Series / artist</label></control>
		</control>
		<control type="list" id="50">
			<left>96</left><top>222</top><width>1140</width><height>624</height><viewtype label="Bald search list">list</viewtype>
			<onfocus>ClearProperty(Bald.SearchMenu)</onfocus><onup>990</onup><onleft>990</onleft><onright>50</onright><scrolltime tween="cubic" easing="out">440</scrolltime><preloaditems>2</preloaditems>
			<itemlayout width="1140" height="48"><control type="label"><left>26</left><width>702</width><height>48</height><aligny>center</aligny><font>Bald_Section</font><textcolor>bald_ink70</textcolor><label>$INFO[ListItem.Label]</label></control><control type="label"><left>752</left><width>80</width><height>48</height><align>right</align><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink70</textcolor><label>$INFO[ListItem.Year]</label></control><control type="label"><left>856</left><width>260</width><height>48</height><align>right</align><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink60</textcolor><label>$INFO[ListItem.TVShowTitle]$INFO[ListItem.Artist]</label></control></itemlayout>
			<focusedlayout width="1140" height="48"><control type="image"><left>0</left><top>20</top><width>8</width><height>8</height><texture colordiffuse="bald_accent">bald/dot.png</texture></control><control type="label"><left>26</left><width>702</width><height>48</height><aligny>center</aligny><font>Bald_Section</font><textcolor>bald_ink</textcolor><label>$INFO[ListItem.Label]</label></control><control type="label"><left>752</left><width>80</width><height>48</height><align>right</align><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink</textcolor><label>$INFO[ListItem.Year]</label></control><control type="label"><left>856</left><width>260</width><height>48</height><align>right</align><aligny>center</aligny><font>Bald_CaptionMeta</font><textcolor>bald_ink70</textcolor><label>$INFO[ListItem.TVShowTitle]$INFO[ListItem.Artist]</label></control></focusedlayout>
		</control>
		<control type="group">
			<visible>!$EXP[Bald_SearchMenuOpen] + !String.IsEmpty(Container(50).ListItem.Label)</visible>
			<animation type="Hidden"><effect type="fade" start="100" end="0" time="180" tween="sine" easing="inout" /></animation><animation type="Visible"><effect type="fade" start="0" end="100" time="380" delay="140" tween="sine" easing="inout" /><effect type="slide" start="40,0" end="0,0" time="480" delay="140" tween="cubic" easing="out" /></animation>
			<control type="image"><left>1296</left><top>222</top><width>528</width><height>297</height><texture colordiffuse="bald_placeholder">bald/white.png</texture></control>
			<control type="image"><left>1296</left><top>222</top><width>528</width><height>297</height><texture background="true">$INFO[Container(50).ListItem.Art(fanart)]</texture><aspectratio>scale</aspectratio><fadetime>700</fadetime></control>
			<control type="image"><left>1296</left><top>222</top><width>528</width><height>297</height><texture background="true">$INFO[Container(50).ListItem.Icon]</texture><aspectratio>keep</aspectratio><fadetime>700</fadetime><visible>String.IsEmpty(Container(50).ListItem.Art(fanart))</visible></control>
			<control type="label"><left>1296</left><top>548</top><width>528</width><height>88</height><font>Bald_CaptionTitle</font><textcolor>bald_ink</textcolor><wrapmultiline>true</wrapmultiline><label>$INFO[Container(50).ListItem.Label]</label></control>
			<control type="label"><left>1296</left><top>636</top><width>528</width><height>28</height><font>Bald_CaptionMeta</font><textcolor>bald_ink70</textcolor><label>$INFO[Container(50).ListItem.Year]$INFO[Container(50).ListItem.Duration(mins), · , min]$INFO[Container(50).ListItem.TVShowTitle, · ]$INFO[Container(50).ListItem.Artist, · ]</label></control>
			<control type="textbox"><left>1296</left><top>686</top><width>528</width><height>144</height><font>Bald_CaptionPlot</font><textcolor>bald_ink76</textcolor><label>$INFO[Container(50).ListItem.Plot]</label></control>
		</control>
		<control type="group"><visible>$EXP[Bald_SearchMenuOpen]</visible><include>Bald_AnimMenuShows</include><control type="label"><left>1466</left><top>292</top><width>394</width><height>30</height><font>Bald_CaptionMeta</font><textcolor>bald_ink60</textcolor><label>Search options</label></control></control>
		<control type="button" id="990">
			<left>1440</left><top>392</top><width>420</width><height>56</height><label>New search</label><visible allowhiddenfocus="true">$EXP[Bald_SearchMenuOpen] | Integer.IsEqual(Container(50).NumItems,0)</visible><include>Bald_AnimMenuShows</include>
			<font>Bald_MenuItem</font><align>left</align><aligny>center</aligny><textoffsetx>26</textoffsetx><textcolor>bald_ink34</textcolor><focusedcolor>bald_ink</focusedcolor><texturefocus /><texturenofocus />
			<onfocus>SetProperty(Bald.SearchMenu,true)</onfocus><onup>9000</onup><ondown>9000</ondown><onleft>ClearProperty(Bald.SearchMenu)</onleft><onleft>50</onleft><onright>ClearProperty(Bald.SearchMenu)</onright><onright>50</onright><onback>ClearProperty(Bald.SearchMenu)</onback><onback>50</onback>
		</control>
		<control type="image"><left>1440</left><top>416</top><width>8</width><height>8</height><texture colordiffuse="bald_accent">bald/dot.png</texture><visible>Control.HasFocus(990)</visible></control>
		<control type="list" id="9000">
			<left>1440</left><top>454</top><width>420</width><height>248</height><orientation>vertical</orientation><scrolltime>0</scrolltime><visible allowhiddenfocus="true">$EXP[Bald_SearchMenuOpen]</visible><include>Bald_AnimMenuShows</include>
			<onfocus>SetProperty(Bald.SearchMenu,true)</onfocus><onup>990</onup><ondown>990</ondown><onleft>ClearProperty(Bald.SearchMenu)</onleft><onleft>50</onleft><onright>ClearProperty(Bald.SearchMenu)</onright><onright>50</onright><onback>ClearProperty(Bald.SearchMenu)</onback><onback>50</onback>
			<itemlayout width="420" height="62"><control type="label"><left>26</left><width>310</width><height>56</height><aligny>center</aligny><font>Bald_MenuItem</font><textcolor>bald_ink34</textcolor><label>$INFO[ListItem.Label]</label></control><control type="label"><right>26</right><width>70</width><height>56</height><align>right</align><aligny>center</aligny><font>Bald_MenuNote</font><textcolor>bald_ink45</textcolor><label>$INFO[ListItem.Label2]</label></control></itemlayout>
			<focusedlayout width="420" height="62"><control type="image"><left>0</left><top>24</top><width>8</width><height>8</height><texture colordiffuse="bald_accent">bald/dot.png</texture></control><control type="label"><left>26</left><width>310</width><height>56</height><aligny>center</aligny><font>Bald_MenuItem</font><textcolor>bald_ink</textcolor><label>$INFO[ListItem.Label]</label></control><control type="label"><right>26</right><width>70</width><height>56</height><align>right</align><aligny>center</aligny><font>Bald_MenuNote</font><textcolor>bald_ink70</textcolor><label>$INFO[ListItem.Label2]</label></control></focusedlayout>
		</control>
		<control type="label" id="999"><left>96</left><top>460</top><width>1140</width><height>80</height><align>center</align><aligny>center</aligny><font>Bald_CaptionTitle</font><textcolor>bald_ink60</textcolor><label>$LOCALIZE[284]</label></control>
		<control type="label"><left>96</left><top>954</top><width>900</width><height>24</height><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>$INFO[Container(50).CurrentItem] / $INFO[Container(50).NumItems]</label></control>
		<control type="label"><left>1000</left><top>954</top><width>824</width><height>24</height><align>right</align><font>Bald_Hint</font><textcolor>bald_ink60</textcolor><label>Up / Left for options · Info for details · Back to close</label></control>
	</controls>
</window>
