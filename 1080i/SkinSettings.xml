<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi's "Configure skin..." opens this window. It draws the Bald Settings page itself (Bald_SettingsHome, shared with
     window 1115) rather than redirecting there, so nothing flashes on the way in. The Estuary settings that windows Bald
     has not redesigned yet still read live under Appearance, Estuary windows. -->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<backgroundcolor>bald_field</backgroundcolor>
	<controls>
		<include>Bald_SettingsHome</include>
	</controls>
</window>
